        public ActionResult UploadControlUpload()
        {
            UploadControlExtension.GetUploadedFiles("UploadControl", TranslationsControllerUploadControlSettings.ValidationSettings, TranslationsControllerUploadControlSettings.FileUploadComplete);
            return null;
        }
