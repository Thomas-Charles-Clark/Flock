<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwExceptions="true">
  <!-- 
  See http://nlog-project.org/wiki/Configuration_file 
  for information on customizing logging rules and outputs.
   -->
  <targets>
    <target xsi:type="File" name="infoTarget"
            fileName="${basedir}/Logs/${date:format=yyyy}/${date:format=MMMM}/Info_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="mertexInfoTarget"
            fileName="${basedir}/Logs/Mertex/Info/${date:format=yyyy}/${date:format=MMMM}/Errors_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}       ${message}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="traceTarget"
            fileName="${basedir}/Logs/${date:format=yyyy}/${date:format=MMMM}/Trace_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="mertexTraceTarget"
            fileName="${basedir}/Logs/Mertex/Traces/${date:format=yyyy}/${date:format=MMMM}/Errors_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}       ${message}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="debugTarget"
            fileName="${basedir}/Logs/${date:format=yyyy}/${date:format=MMMM}/Debug_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}       ${message}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="mertexDebugTarget"
            fileName="${basedir}/Logs/Mertex/Debug/${date:format=yyyy}/${date:format=MMMM}/Errors_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}       ${message}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="warnTarget"
            fileName="${basedir}/Logs/${date:format=yyyy}/${date:format=MMMM}/Warnings_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}       ${message}${newline}${onexception:${exception:format=tostring}}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="errorTarget"
            fileName="${basedir}/Logs/${date:format=yyyy}/${date:format=MMMM}/Errors_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}       ${message}${newline}${onexception:${exception:format=tostring}}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="mertexErrorTarget"
            fileName="${basedir}/Logs/Mertex/Errors/${date:format=yyyy}/${date:format=MMMM}/Errors_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}       ${message}${newline}${onexception:${exception:format=tostring}}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="fatalFileTarget"
            fileName="${basedir}/Logs/${date:format=yyyy}/${date:format=MMMM}/Fatalities_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/${date:format=dd}/log${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}${newline}${onexception:${exception:format=tostring}}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target name="fatalEmailTarget" xsi:type="Mail"
      smtpServer="mailhost.zen.co.uk"
      smtpPort="587"
      smtpAuthentication="Basic"
      smtpUserName="zen100278@zen.co.uk"
      smtpPassword="yiXW9vTS"
      enableSsl="true"
      from="flock@designersguild.com"
      to="tclark@designersguild.com"
      cc="mchristie@designersguild.com"
      subject="URGENT - FLOCK FATALITY"
      body="${date:format=dd-MM-yyyy HH:mm:s} ${message}"
    />
  </targets>

  <rules>
    <!-- add your logging rules here -->
    <logger name="*" level="Info" writeTo="infoTarget" />
    <logger name="*" level="Trace" writeTo="traceTarget" />
    <logger name="*" level="Debug" writeTo="debugTarget" />
    <logger name="*" level="Warn" writeTo="warnTarget" />
    <logger name="*" level="Error" writeTo="errorTarget" />
    <logger name="*" level="Fatal" writeTo="fatalFileTarget" />
    <logger name="Flock.DAL.Mertex.*" level="Info" writeTo="mertexInfoTarget" />
    <logger name="Flock.DAL.Mertex.*" level="Trace" writeTo="mertexTraceTarget" />
    <logger name="Flock.DAL.Mertex.*" level="Debug" writeTo="mertexDebugTarget" />
    <logger name="Flock.DAL.Mertex.*" minlevel="Error" writeTo="mertexErrorTarget" />
    <!--<logger name="*" level="Fatal" writeTo="fatalEmailTarget" />-->
  </rules>
</nlog>