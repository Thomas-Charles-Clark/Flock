@using Flock.DAL
@using Flock.Models
@{
    var UoW = new UnitOfWork<FlockDataContext>();

    var grid = Html.DevExpress().GridView(settings =>
    {
        settings.Name = "DeliveryBandGridView";

        settings.CallbackRouteValues = new { Controller = "eCommerce", Action = "DeliveryBandGridViewPartial" };
        settings.SettingsEditing.AddNewRowRouteValues = new { Controller = "eCommerce", Action = "DeliveryBandGridViewPartialAddNew" };
        settings.SettingsEditing.UpdateRowRouteValues = new { Controller = "eCommerce", Action = "DeliveryBandGridViewPartialUpdate" };
        settings.SettingsEditing.DeleteRowRouteValues = new { Controller = "eCommerce", Action = "DeliveryBandGridViewPartialDelete" };
        settings.CustomActionRouteValues = new { Controller = "eCommerce", Action = "DeliveryBandGridViewPartialCustomCommand" };

        settings.PreRender = (sender, e) =>
        {
            MVCxGridView gv = (MVCxGridView)sender;
            gv.FocusedRowIndex = -1;
        };

        settings.SettingsEditing.Mode = GridViewEditingMode.EditFormAndDisplayRow;
        settings.SettingsEditing.ShowModelErrorsForEditors = true;
        settings.SettingsBehavior.ConfirmDelete = false;
        settings.Settings.ShowFilterRow = true;
        settings.Settings.ShowFilterRowMenu = true;

        settings.SettingsEditing.ShowModelErrorsForEditors = true;

        settings.KeyFieldName = "DeliveryBandID";

        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);

        settings.ClientSideEvents.RowClick = @"function(s, e) {
            var id = s.GetRowKey(e.visibleIndex);
            $('#selected-delivery-band-id').val(id);
            LoadingPanel.Show();
            $.ajax({
                url: '" + @Url.Action("ChangeDeliveryBand", "eCommerce") + @"',
                type: 'POST',
                traditional: true,
                data: {
                    DeliveryBandID: id
                },
                success: function(data) {
                    $('#delivery-band-compose-container').html(data);
                    LoadingPanel.Hide();
                },
                timeout: 20000
            });
        }";


        settings.TotalSummary.Add(DevExpress.Data.SummaryItemType.Count, "DeliveryBandID").DisplayFormat = "Total: {0:n0}";
        settings.Settings.ShowFooter = true;

        
        settings.SettingsBehavior.EnableRowHotTrack = true;
        settings.Styles.Row.Cursor = "pointer";
        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
        settings.CommandColumn.Visible = false;
        
        
        MVCxGridViewColumn CustomColumn = new MVCxGridViewColumn();
        CustomColumn.Name = "CustomCommandColumn";
        CustomColumn.FieldName = "CustomCommandColumn";
        CustomColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        CustomColumn.Settings.AllowHeaderFilter = DefaultBoolean.False;
        CustomColumn.EditFormSettings.Visible = DefaultBoolean.False;
        CustomColumn.UnboundType = DevExpress.Data.UnboundColumnType.String;
        CustomColumn.Width = 80;
        CustomColumn.HeaderStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Center;
        CustomColumn.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Center;
        CustomColumn.SetHeaderTemplateContent(c =>
        {
            ViewContext.Writer.Write("<a class=\"dxgvCommandColumnItem_MetropolisBlue dxgv__cci\" onclick=\"DeliveryBandGridView.AddNewRow();\" href=\"javascript:;\" style='font-weight: 700;'>New</a>");
        });
        CustomColumn.SetDataItemTemplateContent(c => {
            ViewContext.Writer.Write("<a class=\"dxgvCommandColumnItem_MetropolisBlue dxgv__cci\" onclick=\"var args = new Array(); args.push(" + c.VisibleIndex + "); args.push(event); $.confirm(ConfirmedDelete, function() { }, args);\" href=\"javascript:;\">Delete</a>");
        });
        settings.Settings.ShowFilterRow = true;

        settings.SettingsPager.Mode = GridViewPagerMode.EndlessPaging;
        // property to EndlessPaging, and the Settings.VerticalScrollBarMode
        settings.Settings.VerticalScrollBarMode = ScrollBarMode.Visible;
        settings.Settings.VerticalScrollableHeight = 280;

        settings.SettingsEditing.Mode = GridViewEditingMode.EditFormAndDisplayRow;
        settings.SettingsPager.PageSizeItemSettings.Visible = false;
        settings.SettingsPager.PageSize = 20;
        settings.SettingsEditing.ShowModelErrorsForEditors = true;
        settings.SettingsBehavior.AllowFocusedRow = true;

        MVCxGridViewColumn DeliveryBandIDColumn = new MVCxGridViewColumn();
        MVCxGridViewColumn DeliveryOptionIDColumn = new MVCxGridViewColumn();
        MVCxGridViewColumn NameColumn = new MVCxGridViewColumn();
        MVCxGridViewColumn DisplayNameColumn = new MVCxGridViewColumn();
        MVCxGridViewColumn CourierIDColumn = new MVCxGridViewColumn();
        MVCxGridViewColumn PriceListIDColumn = new MVCxGridViewColumn();
        MVCxGridViewColumn CarrCodeColumn = new MVCxGridViewColumn();
        MVCxGridViewColumn SortOrderColumn = new MVCxGridViewColumn();
        MVCxGridViewColumn CreatedDTColumn = new MVCxGridViewColumn();

        DeliveryBandIDColumn.Name = "DeliveryBandID";
        DeliveryBandIDColumn.FieldName = "DeliveryBandID";
        DeliveryBandIDColumn.Caption = "ID";
        DeliveryBandIDColumn.EditFormSettings.Visible = DefaultBoolean.False;
        DeliveryBandIDColumn.Width = 35;
        DeliveryBandIDColumn.Settings.AllowAutoFilter = DefaultBoolean.True;
        DeliveryBandIDColumn.Settings.ShowFilterRowMenu = DefaultBoolean.True;
        DeliveryBandIDColumn.Settings.AllowHeaderFilter = DefaultBoolean.False;
        DeliveryBandIDColumn.Settings.HeaderFilterMode = HeaderFilterMode.List;
        settings.Columns.Add(DeliveryBandIDColumn);

        PriceListIDColumn.Name = "PriceListID";
        PriceListIDColumn.FieldName = "PriceListID";
        PriceListIDColumn.Caption = "Price List";
        PriceListIDColumn.Width = 55;
        PriceListIDColumn.EditFormSettings.Visible = DefaultBoolean.True;
        PriceListIDColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        PriceListIDColumn.Settings.AllowHeaderFilter = DefaultBoolean.True;
        PriceListIDColumn.Settings.HeaderFilterMode = HeaderFilterMode.List;
        PriceListIDColumn.ColumnType = MVCxGridViewColumnType.ComboBox;
        var plProp = PriceListIDColumn.PropertiesEdit as ComboBoxProperties;
        plProp.TextField = "Name";
        plProp.ValueField = "PriceListID";
        plProp.ValueType = typeof(byte);
        plProp.DataSource = UoW.GetRepository<PriceList>().GetAll().ToList();
        settings.Columns.Add(PriceListIDColumn);

        CourierIDColumn.Name = "CourierID";
        CourierIDColumn.FieldName = "CourierID";
        CourierIDColumn.Caption = "Courier";
        CourierIDColumn.Width = 55;
        CourierIDColumn.EditFormSettings.Visible = DefaultBoolean.True;
        CourierIDColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        CourierIDColumn.Settings.AllowHeaderFilter = DefaultBoolean.True;
        CourierIDColumn.Settings.HeaderFilterMode = HeaderFilterMode.List;
        CourierIDColumn.ColumnType = MVCxGridViewColumnType.ComboBox;
        var cProp = CourierIDColumn.PropertiesEdit as ComboBoxProperties;
        cProp.TextField = "Name";
        cProp.ValueField = "CourierID";
        cProp.ValueType = typeof(byte);
        cProp.DataSource = UoW.GetRepository<Courier>().GetAll().OrderBy(p => p.Name).ToList();
        settings.Columns.Add(CourierIDColumn);

        DeliveryOptionIDColumn.Name = "DeliveryOptionID";
        DeliveryOptionIDColumn.FieldName = "DeliveryOptionID";
        DeliveryOptionIDColumn.Caption = "Delivery Option";
        DeliveryOptionIDColumn.Width = 120;
        DeliveryOptionIDColumn.EditFormSettings.Visible = DefaultBoolean.True;
        DeliveryOptionIDColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        DeliveryOptionIDColumn.Settings.AllowHeaderFilter = DefaultBoolean.True;
        DeliveryOptionIDColumn.Settings.HeaderFilterMode = HeaderFilterMode.List;
        DeliveryOptionIDColumn.ColumnType = MVCxGridViewColumnType.ComboBox;
        var doProp = DeliveryOptionIDColumn.PropertiesEdit as ComboBoxProperties;
        doProp.TextField = "Name";
        doProp.ValueField = "DeliveryOptionID";
        doProp.ValueType = typeof(byte);
        doProp.DataSource = UoW.GetRepository<DeliveryOption>().GetAll().OrderBy(p => p.Name).ToList();
        settings.Columns.Add(DeliveryOptionIDColumn);
        
        NameColumn.Name = "Name";
        NameColumn.FieldName = "Name";
        NameColumn.Caption = "Name";
        NameColumn.Width = 130;
        NameColumn.EditFormSettings.Visible = DefaultBoolean.True;
        NameColumn.Settings.AllowAutoFilter = DefaultBoolean.True;
        NameColumn.Settings.AllowHeaderFilter = DefaultBoolean.False;
        NameColumn.Settings.HeaderFilterMode = HeaderFilterMode.List;
        var nProp = NameColumn.PropertiesEdit as TextBoxProperties;
        nProp.MaxLength = 100;
        settings.Columns.Add(NameColumn);

        DisplayNameColumn.Name = "DisplayName";
        DisplayNameColumn.FieldName = "DisplayName";
        DisplayNameColumn.Caption = "Display Name";
        DisplayNameColumn.Width = 130;
        DisplayNameColumn.EditFormSettings.Visible = DefaultBoolean.True;
        var dnProp = NameColumn.PropertiesEdit as TextBoxProperties;
        dnProp.MaxLength = 100;
        DisplayNameColumn.Settings.AllowAutoFilter = DefaultBoolean.True;
        DisplayNameColumn.Settings.AllowHeaderFilter = DefaultBoolean.False;
        DisplayNameColumn.Settings.HeaderFilterMode = HeaderFilterMode.List;
        settings.Columns.Add(DisplayNameColumn);

        CarrCodeColumn.Name = "CARRCODE";
        CarrCodeColumn.FieldName = "CARRCODE";
        CarrCodeColumn.Caption = "CARRCODE";
        CarrCodeColumn.Width = 65;
        var ccProp = CarrCodeColumn.PropertiesEdit as TextBoxProperties;
        ccProp.MaxLength = 10;
        CarrCodeColumn.EditFormSettings.Visible = DefaultBoolean.True;
        CarrCodeColumn.Settings.AllowAutoFilter = DefaultBoolean.True;
        CarrCodeColumn.Settings.AllowHeaderFilter = DefaultBoolean.False;
        CarrCodeColumn.Settings.HeaderFilterMode = HeaderFilterMode.List;
        settings.Columns.Add(CarrCodeColumn);


        SortOrderColumn.Name = "SortOrderID";
        SortOrderColumn.FieldName = "SortOrder";
        SortOrderColumn.Caption = "Sort Order";
        SortOrderColumn.EditFormSettings.Visible = DefaultBoolean.True;
        SortOrderColumn.Width = 65;
        SortOrderColumn.Settings.AllowAutoFilter = DefaultBoolean.True;
        SortOrderColumn.Settings.ShowFilterRowMenu = DefaultBoolean.True;
        SortOrderColumn.Settings.AllowHeaderFilter = DefaultBoolean.False;
        SortOrderColumn.Settings.HeaderFilterMode = HeaderFilterMode.List;
        settings.Columns.Add(SortOrderColumn);

        CreatedDTColumn.Name = "CreatedDTColumn";
        CreatedDTColumn.FieldName = "CreatedDT";
        CreatedDTColumn.Caption = "Created";
        CreatedDTColumn.Width = 75;
        CreatedDTColumn.EditFormSettings.Visible = DefaultBoolean.False;
        CreatedDTColumn.ColumnType = MVCxGridViewColumnType.DateEdit;
        CreatedDTColumn.Settings.AllowAutoFilter = DefaultBoolean.True;
        CreatedDTColumn.Settings.ShowFilterRowMenu = DefaultBoolean.True;
        CreatedDTColumn.Settings.AllowHeaderFilter = DefaultBoolean.False;
        settings.Columns.Add(CreatedDTColumn);

        settings.Columns.Add(CustomColumn);

        settings.HeaderFilterFillItems = (sender, e) =>
        {
            MVCxGridView gridView = (MVCxGridView)sender;
            switch (e.Column.Name)
            {
                case "CourierID":
                    e.Values.Clear();
                    foreach (var c in UoW.GetRepository<Courier>().GetAll().OrderBy(p => p.Name))
                    {
                        e.AddValue(c.Name, c.CourierID.ToString());
                    }
                    e.AddShowAll();
                    break;
                case "PriceListID":
                    e.Values.Clear();
                    foreach (var pl in UoW.GetRepository<PriceList>().GetAll().OrderBy(p => p.Name))
                    {
                        e.AddValue(pl.Name, pl.PriceListID.ToString());
                    }
                    e.AddShowAll();
                    break;
                default: break;
            }
        };
        
