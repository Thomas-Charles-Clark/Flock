@grid.BindToLINQ("", "", (s, e) => {
    var source = UoW.GetRepository<DeliveryBand>().GetAll().Where(p => p.DeletedDT == null);

    e.KeyExpression = "DeliveryBandID";
    e.QueryableSource = source;
}).GetHtml()