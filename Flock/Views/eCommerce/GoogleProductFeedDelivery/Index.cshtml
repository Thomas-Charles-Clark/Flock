@using Flock.ViewModels
@model GoogleProductFeedDeliveryViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Admin/_Layout.cshtml";
}
@section styles {
    @Styles.Render("~/Content/default-price.css")
}
@section scripts {
    @Scripts.Render("~/bundles/js/knockout")
}

<h4 class="page-heading">Google Product Feed Delivery Prices</h4>

<div class="page-subheading">

</div>

<div class="form-group row">
    <label class="col-form-label col-lg-1">
        Price List
    </label>
    <div class="col-lg-11">
        <select id="price-list-id" class="form-control" data-bind="value: selectedPriceListID, options: priceLists, optionsText: function(item) { return item.Name }, optionsValue: function(item) { return item.PriceListID }, optionsCaption: 'Please Select...'"></select>
        <button id="save-changes-top" class="button btn-success btn-xs" data-bind="visible: unsavedChanges().length, click: function() { saveChanges() }">
            Save Changes
        </button>
    </div>
</div>

<div class="row" data-bind="visible: selectedPriceListID">
    <div class="col-lg-12">
        <table id="pricing-table" class="table table-striped table-condensed">
            <thead>
                <tr>
                    <th style="width: 150px;">Product Type</th>
                    <th>Price Inc</th>
                    <th>Price Ex</th>
                </tr>
            </thead>
            <tbody data-bind="foreach: visibleRecords">
                <tr data-bind="attr: { id: 'product-type-' + ProductTypeID() }, css: { 'unsaved-changes': UnsavedChanges }">
                    <td data-bind="text: ProductTypeName"></td>
                    <td>
                        <input type="number" class="form-control" data-bind="textInput: PriceInc" />
                    </td>
                    <td>
                        <input type="number" class="form-control" data-bind="textInput: PriceEx" />
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">

    function getAllRecords() {
        return @Html.Raw(Json.Encode(Model.Prices));
    }

    function getAllPriceLists() {
        return @Html.Raw(Json.Encode(Model.PriceLists));
    }

    function getAllProductTypes() {
        return @Html.Raw(Json.Encode(Model.ProductTypes));
    }

    function record(rec) {
        var self = this;

        self.UnsavedChanges = ko.observable(false);

        self.PriceListID = ko.observable(rec.PriceListID)
        self.ProductTypeID = ko.observable(rec.ProductTypeID);
        self.ProductTypeName = ko.observable(rec.ProductTypeName);
        self.PriceInc = ko.observable(rec.PriceInc);
        self.PriceEx = ko.observable(rec.PriceEx);

        self.PriceInc.subscribe(function (newValue) {
            self.UnsavedChanges(true);
        });
        self.PriceEx.subscribe(function (newValue) {
            self.UnsavedChanges(true);
        });

        self.toJSON = function () {
            var copy = ko.toJS(this);

            delete copy.UnsavedChanges;
            delete copy.ProductTypeName;

            return copy;
        }
    }

    function defaultPricesViewModel() {
        var self = this;

        self.selectedPriceListID = ko.observable(null);

        self.selectedPriceListID.subscribe(function (newValue) {
            self.visibleRecords(
                Enumerable.From(self.allRecords())
                          .Where("$.PriceListID == " + newValue).Select(function (x) {
                              return new record({
                                  PriceListID: newValue,
                                  ProductTypeID: x.ProductTypeID,
                                  ProductTypeName: Enumerable.From(self.productTypes()).Where("$.ProductTypeID == " + x.ProductTypeID).Select("$.Name").Single(),
                                  PriceInc: x.PriceInc,
                                  PriceEx: x.PriceEx
                              })
                          }).ToArray());
        });

        self.allRecords = ko.observable(getAllRecords());

        self.priceLists = ko.observable(getAllPriceLists());

        self.productTypes = ko.observable(getAllProductTypes());

        self.visibleRecords = ko.observableArray([]);

        self.unsavedChanges = ko.pureComputed(function () {
            return Enumerable.From(self.visibleRecords()).Where("$.UnsavedChanges() == true").ToArray();
        }, self);

        self.saveChanges = function () {

            var toSave = self.unsavedChanges();

            $.ajax({
                url: '/admin/ecommerce/UpdateGoogleFeedDefaultPrices',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({
                    'UnsavedChanges': toSave
                }),
                success: function (data) {
                    for (var i = 0; i < toSave.length; i++) {

                        var change = toSave[i];

                        var record = Enumerable.From(self.visibleRecords()).Where(function (x) {
                            if ((x.ProductTypeID() == change.ProductTypeID()) && (x.PriceListID() == change.PriceListID()))
                                return x;
                        }).Single();

                        record.PriceInc(Number(change.PriceInc()));
                        record.PriceEx(Number(change.PriceEx()));
                        record.UnsavedChanges(false);

                        // Because visibleRecords is rebuilt from allRecords on change of PriceList...
                        var originRecord = Enumerable.From(self.allRecords()).Where(function (x) {
                            if ((x.ProductTypeID == change.ProductTypeID()) && (x.PriceListID == change.PriceListID()))
                                return x;
                        }).Single()

                        originRecord.PriceInc = record.PriceInc();
                        originRecord.PriceEx = record.PriceEx();

                        GreenFade($("#product-type-" + record.ProductTypeID()));
                    }
                },
                error: function (x, h, s) {
                    console.log(x);
                    alert('whoops, ' + s + '\r\n' + x.responseText);
                }
            });
        }
    }

    var viewModel = new defaultPricesViewModel();

    ko.applyBindings(viewModel);
</script>