                    var gvtId = s.GetSelectedItem().value;
                    //inspector(gvtId);
                    switch(gvtId) {
                        case 2:
                            $('#goodwill-panel').hide();
                            $('#credit-panel').show();
                        break;
                        case 3:
                            $('#credit-panel').hide();
                            $('#goodwill-panel').show();
                        break;
                        default: break;
                    }
                }";
                var cbProp = cbSettings.Properties as ComboBoxProperties;
                cbProp.ValueField = "GiftVoucherTypeID";
                cbProp.ValueType = typeof(byte);
                cbProp.TextField = "Name";

                if (ViewBag.CreditGiftVoucher != null)
                    cbSettings.SelectedIndex = 0;
                if (ViewBag.GoodwillGiftVoucher != null)
                    cbSettings.SelectedIndex = 1;
            }).BindList(UoW.GetRepository<GiftVoucherType>().GetAll().Where(p => p.GiftVoucherTypeID != 1).OrderBy(p => p.GiftVoucherTypeID)).Render();

            ViewContext.Writer.Write("<div style='clear: both; margin-bottom: 1em;'></div>");

            ViewContext.Writer.Write("<div id='credit-panel' " + (ViewBag.CreditGiftVoucher != null ? " style=' margin-bottom: 1em;'>" : "style='margin-top: 1em; display: none;'>"));

                Html.DevExpress().Label(lblSettings =>
