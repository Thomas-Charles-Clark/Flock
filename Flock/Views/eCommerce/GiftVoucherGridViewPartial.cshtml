                    lblSettings.Text = "Credit Transaction ID";
                    lblSettings.Width = 112;
                    lblSettings.Style.Add("float", "left");
                    lblSettings.Style.Add("margin-right", "1em");
                }).Render();
            
                ViewContext.Writer.Write(Html.Partial("GiftVoucherCreditTransactionIDComboBoxPartial", Model));

                ViewContext.Writer.Write("<div style='clear: both;'></div>");

            ViewContext.Writer.Write("</div>");
            
            ViewContext.Writer.Write("<div id='goodwill-panel'>");
                
            ViewContext.Writer.Write("</div>");

            ViewContext.Writer.Write("<div style='clear: both; margin-bottom: 1em;'></div>");

            
            Html.DevExpress().Label(lblSettings =>
            {
                lblSettings.Text = "Value";
                lblSettings.Width = 38;
                lblSettings.Style.Add("float", "left");
                lblSettings.Style.Add("margin-right", "1em");
            }).Render();
            Html.DevExpress().SpinEdit(seSettings => {
                seSettings.Name = "ValueInc";
                seSettings.Properties.NumberFormat = SpinEditNumberFormat.Number;
                seSettings.ShowModelErrors = true;
                seSettings.Properties.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.ImageWithTooltip;
                seSettings.Properties.DisplayFormatString = "F2";
                seSettings.Properties.LargeIncrement = 10;
                seSettings.Properties.Increment = 1;
                seSettings.Properties.MinValue = 0;
                seSettings.Properties.MaxValue = decimal.MaxValue;
            }).Bind(Model == null ? 0.0M : (Model.ValueInc)).Render();
            
            ViewContext.Writer.Write("<div style='clear: both; margin-bottom: 1em;'></div>");

            Html.DevExpress().Label(lblSettings =>
            {
                lblSettings.Text = "Reason";
                lblSettings.Style.Add("float", "left");
                lblSettings.Style.Add("line-height", "22px");
                lblSettings.Style.Add("margin-right", "1em");
            }).Render();

            Html.DevExpress().Memo(mSettings =>
            {
                mSettings.Name = "Reason";
                mSettings.Properties.MaxLength = 255;
                mSettings.Width = 300;
                mSettings.Properties.Rows = 4;
                mSettings.Properties.Columns = 100;
                mSettings.ShowModelErrors = true;
                mSettings.Properties.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.ImageWithTooltip;
            }).Bind(Model == null ? null : Model.Reason).Render();
            
            ViewContext.Writer.Write("<div style='clear: both'></div>");

            ViewContext.Writer.Write("<div style='text-align: right; padding: 1em;'>");
            Html.DevExpress().Button(btnSettings =>
            {
                btnSettings.Name = "btnUpdate";
                btnSettings.ControlStyle.CssClass = "button";
                btnSettings.Text = "Update";
                btnSettings.Style.Add("margin-right", "1em");
                btnSettings.ClientSideEvents.Click = "function(s, e){ GiftVoucherGridView.UpdateEdit(); }";
            }).Render();
            Html.DevExpress().Button(btnSettings =>
            {
                btnSettings.Name = "btnCancel";
                btnSettings.ControlStyle.CssClass = "button";
                btnSettings.Text = "Cancel";
                btnSettings.Style.Add("margin-right", "34px");
                btnSettings.ClientSideEvents.Click = "function(s, e){ GiftVoucherGridView.CancelEdit(); }";
            }).Render();

            ViewContext.Writer.Write("</div>");
        });
    });
}
@grid.BindToLINQ("", "", (s, e) =>
{
    UoW = new UnitOfWork<FlockDataContext>();
    var source = UoW.GetRepository<GiftVoucher>().GetAll();

    e.KeyExpression = "GiftVoucherID";
    e.QueryableSource = source;
}).GetHtml()
