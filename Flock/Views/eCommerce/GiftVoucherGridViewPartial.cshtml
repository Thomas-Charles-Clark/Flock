        settings.HeaderFilterFillItems = (sender, e) =>
        {
            MVCxGridView gridView = (MVCxGridView)sender;
            switch (e.Column.Name)
            {
                case "PriceListID":
                    e.Values.Clear();
                    foreach (var v in UoW.GetRepository<PriceList>().GetAll().OrderBy(p => p.PriceListID))
                    {
                        e.AddValue(v.Name, v.PriceListID.ToString());
                    }
                    e.AddShowAll();
                    break;
                case "GiftVoucherTypeID":
                    e.Values.Clear();
                    foreach (var v in UoW.GetRepository<GiftVoucherType>().GetAll().OrderBy(p => p.GiftVoucherTypeID))
                    {
                        e.AddValue(v.Name, v.GiftVoucherTypeID.ToString());
                    }
                    e.AddShowAll();
                    break;
                default: break;
            }
        };

