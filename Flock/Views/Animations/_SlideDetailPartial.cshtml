                            var styleString = Flock.Classes.Utilities.buildCallToActionStyleString(a.Style ?? a.CallToAction.Style);
                            <div class="call-to-action width-mode-@a.CallToAction.CallToActionWidthModeID" data-call-to-action-id="@a.CallToActionID" style="@(styleString)">
                                <span class="remove-icon glyphicon glyphicon-remove-circle" onclick="event.stopPropagation(); $.confirm(function () { RemoveCallToAction(@a.CallToActionID, @a.SlideID) }, function () { }, 'Are you sure?')"></span>
                                @a.CallToActionID - @a.CallToAction.Text
                            </div>
                            <div class="clearfix"></div>
                        }
                    </div>
