    var area9Calls = Model.AssignedCallsToAction.Where(p => p.SlideAreaID == 9).OrderBy(p => p.SortOrder).ToList();

    string ImageString = "";
    string HiddenImageInput = "";
    string HiddenVideoInput = "";

    if (Model.Image != null)
    {
        ImageString = "<img src='https://flock.designersguild.com/imagelibrary/1024/" + Model.Image.ImageID + ".jpeg' />";
        HiddenImageInput = "<input type='hidden' id='SlideImageID' value='" + Model.Image.ImageID + "'/>";
    }

    string VideoString = "";

    if (Model.Video != null)
    {
        VideoString = Model.Video.EmbedCode;
        HiddenVideoInput = "<input type='hidden' id='SlideVideoID' value='" + Model.Video.VideoID + "'/>";
    }
}

@Html.Raw(HiddenImageInput)
@Html.Raw(HiddenVideoInput)

<div class="slide-detail-wrapper">
    @Html.Raw(ImageString)
    @Html.Raw(VideoString)
