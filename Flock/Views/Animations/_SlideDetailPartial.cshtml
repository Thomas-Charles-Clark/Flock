@model Flock.ViewModels.SlideEditModel
@{
    var area1Calls = Model.AssignedCallsToAction.Where(p => p.SlideAreaID == 1).OrderBy(p => p.SortOrder).ToList();
    var area2Calls = Model.AssignedCallsToAction.Where(p => p.SlideAreaID == 2).OrderBy(p => p.SortOrder).ToList();
    var area3Calls = Model.AssignedCallsToAction.Where(p => p.SlideAreaID == 3).OrderBy(p => p.SortOrder).ToList();
    var area4Calls = Model.AssignedCallsToAction.Where(p => p.SlideAreaID == 4).OrderBy(p => p.SortOrder).ToList();
