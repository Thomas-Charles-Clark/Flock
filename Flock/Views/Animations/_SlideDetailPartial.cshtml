<div class="slide-link-wrapper">
    <table class="slide-link-table">
        <tbody>
            <tr>
                <td>
                    <p style="font-size: 11px; font-style: italic;">
                        These settings affect just this slide.
                    </p>
                </td>
            </tr>
            <tr>
                <td>
                    @Html.DevExpress().CheckBoxFor(m => Model.SlideNewWindow, settings =>
                    {
                        settings.Name = "SlideNewWindow";
                        settings.Properties.ValueType = typeof(bool);
                        settings.Properties.ValueChecked = true;
                        settings.Properties.ValueUnchecked = false;
                        settings.Properties.Caption = "New Window";
                        settings.ShowModelErrors = true;
                        settings.Properties.ValidationSettings.Display = Display.Dynamic;
                    }).GetHtml()
                </td>
            </tr>
            <tr>
                <td>
                    @Html.Partial("_SlidePageIDComboBoxPartial", Model)
                </td>
            </tr>
            <tr>
                <td>
                    @Html.Partial("_SlideArticleIDComboBoxPartial", Model)
                </td>
            </tr>
            <tr>
                <td>
                    @Html.Partial("_SlideCollectionIDComboBoxPartial", Model)
                </td>
            </tr>
            <tr>
                <td>
                    @Html.Partial("_SlideProductPageIDComboBoxPartial", Model)
                </td>
            </tr>
            <tr>
                <td>
                    @Html.DevExpress().TextBoxFor(m => Model.SlideExternalURL, settings =>
                    {
                        settings.Name = "SlideExternalURL";
                        settings.Properties.MaxLength = 255;
                        settings.Width = 156;
                        settings.Properties.Caption = "External URL";
                        settings.Properties.CaptionSettings.Position = EditorCaptionPosition.Left;
                        settings.Properties.CaptionSettings.VerticalAlign = EditorCaptionVerticalAlign.Middle;
                        settings.ShowModelErrors = true;
                        settings.Properties.ValidationSettings.Display = Display.Dynamic;
                    }).GetHtml()
                </td>
            </tr>
            <tr>
                <td>
                    <button id="slide-save-btn" class="btn btn-success" onclick="SaveSlideDetails(@(Model.SlideID))">Save</button>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<div class="clearfix"></div>

<hr/>

<table class="slide-edit-table">
    <tbody>
        <tr>
            <td colspan="4">
                <p style="font-size: 11px; font-style: italic;">These settings affect all slides.</p>
            </td>
        </tr>
        <tr>
            <td>
                @Html.DevExpress().CheckBoxFor(m => Model.DisplayCallsToAction, settings =>
                    {
                        settings.Name = "DisplayCallsToAction";
                        settings.Properties.Caption = "Display Calls to Action";
                        settings.Properties.ValueType = typeof(bool);
                        settings.Properties.ValueChecked = true;
                        settings.Properties.ValueUnchecked = false;
                        settings.Checked = true;
                        settings.Properties.ClientSideEvents.CheckedChanged = @"function(s, e) {
                            SaveSlideDetails(" + Model.SlideID + @");
                        }";
                    }).GetHtml()
            </td>
            <td>
                @Html.DevExpress().CheckBoxFor(m => Model.AutoHideCallsToAction, settings =>
                    {
                        settings.Name = "AutoHideCallsToAction";
                        settings.Properties.Caption = "Auto-Hide Calls to Action";
                        settings.Properties.ValueType = typeof(bool);
                        settings.Properties.ValueChecked = true;
                        settings.Properties.ValueUnchecked = false;
                        settings.Checked = true;
                        settings.Properties.ClientSideEvents.CheckedChanged = @"function(s, e) {
                            SaveSlideDetails(" + Model.SlideID + @");
                        }";
                    }).GetHtml()
            </td>
            <td>
                @Html.DevExpress().CheckBoxFor(m => Model.DisplayHotspots, settings =>
                    {
                        settings.Name = "DisplayHotspots";
                        settings.Properties.Caption = "Display Hotspots";
                        settings.Properties.ValueType = typeof(bool);
                        settings.Properties.ValueChecked = true;
                        settings.Properties.ValueUnchecked = false;
                        settings.Checked = true;
                        settings.Properties.ClientSideEvents.CheckedChanged = @"function(s, e) {
                            SaveSlideDetails(" + Model.SlideID + @");
                        }";
                    }).GetHtml()
            </td>
            <td>
                @Html.DevExpress().CheckBoxFor(m => Model.AutoHideHotspots, settings =>
                    {
                        settings.Name = "AutoHideHotspots";
                        settings.Properties.Caption = "Auto-Hide Hotspots";
                        settings.Properties.ValueType = typeof(bool);
                        settings.Properties.ValueChecked = true;
                        settings.Properties.ValueUnchecked = false;
                        settings.Checked = true;
                        settings.Properties.ClientSideEvents.CheckedChanged = @"function(s, e) {
                            SaveSlideDetails(" + Model.SlideID + @");
                        }";
                    }).GetHtml()
            </td>
        </tr>
    </tbody>
</table>

<script type="text/javascript">
    initCallToActionDragDrop();

    initAreaSortables();
</script>