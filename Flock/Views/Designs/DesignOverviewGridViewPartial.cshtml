@{
    var grid = Html.DevExpress().GridView(settings =>
    {
        settings.Name = "DesignOverviewGridView";
        settings.CallbackRouteValues = new { Controller = "Designs", Action = "DesignOverviewGridViewPartial" };
        //settings.SettingsEditing.AddNewRowRouteValues = new { Controller = "Designs", Action = "ProductPagesOverviewGridViewPartialAddNew" };
        //settings.SettingsEditing.UpdateRowRouteValues = new { Controller = "Designs", Action = "ProductPagesOverviewGridViewPartialUpdate" };
        //settings.SettingsEditing.DeleteRowRouteValues = new { Controller = "Designs", Action = "ProductPagesOverviewGridViewPartialDelete" };
        settings.CustomActionRouteValues = new { Controller = "Designs", Action = "DesignOverviewGridViewPartialCustomCommand" };

        settings.SettingsDetail.ShowDetailButtons = true;
        settings.ClientSideEvents.BeginCallback = @"function(s, e) {
//            e.customArgs['CollectionID'] = DesignOverviewCollectionListBox.GetValue();
//            e.customArgs['ColourID'] = DesignOverviewColourListBox.GetValue();
//            e.customArgs['CountryID'] = DesignOverviewCountryListBox.GetValue();
        }";

        settings.ClientSideEvents.CallbackError = @"function(s, e) {
            alert(e.message);
            e.handled = true;
            s.Refresh();
        }";

        settings.SettingsDetail.AllowOnlyOneMasterRowExpanded = false;
        settings.CommandColumn.ShowClearFilterButton = true;
        settings.SettingsDetail.ShowDetailRow = true;

        settings.SetDetailRowTemplateContent(c =>
        {
            ViewContext.Writer.Write(Html.Action("DesignOverviewDetailGridViewPartial", "Designs", new { DesignID = c.KeyValue }));
        });


        settings.Width = System.Web.UI.WebControls.Unit.Pixel(975);
        settings.CommandColumn.Visible = true;
        settings.CommandColumn.ShowDeleteButton = false;
        settings.CommandColumn.ShowSelectCheckbox = true;
        settings.Settings.ShowFilterRow = true;
        settings.CommandColumn.SetHeaderTemplateContent(c =>
        {
            Html.DevExpress().CheckBox(settingsCheckBox =>
            {
                settingsCheckBox.Name = "cbSelectAll";
                settingsCheckBox.Properties.ClientSideEvents.CheckedChanged = string.Format("function(s, e) {{ if(s.GetChecked()) {0}.SelectAllRowsOnPage(s.GetChecked()); else {0}.UnselectAllRowsOnPage(s.GetChecked()); }}", settings.Name);
                settingsCheckBox.Checked = c.Grid.VisibleRowCount == c.Grid.Selection.Count;
            }).Render();
        });
        
        settings.SettingsBehavior.ConfirmDelete = true;
        settings.CommandColumn.ShowSelectCheckbox = true;
        settings.SettingsEditing.Mode = GridViewEditingMode.EditFormAndDisplayRow;
        settings.SettingsPager.PageSizeItemSettings.Visible = true;
        settings.SettingsPager.PageSizeItemSettings.Position = PagerPageSizePosition.Right;
        settings.SettingsPager.PageSizeItemSettings.ShowAllItem = false;


        settings.KeyFieldName = "DesignID";

        settings.Columns.Add(column =>
        {
            column.Name = "DesignID";
            column.FieldName = "DesignID";
            column.Caption = "Design ID";
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.Width = 60;
            //column.EditFormCaptionStyle.CssClass = "hidden-input-field";
            //column.EditCellStyle.CssClass = "hidden-input-field";
            column.EditFormSettings.Visible = DefaultBoolean.False;
        });

        settings.Columns.Add(column =>
        {
            column.Name = "Name";
            column.FieldName = "Name";
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.EditFormSettings.Visible = DefaultBoolean.True;
            column.EditFormCaptionStyle.CssClass = "editform-label";
            column.EditCellStyle.CssClass = "editform-cell";
        });

        settings.Columns.Add(column =>
        {
            column.Name = "Family";
            column.FieldName = "Family";
            column.Caption = "Family";
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.EditFormCaptionStyle.CssClass = "hidden-input-field";
            column.EditCellStyle.CssClass = "hidden-input-field";
            //column.EditFormSettings.Visible = DefaultBoolean.True;
        });

        settings.Columns.Add(column =>
        {
            column.Name = "ProductAssociations";
            column.FieldName = "ProductAssociations";
            column.Caption = "Product Associations";
            column.HeaderStyle.Wrap = DefaultBoolean.True;
            column.Width = 60;
            column.EditFormCaptionStyle.CssClass = "editform-label";
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
        });


