@model List<Flock.Models.vwProductOverview>
@{
    var grid = Html.DevExpress().GridView(settings =>
    {
        var UoW = new Flock.DAL.UnitOfWork<Flock.Models.FlockDataContext>();
        
        settings.Name = "DesignOverviewDetailGridView" + ViewBag.DesignOverviewDetailGridDesignID.ToString();
        settings.CallbackRouteValues = new { Controller = "Products", Action = "DesignOverviewDetailGridViewPartial" };
        settings.CommandColumn.Visible = false;
        settings.CommandColumn.ShowClearFilterButton = true;
        settings.CommandColumn.ShowSelectCheckbox = true;
        //settings.CommandColumn.SetHeaderTemplateContent(c =>
        //{
        //    settings.CommandColumn.ShowSelectCheckbox = true;
        //    Html.DevExpress().CheckBox(settingsCheckBox =>
        //    {
        //        settingsCheckBox.Name = "cbSelectAll";
        //        settingsCheckBox.Properties.ClientSideEvents.CheckedChanged = string.Format("function(s, e) {{ if(s.GetChecked()) {0}.SelectAllRowsOnPage(s.GetChecked()); else {0}.UnselectAllRowsOnPage(s.GetChecked()); }}", settings.Name);
        //        settingsCheckBox.Checked = c.Grid.VisibleRowCount == c.Grid.Selection.Count;
        //    }).Render();
        //});
       
        settings.KeyFieldName = "ProductID";

        settings.SettingsPager.Visible = true;
        
        settings.SettingsPager.Mode = GridViewPagerMode.ShowAllRecords;
        settings.SettingsPager.PageSizeItemSettings.Visible = false;
        settings.SettingsBehavior.AllowSelectByRowClick = false;
        settings.SettingsBehavior.AllowSelectSingleRowOnly = false;
        
        MVCxGridViewColumn ProductIDColumn = new MVCxGridViewColumn();
        ProductIDColumn.FieldName = "ProductID";
        ProductIDColumn.Name = "ProductID";
        ProductIDColumn.Caption = "Product ID";
        ProductIDColumn.Settings.AllowHeaderFilter = DefaultBoolean.False;
        ProductIDColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        ProductIDColumn.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
        settings.Columns.Add(ProductIDColumn);
        
        MVCxGridViewColumn FrontColumn = new MVCxGridViewColumn();
        FrontColumn.FieldName = "Front";
        FrontColumn.Name = "Front";
        FrontColumn.Caption = "Front Image";
        FrontColumn.Width = (System.Web.UI.WebControls.Unit)40;
        FrontColumn.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Center;
        FrontColumn.Settings.AllowHeaderFilter = DefaultBoolean.True;
        FrontColumn.Settings.HeaderFilterMode = HeaderFilterMode.List;
        FrontColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        FrontColumn.SetDataItemTemplateContent(c =>
        {
            var ImageID = DataBinder.Eval(c.DataItem, "Front");

            var Image = ImageID != null && ImageID != DBNull.Value ? "<img alt='Front' src='https://flock.designersguild.com/imagelibrary/32/" + ImageID + ".jpeg'/>" : null; 
            
                if (Image != null)
                    ViewContext.Writer.Write(Image);
                else
                    ViewContext.Writer.Write("Not Set");
        });
        settings.Columns.Add(FrontColumn);

        
        settings.Columns.Add(column =>
        {
            column.FieldName = "Enabled";
            column.Name = "Enabled";
            column.Caption = "Enabled";
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            
            column.SetDataItemTemplateContent(c =>
            {
                bool enabledState = (bool)DataBinder.Eval(c.DataItem, "Enabled");
                if (enabledState)
                    ViewContext.Writer.Write("<span style='color: green'>" + DataBinder.Eval(c.DataItem, "Enabled") + "</span>");
                else
                    ViewContext.Writer.Write("<span style='color: red'>" + DataBinder.Eval(c.DataItem, "Enabled") + "</span>");
            });
        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "Status";
            column.Name = "Status";
            column.Caption = "Status";
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.SetDataItemTemplateContent(c =>
            {
                char enabledState = '?';
                if (DataBinder.Eval(c.DataItem, "Status") != DBNull.Value && DataBinder.Eval(c.DataItem, "Status") != null)
                    enabledState = (char)DataBinder.Eval(c.DataItem, "Status");
                switch (enabledState)
                {
                    case 'C':
                        ViewContext.Writer.Write("<span style='color: green'>" + enabledState + "</span>");
                        break;
                    case 'D':
                        ViewContext.Writer.Write("<span style='color: red'>" + enabledState + "</span>");
                        break;
                    case 'L':
                        ViewContext.Writer.Write("<span style='color: orange'>" + enabledState + "</span>");
                        break;
                    case 'Y':
                        ViewContext.Writer.Write("<span style='color: orange'>" + enabledState + "</span>");
                        break;
                    default:
                        ViewContext.Writer.Write("<span style='color: black'>" + enabledState + "</span>");
                        break;
                }
            });
        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "StatusID";
            column.Name = "StatusID";
            column.Caption = "Web Status";
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
            column.SetDataItemTemplateContent(c =>
            {
                var i = Convert.ToByte(DataBinder.Eval(c.DataItem, "StatusID"));
                string colour = "black";
                string statusText = "unknown";
                statusText = UoW.GetRepository<Flock.Models.Status>().GetAll().Where(p => p.StatusID == i).Select(p => p.Name).Single();
                switch (i)
                {
                    case 0:
                        colour = "green";
                        break;
                    case 1:
                        colour = "orange";
                        break;
                    case 2:
                        colour = "orange";
                        break;
                    case 3:
                        colour = "green";
                        break;
                    case 4:
                        colour = "red";
                        break;
                    default: break;
                }
                string res = "<span style='color: " + colour + " '>" + statusText + "</span>";
                ViewContext.Writer.Write(res);
            });
        });

        MVCxGridViewColumn StockStatusColumn = new MVCxGridViewColumn();
        StockStatusColumn.FieldName = "StockStatusID";
        StockStatusColumn.Name = "StockStatusID";
        StockStatusColumn.Caption = "Stock";
        StockStatusColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        StockStatusColumn.Settings.AllowHeaderFilter = DefaultBoolean.False;
        StockStatusColumn.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
        StockStatusColumn.SetDataItemTemplateContent(c =>
        {
            short StockStatusID = 0;
            string StockStatus = "<i>Unknown</i>";

            if (DataBinder.Eval(c.DataItem, "StockStatusID") != DBNull.Value && DataBinder.Eval(c.DataItem, "StockStatusID") != null)
            {
                StockStatusID = Convert.ToInt16(DataBinder.Eval(c.DataItem, "StockStatusID"));
                StockStatus = UoW.GetRepository<Flock.Models.StockStatus>().GetAll().Where(p => p.StockStatusID == StockStatusID).Select(p => p.StockStatus1).Single();
            }

            switch (StockStatusID)
            {
                case 1:
                    ViewContext.Writer.Write("<span style='color: green'>" + StockStatus + "</span>");
                    break;
                case 2:
                case 3:
                case 4:
                    ViewContext.Writer.Write("<span style='color: orange'>" + StockStatus + "</span>");
                    break;
                case 5:
                case 6:
                case 7:
                    ViewContext.Writer.Write("<span style='color: red'>" + StockStatus + "</span>");
                    break;

                default:
                    ViewContext.Writer.Write("<span style='color: black'>" + StockStatus + "</span>");
                    break;
            }
        });
        settings.Columns.Add(StockStatusColumn);

        MVCxGridViewColumn ProductTypeColumn = new MVCxGridViewColumn();
        ProductTypeColumn.FieldName = "ProductTypeID";
        ProductTypeColumn.Name = "ProductTypeID";
        ProductTypeColumn.Caption = "Product Type";
        ProductTypeColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        ProductTypeColumn.Settings.AllowHeaderFilter = DefaultBoolean.False;
        ProductTypeColumn.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
        ProductTypeColumn.SetDataItemTemplateContent(c =>
        {
            int ProductTypeID = 0;
            string ProductType = "<i>Unknown</i>";

            if (DataBinder.Eval(c.DataItem, "ProductTypeID") != DBNull.Value && DataBinder.Eval(c.DataItem, "ProductTypeID") != null)
            {
                ProductTypeID = Convert.ToInt16(DataBinder.Eval(c.DataItem, "ProductTypeID"));
                ProductType = UoW.GetRepository<Flock.Models.ProductType>().GetAll().Where(p => p.ProductTypeID == ProductTypeID).Select(p => p.Name).Single();
            }

            ViewContext.Writer.Write("<span style='color: black'>" + ProductType+ "</span>");
        });
        settings.Columns.Add(ProductTypeColumn);
        
        MVCxGridViewColumn BrandColumn = new MVCxGridViewColumn();
        BrandColumn.FieldName = "BrandID";
        BrandColumn.Name = "BrandID";
        BrandColumn.Caption = "Brand";
        BrandColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        BrandColumn.Settings.AllowHeaderFilter = DefaultBoolean.False;
        BrandColumn.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
        BrandColumn.SetDataItemTemplateContent(c =>
        {
            int BrandID = 0;
            string Brand = "<i>Not Set</i>";

            if (DataBinder.Eval(c.DataItem, "BrandID") != DBNull.Value && DataBinder.Eval(c.DataItem, "BrandID") != null)
            {
                BrandID = Convert.ToInt16(DataBinder.Eval(c.DataItem, "BrandID"));
                Brand = UoW.GetRepository<Flock.Models.Brand>().GetAll().Where(p => p.BrandID == BrandID).Select(p => p.Name).Single();
            }

            ViewContext.Writer.Write("<span style='color: black'>" + Brand + "</span>");
        });
        settings.Columns.Add(BrandColumn);
        MVCxGridViewColumn LaunchColumn = new MVCxGridViewColumn();
        LaunchColumn.FieldName = "Launch";
        LaunchColumn.Name = "Launch";
        LaunchColumn.Caption = "Launch";
        LaunchColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        LaunchColumn.Settings.AllowHeaderFilter = DefaultBoolean.False;
        LaunchColumn.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
        settings.Columns.Add(LaunchColumn);
        MVCxGridViewColumn DesignColumn = new MVCxGridViewColumn();
        DesignColumn.FieldName = "Design";
        DesignColumn.Name = "Design";
        DesignColumn.Caption = "Design";
        DesignColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        DesignColumn.Settings.AllowHeaderFilter = DefaultBoolean.False;
        settings.Columns.Add(DesignColumn);

        MVCxGridViewColumn CodeColumn = new MVCxGridViewColumn();
        CodeColumn.FieldName = "Code";
        CodeColumn.Name = "Code";
        CodeColumn.Caption = "Code";
        CodeColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        CodeColumn.Settings.AllowHeaderFilter = DefaultBoolean.False;
        settings.Columns.Add(CodeColumn);

        settings.Style.Add("width", "100%");
        settings.Style.Add("float", "left");

    });
    if (ViewData["EditError"] != null)
    {
        grid.SetEditErrorText((string)ViewData["EditError"]);
    }
}
@grid.Bind(Model).GetHtml()