@model Flock.ViewModels.SampleOrderEmailMessageViewModel
@{
    ViewBag.Title = "Email Messages";
    Layout = "~/Views/Admin/_Layout.cshtml";
}
@section styles {
    @Styles.Render("~/content/email-messages.css")
}

<div class="page-heading">
    <h4>Sample Ordering System - Confirmation Email Messages</h4>
</div>

<div class="page-subheading">
    <p style="font-style: italic;">
        Right... must offer the ability to create (HTML?) messages to be injected into the Sample Order Confirmation emails which will be sent worldwide by people downstairs, and to retail customers by Retail.<br /><br />
        What about sort orders... keep it simple: you're only allowed one message top and one message bottom.<br /><br />
        Do we give them a beautiful and easy to use but powerful too? Or a grid which is... not as great. Visually show them where the message is going to go? Do your best to replicate the very email which will be sent?
        ... what about on and off dates?
    </p>
</div>

<div class="page-subheading">
    @Html.DevExpress().DateEdit(settings =>
    {
        settings.Name = "PreviewingDate";
        settings.Properties.Caption = "Viewing as at date";
        settings.Date = DateTime.Today;
    }).GetHtml()

    @Html.DevExpress().ComboBox(settings =>
    {
        settings.Name = "Market";
        settings.Properties.Caption = "Market";
    }).GetHtml()

    @Html.DevExpress().ComboBox(settings =>
{
    settings.Name = "Language";
    settings.Properties.Caption = "Language";
}).GetHtml()
</div>

