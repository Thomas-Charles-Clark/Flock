                    $("#translation-save-button").animate({ opacity: '0.0' }, 250, 'linear', function(){
                        $(this).attr('src','/images/icons/64/save-failed.png').bind('onreadystatechange load', function(){
                            if (this.complete) {
                                $(this).unbind('onreadystatechange load');
                                flash(i);
                                return false;
                            }
                        });
                    });
                },
                timeout: 20000
            });
        }

