@model Flock.ViewModels.TranslateMenuGridViewModel
@{
    var grid = Html.DevExpress().GridView(settings =>
    {
        settings.Name = "TranslateGridView";
        settings.CallbackRouteValues = new { Controller = "Translations", Action = "TranslateMenuGridView" };
        settings.SettingsEditing.UpdateRowRouteValues = new { Controller = "Translations", Action = "TranslateMenuGridViewUpdate" };

        settings.ClientSideEvents.BeginCallback = @"function(s, e) {
            e.customArgs['languageId'] = TranslationTargetLanguageListBox.GetValue();
            var val = null;
            if (window['TranslatedMessageHTML']) {
                val = window['TranslatedMessageHTML'].getValue();
            }
            e.customArgs['TranslatedMessageHTML'] = val;
        }";

        settings.ClientSideEvents.CustomButtonClick = @"function (s, e) { 
            $.confirm(function() {
                var rowKey = s.GetRowKey(e.visibleIndex);
                s.PerformCallback({ commandType: 'Clear', menuId: rowKey, languageId: TranslationTargetLanguageListBox.GetValue() });
            }, function() { }, [], 'This will set this record\'s translation fields for ' + TranslationTargetLanguageDD.GetText() + ' to NULL.');
        }";

        settings.SettingsEditing.Mode = GridViewEditingMode.EditForm;
        settings.CommandColumn.Visible = true;
        settings.CommandColumn.VisibleIndex = 10;
        settings.CommandColumn.ShowEditButton = true;
        settings.CommandColumn.ShowCancelButton = true;
        settings.CommandColumn.CustomButtons.Add(new GridViewCommandColumnCustomButton()
        {
            ID = "Clear",
            Index = 0,
            Text = "Clear",
            Visibility = GridViewCustomButtonVisibility.AllDataRows
        });

        settings.SettingsPager.PageSize = 20;

        settings.KeyFieldName = "MenuID";

        settings.Columns.Add(column =>
        {
            column.Name = "MenuID";
            column.FieldName = "MenuID";
            column.Caption = "ID";
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.Width = 50;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.ReadOnly = true;
            column.SetDataItemTemplateContent(c =>
            {
                ViewContext.Writer.Write("<a href='/admin/Menus/compose/" + c.KeyValue.ToString() + "'>" + c.KeyValue.ToString() + "</a>");
            });
            column.SetEditItemTemplateContent(c =>
            {
                ViewContext.Writer.Write("<span style='float: left;'>" + c.KeyValue.ToString() + "</span>");
            });
        });

        settings.Columns.Add(column =>
        {
            column.Name = "LocalName";
            column.FieldName = "LocalName";
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.EditFormSettings.Visible = DefaultBoolean.True;
            column.ReadOnly = true;
            column.Width = System.Web.UI.WebControls.Unit.Percentage(100);
            column.EditFormSettings.Visible = DefaultBoolean.False;
        });

        settings.Columns.Add(column =>
        {
            column.Name = "Name";
            column.FieldName = "Name";
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.EditFormSettings.Visible = DefaultBoolean.True;
            column.ReadOnly = true;
            column.Width = System.Web.UI.WebControls.Unit.Percentage(100);

            column.EditFormSettings.CaptionLocation = ASPxColumnCaptionLocation.Top;
            column.EditFormSettings.VisibleIndex = 1;

            column.SetEditItemTemplateContent(c =>
            {
                Html.DevExpress().TextBox(t =>
                {
                    t.Name = "Name";
                    t.Width = System.Web.UI.WebControls.Unit.Percentage(100);
                }).Bind(Convert.ToString(DataBinder.Eval(c.DataItem, "Name"))).Render();
            });
        });

        settings.Columns.Add(column => {
            column.Name = "Message HTML";
            column.FieldName = "MessageHTML";
            column.Visible = false;
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.False;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.EditFormSettings.Visible = DefaultBoolean.True;
            column.ReadOnly = true;

            column.EditFormSettings.CaptionLocation = ASPxColumnCaptionLocation.Top;
            column.EditFormSettings.VisibleIndex = 3;

            column.SetEditItemTemplateContent(c =>
            {
                Html.DevExpress().Memo(h =>
                {
                    h.Name = "MessageHTML";
                    h.Width = System.Web.UI.WebControls.Unit.Percentage(100);
                    h.Height = System.Web.UI.WebControls.Unit.Pixel(294);

                    h.ReadOnly = true;
                }).Bind(DataBinder.Eval(c.DataItem, "MessageHTML")).Render();
            });
        });

        settings.Columns.Add(column =>
        {
            column.Name = "Translated Name";
            column.FieldName = "TranslatedName";
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.EditFormSettings.Visible = DefaultBoolean.True;
            column.ColumnType = MVCxGridViewColumnType.TextBox;
            column.Width = System.Web.UI.WebControls.Unit.Percentage(100);
            var tbProp = column.PropertiesEdit as TextBoxProperties;
            tbProp.MaxLength = 50;

            column.EditFormSettings.CaptionLocation = ASPxColumnCaptionLocation.Top;
            column.EditFormSettings.VisibleIndex = 2;

            column.SetEditItemTemplateContent(c =>
            {
                Html.DevExpress().TextBox(t =>
                {
                    t.Name = "TranslatedName";
                    t.Width = System.Web.UI.WebControls.Unit.Percentage(100);
                }).Bind(Convert.ToString(DataBinder.Eval(c.DataItem, "TranslatedName"))).Render();
            });
        });

        settings.Columns.Add(column => {
            column.Name = "Translated Message HTML";
            column.FieldName = "TranslatedMessageHTML";
            column.Visible = false;
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.False;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.EditFormSettings.Visible = DefaultBoolean.True;

            column.EditFormSettings.CaptionLocation = ASPxColumnCaptionLocation.Top;
            column.EditFormSettings.VisibleIndex = 4;

            column.SetEditItemTemplateContent(c =>
            {
                var html = DataBinder.Eval(c.DataItem, "TranslatedMessageHTML") == null ? null : DataBinder.Eval(c.DataItem, "TranslatedMessageHTML").ToString();

                ViewContext.Writer.Write("<textarea id='translation-htmleditor' style='width: 100%;'>" + html+"</textarea>");

                ViewContext.Writer.Write(@"
                    <script type='text/javascript' id='dxss_1'>
                        window['TranslatedMessageHTML'] = CodeMirror.fromTextArea(document.getElementById('translation-htmleditor'), {
                            lineNumbers: true,
                            autoCloseTags: true,
                            mode: 'htmlmixed',
                            lineWrapping: false
                        });
                    </script>");

                //Html.DevExpress().HtmlEditor(h =>
                //{
                //    h.Name = "TranslatedMessageHTML";

                //    h.Width = System.Web.UI.WebControls.Unit.Pixel(400);
                //    h.Height = System.Web.UI.WebControls.Unit.Pixel(100);

                //    h.SettingsHtmlEditing.AllowScripts = true;
                //    h.SettingsHtmlEditing.AllowIFrames = true;
                //    h.SettingsHtmlEditing.AllowFormElements = true;
                //    h.SettingsHtmlEditing.UpdateDeprecatedElements = true;
                //    h.SettingsHtmlEditing.UpdateBoldItalic = true;
                //    h.SettingsHtmlEditing.EnterMode = HtmlEditorEnterMode.BR;
                //    h.Settings.AllowContextMenu = DefaultBoolean.True;
                //    h.Settings.AllowDesignView = false;
                //    h.Settings.AllowHtmlView = true;
                //    h.Settings.AllowPreview = false;
                //    h.ActiveView = HtmlEditorView.Html;

                //    h.Toolbars.CreateDefaultToolbars();

                //    h.Html = html;

                //}).Render();
            });
        });

        settings.Columns.Add(column =>
        {
            column.Name = "Stage";
            column.FieldName = "Stage";
            column.Caption = "Translation Stage";
            column.Width = 180;
            column.Settings.HeaderFilterMode = HeaderFilterMode.List;
            column.Settings.AllowHeaderFilter = DefaultBoolean.True;
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.ReadOnly = true;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
            column.SetDataItemTemplateContent(c =>
            {
                bool? TranslationStatusID = null;
                string TranslationStatus = "<i>Unknown</i>";

                TranslationStatusID = (bool?)(DataBinder.Eval(c.DataItem, "Stage"));

                switch (TranslationStatusID)
                {
                    case null:
                        TranslationStatus = "Not Translated";
                        break;
                    case false:
                        TranslationStatus = "Google Translated";
                        break;
                    case true:
                        TranslationStatus = "Manually Translated";
                        break;
                }

                ViewContext.Writer.Write("<span style='float: left;'>" + TranslationStatus + "</span>");
            });
            column.SetEditItemTemplateContent(c =>
            {
                bool? TranslationStatusID = null;
                string TranslationStatus = "<i>Unknown</i>";

                TranslationStatusID = (bool?)(DataBinder.Eval(c.DataItem, "Stage"));

                switch (TranslationStatusID)
                {
                    case null:
                        TranslationStatus = "Not Translated";
                        break;
                    case false:
                        TranslationStatus = "Google Translated";
                        break;
                    case true:
                        TranslationStatus = "Manually Translated";
                        break;
                }

                ViewContext.Writer.Write("<span style='float: left;'>" + TranslationStatus + "</span>");
            });
        });

        settings.Columns.Add(column =>
        {
            column.Name = "FieldsToReview";
            column.FieldName = "FieldsToReview";
            column.Caption = "Status";
            column.Width = 100;
            column.Settings.HeaderFilterMode = HeaderFilterMode.List;
            column.Settings.AllowHeaderFilter = DefaultBoolean.True;
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
            column.SetDataItemTemplateContent(c =>
            {
                byte? Status = 0;
                string TranslationStatus = "Complete";

                Status = (Nullable<byte>)(DataBinder.Eval(c.DataItem, "FieldsToReview"));

                switch (Status)
                {
                    case 0:
                        break;
                    default:
                        TranslationStatus = "Review";
                        break;
                }

                ViewContext.Writer.Write("<span style='float: left;'>" + TranslationStatus + "</span>");
            });
            column.SetEditItemTemplateContent(c =>
            {
                byte? Status = 0;
                string TranslationStatus = "Complete";

                Status = (Nullable<byte>)(DataBinder.Eval(c.DataItem, "FieldsToReview"));

                switch (Status)
                {
                    case 0:
                        break;
                    default:
                        TranslationStatus = "Review";
                        break;
                }

                ViewContext.Writer.Write("<span style='float: left;'>" + TranslationStatus + "</span>");
            });
        });


        settings.HeaderFilterFillItems = (sender, e) =>
        {
            MVCxGridView gridView = (MVCxGridView)sender;
            switch (e.Column.Name)
            {
                case "Stage":
                    e.Values.Clear();
                    e.Values.Add(FilterValue.CreateShowBlanksValue(gridView.Columns["Stage"] as GridViewDataColumn, "Not Translated"));
                    e.Values.Add(new FilterValue("Google Translated", "false"));
                    e.Values.Add(new FilterValue("Manually Translated", "true"));
                    e.AddShowAll();
                    break;
                case "FieldsToReview":
                    e.Values.Clear();
                    e.Values.Add(new FilterValue("Complete", null, string.Format("FieldsToReview = {0}", 0)));
                    e.Values.Add(new FilterValue("Review", null, string.Format("FieldsToReview != {0}", 0)));
                    e.AddShowAll();
                    break;
                default: break;
            }
        };
    });

    if (ViewData["UpdateErrors"] != null)
    {
        grid.SetEditErrorText((string)ViewData["UpdateErrors"]);
    }
}
@grid.Bind(Model.Menus).GetHtml()
