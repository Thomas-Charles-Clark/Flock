        function UnlockDefault() {
            var c = window.confirm("Are you sure? (MUST ENFORCE USER ROLES HERE! - Ajax up to Server quickly, ask if user is auth'd to perform action, respond appropriately.)");
            if (c) {
                $("#unlock-default").animate({ opacity: '0.0' }, 300, 'linear', function () {
                    $(this).attr('src', '/images/systemicons/unlock-icon.png').bind('onreadystatechange load', function () {
                        $("#unlock-default").animate({ opacity: '1.0' }, 300, 'linear', function () { });

                        Heading.SetEnabled(true);
                        SubHeading.SetEnabled(true);
                        HTMLEditor.SetEnabled(true);
                        TitleTag.SetEnabled(true);
                        URLKeywords.SetEnabled(true);
                        MetaDescription.SetEnabled(true);

                        $(this).unbind('onreadystatechange load');
                    });
                });
                $("#save-button").fadeIn("fast");
                $("#reload-button").fadeIn("fast");
            }
