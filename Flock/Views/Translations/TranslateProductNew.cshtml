        function ReloadTranslation(ID) {
            window.TranslationUnsaved = false;
            $.ajax({
                url: '@Url.Action("ReloadProductTranslation", "Translations")',
                type: 'POST',
                traditional: true,
                data: {
                    ID: ID,
                    SelectedTargetLanguageID: TranslationTargetLanguageListBox.GetValue()
                },
                success: function (data) {
                    HeadingTranslation.SetText(data.HeadingTranslation);
                    SubHeadingTranslation.SetText(data.SubHeadingTranslation);
                    TranslationHTMLEditor.SetHtml(data.DescriptionTranslation);
                    TitleTagTranslation.SetText(data.TitleTagTranslation);
                    URLKeywordsTranslation.SetText(data.URLKeywordsTranslation);
                    MetaDescriptionTranslation.SetText(data.MetaDescriptionTranslation);
                    $("#translation-htmleditor-border").css("background-color", "#0072C6");

                    $(HeadingTranslation.GetInputElement()).focusout();
                    $(SubHeadingTranslation.GetInputElement()).focusout();
                    $(TitleTagTranslation.GetInputElement()).focusout();
                    $(URLKeywordsTranslation.GetInputElement()).focusout();
                    $(MetaDescriptionTranslation.GetInputElement()).focusout();

                    $(HeadingTranslation.GetInputElement()).css('background-color', 'white');
                    $(SubHeadingTranslation.GetInputElement()).css('background-color', 'white');
                    $("#translation-htmleditor-border").css('background-color', '#0072C6');
                    $(TitleTagTranslation.GetInputElement()).css('background-color', 'white');
                    $(URLKeywordsTranslation.GetInputElement()).css('background-color', 'white');
                    $(MetaDescriptionTranslation.GetInputElement()).css('background-color', 'white');

                    $(HeadingTranslation.GetInputElement()).parent().css('background-color', 'white');
                    $(SubHeadingTranslation.GetInputElement()).parent().css('background-color', 'white');
                    $(TitleTagTranslation.GetInputElement()).parent().css('background-color', 'white');
                    $(URLKeywordsTranslation.GetInputElement()).parent().css('background-color', 'white');
                    $(MetaDescriptionTranslation.GetInputElement()).parent().css('background-color', 'white');
                    window.TranslationUnsaved = false;

                    $("#content-name").html(data.Name);
                    if (data.ImageID != null && data.ImageID != 0)
                        $("#content-img").attr("src", "http://flock.designersguild.com/imagelibrary/654/" + data.ImageID + ".jpeg")
                    else
                        $("#content-img").attr("src", "/images/admin/image-not-set.png");
                    $("#content-id-label").html(data.ID);
                },
                error: function (e, s, a) {
                    alert(e.responseText);
                },
                timeout: 20000
            });
        }

