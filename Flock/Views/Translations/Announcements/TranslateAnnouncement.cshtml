@model Flock.ViewModels.TranslateAnnouncementViewModel
@{
    ViewBag.Title = "Translate Announcements";
    Layout = "~/Views/Admin/_Layout.cshtml";
}
@section styles {
    @Styles.Render("~/bundles/css/cms")
    @Styles.Render("~/bundles/composer")
    @Styles.Render("~/content/translations.css")

    <style type="text/css">
        #container {
            width: 1260px;
        }
        /*.dxgvFooter_MetropolisBlue .dxgv {
            border-top: 1px solid #c0c0c0;
        }*/
        fieldset {
            padding: 2px;
        }
        input {
            -moz-box-sizing: border-box;
            -webkit-box-sizing: border-box;
            box-sizing: border-box;
        }
        .buttons-table {
            border: 0;
            border-collapse: collapse;
            width: 100%;
        }
        .buttons-table td {
            width: 25%;
            text-align: center;
        }
        .translation-subheading-label {
            display: none;
            line-height: 35px;
            font-size: 12px;
            font-weight: normal;
            float: right;
            margin-right: 2em;
        }

        #grid-container {
            width: 100%;
        }
    </style>
}

<h4 class="page-heading">
    Translate Announcements
</h4>
<div class="page-subheading" style="margin-bottom: 1em;">
    @Html.ValidationSummary()

    @Html.Action("TranslateAnnouncementTargetLanguageDropDown", "Translations", new { TargetLanguageID = Model.TargetLanguageID })
    <div style="clear: both;"></div>
</div>


<div id="grid-container">
    @Html.Action("TranslateAnnouncementGridView", "Translations", new { LanguageID = Model.TargetLanguageID, AnnouncementID = Model.AnnouncementID })
</div>

<div id="ajax-container">

</div>