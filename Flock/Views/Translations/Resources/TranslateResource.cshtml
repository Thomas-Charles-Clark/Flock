@model Flock.ViewModels.TranslateResourceViewModel
@{
    ViewBag.Title = "Translate Resources";
    Layout = "~/Views/Admin/_Layout.cshtml";
}
@section styles {
    @Styles.Render("~/bundles/css/cms")
    @Styles.Render("~/bundles/composer")
    @Styles.Render("~/content/translations.css")

    <style type="text/css">
        #container {
            width: 1260px;
        }
        /*.dxgvFooter_MetropolisBlue .dxgv {
            border-top: 1px solid #c0c0c0;
        }*/
        fieldset {
            padding: 2px;
        }

        input {
            -moz-box-sizing: border-box;
            -webkit-box-sizing: border-box;
            box-sizing: border-box;
        }

        .buttons-table {
            border: 0;
            border-collapse: collapse;
            width: 100%;
        }

            .buttons-table td {
                width: 25%;
                text-align: center;
            }

        .translation-subheading-label {
            display: none;
            line-height: 35px;
            font-size: 12px;
            font-weight: normal;
            float: right;
            margin-right: 2em;
        }
        /*#TranslateGridView_DXHeadersRow0 td:nth-child(2),
        #TranslateGridView_DXMainTable tr.dxgvFilterRow_MetropolisBlue td:nth-child(2),
        #TranslateGridView_DXMainTable tr.dxgvDataRow_MetropolisBlue td:nth-child(2),
        #TranslateGridView_DXMainTable tr.dxgvInlineEditRow_MetropolisBlue td:nth-child(2),
        #TranslateGridView_DXHeadersRow0 td:nth-child(3),
        #TranslateGridView_DXMainTable tr.dxgvFilterRow_MetropolisBlue td:nth-child(3),
        #TranslateGridView_DXMainTable tr.dxgvDataRow_MetropolisBlue td:nth-child(3),
        #TranslateGridView_DXMainTable tr.dxgvInlineEditRow_MetropolisBlue td:nth-child(3) {
            display: none;
        }*/
        #grid-container {
            width: 100%;
        }


        #TranslateGridView_DXMainTable {
            table-layout: fixed;
        }

            #TranslateGridView_DXMainTable td {
                vertical-align: top;
            }

        .translated-resource-cell {
            height: 54px;
            width: 396px;
            vertical-align: top;
        }

        .translated-resource-cell-editing {
        }
    </style>
}

<h4 class="page-heading">
    Translate Resources
</h4>
<div class="page-subheading" style="margin-bottom: 1em;">
    @Html.ValidationSummary()

    <h5 style="font-size: 1.5em;">It is crucially important (more so even than the accuracy of translation) that the <span style="font-style: italic;">formatting</span> of these Resources <span style="text-decoration: underline">remains the same</span> as the original.</h5>
    <span style="float: left;">The checkbox beneath allows you to save translations you make in a particular language to all countries which share in that language. For example, saving Switzerland - French with this checkbox checked will affect France - French.</span>

    @Html.Action("TranslateResourceTargetLanguageDropDown", "Translations", new { TargetCountryLanguageID = Model.TargetCountryLanguageID })

    <label style="line-height: 34px; cursor: pointer; user-select: none" class="pull-right">
        <input style="width: 16px; height: 16px; position: relative; margin-right: 2px; top: 4px; cursor: pointer;" id="across-countries" type="checkbox" value="1" checked />
        Save translation to countries sharing this language
    </label>

    <div style="clear: both;"></div>
</div>


<div id="grid-container">
    @Html.Action("TranslateResourceGridView", "Translations", new { CountryLanguageID = Model.TargetCountryLanguageID, ResourceID = Model.ResourceID })
</div>

<div id="ajax-container">

</div>