        MVCxGridViewColumn approvalStatusColumn = new MVCxGridViewColumn();
        approvalStatusColumn.Name = "ApprovalStatus";
        approvalStatusColumn.FieldName = "ApprovalStatus";
        approvalStatusColumn.Caption = "Approval Status";
        approvalStatusColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        approvalStatusColumn.Settings.AllowHeaderFilter = DefaultBoolean.True;
        approvalStatusColumn.SettingsHeaderFilter.Mode = GridHeaderFilterMode.Default;
        approvalStatusColumn.EditFormSettings.Visible = DefaultBoolean.True;
        approvalStatusColumn.ColumnType = MVCxGridViewColumnType.ComboBox;
        approvalStatusColumn.Width = 130;
        approvalStatusColumn.SetDataItemTemplateContent(c =>
        {
            var text = "";

            var appS = DataBinder.Eval(c.DataItem, "ApprovalStatus") == null ? "2" : DataBinder.Eval(c.DataItem, "ApprovalStatus").ToString();

            switch(appS)
            {
                case "False":
                    text = "Timed Approval";
                    break;
                case "True":
                    text = "Indefinitely Approved";
                    break;
                case "2":
                    text = "Not Approved";
                    break;
                case "3":
                    text = "Approval Expired";
                    break;
                default:
                    break;
            }

            ViewContext.Writer.Write("<a href='javascript:void(0)' onclick=\"UserGridView.StartEditRowByKey('" + c.KeyValue + "')\">" + text + "</a>");
        });

        var asProp = approvalStatusColumn.PropertiesEdit as ComboBoxProperties;
        asProp.ValueType = typeof(string);
        asProp.Items.Add(new ListEditItem() { Index = 0, Text = "Not Approved", Value = "2" });
        asProp.Items.Add(new ListEditItem() { Index = 1, Text = "Timed Approval", Value = "False" });
        asProp.Items.Add(new ListEditItem() { Index = 2, Text = "Approval Expired", Value = "3" });
        asProp.Items.Add(new ListEditItem() { Index = 3, Text = "Indefinitely Approved", Value = "True" });
        asProp.TextField = "Text";
        asProp.ValueField = "Value";

        settings.Columns.Add(approvalStatusColumn);

