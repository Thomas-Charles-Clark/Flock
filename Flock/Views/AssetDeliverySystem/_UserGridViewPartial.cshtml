}
@grid.BindToLINQ("", "", (s, e) => {

    var list = new Flock.DAL.UnitOfWork<Flock.Models.FlockDataContext>().GetRepository<Flock.Models.User>().GetAll().Select(c => new Flock.ViewModels.approvalRequestShunt
    {
        Id = c.Id,
        User = c,
        ApprovalStatus =
            (c.ApprovalRequest.ApprovalExpiryDT.Value < DateTime.Now && c.ApprovalRequest.ApprovalStatus == false) ?
                "3" :
                (c.ApprovalRequest.ApprovalStatus.HasValue ?
                   c.ApprovalRequest.ApprovalStatus.ToString() :
                    "2"),
        ApprovalRequestID = c.ApprovalRequest.ApprovalRequestID,
        ApprovalExpiryDT = c.ApprovalRequest.ApprovalExpiryDT,
        RequestDT = c.ApprovalRequest.RequestDT,
        StockFeedAccess = c.APIKey != null,
        BatchPieceStockAccess = c.PieceBatchStockAPIKeys.Any(),
        UpcomingSeasonEarlyAccess = c.UpcomingSeasonEarlyAccess
    }).OrderBy(p => p.User.CreatedDT).ToList();

    e.QueryableSource = list.AsQueryable();
    e.KeyExpression = "Id";
}).GetHtml()