        settings.HeaderFilterFillItems += (sender, e) => {
            var g = (MVCxGridView)sender;

            switch(e.Column.Name)
            {
                case "ApprovalStatus":
                    e.Values.Clear();
                    e.AddValue("Not Approved", "2");
                    e.AddValue("Timed Approval", "False");
                    e.AddValue("Approval Expired", "3");
                    e.AddValue("Indefinitely Approved", "True");
                    e.AddShowAll();
                    break;
                default: break;
            }
        };

        //MVCxGridViewColumn approvedColumn = new MVCxGridViewColumn();
        //approvedColumn.Name = "Approved";
        //approvedColumn.FieldName = "Approved";
        //approvedColumn.Caption = "Approved";
        //approvedColumn.EditFormSettings.Visible = DefaultBoolean.True;
        //approvedColumn.ColumnType = MVCxGridViewColumnType.CheckBox;
        //var aProp = approvedColumn.PropertiesEdit as CheckBoxProperties;
        //aProp.ValueType = typeof(bool);
        //aProp.ValueChecked = true;
        //aProp.ValueUnchecked = false;
        //aProp.DisplayTextChecked = "Approved";
        //aProp.DisplayTextUnchecked = "Not Approved";
        //settings.Columns.Add(approvedColumn);

        settings.HtmlDataCellPrepared += (sender, e) => {
            var g = sender as MVCxGridView;

            switch(e.DataColumn.Name)
            {
                case "ApprovalStatus":

                    if(e.CellValue != null)
                    {
                        switch (e.CellValue.ToString())
                        {
                            case "False":
                                e.Cell.BackColor = System.Drawing.ColorTranslator.FromHtml("#76ff76");
                                break;
                            case "True":
                                e.Cell.BackColor = System.Drawing.ColorTranslator.FromHtml("#ffffcc");
                                break;
                            case "3":
                                e.Cell.BackColor = System.Drawing.ColorTranslator.FromHtml("#FFADAD");
                                e.Cell.ForeColor = System.Drawing.Color.White;
                                break;
                            case "2":
                                e.Cell.BackColor = System.Drawing.ColorTranslator.FromHtml("#ffadad");
                                break;
                            default: break;
                        }
                    }
                    break;

                case "ApprovalExpiryDT":
                    if (e.CellValue != null)
                    {
                        var dt = Convert.ToDateTime(e.CellValue);

                        if (dt < DateTime.Now)
                        {
                            e.Cell.BackColor = System.Drawing.ColorTranslator.FromHtml("#ffadad");
                        }
                        else
                        {
                            e.Cell.BackColor = System.Drawing.ColorTranslator.FromHtml("#76ff76");
                        }
                    }
                    break;

                default: break;
            }
        };
    });
    if (ViewData["EditError"] != null) {
        grid.SetEditErrorText((string)ViewData["EditError"]);
