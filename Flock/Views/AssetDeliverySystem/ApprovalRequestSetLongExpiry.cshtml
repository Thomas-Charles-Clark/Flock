@{
    ViewBag.Title = "ApprovalRequestSetExpiry";
    Layout = "~/Views/Admin/_Layout.cshtml";
}

@section styles {
    <style type="text/css">
        .container {
            width: auto;
        }
    </style>
}

<div class="row">
    <div class="col-lg-12">
        <h4 class="page-heading">Request Approved - 3 Months</h4>
        <p class="page-subheading">
            Thank you
        </p>
        <p>
            Approval Request ID @ViewBag.ApprovalRequestID has been approved. This approval will expire on @ViewBag.ApprovalExpiryDT.ToString("dd/MM/yyyy HH:MM:ss")
        </p>
    </div>
</div>
