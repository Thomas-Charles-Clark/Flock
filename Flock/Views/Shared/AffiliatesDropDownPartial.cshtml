//                                type: 'POST',
//                                traditional: true,
//                                data: {},
//                                success: function(data) { 
//                                    $('#dialog-marketingpartner-inner').html(data); 
//                                    $('#dialog-marketingpartner-manage').dialog('open');
//                                },
//                              error: function(e, r, s) {
//                                    $.showError(e, s, a);
//                                },
//                                timeout: 20000
//                            });
//                        }";
//                    buttonSettings.Text = "Manage";
//                    buttonSettings.Style.Add("float", "left");
//                }
//                ).Render();

            @Html.DevExpress().Button(
                buttonSettings =>
                {
                        buttonSettings.Name = name + "ButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            " + name + @"MarketingPartnerDD.HideDropDown();
                            " + name + @"MarketingPartnerDD.SetText('Marketing Partner');
                            " + name + @"MarketingPartnerListBox.UnselectAll();
                        }";
                        buttonSettings.Text = "Clear";
                        buttonSettings.Style.Add("float", "left");
                }
                ).Render();
            @Html.DevExpress().Button(
                buttonSettings =>
                {
                    buttonSettings.Name = name + "ButtonClose";
                    buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                        " + name + @"MarketingPartnerDD.HideDropDown();
                    }";
                    
                    buttonSettings.Text = "Close";
                    buttonSettings.Style.Add("float", "right");
                }).Render();
            ViewContext.Writer.Write("<div style='clear: both;'></div></div>");
        });
    }).GetHtml()
