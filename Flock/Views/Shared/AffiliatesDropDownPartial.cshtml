        settings.Width = 200;
        settings.Height = System.Web.UI.WebControls.Unit.Pixel(35);

        settings.Text = "Marketing Partner";
        settings.Properties.DropDownWindowStyle.BackColor = System.Drawing.Color.FromArgb(0xEDEDED);
        settings.Properties.DropDownWindowWidth = System.Web.UI.WebControls.Unit.Pixel(270);

        settings.SetDropDownWindowTemplateContent(c => {
            ViewContext.Writer.Write("<div>");
            Html.DevExpress().ListBox(lbSettings =>
            {
                lbSettings.Name = name + "MarketingPartnerListBox";
                lbSettings.Properties.TextField = "Name";
                lbSettings.Properties.ValueField = "MarketingPartnerID";
                lbSettings.Properties.ValueType = typeof(long);
                lbSettings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
                lbSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) { 
                    " + name + @"MarketingPartnerDD.SetText(s.GetSelectedItem().text);
                }";
            }).BindList(Model).Render();
            
            ViewContext.Writer.Write("</div>");
