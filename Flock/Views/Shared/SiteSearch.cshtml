@using Flock.ViewModels
<div class="resource-panel-container">
    <fieldset id="country-search-fieldset">
        <legend onclick="$('.hideable-dataview').not('#country-language-dataview').slideUp('fast'); $('#country-language-dataview').slideToggle('fast'); ">Site Search (click to expand / contract)</legend>
        <div id="country-language-dataview" class="hideable-dataview" style="display: none;">
            <div style="padding: 1em 1em 0px; background-color: white;">

                @Html.Action("CountryLanguageSearchNameTextBox", "CountrySearch")

                @Html.DevExpress().Button(button =>
               {
                   button.Text = "Add All";
                   button.Name = "CountryLanguageAddAllButton";
                   button.Style.Add("float", "left");
                   button.Style.Add("line-height", "32px");
                   button.Height = System.Web.UI.WebControls.Unit.Pixel(35);
                   button.Width = System.Web.UI.WebControls.Unit.Pixel(75);
                   //button.ControlStyle.BackColor = System.Drawing.ColorTranslator.FromHtml("#0072C6");
                   //button.ControlStyle = System.Drawing.ColorTranslator.FromHtml("#0072C6");
                   button.Style.Add("text-align", "center");
                   button.Style.Add("float", "right");
                   button.Style.Add("margin-right", "55px");
                   button.ClientSideEvents.Click = @"function(s, e) {
                                if($('#add-all-country-language-dialog').length > 0) {
                                    $('#add-all-country-language-dialog').dialog('open');
                                }
                            }";
               }).GetHtml()
                <img id="country-language-searching-icon" style="display: none;" src="/Images/SystemIcons/searching-icon.gif" alt="searching" />
                <div style="clear: both"></div>
            </div>
            <div id="country-search-data-view-container" style="background-color: white;">
                @if (Model == null)
                {
                    @Html.Action("Search", "CountrySearch")
                }
                else
                {
                    if (Model.GetType().GetProperty("ColumnCount") == null)
                    {
                        @Html.Action("SiteSearch", "CountrySearch")
                    }
                    else
                    {
                        @Html.Action("SiteSearch", "CountrySearch", new CountrySearchHelperModel() { ColumnCount = Model.ColumnCount })
                    }
                }
            </div>
        </div>

    </fieldset>
    <div style="clear: both"></div>
</div>