@model List<Flock.Models.SiteSection>
@Html.DevExpress().DropDownEdit(
    settings =>
    {
        settings.Style.Add("float", "left");
        settings.Style.Add("margin", "0 7px 7px 0");

        string action = ViewContext.Controller.ValueProvider.GetValue("action").AttemptedValue;

        if (action == "BannerOverviewSiteSectionDropDownPartial")
            settings.Name = "BannerOverviewSiteSectionDD";
        else if (action == "ComposeBannerHeaderSiteSectionDropDownPartial")
            settings.Name = "ComposeBannerHeaderSiteSectionDD";
        else if (action == "PageSearchSiteSectionDropDownPartial")
            settings.Name = "PageSearchSiteSectionDD";
        else if (action == "ComposePageHeaderSiteSectionDropDownPartial")
        {
            settings.Name = "ComposePageHeaderSiteSectionDD";
            settings.Style.Remove("margin");
            settings.Style.Add("margin", "0 7px 2px 0");
        }
        else if (action == "CMSOverviewSiteSectionDropDownPartial")
        {
            settings.Name = "CMSOverviewSiteSectionDD";
        }
        else if (action == "TranslatePageHeaderSiteSectionDropDown")
        {
            settings.Name = "TranslatePageHeaderSiteSectionDD";
        }
        
        settings.Text = "Site Section";
        settings.Properties.DropDownWindowStyle.BackColor = System.Drawing.Color.FromArgb(0xEDEDED);

        settings.Width = System.Web.UI.WebControls.Unit.Pixel(200);
        settings.Height = System.Web.UI.WebControls.Unit.Pixel(35);
        
        settings.Properties.EnableClientSideAPI = true;

        settings.SetDropDownWindowTemplateContent(c =>
        {
            ViewContext.Writer.Write("<div id='banner-location-listbox'>");
            ViewContext.Writer.Write(@Html.Partial("~/Views/Shared/SearchFilters/SiteSectionListBoxPartial.cshtml", Model));
            ViewContext.Writer.Write("</div>");
            ViewContext.Writer.Write("<div style=\"padding: 6px;\">");

            if (action != "CMSOverviewSiteSectionDropDownPartial")
            {
                @Html.DevExpress().Button(
                    buttonSettings =>
                    {
                        if (action == "BannerOverviewSiteSectionDropDownPartial")
                        {
                            buttonSettings.Name = "BannerOverviewSiteSectionButtonClear";
                            buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                            BannerOverviewSiteSectionListBox.UnselectAll();
                            BannerOverviewSiteSectionDD.HideDropDown(); 
                            BannerOverviewSiteSectionDD.SetText('Site Section');
                            $('#banner-searching-icon').fadeIn('fast');
                            BannerOverviewGridView.PerformCallback();
                        }";
                        }
                        else if (action == "ComposeBannerHeaderSiteSectionDropDownPartial")
                        {
                            buttonSettings.Name = "ComposeBannerHeaderSiteSectionButtonClear";
                            buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                            ComposeBannerHeaderSiteSectionListBox.UnselectAll();
                            ComposeBannerHeaderSiteSectionDD.HideDropDown(); 
                            ComposeBannerHeaderSiteSectionDD.SetText('Site Section');
                            BannerSelectorGridView.Refresh();
                        }";
                        }
                        else if (action == "PageSearchSiteSectionDropDownPartial")
                        {
                            buttonSettings.Name = "PageSearchSiteSectionButtonClear";
                            buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                            PageSearchSiteSectionListBox.UnselectAll();
                            PageSearchSiteSectionDD.HideDropDown(); 
                            PageSearchSiteSectionDD.SetText('Site Section');
                            $('#page-searching-icon').fadeIn('fast');
                                $.ajax({
	                                url: '" + Url.Action("PageSearch", "Pages") + @"',
	                                traditional: true,
	                                data: {
		                                SiteSectionID: PageSearchSiteSectionListBox.GetValue(),
                                        //TemplateID: PageSearchTemplateListBox.GetValue(),
                                        SearchString: PageSearchNameTextBox.GetValue()
	                                },
	                                success: function(data) {
		                                $('#page-searching-icon').fadeOut('fast');
		                                $('#page-data-view-container').html(data);
	                                },
	                                error: function(e, s, a) { 
		                                $('#page-searching-icon').fadeOut('fast');
		                                alert(e.responseText);
	                                },
	                                timeout: 60000
                                });
                        }";
                        }
                        else if (action == "ComposePageHeaderSiteSectionDropDownPartial")
                        {
                            buttonSettings.Name = "ComposePageHeaderSiteSectionButtonClear";
                            buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                            ComposePageHeaderSiteSectionDD.UnselectAll();
                            ComposePageHeaderSiteSectionDD.HideDropDown();
                            ComposePageHeaderSiteSectionDD.SetText('Site Section');
                            $('#page-select-header-busy').fadeIn('fast');
                            $.ajax({ 
                                url: '" + Url.Action("ComposePageHeaderPageDropDownPartial", "CMS") + @"',
                                type: 'POST',
                                traditional: true,
                                data: {
                                    SelectedSiteSectionID: ComposePageHeaderSiteSectionListBox.GetValue(),
                                    SelectedParentPageID: ComposePageHeaderParentPageListBox.GetValue(),
                                    SelectedPageID: ComposePageHeaderPageListBox.GetValue()
                                },
                                success: function(data) { 
                                    $('#page-select-header-busy').fadeOut('fast');
                                    $('#page-header-page-drop-down-container').html(data);
                                },
                                error: function(e, s, a) {
                                    $('#page-select-header-busy').fadeOut('fast');
                                    alert(e.responseText);
                                },
                                timeout: 60000
                            });
                        }";
                        }
                        else if (action == "TranslatePageHeaderSiteSectionDropDown")
                        {
                            buttonSettings.Name = "TranslatePageHeaderSiteSectionButtonClear";
                            buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            TranslatePageHeaderSiteSectionListBox.UnselectAll();
                            TranslatePageHeaderSiteSectionDD.HideDropDown();
                            TranslatePageHeaderSiteSectionDD.SetText('Site Section');
                            var TargetLanguageID = null;
                            if(typeof(TranslationTargetLanguageListBox) != 'undefined' && typeof(TranslationTargetLanguageListBox) != false)
                                TargetLanguageID = TranslationTargetLanguageListBox.GetValue();

                            $.ajax({ 
                                url: '" + Url.Action("TranslatePageHeaderParentPageDropDown", "Translations") + @"',
                                type: 'POST',
                                traditional: true,
                                data: { 
                                    SelectedParentPageID: TranslatePageHeaderParentPageListBox.GetValue(),
                                    SelectedSiteSectionID: null
                                },
                                success: function(data) {
                                    $('#translate-page-parent-page-drop-down-container').html(data);
                                },
                                error: function(e, s, a) {
                                    alert(e.responseText);
                                },
                                timeout: 60000
                            });

                            $.ajax({
                                url: '" + Url.Action("TranslatePageHeaderPageDropDown", "Translations") + @"',
                                type: 'POST',
                                traditional: true,
                                data: {
                                    ID: TranslateHeaderContentListBox.GetValue(),
                                    SiteSectionID: TranslatePageHeaderSiteSectionListBox.GetValue(),
                                    ParentPageID: TranslatePageHeaderParentPageListBox.GetValue(),
                                    TranslationStatusID: TranslatePageHeaderTranslationStatusListBox.GetValue(),
                                    TargetLanguageID: TargetLanguageID
                                },
                                success: function(data) { 
                                    $('#translate-page-page-drop-down-container').html(data);
                                    if (TranslateHeaderContentListBox.FindItemByValue($('#content-id-label').html()) == null) {
                                        TranslateHeaderContentListBox.SetSelectedIndex(0);
                                        var e = new ASPxClientProcessingModeEventArgs();
                                        if(TranslateHeaderContentListBox.GetItemCount() > 0)
                                            TranslateHeaderContentListBox.SelectedIndexChanged.FireEvent(TranslateHeaderContentListBox, e);
                                        else {
                                            $('#pager-total').html(0);
                                            $('#pager-current').html(0);
                                        }
                                    }
                                },
                                error: function(e, s, a) { 
                                    alert(e.responseText);
                                },
                                timeout: 60000
                            });
                        }";
                        }
                        buttonSettings.Text = "Clear";
                        buttonSettings.Style.Add("float", "left");
                    }
                )
                .Render();
            }
            @Html.DevExpress().Button(
                buttonSettings =>
                {
                    if (action == "BannerOverviewSiteSectionDropDownPartial")
                    {
                        buttonSettings.Name = "BannerOverviewSiteSectionButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) {
                            BannerOverviewSiteSectionDD.HideDropDown();
                        }";
                    }
                    else if (action == "ComposeBannerHeaderSiteSectionDropDownPartial")
                    {
                        buttonSettings.Name = "ComposeBannerHeaderSiteSectionButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) {
                            ComposeBannerHeaderSiteSectionDD.HideDropDown();
                        }";
                    }
                    else if (action == "PageSearchSiteSectionDropDownPartial")
                    {
                        buttonSettings.Name = "PageSearchSiteSectionButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) {
                            PageSearchSiteSectionDD.HideDropDown();
                        }";
                    }
                    else if (action == "ComposePageHeaderSiteSectionDropDownPartial")
                    {
                        buttonSettings.Name = "ComposePageHeaderSiteSectionButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            ComposePageHeaderSiteSectionDD.HideDropDown();
                        }";
                    }
                    else if (action == "CMSOverviewSiteSectionDropDownPartial")
                    {
                        buttonSettings.Name = "CMSOverviewSiteSectionButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            CMSOverviewSiteSectionDD.HideDropDown();
                        }";
                    }
                    else if (action == "TranslatePageHeaderSiteSectionDropDown")
                    {
                        buttonSettings.Name = "TranslatePageHeaderSiteSectionButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) {
                            TranslatePageHeaderSiteSectionDD.HideDropDown();
                        }";
                    }
                    buttonSettings.Text = "Close";
                    buttonSettings.Style.Add("float", "right");
                }
            )
            .Render();
            ViewContext.Writer.Write("<div style='clear: both;'></div></div>");
        });
        settings.Properties.AnimationType = AnimationType.None;
    }
).GetHtml()