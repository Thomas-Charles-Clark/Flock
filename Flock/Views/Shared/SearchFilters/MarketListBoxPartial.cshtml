@Html.DevExpress().ListBox(
listBoxSettings =>
{
    listBoxSettings.Properties.ValueField = "MarketID";
    string action = ViewContext.Controller.ValueProvider.GetValue("action").AttemptedValue;
    if (action == "CountrySearchMarketDropDownPartial")
    {
        listBoxSettings.Name = "CountrySearchMarketListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            $('#country-searching-icon').fadeIn('fast');
            CountrySearchMarketDD.SetText(s.GetSelectedItem().text);
            CountrySearchMarketDD.HideDropDown();
            $.ajax({
                url: '" + Url.Action("Search", "CountrySearch") + @"',
                traditional: true,
                data: {
                    MarketID: CountrySearchMarketListBox.GetValue(),
                    ContinentID: CountrySearchContinentListBox.GetValue(),
                    RegionID: CountrySearchRegionListBox.GetValue(),
                    LanguageID: CountrySearchLanguageListBox.GetValue(),
                    SearchString: CountrySearchNameTextBox.GetText(),
                    TableLock: CountrySearchCLTableLock.GetValue()
                },
                success: function(data) {
                    $('#country-search-data-view-container').html(data);
                    $('#country-searching-icon').fadeOut('slow');
                    if (typeof (InitCountryDragDrop) == 'function')
                        InitCountryDragDrop();
                },
                error: function(e, s, a) {
                    $.showError(e, s, a, function() { $('#country-searching-icon').fadeOut('slow'); });
                },
                timeout: 60000
            });
        }";
    }
    else if (action == "ProductOverviewMarketDropDownPartial")
    {
        listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.CheckColumn;
        listBoxSettings.Name = "ProductOverviewMarketListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            ProductOverviewMarketDD.HideDropDown();

            var items = s.GetSelectedItems();
            var text = 'Markets';
            if(items.length > 1)
                text = '(' + items.length.toString() + ' Markets Selected)';
            else if(items.length == 1)
                text = items[0].text;    

            ProductOverviewMarketDD.SetText(text);
            ProductOverviewGridView.Refresh();
        }";
        listBoxSettings.Properties.ValueField = "PriceListID";
    }
    else if (action == "ProductDimensionsMarketDropDownPartial")
    {
        listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.CheckColumn;
        listBoxSettings.Name = "ProductDimensionsMarketListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            ProductDimensionsMarketDD.HideDropDown();

            var items = s.GetSelectedItems();
            var text = 'Markets';
            if(items.length > 1)
                text = '(' + items.length.toString() + ' Markets Selected)';
            else if(items.length == 1)
                text = items[0].text;    

            ProductDimensionsMarketDD.SetText(text);
            ProductDimensionsGridView.Refresh();
        }";
        listBoxSettings.Properties.ValueField = "PriceListID";
    }
    else if (action == "ProductReviewsMarketDropDownPartial")
    {
        listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.Single;
        listBoxSettings.Name = "ProductReviewsMarketListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            ProductReviewsMarketDD.HideDropDown();

            var items = s.GetSelectedItems();
            var text = 'Markets';
            if(items.length > 1)
                text = '(' + items.length.toString() + ' Markets Selected)';
            else if(items.length == 1)
                text = items[0].text;    

            ProductReviewsMarketDD.SetText(text);

            $.ajax({
                url: '" + Url.Action("ProductReviewsMarketListBoxSetSessionVariable", "Reviews") + @"',
                type: 'POST',
                traditional: true,
                data: { MarketIDs: ProductReviewsMarketListBox.GetSelectedValues().toString() },
                success: function(data) {
                    ProductReviewsGridView.Refresh();
                },
                error: function(e, s, a) {
                    alert(e.responseText);
                },
                timeout: 60000
            });
        }";
        listBoxSettings.Properties.ValueField = "PriceListID";
    }
    else if (action == "SalePricesMarketDropDownPartial")
    {
        listBoxSettings.Properties.ValueField = "PriceListID";
        listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.Single;
        listBoxSettings.Name = "SalePricesMarketListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            if(changePrefilterCheck()) {
                window.priceListId = s.GetValue();
                SalePricesMarketDD.SetText(s.GetSelectedItem().text);
                SalePricesMarketDD.HideDropDown();
                loadSalePrices();
            }
        }";
    }
    listBoxSettings.ControlStyle.Border.BorderWidth = 0;
    listBoxSettings.ControlStyle.BorderBottom.BorderWidth = 1;
    listBoxSettings.ControlStyle.BorderBottom.BorderColor = System.Drawing.Color.FromArgb(0xDCDCDC);
    listBoxSettings.Width = System.Web.UI.WebControls.Unit.Percentage(100);

    listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.Single;

    listBoxSettings.Properties.TextField = "Name";
}
).BindList(Model).GetHtml()