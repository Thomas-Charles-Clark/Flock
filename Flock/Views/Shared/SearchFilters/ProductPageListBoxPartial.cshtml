    if (action == "TranslateProductPageHeaderProductPageDropDown")
    {
        // I wish....
        //listBoxSettings.Properties.CallbackPageSize = 30;

        listBoxSettings.Name = "TranslateHeaderContentListBox";
listBoxSettings.Properties.ValueType = typeof(byte);
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            TranslateProductPageHeaderProductPageDD.SetText(s.GetSelectedItem().text);
            TranslateProductPageHeaderProductPageDD.HideDropDown();

            if(typeof(TranslationTargetLanguageListBox) == 'undefined' || typeof(TranslationTargetLanguageListBox) == false)
            {
                var url = '" + @Url.Action("productpage", "translations", new { id = "-1", ProductTypeid = "-2", brandid = "-3", launchid = "-4", webstatusid = "-5", templateid = "-6", translationstatusid = "-7" }) + @"';
                url = url.replace('-1', s.GetSelectedItem().value);
                url = url.replace('-2', TranslateProductPageHeaderProductTypeListBox.GetValue());
                url = url.replace('-3', TranslateProductPageHeaderBrandListBox.GetValue());
                url = url.replace('-4', TranslateProductPageHeaderLaunchListBox.GetValue());
                url = url.replace('-5', TranslateProductPageHeaderWebStatusListBox.GetValue());
                url = url.replace('-6', TranslateProductPageHeaderTemplateListBox.GetValue());
                url = url.replace('-7', TranslateProductPageHeaderTranslationStatusListBox.GetValue());
                window.location.href = url;
            }
            else
            {
                $.ajax({ 
                    url: '" + Url.Action("ChangeProductPage", "Translations") + @"',
                    type: 'POST',
                    traditional: true,
                    data: {  
                        ProductPageID: s.GetSelectedItem().value,
                        TargetLanguageID: TranslationTargetLanguageListBox.GetValue()
                    },
                    success: function(data) {
                        $('#translate-middle-container').html(data);
                    },
                    error: function(e, s, a) { 
                        alert(e.responseText);    
                    },
                    timeout: 60000
                });
            }
            $('#pager-current').html(s.GetSelectedItem().index + 1);
        }";
        listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) { 
            s.SetSelectedItem(s.FindItemByValue(" + ViewBag.TranslateProductPageHeaderSelectedProductPageID + @"));
            if(s.GetSelectedItem() != null && s.GetSelectedItem() != false) {
                TranslateProductPageHeaderProductPageDD.SetText(s.GetSelectedItem().text);
                $('#pager-current').html(TranslateHeaderContentListBox.GetSelectedItem().index + 1);
                $('#pager-total').html(TranslateHeaderContentListBox.GetItemCount().toString());
            }
        }";
    }
    else
    {
        listBoxSettings.Name = "ProductPageListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e){ 
            alert('Not Implemented: Bad Control Name (Product Page ListBox)');
        }";
    }
    
    listBoxSettings.ControlStyle.Border.BorderWidth = 0;
    listBoxSettings.ControlStyle.BorderBottom.BorderWidth = 1;
    listBoxSettings.ControlStyle.BorderBottom.BorderColor = System.Drawing.Color.FromArgb(0xDCDCDC);
    listBoxSettings.Width = System.Web.UI.WebControls.Unit.Percentage(100);

    listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.Single;
    listBoxSettings.Properties.ValueField = "ProductPageID";
    listBoxSettings.Properties.TextField = "Name";
}
).BindList(Model).GetHtml()