                                            CollectionID: ProductSearchCollectionListBox.GetValue(),
                                            ColourID: ProductSearchColourListBox.GetValue(),
                                            SearchString: SearchText,
                                            ProductPageAssociation: ProductSearchAssociatedListBox.GetValue(),
                                            PriceListID: ProductSearchPriceListListBox.GetValue()
                                        },
                                        success: function(data) {
                                            $('#product-data-view-container').html(data);
                                            $('#product-searching-icon').fadeOut('slow');
                                        },
                                        error: function(e, s, a) {
                                            $('#product-searching-icon').fadeOut('slow');
                                            alert(e.responseText);
                                        },
                                        timeout: 60000
                                    });
                                }

                            }";
                        }
                        else if (action == "CollectionComposeHeaderProductTypeDropDownPartial")
