@{
    Layout = null;
}
@model List<Flock.Models.ProductType>
@Html.DevExpress().DropDownEdit(
    settings =>
    {
        settings.Style.Add("float", "left");
        settings.Style.Add("margin", "0 7px 7px 0");
        settings.Width = System.Web.UI.WebControls.Unit.Pixel(200);
        settings.Height = System.Web.UI.WebControls.Unit.Pixel(35);

        string action = ViewContext.Controller.ValueProvider.GetValue("action").AttemptedValue;
        if (action == "ImageSearchProductTypeDropDownPartial")
            settings.Name = "ImageSearchProductTypeDD";
        else if (action == "CollectionSearchProductTypeDropDownPartial")
            settings.Name = "CollectionProductTypeDD";
        else if (action == "ProductSearchProductTypeDropDownPartial")
            settings.Name = "ProductSearchProductTypeDD";
        else if (action == "CollectionComposeHeaderProductTypeDropDownPartial")
        {
            settings.Name = "CollectionComposeHeaderProductTypeDD";
            settings.Style.Remove("margin");
            settings.Style.Add("margin", "0px 7px 0px 0px");
        }
        else if (action == "ProductAssociationHeaderProductTypeDropDownPartial")
        {
            settings.Name = "ProductAssociationHeaderProductTypeDD";
            settings.Style.Remove("margin");
            settings.Style.Add("margin", "0px 7px 0px 0px");
        }
        else if (action == "CollectionOverviewProductTypeDropDownPartial")
        {
            settings.Name = "CollectionOverviewProductTypeDD";
            settings.Style.Remove("margin");
        }
        else if (action == "ProductPageSearchProductTypeDropDownPartial")
        {
            settings.Name = "ProductPageSearchProductTypeDD";
        }
        else if (action == "ComposeProductPageHeaderProductTypeDropDownPartial")
        {
            settings.Name = "ComposeProductPageHeaderProductTypeDD";
            settings.Width = System.Web.UI.WebControls.Unit.Pixel(175);
        }
        else if (action == "ProductPageComposeProductTypeDropDownPartial")
        {
            settings.Name = "ProductPageComposeProductTypeDD";
        }
        else if (action == "TranslateProductPageHeaderProductTypeDropDown")
        {
            settings.Name = "TranslateProductPageHeaderProductTypeDD";
            settings.Width = 180;
        }
        else if (action == "TranslateCollectionHeaderProductTypeDropDown")
        {
            settings.Name = "TranslateCollectionHeaderProductTypeDD";
            settings.Width = 180;
        }
        else if (action == "AttributeProductTypeDropDown")
        {
            settings.Name = "AttributeDetailProductTypeDD";
        }
        else if (action == "AttributeHeaderProductTypeDropDownPartial")
        {
            settings.Name = "AttributeProductTypeDD";
            settings.Style.Remove("margin");
            settings.Style.Add("margin", "0px 7px 0px 0px");
            settings.Width = 175;
        }
        else if (action == "ProductPage_ProductTypeDropDown")
        {
            settings.Name = "RelatedProductPagePrimaryProductTypeDD";
        }
        else if (action == "RelatedProductPage_ProductTypeDropDown")
        {
            settings.Name = "RelatedProductPageSecondaryProductTypeDD";
        }
        else if (action == "MapAttributesProductTypeDropDown")
        {
            settings.Name = "MapAttributesProductTypeDD";
        }
        else if (action == "ClassifierProductTypeDropDown")
        {
            settings.Name = "ClassifierProductTypeDD";
        }
        else if (action == "SalePricesProductTypeDropDownPartial")
        {
            settings.Name = "SalePricesProductTypeDD";
        }

        settings.Text = "Product Type";
        settings.Properties.DropDownWindowStyle.BackColor = System.Drawing.Color.FromArgb(0xEDEDED);


        settings.Properties.EnableClientSideAPI = true;

        settings.SetDropDownWindowTemplateContent(c =>
        {
            ViewContext.Writer.Write("<div id='product-type-listbox'>");
            ViewContext.Writer.Write(@Html.Partial("~/Views/Shared/SearchFilters/ProductTypeListBoxPartial.cshtml", Model));
            ViewContext.Writer.Write("</div>");
            ViewContext.Writer.Write("<div style=\"padding: 6px;\">");
            if (action != "CollectionOverviewProductTypeDropDownPartial" &&
                action != "ProductPageComposeProductTypeDropDownPartial" &&
                action != "AttributeProductTypeDropDown" &&
                action != "MapAttributesProductTypeDropDown" &&
                action != "ClassifierProductTypeDropDown")
            {
                @Html.DevExpress().Button(
                    buttonSettings =>
                    {
                        buttonSettings.Text = "Clear";
                        buttonSettings.Style.Add("float", "left");
                        if (action == "ImageSearchProductTypeDropDownPartial")
                        {
                            buttonSettings.Name = "ImageSearchProductTypeButtonClear";
                            buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                                ImageSearchProductTypeListBox.UnselectAll();
                                ImageSearchProductTypeDD.HideDropDown(); 
                                ImageSearchProductTypeDD.SetText('Product Type');
                                $('#image-searching-icon').fadeIn('fast');
                                $.ajax({
                                    url: '" + Url.Action("ImageSearch", "Images") + @"',
                                    traditional: true,
                                    data: { 
                                        ProductType: ImageSearchProductTypeListBox.GetValue(),
                                        Brand: ImageSearchBrandListBox.GetValue(),
                                        Launch: ImageSearchLaunchListBox.GetValue(),
                                        Collection: ImageSearchCollectionListBox.GetValue(),
                                        AspectRatio: ImageSearchAspectRatioListBox.GetValue(),
                                        ImageType: ImageSearchImageTypeListBox.GetValue(),
                                        Perspective: ImageSearchPerspectiveListBox.GetValue(),
                                        HotspotStatus: ImageSearchHotspotStatusListBox.GetValue(),
                                        Colour: ImageSearchColourListBox.GetValue(),
                                        Room: ImageSearchRoomListBox.GetValue(),
                                        Style: ImageSearchStyleListBox.GetValue(),
                                        NameOrID: ImageSearchNameOrIDTextBox.GetValue(),
                                        SearchWithinHotspots: SearchWithinHotspotsCheckbox.GetValue(),
                                        Resolution: ResolutionListBox.GetValue()
                                    },
                                    success: function(data) {
                                        $('#image-data-view-container').html(data);
                                        $('#image-searching-icon').fadeOut('slow');
                                    },
                                    error: function(e, s, a) {
                                        $('#image-searching-icon').fadeOut('slow');
                                        alert(e.responseText);
                                    },
                                    timeout: 60000
                                });
                            }";
                        }
                        else if (action == "CollectionSearchProductTypeDropDownPartial")
                        {
                            buttonSettings.Name = "CollectionProductTypeButtonClear";
                            buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                                CollectionProductTypeListBox.UnselectAll();
                                CollectionProductTypeDD.HideDropDown(); 
                                CollectionProductTypeDD.SetText('Product Type');
                                $('#collection-searching-icon').fadeIn('fast');
                                $.ajax({
                                    url: '" + Url.Action("CollectionSearch", "Collections") + @"',
                                    traditional: true,
                                    data: { 
                                        ProductType: CollectionProductTypeListBox.GetValue(),
                                        Brand: CollectionBrandListBox.GetValue(),
                                        Launch: CollectionLaunchListBox.GetValue(),
                                        NameOrID: CollectionNameOrIDTextBox.GetValue()
                                    },
                                    success: function(data) {
                                        $('#collection-data-view-container').html(data);
                                        $('#collection-searching-icon').fadeOut('slow');
                                    },
                                    error: function(e, s, a) {
                                        $('#collection-searching-icon').fadeOut('slow');
                                        alert(e.responseText);
                                    },
                                    timeout: 60000
                                });
                            }";
                        }
                        else if (action == "ProductSearchProductTypeDropDownPartial")
                        {
                            //ProductSearchProductTypeDD
                            /*
                             (byte? ProductTypeID, byte? BrandID, short? LaunchID, short? DesignID, byte? PatternID, char? Status,
                bool? ProductPageAssociation, byte? StatusID, byte? StockStatusID, short? CollectionID, byte? ColourID, string SearchString)
                             */
                            buttonSettings.Name = "ProductSearchProductTypeButtonClear";
                            buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                                ProductSearchProductTypeListBox.UnselectAll();
                                ProductSearchProductTypeDD.HideDropDown(); 
                                ProductSearchProductTypeDD.SetText('Product Type');
                                $('#product-searching-icon').fadeIn('fast');
                                var SearchText = ProductSearchNameOrIDTextBox.GetText();
                                if($('#product-search-small-marker').length > 0) {
                                    $.ajax({
                                        url: '" + Url.Action("ProductSearchSmall", "Products") + @"',
                                        traditional: true,
                                        data: { 
                                            ProductTypeID: ProductSearchProductTypeListBox.GetValue(),
                                            BrandID: ProductSearchBrandListBox.GetValue(),
                                            LaunchID: ProductSearchLaunchListBox.GetValue(),
                                            PatternID: ProductSearchPatternListBox.GetValue(),
                                            Status: ProductSearchStatusListBox.GetValue(),
                                            StatusID: ProductSearchWebStatusListBox.GetValue(),
                                            StockStatusID: ProductSearchStockStatusListBox.GetValue(),
                                            CollectionID: ProductSearchCollectionListBox.GetValue(),
                                            ColourID: ProductSearchColourListBox.GetValue(),
                                            SearchString: SearchText,
                                            ProductPageAssociation: ProductSearchAssociatedListBox.GetValue(),
                                            PriceListID: ProductSearchPriceListListBox.GetValue()
                                        },
                                        success: function(data) {
                                            $('#product-data-view-container').html(data);
                                            $('#product-searching-icon').fadeOut('slow');
                                        },
                                        error: function(e, s, a) {
                                            $('#product-searching-icon').fadeOut('slow');
                                            alert(e.responseText);
                                        },
                                        timeout: 60000
                                    });
                                }
                                else {
                                    $.ajax({
                                        url: '" + Url.Action("ProductSearch", "Products") + @"',
                                        traditional: true,
                                        data: { 
                                            ProductTypeID: ProductSearchProductTypeListBox.GetValue(),
