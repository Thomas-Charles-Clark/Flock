                                TranslateProductPageHeaderProductTypeDD.HideDropDown();
                                TranslateProductPageHeaderProductTypeDD.SetText('Product Type');
                                $('#translate-product-page-header-searching-icon').fadeIn('fast');
                                var TargetLanguageID = null;
                                if(typeof(TranslationTargetLanguageListBox) != 'undefined' && typeof(TranslationTargetLanguageListBox) != false)
                                    TargetLanguageID = TranslationTargetLanguageListBox.GetValue();
                                $.ajax({
                                    url: '" + Url.Action("TranslateProductPageHeader", "Translations") + @"',
                                    type: 'POST',
                                    traditional: true,
                                    data: { 
                                        ProductTypeID: TranslateProductPageHeaderProductTypeListBox.GetValue(),
