@model List<Flock.Models.Template>
@Html.DevExpress().ListBox(
listBoxSettings =>
{
    string action = ViewContext.Controller.ValueProvider.GetValue("action").AttemptedValue;

    if (action == "ComposeProductPageHeaderTemplateDropDownPartial")
    {
        listBoxSettings.Name = "ComposeProductPageHeaderTemplateListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            ComposeProductPageHeaderTemplateDD.SetText(s.GetSelectedItem().text);
            ComposeProductPageHeaderTemplateDD.HideDropDown();

            $('#product-page-header-searching-icon').fadeIn('fast');
            $.ajax({
	            url: '" + Url.Action("ComposeProductPageHeader", "ProductPages") + @"',
                type: 'POST',
	            traditional: true,
	            data: {
		            ProductTypeID: ComposeProductPageHeaderProductTypeListBox.GetValue(),
		            BrandID: ComposeProductPageHeaderBrandListBox.GetValue(),
		            LaunchID: ComposeProductPageHeaderLaunchListBox.GetValue(),
		            WebStatusID: ComposeProductPageHeaderWebStatusListBox.GetValue(),
		            TemplateID: ComposeProductPageHeaderTemplateListBox.GetValue()
	            },
	            success: function(data) {
		            $('#product-page-header-searching-icon').fadeOut('fast');
                    $('#product-select-header-container').html(data);
	            },
	            error: function(e, s, a) { 
		            $('#product-page-header-searching-icon').fadeOut('fast');
		            alert(e.responseText);
	            },
	            timeout: 60000
            });
        }";
        listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) { 
            s.SetSelectedItem(s.FindItemByValue(" + ViewBag.ProductHeaderSelectedTemplateID + @"));
            if(s.GetSelectedItem() != null && s.GetSelectedItem() != false)
                ComposeProductPageHeaderTemplateDD.SetText(s.GetSelectedItem().text);
        }";
    }
    else if (action == "AttributeHeaderTemplateDropDownPartial")
    {
        listBoxSettings.Name = "AttributeTemplateListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            AttributeTemplateDD.HideDropDown();
            AttributeTemplateDD.SetText(s.GetSelectedItem().text);
            
            $('#attribute-product-page-select-busy').fadeIn('fast');
            $.ajax({
                url: '" + Url.Action("ProductPageAttributeHeader", "ProductPages") + @"',
                type: 'POST',
                traditional: true,
                data: {
                    ProductTypeID: AttributeProductTypeListBox.GetValue(),
                    BrandID: AttributeBrandListBox.GetValue(),
                    LaunchID: AttributeLaunchListBox.GetValue(),
                    WebStatusID: AttributeWebStatusListBox.GetValue(),
                    TemplateID: AttributeTemplateListBox.GetValue()
                },
                success: function(data) {
                    $('#attribute-filter-header').html(data);
                    AttributeProductPageListBox.PerformCallback();
                },
                error: function(e, s, a) { 
                    $('#attribute-product-page-select-busy').fadeOut('fast');
                    alert(e.responseText);
                },
                timeout: 60000
            });
        }";
        listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) { 
            s.SetSelectedItem(s.FindItemByValue(" + ViewBag.AttributeHeaderSelectedTemplateID + @"));
            if(s.GetSelectedItem() != null && s.GetSelectedItem() != false)
                AttributeTemplateDD.SetText(s.GetSelectedItem().text);
        }";
    }
    else if (action == "ProductPageComposeTemplateDropDownPartial")
    {
        listBoxSettings.Name = "TemplateID";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            ProductPageComposeTemplateDD.SetText(s.GetSelectedItem().text);
            ProductPageComposeTemplateDD.HideDropDown();
        }";

        listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) { 
            s.SetSelectedItem(s.FindItemByValue(" + ViewBag.ProductPageComposeSelectedTemplateID + @"));
            if(s.GetSelectedItem() != null && s.GetSelectedItem() != false)
                ProductPageComposeTemplateDD.SetText(s.GetSelectedItem().text);
        }";
    }
    else if (action == "PageSearchTemplateDropDownPartial")
    {
        listBoxSettings.Name = "PageSearchTemplateListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            PageSearchTemplateDD.SetText(s.GetSelectedItem().text);
            PageSearchTemplateDD.HideDropDown();
            $('#page-searching-icon').fadeIn('fast');
                $.ajax({
	                url: '" + Url.Action("PageSearch", "Pages") + @"',
	                traditional: true,
	                data: {
		                SiteSectionID: PageSearchSiteSectionListBox.GetValue(),
                        TemplateID: PageSearchTemplateListBox.GetValue(),
                        SearchString: PageSearchNameTextBox.GetValue()
	                },
	                success: function(data) {
		                $('#page-searching-icon').fadeOut('fast');
		                $('#page-data-view-container').html(data);
	                },
	                error: function(e, s, a) { 
		                $('#page-searching-icon').fadeOut('fast');
		                alert(e.responseText);
	                },
	                timeout: 60000
            });
        }";
    }
    else if (action == "TranslateProductPageHeaderTemplateDropDown")
    {
        listBoxSettings.Name = "TranslateProductPageHeaderTemplateListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) { 
            TranslateProductPageHeaderTemplateDD.HideDropDown();
            TranslateProductPageHeaderTemplateDD.SetText(s.GetSelectedItem().text);
            $('#translate-product-page-header-searching-icon').fadeIn('fast');
            var TargetLanguageID = null;
            if(typeof(TranslationTargetLanguageListBox) != 'undefined' && typeof(TranslationTargetLanguageListBox) != false)
                TargetLanguageID = TranslationTargetLanguageListBox.GetValue();
            $.ajax({
	            url: '" + Url.Action("TranslateProductPageHeader", "Translations") + @"',
	            type: 'POST',
	            traditional: true,
	            data: { 
		            ProductTypeID: TranslateProductPageHeaderProductTypeListBox.GetValue(),
		            BrandID: TranslateProductPageHeaderBrandListBox.GetValue(),
		            LaunchID: TranslateProductPageHeaderLaunchListBox.GetValue(),
		            TemplateID: TranslateProductPageHeaderTemplateListBox.GetValue(),
		            WebStatusID: TranslateProductPageHeaderWebStatusListBox.GetValue(),
		            TranslationStatusID: TranslateProductPageHeaderTranslationStatusListBox.GetValue(),
                    TargetLanguageID: TargetLanguageID
	            },
	            success: function(data) { 
		            $('#translate-product-page-header-searching-icon').fadeOut('fast');
		            $('#translate-product-page-header-container').html(data);
                
                    $('#default-fieldset').slideUp('fast');
                    $('#translation-fieldset').slideUp('fast');
	            },
	            error: function(e, s, a) { 
		            $('#translate-product-page-header-searching-icon').fadeOut('fast');
		            alert(e.responseText);
	            },
	            timeout: 60000
            });
        }";
        listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) {
            s.SetSelectedItem(s.FindItemByValue(" + ViewBag.TranslateProductPageHeaderSelectedTemplateID + @"));
            if(s.GetSelectedItem() != null && s.GetSelectedItem() != false)
                TranslateProductPageHeaderTemplateDD.SetText(s.GetSelectedItem().text);
        }";
    }
    else if (action == "ProductPage_TemplateDropDown")
    {
        listBoxSettings.Name = "RelatedProductPagePrimaryTemplateListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) { 
            RelatedProductPagePrimaryTemplateDD.SetText(s.GetSelectedItem().text);
            RelatedProductPagePrimaryTemplateDD.HideDropDown();
            LoadingPanel.Show();
            
            var rpppnid = RelatedProductPagePrimaryNameOrIDTextBox.GetValue();

            if (rpppnid == 'Name, Code or ID')
                rpppnid = null;

            LoadingPanel.Show();
            $.ajax({ 
                url: '" + @Url.Action("RelatedProductPagePartial", "RelatedProductPages") + @"',
                type: 'POST',
                traditional: true,
                data: { 
                    PP_NameOrID: rpppnid,
                    PP_ProductTypeID: RelatedProductPagePrimaryProductTypeListBox.GetValue(),
                    PP_CollectionID: RelatedProductPagePrimaryCollectionListBox.GetValue(),
                    PP_BrandID: RelatedProductPagePrimaryBrandListBox.GetValue(),
                    PP_LaunchID: RelatedProductPagePrimaryLaunchListBox.GetValue(),
                    PP_TemplateID: RelatedProductPagePrimaryTemplateListBox.GetValue(),
                    PP_StatusID: RelatedProductPagePrimaryStatusListBox.GetValue(),
                    RPP_ProductTypeID: RelatedProductPageSecondaryProductTypeListBox.GetValue(),
                    RPP_CollectionID: RelatedProductPageSecondaryCollectionListBox.GetValue(),
                    RPP_BrandID: RelatedProductPageSecondaryBrandListBox.GetValue(),
                    RPP_LaunchID: RelatedProductPageSecondaryLaunchListBox.GetValue(),
                    RPP_TemplateID: RelatedProductPageSecondaryTemplateListBox.GetValue(),
                    RPP_StatusID: RelatedProductPageSecondaryStatusListBox.GetValue(),
                    RPP_Count: RelatedProductPageCount.GetValue(),
                    RPP_CountOperator: RelatedProductPageCountOperator.GetValue(),
                    PageLimit: PageLimit.GetValue(),
                    PageOffset: $('#current-page').val()
                },
                success: function(data) { 
                    $('#ajax-target').html(data);
                    LoadingPanel.Hide();
                },
                error: function(e, s, a) {
                    LoadingPanel.Hide(); 
                    alert(s + ' error: e.responseText was: ' + e.responseText);
                    //log e
                },
                timeout: 30000
            });
        }";
    }
    else if (action == "RelatedProductPage_TemplateDropDown")
    {
        listBoxSettings.Name = "RelatedProductPageSecondaryTemplateListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) { 
            RelatedProductPageSecondaryTemplateDD.SetText(s.GetSelectedItem().text);
            RelatedProductPageSecondaryTemplateDD.HideDropDown();
            LoadingPanel.Show();
            
            var rpppnid = RelatedProductPagePrimaryNameOrIDTextBox.GetValue();

            if (rpppnid == 'Name, Code or ID')
                rpppnid = null;

            LoadingPanel.Show();
            $.ajax({ 
                url: '" + @Url.Action("RelatedProductPagePartial", "RelatedProductPages") + @"',
                type: 'POST',
                traditional: true,
                data: { 
                    PP_NameOrID: rpppnid,
                    PP_ProductTypeID: RelatedProductPagePrimaryProductTypeListBox.GetValue(),
                    PP_CollectionID: RelatedProductPagePrimaryCollectionListBox.GetValue(),
                    PP_BrandID: RelatedProductPagePrimaryBrandListBox.GetValue(),
                    PP_LaunchID: RelatedProductPagePrimaryLaunchListBox.GetValue(),
                    PP_TemplateID: RelatedProductPagePrimaryTemplateListBox.GetValue(),
                    PP_StatusID: RelatedProductPagePrimaryStatusListBox.GetValue(),
                    RPP_ProductTypeID: RelatedProductPageSecondaryProductTypeListBox.GetValue(),
                    RPP_CollectionID: RelatedProductPageSecondaryCollectionListBox.GetValue(),
                    RPP_BrandID: RelatedProductPageSecondaryBrandListBox.GetValue(),
                    RPP_LaunchID: RelatedProductPageSecondaryLaunchListBox.GetValue(),
                    RPP_TemplateID: RelatedProductPageSecondaryTemplateListBox.GetValue(),
                    RPP_StatusID: RelatedProductPageSecondaryStatusListBox.GetValue(),
                    RPP_Count: RelatedProductPageCount.GetValue(),
                    RPP_CountOperator: RelatedProductPageCountOperator.GetValue(),
                    PageLimit: PageLimit.GetValue(),
                    PageOffset: $('#current-page').val()
                },
                success: function(data) { 
                    $('#ajax-target').html(data);
                    LoadingPanel.Hide();
                },
                error: function(e, s, a) { 
                    LoadingPanel.Hide();
                    alert(s + ' error: e.responseText was: ' + e.responseText);
                    //log e
                },
                timeout: 30000
            });
        }";
    }
    else if (action == "ProductPageSearchTemplateDropDownPartial")
    {
        listBoxSettings.Name = "ProductPageSearchTemplateListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) { 
            ProductPageSearchTemplateDD.HideDropDown();
            ProductPageSearchTemplateDD.SetText(s.GetSelectedItem().text);
            $('#product-page-searching-icon').fadeIn('fast');
            $.ajax({
                url: '" + Url.Action("ProductPageSearch", "ProductPages") + @"',
                traditional: true,
                data: {
                    ProductTypeID: ProductPageSearchProductTypeListBox.GetValue(),
                    BrandID: ProductPageSearchBrandListBox.GetValue(),
                    LaunchID: ProductPageSearchLaunchListBox.GetValue(),
                    CollectionID: ProductPageSearchCollectionListBox.GetValue(),
                    PatternID: ProductPageSearchPatternListBox.GetValue(),
		            ColourID: ProductPageSearchColourListBox.GetValue(),
                    StatusID: ProductPageSearchStatusListBox.GetValue(),
                    TemplateID: ProductPageSearchTemplateListBox.GetValue(),
                    SearchString: ProductPageSearchNameTextBox.GetValue()
                },
                success: function(data) {
                    $('#product-page-searching-icon').fadeOut('fast');
                    $('#product-page-data-view-container').html(data);
                },
                error: function(e, s, a) { 
                    $('#product-page-searching-icon').fadeOut('fast');
                    alert(e.responseText);
                },
                timeout: 60000
            });
        }";
    }
    else
    {
        listBoxSettings.Name = "TemplateListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e){ 
            alert('Not Implemented: Bad Control Name - Template Listbox');
        }";
    }
    
    listBoxSettings.ControlStyle.Border.BorderWidth = 0;
    listBoxSettings.ControlStyle.BorderBottom.BorderWidth = 1;
    listBoxSettings.ControlStyle.BorderBottom.BorderColor = System.Drawing.Color.FromArgb(0xDCDCDC);
    listBoxSettings.Width = System.Web.UI.WebControls.Unit.Percentage(100);

    listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.Single;
    listBoxSettings.Properties.ValueField = "TemplateID";
    listBoxSettings.Properties.TextField = "Name";
}
).BindList(Model).GetHtml()