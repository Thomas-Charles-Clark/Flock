@model List<Flock.Models.PriceList>
@Html.DevExpress().ListBox(
listBoxSettings =>
{
    string action = ViewContext.Controller.ValueProvider.GetValue("action").AttemptedValue;
    if (action == "PricesOverviewPriceListDropDownPartial")
    {
        listBoxSettings.Name = "PricesOverviewPriceListListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            var i = s.GetSelectedValues();
            PricesOverviewPriceListDD.HideDropDown();
            PricesOverviewPriceListDD.SetText(s.GetSelectedItem().text);
            var result = $.grep(window.PriceLists, function(e){ return e[0] == i[0]; });
            $('#price-list-currency').html(result[0][3] + ' (' + result[0][4] + ')');
            $('#price-list-exchange-rate').html(result[0][2]);
            ProductPricesGridView.Refresh();
        }";

        listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) { 
            PricesOverviewPriceListDD.SetText(s.GetSelectedItem().text);
            var i = s.GetSelectedValues();
            var result = $.grep(window.PriceLists, function(e){ return e[0] == i[0]; });
            $('#price-list-currency').html(result[0][3] + ' (' + result[0][4] + ')');
            $('#price-list-exchange-rate').html(result[0][2]);
        }";
        listBoxSettings.SelectedIndex = 0;
    }
    else if (action == "SalePricePriceListDropDownPartial")
    {
        listBoxSettings.Name = "SalePricePriceListListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            var i = s.GetSelectedValues();
            SalePricePriceListDD.HideDropDown();
            SalePricePriceListDD.SetText(s.GetSelectedItem().text);
            var result = $.grep(window.PriceLists, function(e){ return e[0] == i[0]; });
            $('#price-list-currency').html(result[0][3] + ' (' + result[0][4] + ')');
            $('#price-list-exchange-rate').html(result[0][2]);
            $.ajax({
                url: '" + @Url.Action("SalePricePriceListBoxSetSessionVariable", "Promotions") + @"',
                type: 'POST',
                traditional: true,
                data: { 
                    PriceListID: SalePricePriceListListBox.GetValue()
                },
                success: function(data) { 
                    AddNewSaleGroupProductSelectGrid.Refresh();
                },
                error: function(e, s, a) {
                    alert(e.responseText); 
                }
            });
        }";
        listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) { 
            SalePricePriceListDD.SetText(s.GetSelectedItem().text);
            var i = s.GetSelectedValues();
            var result = $.grep(window.PriceLists, function(e){ return e[0] == i[0]; });
            $('#price-list-currency').html(result[0][3] + ' (' + result[0][4] + ')');
            $('#price-list-exchange-rate').html(result[0][2]);
        }";
        listBoxSettings.SelectedIndex = 0;

    }
    else if (action == "SalesOverviewPriceListDropDownPartial")
    {
        listBoxSettings.Name = "SalesOverviewPriceListListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            var i = s.GetSelectedValues();
            SalesOverviewPriceListDD.HideDropDown();
            SalesOverviewPriceListDD.SetText(s.GetSelectedItem().text);

            if(checkReadiness()) { 
                fetchResults();
            }
        }";
        listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) { 
            SalesOverviewPriceListDD.SetText(s.GetSelectedItem().text);
        }";
        listBoxSettings.SelectedIndex = 0;
    }
    else if (action == "WeeklyPriceListDropDownPartial")
    {
        listBoxSettings.Name = "WeekPriceListListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            var i = s.GetSelectedValues();
            WeekPriceListDD.HideDropDown();
            WeekPriceListDD.SetText(s.GetSelectedItem().text);
            TryGetRecord();
        }";
    }
    else if (action == "ProductSearchPriceListDropDownPartial")
    {
        listBoxSettings.Name = "ProductSearchPriceListListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            $('#product-searching-icon').fadeIn('fast');
            ProductSearchPriceListDD.SetText(s.GetSelectedItem().text);
            ProductSearchPriceListDD.HideDropDown();
            $('#product-searching-icon').fadeIn('fast');
            var SearchText = ProductSearchNameOrIDTextBox.GetText();
            if($('#product-search-small-marker').length > 0) {
                $.ajax({
                    url: '" + Url.Action("ProductSearchSmall", "Products") + @"',
                    traditional: true,
                    data: { 
                        ProductTypeID: ProductSearchProductTypeListBox.GetValue(),
                        BrandID: ProductSearchBrandListBox.GetValue(),
                        LaunchID: ProductSearchLaunchListBox.GetValue(),
                        PatternID: ProductSearchPatternListBox.GetValue(),
                        Status: ProductSearchStatusListBox.GetValue(),
                        StatusID: ProductSearchWebStatusListBox.GetValue(),
                        StockStatusID: ProductSearchStockStatusListBox.GetValue(),
                        CollectionID: ProductSearchCollectionListBox.GetValue(),
                        ColourID: ProductSearchColourListBox.GetValue(),
                        SearchString: SearchText,
                        ProductPageAssociation: ProductSearchAssociatedListBox.GetValue(),
                        PriceListID: ProductSearchPriceListListBox.GetValue()
                    },
                    success: function(data) {
                        $('#product-data-view-container').html(data);
                        $('#product-searching-icon').fadeOut('slow');
                    },
                    error: function(e, s, a) {
                        $('#product-searching-icon').fadeOut('slow');
                        alert(e.responseText);
                    },
                    timeout: 60000
                });
            }
            else {
                $.ajax({
                    url: '" + Url.Action("ProductSearch", "Products") + @"',
                    traditional: true,
                    data: { 
                        ProductTypeID: ProductSearchProductTypeListBox.GetValue(),
                        BrandID: ProductSearchBrandListBox.GetValue(),
                        LaunchID: ProductSearchLaunchListBox.GetValue(),
                        PatternID: ProductSearchPatternListBox.GetValue(),
                        Status: ProductSearchStatusListBox.GetValue(),
                        StatusID: ProductSearchWebStatusListBox.GetValue(),
                        StockStatusID: ProductSearchStockStatusListBox.GetValue(),
                        CollectionID: ProductSearchCollectionListBox.GetValue(),
                        ColourID: ProductSearchColourListBox.GetValue(),
                        SearchString: SearchText,
                        ProductPageAssociation: ProductSearchAssociatedListBox.GetValue(),
                        PriceListID: ProductSearchPriceListListBox.GetValue()
                    },
                    success: function(data) {
                        $('#product-data-view-container').html(data);
                        $('#product-searching-icon').fadeOut('slow');
                    },
                    error: function(e, s, a) {
                        $('#product-searching-icon').fadeOut('slow');
                        alert(e.responseText);
                    },
                    timeout: 60000
                });
            }
        }";
    }
    else if (action == "BundlesPriceListDropDown")
    {
        listBoxSettings.Name = "BundlesPriceListListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            var i = s.GetSelectedValues();
            BundlesPriceListDD.HideDropDown();
            BundlesPriceListDD.SetText(s.GetSelectedItem().text);

            BundlesGridView.Refresh();
        }";
    }

    listBoxSettings.ControlStyle.Border.BorderWidth = 0;
    listBoxSettings.ControlStyle.BorderBottom.BorderWidth = 1;
    listBoxSettings.ControlStyle.BorderBottom.BorderColor = System.Drawing.Color.FromArgb(0xDCDCDC);
    listBoxSettings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
    listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.Single;
    listBoxSettings.Properties.Items.Add("All", "-1");
    listBoxSettings.Properties.TextField = "Name";
    listBoxSettings.Properties.ValueField = "PriceListID";
}
).BindList(Model).GetHtml()