@Html.DevExpress().TextBox(settings => {
    settings.Style.Add("float", "left");
    settings.Style.Add("margin", "0 7px 7px 0");
    settings.Height = System.Web.UI.WebControls.Unit.Pixel(35);
    settings.Width = System.Web.UI.WebControls.Unit.Pixel(200);

    settings.Properties.NullText = "Name, Code or ID";
    
    settings.Properties.NullDisplayText = "Name, Code or ID";

    settings.Properties.ConvertEmptyStringToNull = true;
    
    string action = ViewContext.Controller.ValueProvider.GetValue("action").AttemptedValue;

    settings.Properties.ClientSideEvents.GotFocus = @"function(s, e) {
        if(s.GetValue() == 'Name, Code or ID')
            s.SetText('');
    }";
    settings.Properties.ClientSideEvents.LostFocus = @"function(s, e) {
        if(s.GetValue() == '' || s.GetValue() == null || s.GetValue() == false)
            s.SetText('Name, Code or ID');
    }";
    
    if (action == "ImageSearchNameOrIDTextBoxPartial")
    {
        settings.Name = "ImageSearchNameOrIDTextBox";
        settings.Properties.ClientSideEvents.KeyUp = @"function(s, e) {
            if(e.htmlEvent.keyCode == 13) {
                $('#image-searching-icon').fadeIn('fast');
                $.ajax({
                    url: '" + Url.Action("ImageSearch", "Images") + @"',
                    traditional: true,
                    data: { 
                        ProductType: ImageSearchProductTypeListBox.GetValue(),
                        Brand: ImageSearchBrandListBox.GetValue(),
                        Launch: ImageSearchLaunchListBox.GetValue(),
                        Collection: ImageSearchCollectionListBox.GetValue(),
                        AspectRatio: ImageSearchAspectRatioListBox.GetValue(),
                        ImageType: ImageSearchImageTypeListBox.GetValue(),
                        Perspective: ImageSearchPerspectiveListBox.GetValue(),
                        HotspotStatus: ImageSearchHotspotStatusListBox.GetValue(),
                        Colour: ImageSearchColourListBox.GetValue(),
                        Room: ImageSearchRoomListBox.GetValue(),
                        Style: ImageSearchStyleListBox.GetValue(),
                        NameOrID: ImageSearchNameOrIDTextBox.GetValue(),
                        SearchWithinHotspots: SearchWithinHotspotsCheckbox.GetValue(),
                        Resolution: ResolutionListBox.GetValue()
                    },
                    success: function(data) {
                        $('#image-data-view-container').html(data);
                        $('#image-searching-icon').fadeOut('slow');
                    },
                    error: function(e, s, a) {
                        $('#image-searching-icon').fadeOut('slow');
                        alert(e.responseText);
                    },
                    timeout: 60000
                });
            }
        }";
    }
    else if (action == "CollectionSearchNameOrIDTextBoxPartial")
    {
        settings.Name = "CollectionNameOrIDTextBox";
        settings.Properties.ClientSideEvents.KeyUp = @"function(s, e) {
            if(e.htmlEvent.keyCode == 13) {
                $('#collection-searching-icon').fadeIn('fast');
                $.ajax({
                    url: '" + Url.Action("CollectionSearch", "Collections") + @"',
                    traditional: true,
                    data: { 
                        ProductType: CollectionProductTypeListBox.GetValue(),
                        Brand: CollectionBrandListBox.GetValue(),
                        Launch: CollectionLaunchListBox.GetValue(),
                        NameOrID: CollectionNameOrIDTextBox.GetValue()
                    },
                    success: function(data) {
                        $('#collection-data-view-container').html(data);
                        $('#collection-searching-icon').fadeOut('slow');
                        if(typeof(InitCollectionDragDrop) == 'function')
                                    InitCollectionDragDrop();
                    },
                    error: function(e, s, a) {
                        $('#collection-searching-icon').fadeOut('slow');
                        alert(e.responseText);
                    },
                    timeout: 60000
                });
            }
        }";
    }
    else if (action == "ProductSearchNameOrIDTextPartial")
    {
        settings.Name = "ProductSearchNameOrIDTextBox";
        settings.Properties.ClientSideEvents.KeyUp = @"function(s, e) {
            if(e.htmlEvent.keyCode == 13) {
                $('#product-searching-icon').fadeIn('fast');
                var SearchText = ProductSearchNameOrIDTextBox.GetText();
                if($('#product-search-small-marker').length > 0) {
                    $.ajax({
                        url: '" + Url.Action("ProductSearchSmall", "Products") + @"',
                        traditional: true,
                        data: { 
                            ProductTypeID: ProductSearchProductTypeListBox.GetValue(),
                            BrandID: ProductSearchBrandListBox.GetValue(),
                            LaunchID: ProductSearchLaunchListBox.GetValue(),
                            PatternID: ProductSearchPatternListBox.GetValue(),
                            Status: ProductSearchStatusListBox.GetValue(),
                            StatusID: ProductSearchWebStatusListBox.GetValue(),
                            StockStatusID: ProductSearchStockStatusListBox.GetValue(),
                            CollectionID: ProductSearchCollectionListBox.GetValue(),
                            ColourID: ProductSearchColourListBox.GetValue(),
                            SearchString: SearchText,
                            ProductPageAssociation: ProductSearchAssociatedListBox.GetValue(),
                            PriceListID: ProductSearchPriceListListBox.GetValue()
                        },
                        success: function(data) {
                            $('#product-data-view-container').html(data);
                            $('#product-searching-icon').fadeOut('slow');
                        },
                        error: function(e, s, a) {
                            $('#product-searching-icon').fadeOut('slow');
                            alert(e.responseText);
                        },
                        timeout: 60000
                    });
                }
                else {
                    $.ajax({
                        url: '" + Url.Action("ProductSearch", "Products") + @"',
                        traditional: true,
                        data: { 
                            ProductTypeID: ProductSearchProductTypeListBox.GetValue(),
                            BrandID: ProductSearchBrandListBox.GetValue(),
                            LaunchID: ProductSearchLaunchListBox.GetValue(),
                            PatternID: ProductSearchPatternListBox.GetValue(),
                            Status: ProductSearchStatusListBox.GetValue(),
                            StatusID: ProductSearchWebStatusListBox.GetValue(),
                            StockStatusID: ProductSearchStockStatusListBox.GetValue(),
                            CollectionID: ProductSearchCollectionListBox.GetValue(),
                            ColourID: ProductSearchColourListBox.GetValue(),
                            SearchString: SearchText,
                            ProductPageAssociation: ProductSearchAssociatedListBox.GetValue(),
                            PriceListID: ProductSearchPriceListListBox.GetValue()
                        },
                        success: function(data) {
                            $('#product-data-view-container').html(data);
                            $('#product-searching-icon').fadeOut('slow');
                        },
                        error: function(e, s, a) {
                            $('#product-searching-icon').fadeOut('slow');
                            alert(e.responseText);
                        },
                        timeout: 60000
                    });
                }
            }
        }";
    }
    else if (action == "CountrySearchNameTextBox")
    {
        settings.Name = "CountrySearchNameTextBox";
        settings.Text = "Country Name";
        settings.Properties.ClientSideEvents.GotFocus = @"function(s, e) { 
            if(s.GetValue() == 'Country Name')
                s.SetText('');
        }";
        settings.Properties.ClientSideEvents.LostFocus = @"function(s, e){
            if(s.GetValue() == '' || s.GetValue() == null || s.GetValue() == false)
                s.SetText('Country Name');
        }";
        settings.Properties.ClientSideEvents.KeyUp = @"function(s, e) { 
            if(e.htmlEvent.keyCode == 13) {
                $('#country-searching-icon').fadeIn('fast');
                var nameCodeID = null;
                if(CountrySearchNameTextBox.GetValue() != 'Country Name')
                    nameCodeID = CountrySearchNameTextBox.GetValue();
                 $.ajax({
                    url: '" + Url.Action("Search", "CountrySearch") + @"',
                    traditional: true,
                    data: { 
                        MarketID: CountrySearchMarketListBox.GetValue(),
                        ContinentID: CountrySearchContinentListBox.GetValue(),
                        RegionID: CountrySearchRegionListBox.GetValue(),
                        LanguageID: CountrySearchLanguageListBox.GetValue(),
                        SearchString: nameCodeID,
                        TableLock: CountrySearchCLTableLock.GetValue()
                    },
                    success: function(data) {
                        $('#country-search-data-view-container').html(data);
                        $('#country-searching-icon').fadeOut('slow');
                        if (typeof (InitCountryDragDrop) == 'function')
                            InitCountryDragDrop();
                    },
                    error: function(e, s, a) {
                        $('#country-searching-icon').fadeOut('slow');
                        alert(e.responseText);
                    },
                    timeout: 60000
                });
            }
        }";
    }
    else if (action == "ProductPageSearchNameTextBox")
    {
        settings.Name = "ProductPageSearchNameTextBox";
        settings.Text = "Product Page Name or ID";
        settings.Properties.ClientSideEvents.GotFocus = @"function(s, e) { 
            if(s.GetText() == 'Product Page Name or ID')
                s.SetText('');
        }";
        settings.Properties.ClientSideEvents.LostFocus = @"function(s, e){
            if(s.GetValue() == '' || s.GetValue() == null || s.GetValue() == false)
                s.SetText('Product Page Name or ID');
        }";
        settings.Properties.ClientSideEvents.KeyUp = @"function(s, e) { 
            if(e.htmlEvent.keyCode == 13) {
                var nameCodeID = null;
                if(ProductPageSearchNameTextBox.GetValue() != 'Product Page Name or ID')
                    nameCodeID = ProductPageSearchNameTextBox.GetValue();
                $('#product-page-searching-icon').fadeIn('fast');
                $.ajax({
	                url: '" + Url.Action("ProductPageSearch", "ProductPages") + @"',
	                traditional: true,
	                data: {
		                ProductTypeID: ProductPageSearchProductTypeListBox.GetValue(),
		                BrandID: ProductPageSearchBrandListBox.GetValue(),
		                LaunchID: ProductPageSearchLaunchListBox.GetValue(),
		                CollectionID: ProductPageSearchCollectionListBox.GetValue(),
		                PatternID: ProductPageSearchPatternListBox.GetValue(),
		                ColourID: ProductPageSearchColourListBox.GetValue(),
		                StatusID: ProductPageSearchStatusListBox.GetValue(),
                        TemplateID: ProductPageSearchTemplateListBox.GetValue(),
		                SearchString: nameCodeID
	                },
	                success: function(data) {
		                $('#product-page-searching-icon').fadeOut('fast');
		                $('#product-page-data-view-container').html(data);
	                },
	                error: function(e, s, a) { 
		                $('#product-page-searching-icon').fadeOut('fast');
		                alert(e.responseText);
	                },
	                timeout: 60000
                });
            }
        }";
    }
    else if (action == "PageSearchNameOrIDTextPartial")
    {
        settings.Name = "PageSearchNameTextBox";
        
        settings.Properties.ClientSideEvents.KeyUp = @"function(s, e) { 
            if(e.htmlEvent.keyCode == 13) {
                $('#page-searching-icon').fadeIn('fast');
                $.ajax({
	                url: '" + Url.Action("PageSearch", "Pages") + @"',
	                traditional: true,
	                data: {
		                SiteSectionID: PageSearchSiteSectionListBox.GetValue(),
                        //TemplateID: PageSearchTemplateListBox.GetValue(),
                        SearchString: PageSearchNameTextBox.GetValue()
	                },
	                success: function(data) {
		                $('#page-searching-icon').fadeOut('fast');
		                $('#page-data-view-container').html(data);
	                },
	                error: function(e, s, a) { 
		                $('#page-searching-icon').fadeOut('fast');
		                alert(e.responseText);
	                },
	                timeout: 60000
                });
            }
        }";
    }
    else if (action == "ProductPage_NameOrIDTextBox")
    {
        settings.Name = "RelatedProductPagePrimaryNameOrIDTextBox";

        settings.Properties.ClientSideEvents.KeyUp = @"function(s, e) { 
            if(e.htmlEvent.keyCode == 13) {
                LoadingPanel.Show();
                
                var rpppnid = RelatedProductPagePrimaryNameOrIDTextBox.GetValue();

                if (rpppnid == 'Name, Code or ID')
                    rpppnid = null;

                LoadingPanel.Show();
                $.ajax({ 
                    url: '" + @Url.Action("RelatedProductPagePartial", "RelatedProductPages") + @"',
                    type: 'POST',
                    traditional: true,
                    data: { 
                        PP_NameOrID: rpppnid,
                        PP_ProductTypeID: RelatedProductPagePrimaryProductTypeListBox.GetValue(),
                        PP_CollectionID: RelatedProductPagePrimaryCollectionListBox.GetValue(),
                        PP_BrandID: RelatedProductPagePrimaryBrandListBox.GetValue(),
                        PP_LaunchID: RelatedProductPagePrimaryLaunchListBox.GetValue(),
                        PP_TemplateID: RelatedProductPagePrimaryTemplateListBox.GetValue(),
                        PP_StatusID: RelatedProductPagePrimaryStatusListBox.GetValue(),
                        RPP_ProductTypeID: RelatedProductPageSecondaryProductTypeListBox.GetValue(),
                        RPP_CollectionID: RelatedProductPageSecondaryCollectionListBox.GetValue(),
                        RPP_BrandID: RelatedProductPageSecondaryBrandListBox.GetValue(),
                        RPP_LaunchID: RelatedProductPageSecondaryLaunchListBox.GetValue(),
                        RPP_TemplateID: RelatedProductPageSecondaryTemplateListBox.GetValue(),
                        RPP_StatusID: RelatedProductPageSecondaryStatusListBox.GetValue(),
                        RPP_Count: RelatedProductPageCount.GetValue(),
                        RPP_CountOperator: RelatedProductPageCountOperator.GetValue(),
                        PageLimit: PageLimit.GetValue(),
                        PageOffset: $('#current-page').val()
                    },
                    success: function(data) { 
                        $('#ajax-target').html(data);
                        LoadingPanel.Hide();
                    },
                    timeout: 30000
                });
            }
        }";
    }
    
}).GetHtml()