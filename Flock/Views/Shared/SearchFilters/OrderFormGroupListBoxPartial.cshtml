@model List<Flock.Models.OrderFormGroup>
@Html.DevExpress().ListBox(
listBoxSettings =>
{
    string action = ViewContext.Controller.ValueProvider.GetValue("action").AttemptedValue;
    if (action == "PrimaryOrderFormGroupDropDownPartial")
    {
        string name = "PrimaryOrderFormGroupListBox" + ViewBag.OrderFormGroupProductID;
        string dropDownName = "OrderFormGroupDD" + ViewBag.OrderFormGroupProductID;
        listBoxSettings.Name = name;
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            " + dropDownName + @".SetText(s.GetSelectedItem().text);
            " + dropDownName + @".HideDropDown();
            $.ajax({ 
                url: '" + @Url.Action("SetPrimaryProductOrderFormGroup", "ProductPages") + @"',
                type: 'POST',
                traditional: true,    
                data: { ProductPageID: " + ViewBag.OrderFormGroupProductPageID + @", ProductID: " + ViewBag.OrderFormGroupProductID + @", OrderFormGroupID: s.GetSelectedItem().value },
                success: function(data) {
                    $('#primary-products-container').html(data);
                },
                error: function(e, s, a) { 
                    alert(e.responseText);
                },
                timeout: 60000
            });
        }";
        listBoxSettings.PreRender = (s, e) =>
        {
            ((MVCxListBox)s).Properties.Items.Insert(0, new ListEditItem() { Text = "Not Set", Value = null });
        };
        
        listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) { 
            s.SetSelectedItem(s.FindItemByValue(" + ViewBag.SelectedOrderFormGroupID + @"));
            if(s.GetSelectedItem() != null && s.GetSelectedItem() != false)
                " + dropDownName + @".SetText(s.GetSelectedItem().text);
        }";
    }
    else if (action == "SecondaryOrderFormGroupDropDownPartial")
    {
        string name = "SecondaryOrderFormGroupListBox" + ViewBag.OrderFormGroupProductID;
        string dropDownName = "OrderFormGroupDD" + ViewBag.OrderFormGroupProductID;
        listBoxSettings.Name = name;
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            " + dropDownName + @".SetText(s.GetSelectedItem().text);
            " + dropDownName + @".HideDropDown();
            $.ajax({ 
                url: '" + @Url.Action("SetSecondaryProductOrderFormGroup", "ProductPages") + @"',
                type: 'POST',
                traditional: true,    
                data: { ProductPageID: " + ViewBag.OrderFormGroupProductPageID + @", ProductID: " + ViewBag.OrderFormGroupProductID + @", OrderFormGroupID: s.GetSelectedItem().value },
                success: function(data) {
                    $('#secondary-products-container').html(data);
                },
                error: function(e, s, a) { 
                    alert(e.responseText);
                },
                timeout: 60000
            });
        }";
        listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) { 
            s.SetSelectedItem(s.FindItemByValue(" + ViewBag.SelectedOrderFormGroupID + @"));
            if(s.GetSelectedItem() != null && s.GetSelectedItem() != false)
                " + dropDownName + @".SetText(s.GetSelectedItem().text);
        }";
    }
    
    listBoxSettings.ControlStyle.Border.BorderWidth = 0;
    listBoxSettings.ControlStyle.BorderBottom.BorderWidth = 1;
    listBoxSettings.ControlStyle.BorderBottom.BorderColor = System.Drawing.Color.FromArgb(0xDCDCDC);
    listBoxSettings.Width = System.Web.UI.WebControls.Unit.Percentage(100);

    listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.Single;
    
    listBoxSettings.Properties.TextField = "Name";
    listBoxSettings.Properties.ValueField = "OrderFormGroupID";
}
).BindList(Model).GetHtml()