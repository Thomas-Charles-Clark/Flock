@Html.DevExpress().DropDownEdit(
    settings =>
    {
        settings.Style.Add("float", "left");
        settings.Style.Add("margin", "0 7px 7px 0");
        settings.Width = System.Web.UI.WebControls.Unit.Pixel(200);
        settings.Height = System.Web.UI.WebControls.Unit.Pixel(35);


        string action = ViewContext.Controller.ValueProvider.GetValue("action").AttemptedValue;

        if (action == "TranslateProductPageHeaderTranslationStatusDropDown")
        {
            settings.Name = "TranslateProductPageHeaderTranslationStatusDD";
            settings.Width = 180;
        }
        else if (action == "TranslateCollectionHeaderTranslationStatusDropDown")
        {
            settings.Name = "TranslateCollectionHeaderTranslationStatusDD";
            settings.Width = 180;
        }
        else if (action == "TranslatePageHeaderTranslationStatusDropDown")
            settings.Name = "TranslatePageHeaderTranslationStatusDD";
        else
            settings.Name = "TranslationStatusDD";


        settings.Text = "Translation Status";
        settings.Properties.DropDownWindowStyle.BackColor = System.Drawing.Color.FromArgb(0xEDEDED);

        settings.Properties.EnableClientSideAPI = true;

        settings.SetDropDownWindowTemplateContent(c =>
        {
            ViewContext.Writer.Write("<div id='status-listbox'>");
            ViewContext.Writer.Write(@Html.Partial("~/Views/Shared/SearchFilters/TranslationStatusListBoxPartial.cshtml"));
            ViewContext.Writer.Write("</div>");
            ViewContext.Writer.Write("<div style=\"padding: 6px;\">");
            @Html.DevExpress().Button(
                buttonSettings =>
                {
                    if (action == "TranslateProductPageHeaderTranslationStatusDropDown")
                    {
                        buttonSettings.Name = "TranslateProductPageHeaderTranslationStatusButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) {
                            TranslateProductPageHeaderTranslationStatusListBox.UnselectAll();
                            TranslateProductPageHeaderTranslationStatusDD.HideDropDown();
                            TranslateProductPageHeaderTranslationStatusDD.SetText('Translation Status');
                            var TargetLanguageID = null;
                            if(typeof(TranslationTargetLanguageListBox) != 'undefined' && typeof(TranslationTargetLanguageListBox) != false)
                                TargetLanguageID = TranslationTargetLanguageListBox.GetValue();
                            $('#translate-product-page-header-searching-icon').fadeIn('fast');
                            $.ajax({
	                            url: '" + Url.Action("TranslateProductPageHeader", "Translations") + @"',
	                            type: 'POST',
	                            traditional: true,
	                            data: { 
		                            ProductTypeID: TranslateProductPageHeaderProductTypeListBox.GetValue(),
		                            BrandID: TranslateProductPageHeaderBrandListBox.GetValue(),
		                            LaunchID: TranslateProductPageHeaderLaunchListBox.GetValue(),
		                            TemplateID: TranslateProductPageHeaderTemplateListBox.GetValue(),
		                            WebStatusID: TranslateProductPageHeaderWebStatusListBox.GetValue(),
		                            TranslationStatusID: TranslateProductPageHeaderTranslationStatusListBox.GetValue(),
                                    TargetLanguageID: TargetLanguageID
	                            },
	                            success: function(data) { 
		                            $('#translate-product-page-header-searching-icon').fadeOut('fast');
		                            $('#translate-product-page-header-container').html(data);
                
                                    $('#default-fieldset').slideUp('fast');
                                    $('#translation-fieldset').slideUp('fast');
	                            },
	                            error: function(e, s, a) { 
		                            $('#translate-product-page-header-searching-icon').fadeOut('fast');
		                            alert(e.responseText);
	                            },
	                            timeout: 60000
                            });
                        }";
                    }
                    else if (action == "TranslateCollectionHeaderTranslationStatusDropDown")
                    {
                        buttonSettings.Name = "TranslateCollectionHeaderTranslationStatusButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) {
                            TranslateCollectionHeaderTranslationStatusListBox.UnselectAll();
                            TranslateCollectionHeaderTranslationStatusDD.HideDropDown();
                            TranslateCollectionHeaderTranslationStatusDD.SetText('Translation Status');
                            var TargetLanguageID = null;
                            if(typeof(TranslationTargetLanguageListBox) != 'undefined' && typeof(TranslationTargetLanguageListBox) != false)
                                TargetLanguageID = TranslationTargetLanguageListBox.GetValue();
                            $('#translate-collection-header-searching-icon').fadeIn('fast');
                            $.ajax({
	                            url: '" + Url.Action("TranslateCollectionHeader", "Translations") + @"',
	                            type: 'POST',
	                            traditional: true,
	                            data: { 
		                            ProductTypeID: TranslateCollectionHeaderProductTypeListBox.GetValue(),
		                            BrandID: TranslateCollectionHeaderBrandListBox.GetValue(),
		                            LaunchID: TranslateCollectionHeaderLaunchListBox.GetValue(),
		                            WebStatusID: TranslateCollectionHeaderWebStatusListBox.GetValue(),
		                            TranslationStatusID: TranslateCollectionHeaderTranslationStatusListBox.GetValue(),
                                    TargetLanguageID: TargetLanguageID
	                            },
	                            success: function(data) { 
		                            $('#translate-collection-header-searching-icon').fadeOut('fast');
		                            $('#translate-collection-header-container').html(data);
	                            },
	                            error: function(e, s, a) { 
		                            $('#translate-collection-header-searching-icon').fadeOut('fast');
		                            alert(e.responseText);
	                            },
	                            timeout: 60000
                            });
                        }";
                    }
                    else if (action == "TranslatePageHeaderTranslationStatusDropDown")
                    {
                        buttonSettings.Name = "TranslatePageHeaderTranslationStatusButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            TranslatePageHeaderTranslationStatusListBox.UnselectAll();
                            TranslatePageHeaderTranslationStatusDD.HideDropDown();
                            TranslatePageHeaderTranslationStatusDD.SetText('Translation Status');
                            var TargetLanguageID = null;
                            if(typeof(TranslationTargetLanguageListBox) != 'undefined' && typeof(TranslationTargetLanguageListBox) != false)
                                TargetLanguageID = TranslationTargetLanguageListBox.GetValue();
                            $.ajax({
	                            url: '" + Url.Action("TranslatePageHeaderPageDropDown", "Translations") + @"',
	                            type: 'POST',
	                            traditional: true,
	                            data: {
	                                ID: TranslateHeaderContentListBox.GetValue(),
	                                SiteSectionID: TranslatePageHeaderSiteSectionListBox.GetValue(),
	                                ParentPageID: TranslatePageHeaderParentPageListBox.GetValue(),
	                                TranslationStatusID: TranslatePageHeaderTranslationStatusListBox.GetValue(),
                                    TargetLanguageID: TargetLanguageID
	                            },
	                            success: function(data) { 
	                                $('#translate-page-page-drop-down-container').html(data);
                                    if (TranslateHeaderContentListBox.FindItemByValue($('#content-id-label').html()) == null) {
                                        TranslateHeaderContentListBox.SetSelectedIndex(0);
                                        var e = new ASPxClientProcessingModeEventArgs();
                                        if(TranslateHeaderContentListBox.GetItemCount() > 0)
                                            TranslateHeaderContentListBox.SelectedIndexChanged.FireEvent(TranslateHeaderContentListBox, e);
                                    }
	                            },
	                            error: function(e, s, a) { 
	                                alert(e.responseText);
	                            },
	                            timeout: 60000
                                });
                            }";
                    }
                    else
                    {
                        buttonSettings.Name = "TemplateButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e){
                        alert('Not Implemented: Bad Control Name.');
                    }";
                    }
                    buttonSettings.Text = "Clear";
                    buttonSettings.Style.Add("float", "left");
                }
            )
            .Render();
            
            @Html.DevExpress().Button(
                buttonSettings =>
                {
                    if (action == "TranslateProductPageHeaderTranslationStatusDropDown")
                    {
                        buttonSettings.Name = "TranslateProductPageHeaderTranslationStatusButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) {
                            TranslateProductPageHeaderTranslationStatusDD.HideDropDown();
                        }";
                    }
                    else if (action == "TranslateCollectionHeaderTranslationStatusDropDown")
                    {
                        buttonSettings.Name = "TranslateCollectionHeaderTranslationStatusButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) {
                            TranslateCollectionHeaderTranslationStatusDD.HideDropDown();
                        }";
                    }
                    else if (action == "TranslatePageHeaderTranslationStatusDropDown")
                    {
                        buttonSettings.Name = "TranslatePageHeaderTranslationStatusButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) {
                            TranslatePageHeaderTranslationStatusDD.HideDropDown();
                        }";
                    }
                    else
                    {
                        buttonSettings.Name = "TemplateButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) {
                            alert('Not Implemented. Bad control name.');
                        }";
                    }
                    buttonSettings.Text = "Close";
                    buttonSettings.Style.Add("float", "right");
                }
            )
            .Render();
            ViewContext.Writer.Write("<div style='clear: both;'></div></div>");
        });
        settings.Properties.AnimationType = AnimationType.None;
    }
).GetHtml()