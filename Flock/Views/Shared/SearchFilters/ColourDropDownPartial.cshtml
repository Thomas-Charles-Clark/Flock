@{
    Layout = null;
}
@model List<Flock.Models.Colour>

@Html.DevExpress().DropDownEdit(
    settings =>
    {
        settings.Style.Add("float", "left");
        settings.Style.Add("margin", "0 7px 7px 0");
        settings.Text = "Colour";

        settings.Properties.ClientSideEvents.CloseUp = @"function(s, e) {
            s.SetText('Colour');
        }";

        string action = ViewContext.Controller.ValueProvider.GetValue("action").AttemptedValue;

        if (action == "ProductSearchColourDropDownPartial")
            settings.Name = "ProductSearchColourDD";
        else if (action == "ImageSearchColourDropDownPartial")
            settings.Name = "ImageSearchColourDD";
        else if (action == "ProductPageSearchColourDropDownPartial")
            settings.Name = "ProductPageSearchColourDD";
        else if (action == "ProductImagesOverviewColourDropDownPartial")
            settings.Name = "ProductImagesOverviewColourDD";
        else if (action == "ProductPagesOverviewColourDropDownPartial")
            settings.Name = "ProductPagesOverviewColourDD";
        else if (action == "ProductOverviewColourDropDownPartial")
        {
            settings.Name = "ProductOverviewColourDD";
            settings.Text = "Colours";
            settings.Style.Remove("margin");
            settings.Style.Add("margin", "0px 7px 0px 0px");
        }
        else if (action == "ProductDimensionsColourDropDownPartial")
        {
            settings.Name = "ProductDimensionsColourDD";
            settings.Text = "Colours";
            settings.Style.Remove("margin");
            settings.Style.Add("margin", "0px 7px 0px 0px");
        }
        else if (action == "ProductReviewsColourDropDownPartial")
        {
            settings.Name = "ProductReviewsColourDD";
            settings.Text = "Colours";
            settings.Properties.ClientSideEvents.CloseUp = @"function(s, e) {
            }";
        }
        else if (action == "PricesOverviewColourDropDownPartial")
            settings.Name = "PricesOverviewColourDD";
        else if (action == "StockOverviewColourDropDownPartial")
            settings.Name = "StockOverviewColourDD";
        else if (action == "AttributeColourDropDown")
            settings.Name = "AttributeDetailColourDD";

        settings.Properties.DropDownWindowStyle.BackColor = System.Drawing.Color.FromArgb(0xEDEDED);

        settings.Width = System.Web.UI.WebControls.Unit.Pixel(200);
        settings.Height = System.Web.UI.WebControls.Unit.Pixel(35);

        if (action == "AttributeColourDropDown")
        {
            settings.Width = System.Web.UI.WebControls.Unit.Pixel(100);
        }

        settings.Properties.EnableClientSideAPI = true;


        //string action = ViewContext.Controller.ValueProvider.GetValue("action").AttemptedValue;

        settings.SetDropDownWindowTemplateContent(c =>
        {
            ViewContext.Writer.Write("<div id='Colour-listbox'>");
            ViewContext.Writer.Write(@Html.Partial("~/Views/Shared/SearchFilters/ColourListBoxPartial.cshtml", Model));
            ViewContext.Writer.Write("</div>");
            ViewContext.Writer.Write("<div style=\"padding: 6px;\">");

            if(action != "AttributeColourDropDown")
            {
                @Html.DevExpress().Button(
                buttonSettings =>
                {
                    buttonSettings.Text = "Clear";
                    buttonSettings.Style.Add("float", "left");
                    if (action == "ProductSearchColourDropDownPartial")
                    {
                        buttonSettings.Name = "ProductSearchColourButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                            ProductSearchColourListBox.UnselectAll();
                            ProductSearchColourDD.HideDropDown(); 
                            ProductSearchColourDD.SetText('Colour');
                            $('#product-searching-icon').fadeIn('fast');
                            var SearchText = ProductSearchNameOrIDTextBox.GetText();
                            if($('#product-search-small-marker').length > 0) {
                                $.ajax({
                                    url: '" + Url.Action("ProductSearchSmall", "Products") + @"',
                                    traditional: true,
                                    data: { 
                                        ProductTypeID: ProductSearchProductTypeListBox.GetValue(),
                                        BrandID: ProductSearchBrandListBox.GetValue(),
                                        LaunchID: ProductSearchLaunchListBox.GetValue(),
                                        PatternID: ProductSearchPatternListBox.GetValue(),
                                        Status: ProductSearchStatusListBox.GetValue(),
                                        StatusID: ProductSearchWebStatusListBox.GetValue(),
                                        StockStatusID: ProductSearchStockStatusListBox.GetValue(),
                                        CollectionID: ProductSearchCollectionListBox.GetValue(),
                                        ColourID: ProductSearchColourListBox.GetValue(),
                                        SearchString: SearchText,
                                        ProductPageAssociation: ProductSearchAssociatedListBox.GetValue(),
                                        PriceListID: ProductSearchPriceListListBox.GetValue()
                                    },
                                    success: function(data) {
                                        $('#product-data-view-container').html(data);
                                        $('#product-searching-icon').fadeOut('slow');
                                    },
                                    error: function(e, s, a) {
                                        $('#product-searching-icon').fadeOut('slow');
                                        alert(e.responseText);
                                    },
                                    timeout: 60000
                                });
                            }
                            else {
                                $.ajax({
                                    url: '" + Url.Action("ProductSearch", "Products") + @"',
                                    traditional: true,
                                    data: { 
                                        ProductTypeID: ProductSearchProductTypeListBox.GetValue(),
                                        BrandID: ProductSearchBrandListBox.GetValue(),
                                        LaunchID: ProductSearchLaunchListBox.GetValue(),
                                        PatternID: ProductSearchPatternListBox.GetValue(),
                                        Status: ProductSearchStatusListBox.GetValue(),
                                        StatusID: ProductSearchWebStatusListBox.GetValue(),
                                        StockStatusID: ProductSearchStockStatusListBox.GetValue(),
                                        CollectionID: ProductSearchCollectionListBox.GetValue(),
                                        ColourID: ProductSearchColourListBox.GetValue(),
                                        SearchString: SearchText,
                                        ProductPageAssociation: ProductSearchAssociatedListBox.GetValue(),
                                        PriceListID: ProductSearchPriceListListBox.GetValue()
                                    },
                                    success: function(data) {
                                        $('#product-data-view-container').html(data);
                                        $('#product-searching-icon').fadeOut('slow');
                                    },
                                    error: function(e, s, a) {
                                        $('#product-searching-icon').fadeOut('slow');
                                        alert(e.responseText);
                                    },
                                    timeout: 60000
                                });
                            }
                        }";
                    }
                    else if (action == "ImageSearchColourDropDownPartial")
                    {
                        buttonSettings.Name = "ImageSearchColourButtonClear";
                        buttonSettings.Text = "Clear";
                        buttonSettings.Style.Add("float", "left");
                        buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                            ImageSearchColourListBox.UnselectAll();
                            ImageSearchColourDD.HideDropDown(); 
                            ImageSearchColourDD.SetText('Colour');
                            $('#image-searching-icon').fadeIn('fast');
                            $.ajax({
                                url: '" + Url.Action("ImageSearch", "Images") + @"',
                                traditional: true,
                                data: { 
                                    ProductType: ImageSearchProductTypeListBox.GetValue(),
                                    Brand: ImageSearchBrandListBox.GetValue(),
                                    Launch: ImageSearchLaunchListBox.GetValue(),
                                    Collection: ImageSearchCollectionListBox.GetValue(),
                                    AspectRatio: ImageSearchAspectRatioListBox.GetValue(),
                                    ImageType: ImageSearchImageTypeListBox.GetValue(),
                                    Perspective: ImageSearchPerspectiveListBox.GetValue(),
                                    HotspotStatus: ImageSearchHotspotStatusListBox.GetValue(),
                                    Colour: ImageSearchColourListBox.GetValue(),
                                    Room: ImageSearchRoomListBox.GetValue(),
                                    Style: ImageSearchStyleListBox.GetValue(),
                                    NameOrID: ImageSearchNameOrIDTextBox.GetValue(),
                                    SearchWithinHotspots: SearchWithinHotspotsCheckbox.GetValue(),
                                    Resolution: ResolutionListBox.GetValue()
                                },
                                success: function(data) {
                                    $('#image-data-view-container').html(data);
                                    $('#image-searching-icon').fadeOut('slow');
                                },
                                error: function(e, s, a) {
                                    $.showError(e, s, a, function() { $('#image-searching-icon').fadeOut('slow'); });
                                },
                                timeout: 60000
                            });
                        }";
                    }
                    else if (action == "ProductPageSearchColourDropDownPartial")
                    {
                        buttonSettings.Name = "ProductPageSearchColourButtonClear";
                        buttonSettings.Text = "Clear";
                        buttonSettings.Style.Add("float", "left");
                        buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                            ProductPageSearchColourListBox.UnselectAll();
                            ProductPageSearchColourDD.HideDropDown(); 
                            ProductPageSearchColourDD.SetText('Colour');
                            $('#product-page-searching-icon').fadeIn('fast');
                            $.ajax({
	                            url: '" + Url.Action("ProductPageSearch", "ProductPages") + @"',
	                            traditional: true,
	                            data: {
		                            ProductTypeID: ProductPageSearchProductTypeListBox.GetValue(),
		                            BrandID: ProductPageSearchBrandListBox.GetValue(),
		                            LaunchID: ProductPageSearchLaunchListBox.GetValue(),
		                            CollectionID: ProductPageSearchCollectionListBox.GetValue(),
		                            PatternID: ProductPageSearchPatternListBox.GetValue(),
		                            ColourID: ProductPageSearchColourListBox.GetValue(),
		                            StatusID: ProductPageSearchStatusListBox.GetValue(),
                                    TemplateID: ProductPageSearchTemplateListBox.GetValue(),
		                            SearchString: ProductPageSearchNameTextBox.GetValue()
	                            },
	                            success: function(data) {
		                            $('#product-page-searching-icon').fadeOut('fast');
		                            $('#product-page-data-view-container').html(data);
	                            },
	                            error: function(e, s, a) { 
		                            $.showError(e, s, a, function() { $('#product-page-searching-icon').fadeOut('fast'); });
	                            },
	                            timeout: 60000
                            });
                        }";
                    }
                    else if (action == "ProductImagesOverviewColourDropDownPartial")
                    {
                        buttonSettings.Name = "ProductImagesOverviewButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                            ProductImagesOverviewColourCheckComboBox.UnselectAll();
                            ProductImagesOverviewColourDD.HideDropDown(); 
                            ProductImagesOverviewColourDD.SetText('Colour');
                            ProductImagesOverviewGridView.Refresh();  
                        }";
                    }
                    else if (action == "ProductPagesOverviewColourDropDownPartial")
                    {
                        buttonSettings.Name = "ProductPagesOverviewColourButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                            ProductPagesOverviewColourListBox.UnselectAll();
                            ProductPagesOverviewColourDD.HideDropDown(); 
                            ProductPagesOverviewColourDD.SetText('Colour');
                            ProductPagesOverviewGridView.Refresh();
                        }";
                    }
                    else if (action == "ProductOverviewColourDropDownPartial")
                    {
                        buttonSettings.Name = "ProductOverviewColourButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            ProductOverviewColourListBox.UnselectAll();
                            ProductOverviewColourDD.HideDropDown(); 
                            ProductOverviewColourDD.SetText('Colours');
                            ProductOverviewGridView.Refresh();
                        }";
                    }
                    else if (action == "ProductDimensionsColourDropDownPartial")
                    {
                        buttonSettings.Name = "ProductDimensionsColourButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            ProductDimensionsColourListBox.UnselectAll();
                            ProductDimensionsColourDD.HideDropDown(); 
                            ProductDimensionsColourDD.SetText('Colours');
                            ProductDimensionsGridView.Refresh();
                        }";
                    }
                    else if (action == "ProductReviewsColourDropDownPartial")
                    {
                        buttonSettings.Name = "ProductReviewsColourButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            ProductReviewsColourListBox.UnselectAll();
                            ProductReviewsColourDD.HideDropDown(); 
                            ProductReviewsColourDD.SetText('Colours');

                            $.ajax({
                                url: '" + Url.Action("ProductReviewsColourListBoxSetSessionVariable", "Reviews") + @"',
                                type: 'POST',
                                traditional: true,
                                data: { ColourIDs: ProductReviewsColourListBox.GetSelectedValues() },
                                success: function(data) { 
                                    ProductReviewsGridView.Refresh(); 
                                },
                                error: function(e, s, a) { 
                                    $.showError(e, s, a);
                                },
                                timeout: 60000
                            });
                        }";
                    }
                    else if (action == "PricesOverviewColourDropDownPartial")
                    {
                        buttonSettings.Name = "PricesOverviewColourButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            PricesOverviewColourListBox.UnselectAll();
                            PricesOverviewColourDD.HideDropDown();
                            PricesOverviewColourDD.SetText('Colour');
                            ProductPricesGridView.Refresh();
                        }";
                    }
                    else if (action == "StockOverviewColourDropDownPartial")
                    {
                        buttonSettings.Name = "StockOverviewColourButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            StockOverviewColourListBox.UnselectAll();
                            StockOverviewColourDD.HideDropDown(); 
                            StockOverviewColourDD.SetText('Colour');
                            alert('needs implementing');
                            //PricesOverviewGridView.PerformCallback();
                        }";
                    }
                }
            )
            .Render();
            }


            @Html.DevExpress().Button(
                buttonSettings =>
                {
                    buttonSettings.Text = "Close";
                    buttonSettings.Style.Add("float", "right");
                    if (action == "ProductSearchColourDropDownPartial")
                    {
                        buttonSettings.Name = "ProductSearchColourCloseButton";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            ProductSearchColourDD.HideDropDown();
                            ProductSearchColourDD.SetText('Colour');
                        }";
                    }
                    else if (action == "ImageSearchColourDropDownPartial")
                    {
                        buttonSettings.Name = "ImageSearchColourCloseButton";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            ImageSearchColourDD.HideDropDown();
                            ImageSearchColourDD.SetText('Colour');
                        }";
                    }
                    else if (action == "ProductPageSearchColourDropDownPartial")
                    {
                        buttonSettings.Name = "ProductPageSearchColourCloseButton";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            ProductPageSearchColourDD.HideDropDown();
                            ProductPageSearchColourDD.SetText('Colour');
                        }";
                    }
                    else if (action == "ProductImagesOverviewColourDropDownPartial")
                    {
                        buttonSettings.Name = "ProductImagesOverviewColourButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                            ProductImagesOverviewColourDD.HideDropDown(); 
                            ProductImagesOverviewColourDD.SetText('Colour');
                        }";
                    }
                    else if (action == "ProductPagesOverviewColourDropDownPartial")
                    {
                        buttonSettings.Name = "ProductPagesOverviewColourButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                            ProductPagesOverviewColourDD.HideDropDown(); 
                            ProductPagesOverviewColourDD.SetText('Colour');
                        }";
                    }
                    else if (action == "ProductOverviewColourDropDownPartial")
                    {
                        buttonSettings.Name = "ProductOverviewColourButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                            ProductOverviewColourDD.HideDropDown(); 
                            ProductOverviewColourDD.SetText('Colour');
                        }";
                    }
                    else if (action == "ProductDimensionsColourDropDownPartial")
                    {
                        buttonSettings.Name = "ProductDimensionsColourButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                            ProductDimensionsColourDD.HideDropDown(); 
                            ProductDimensionsColourDD.SetText('Colour');
                        }";
                    }
                    else if (action == "ProductReviewsColourDropDownPartial")
                    {
                        buttonSettings.Name = "ProductReviewsColourButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                            ProductReviewsColourDD.HideDropDown(); 
                            ProductReviewsColourDD.SetText('Colour');
                        }";
                    }
                    else if (action == "PricesOverviewColourDropDownPartial")
                    {
                        buttonSettings.Name = "PricesOverviewColourButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                            PricesOverviewColourDD.HideDropDown(); 
                            PricesOverviewColourDD.SetText('Colour');
                        }";
                    }
                    else if (action == "StockOverviewColourDropDownPartial")
                    {
                        buttonSettings.Name = "StockOverviewColourButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                            StockOverviewColourDD.HideDropDown(); 
                            StockOverviewColourDD.SetText('Colour');
                            alert('needs implementing');
                        }";
                    }
                    else if (action == "AttributeColourDropDown")
                    {
                        buttonSettings.Name = "AttributeColourButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                            AttributeDetailColourDD.HideDropDown();
                        }";
                    }
                }
            )
            .Render();
            ViewContext.Writer.Write("<div style='clear: both;'></div></div>");
        });
        settings.Properties.AnimationType = AnimationType.None;
        settings.Properties.ClientSideEvents.TextChanged = "";// "SynchronizeListBoxValues";
        settings.Properties.ClientSideEvents.DropDown = "";// "SynchronizeListBoxValues";

        /* 
         * Will Stock and Prices ever want to display sparklines? if so they'll need :
         * 
        //      $('.inlinesparkline').each(function () {
        //          $(this).html($(this).data('sparkline'));
        //          $(this).sparkline();
        //      });
         * 
         * in their ajax success handlers.
         */
    }
).GetHtml()