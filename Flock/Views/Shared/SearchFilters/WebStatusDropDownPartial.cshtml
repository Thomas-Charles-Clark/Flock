@model List<Flock.Models.Status>
@Html.DevExpress().DropDownEdit(
    settings =>
    {
        settings.Style.Add("float", "left");
        settings.Style.Add("margin", "0 0 0 0");
        settings.Width = System.Web.UI.WebControls.Unit.Pixel(200);
        settings.Height = System.Web.UI.WebControls.Unit.Pixel(35);
        

        string action = ViewContext.Controller.ValueProvider.GetValue("action").AttemptedValue;

        if (action == "ProductSearchWebStatusDropDownPartial")
            settings.Name = "ProductSearchWebStatusDD";
        else if (action == "ProductPageSearchStatusDropDownPartial")
            settings.Name = "ProductPageSearchStatusDD";
        else if (action == "ComposeProductPageHeaderWebStatusDropDownPartial")
        {
            settings.Name = "ComposeProductPageHeaderWebStatusDD";
            settings.Width = System.Web.UI.WebControls.Unit.Pixel(175);
        }
        else if (action == "ComposeBannerHeaderWebStatusDropDownPartial")
            settings.Name = "ComposeBannerHeaderWebStatusDD";
        else if (action == "TranslateProductPageHeaderWebStatusDropDown")
        {
            settings.Name = "TranslateProductPageHeaderWebStatusDD";
            settings.Width = 180;
        }
        else if (action == "TranslateCollectionHeaderWebStatusDropDown")
        {
            settings.Name = "TranslateCollectionHeaderWebStatusDD";
            settings.Width = 180;
        }
        else if (action == "TranslatePageHeaderWebStatusDropDown")
            settings.Name = "TranslatePageHeaderWebStatusDD";
        else if (action == "AttributeHeaderWebStatusDropDownPartial")
        {
            settings.Name = "AttributeWebStatusDD";
            settings.Style.Remove("margin");
            settings.Style.Add("margin", "0px 7px 0px 0px");
            settings.Width = 175;
        }
        else if (action == "ProductPage_StatusDropDown")
        {
            settings.Name = "RelatedProductPagePrimaryStatusDD";
        }
        else if (action == "RelatedProductPage_StatusDropDown")
        {
            settings.Name = "RelatedProductPageSecondaryStatusDD";
        }
        else if (action == "PageComposePageSectionWebStatusDropDown")
            settings.Name = "PageSectionWebStatusDD";
        else
            settings.Name = "WebStatusDD";
        

        settings.Text = "Web Status";
        settings.Properties.DropDownWindowStyle.BackColor = System.Drawing.Color.FromArgb(0xEDEDED);

        settings.Properties.EnableClientSideAPI = true;

        settings.SetDropDownWindowTemplateContent(c =>
        {
            ViewContext.Writer.Write("<div id='status-listbox'>");
            ViewContext.Writer.Write(@Html.Partial("~/Views/Shared/SearchFilters/WebStatusListBoxPartial.cshtml", Model));
            ViewContext.Writer.Write("</div>");
            ViewContext.Writer.Write("<div style=\"padding: 6px;\">");
            @Html.DevExpress().Button(
                buttonSettings =>
                {
                    if (action == "ProductSearchWebStatusDropDownPartial")
                    {
                        buttonSettings.Name = "ProductSearchWebStatusButtonClear"; 
                        buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                            ProductSearchWebStatusListBox.UnselectAll();
                            ProductSearchWebStatusDD.HideDropDown(); 
                            ProductSearchWebStatusDD.SetText('Web Status');
                            $('#product-searching-icon').fadeIn('fast');
                            var SearchText = ProductSearchNameOrIDTextBox.GetText();
                            if($('#product-search-small-marker').length > 0) {
                                $.ajax({
                                    url: '" + Url.Action("ProductSearchSmall", "Products") + @"',
                                    traditional: true,
                                    data: { 
                                        ProductTypeID: ProductSearchProductTypeListBox.GetValue(),
                                        BrandID: ProductSearchBrandListBox.GetValue(),
                                        LaunchID: ProductSearchLaunchListBox.GetValue(),
                                        PatternID: ProductSearchPatternListBox.GetValue(),
                                        Status: ProductSearchStatusListBox.GetValue(),
                                        StatusID: ProductSearchWebStatusListBox.GetValue(),
                                        StockStatusID: ProductSearchStockStatusListBox.GetValue(),
                                        CollectionID: ProductSearchCollectionListBox.GetValue(),
                                        ColourID: ProductSearchColourListBox.GetValue(),
                                        SearchString: SearchText,
                                        ProductPageAssociation: ProductSearchAssociatedListBox.GetValue(),
                                        PriceListID: ProductSearchPriceListListBox.GetValue()
                                    },
                                    success: function(data) {
                                        $('#product-data-view-container').html(data);
                                        $('#product-searching-icon').fadeOut('slow');
                                    },
                                    error: function(e, s, a) {
                                        $('#product-searching-icon').fadeOut('slow');
                                        alert(e.responseText);
                                    },
                                    timeout: 60000
                                });
                            }
                            else {
                                $.ajax({
                                    url: '" + Url.Action("ProductSearch", "Products") + @"',
                                    traditional: true,
                                    data: { 
                                        ProductTypeID: ProductSearchProductTypeListBox.GetValue(),
                                        BrandID: ProductSearchBrandListBox.GetValue(),
                                        LaunchID: ProductSearchLaunchListBox.GetValue(),
                                        PatternID: ProductSearchPatternListBox.GetValue(),
                                        Status: ProductSearchStatusListBox.GetValue(),
                                        StatusID: ProductSearchWebStatusListBox.GetValue(),
                                        StockStatusID: ProductSearchStockStatusListBox.GetValue(),
                                        CollectionID: ProductSearchCollectionListBox.GetValue(),
                                        ColourID: ProductSearchColourListBox.GetValue(),
                                        SearchString: SearchText,
                                        ProductPageAssociation: ProductSearchAssociatedListBox.GetValue(),
                                        PriceListID: ProductSearchPriceListListBox.GetValue()
                                    },
                                    success: function(data) {
                                        $('#product-data-view-container').html(data);
                                        $('#product-searching-icon').fadeOut('slow');
                                    },
                                    error: function(e, s, a) {
                                        $('#product-searching-icon').fadeOut('slow');
                                        alert(e.responseText);
                                    },
                                    timeout: 60000
                                });
                            }

                        }";
                    }
                    else if (action == "ProductPageSearchStatusDropDownPartial")
                    {
                        buttonSettings.Name = "ProductPageSearchStatusButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                            ProductPageSearchStatusListBox.UnselectAll();
                            ProductPageSearchStatusDD.HideDropDown(); 
                            ProductPageSearchStatusDD.SetText('Status');
                            $('#product-page-searching-icon').fadeIn('fast');
                            $.ajax({
	                            url: '" + Url.Action("ProductPageSearch", "ProductPages") + @"',
	                            traditional: true,
	                            data: {
		                            ProductTypeID: ProductPageSearchProductTypeListBox.GetValue(),
		                            BrandID: ProductPageSearchBrandListBox.GetValue(),
		                            LaunchID: ProductPageSearchLaunchListBox.GetValue(),
		                            CollectionID: ProductPageSearchCollectionListBox.GetValue(),
		                            PatternID: ProductPageSearchPatternListBox.GetValue(),
		                            ColourID: ProductPageSearchColourListBox.GetValue(),
		                            StatusID: ProductPageSearchStatusListBox.GetValue(),
                                    TemplateID: ProductPageSearchTemplateListBox.GetValue(),
		                            SearchString: ProductPageSearchNameTextBox.GetValue()
	                            },
	                            success: function(data) {
		                            $('#product-page-searching-icon').fadeOut('fast');
		                            $('#product-page-data-view-container').html(data);
	                            },
	                            error: function(e, s, a) { 
		                            $('#product-page-searching-icon').fadeOut('fast');
		                            alert(e.responseText);
	                            },
	                            timeout: 60000
                            });
                        }";
                    }
                    else if (action == "ComposeProductPageHeaderWebStatusDropDownPartial")
                    {
                        buttonSettings.Name = "ComposeProductPageHeaderWebStatusButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            ComposeProductPageHeaderWebStatusDD.HideDropDown();
                            ComposeProductPageHeaderWebStatusListBox.UnselectAll();
                            ComposeProductPageHeaderWebStatusDD.SetText('Web Status');
                            $('#product-page-header-searching-icon').fadeIn('fast');
                            $.ajax({
	                            url: '" + Url.Action("ComposeProductPageHeader", "ProductPages") + @"',
                                type: 'POST',
	                            traditional: true,
	                            data: {
		                            ProductTypeID: ComposeProductPageHeaderProductTypeListBox.GetValue(),
		                            BrandID: ComposeProductPageHeaderBrandListBox.GetValue(),
		                            LaunchID: ComposeProductPageHeaderLaunchListBox.GetValue(),
		                            WebStatusID: ComposeProductPageHeaderWebStatusListBox.GetValue(),
		                            TemplateID: ComposeProductPageHeaderTemplateListBox.GetValue()
	                            },
	                            success: function(data) {
		                            $('#product-page-header-searching-icon').fadeOut('fast');
		                            $('#product-select-header-container').html(data);
	                            },
	                            error: function(e, s, a) { 
		                            $('#product-page-header-searching-icon').fadeOut('fast');
		                            alert(e.responseText);
	                            },
	                            timeout: 60000
                            });
                        }";
                    }
                    else if (action == "AttributeHeaderWebStatusDropDownPartial")
                    {
                        buttonSettings.Name = "AttributeHeaderWebStatusButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            AttributeWebStatusListBox.UnselectAll();
                            AttributeWebStatusDD.HideDropDown();
                            AttributeWebStatusDD.SetText('Product Type');
                            $('#attribute-product-page-select-busy').fadeIn('fast');
                            $.ajax({
                                url: '" + Url.Action("ProductPageAttributeHeader", "ProductPages") + @"',
                                type: 'POST',
                                traditional: true,
                                data: {
                                    ProductTypeID: AttributeProductTypeListBox.GetValue(),
                                    BrandID: AttributeBrandListBox.GetValue(),
                                    LaunchID: AttributeLaunchListBox.GetValue(),
                                    WebStatusID: AttributeWebStatusListBox.GetValue(),
                                    TemplateID: AttributeTemplateListBox.GetValue()
                                },
                                success: function(data) {
                                    $('#attribute-filter-header').html(data);
                                    AttributeProductPageListBox.PerformCallback();
                                },
                                error: function(e, s, a) { 
                                    $('#attribute-product-page-select-busy').fadeOut('fast');
                                    alert(e.responseText);
                                },
                                timeout: 60000
                            });
                        }";
                    }
                    else if (action == "ComposeBannerHeaderWebStatusDropDownPartial")
                    {
                        buttonSettings.Name = "ComposeBannerHeaderStatusButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            ComposeBannerHeaderWebStatusListBox.UnselectAll();
                            ComposeBannerHeaderWebStatusDD.HideDropDown();
                            ComposeBannerHeaderWebStatusDD.SetText('Language');
                            $('#banner-select-header-busy').fadeIn('fast');
                            $.ajax({ 
                                url: '" + Url.Action("ComposeBannerHeaderBannerDropDownPartial", "Banners") + @"',
                                type: 'POST',
                                traditional: true,
                                data: {
                                    SelectedBannerID: $('#banner-compose-section').data('banner-id'),
                                    SelectedBannerLocationID: ComposeBannerHeaderLocationListBox.GetValue(),
                                    SelectedSiteSectionID: ComposeBannerHeaderSiteSectionListBox.GetValue(), 
                                    SelectedCountryID: ComposeBannerHeaderCountryListBox.GetValue(), 
                                    SelectedLanguageID: ComposeBannerHeaderLanguageListBox.GetValue(),
                                    SelectedStatusID: ComposeBannerHeaderWebStatusListBox.GetValue()
                                },
                                success: function(data) { 
                                    $('#banner-select-header-busy').fadeOut('fast');
                                    $('#banner-header-banner-drop-down-container').html(data);
                                },
                                error: function(e, s, a) {
                                    $('#banner-select-header-busy').fadeOut('fast');
                                    alert(e.responseText);
                                },
                                timeout: 60000
                            });   
                        }";
                    }
                    else if (action == "TranslateProductPageHeaderWebStatusDropDown")
                    {
                        buttonSettings.Name = "TranslateProductPageHeaderWebStatusButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            TranslateProductPageHeaderWebStatusListBox.UnselectAll();
                            TranslateProductPageHeaderWebStatusDD.HideDropDown();
                            TranslateProductPageHeaderWebStatusDD.SetText('Web Status');
                            var TargetLanguageID = null;
                            if(typeof(TranslationTargetLanguageListBox) != 'undefined' && typeof(TranslationTargetLanguageListBox) != false)
                                TargetLanguageID = TranslationTargetLanguageListBox.GetValue();
                            $('#translate-product-page-header-searching-icon').fadeIn('fast');
                            $.ajax({
	                            url: '" + Url.Action("TranslateProductPageHeader", "Translations") + @"',
	                            type: 'POST',
	                            traditional: true,
	                            data: { 
		                            ProductTypeID: TranslateProductPageHeaderProductTypeListBox.GetValue(),
		                            BrandID: TranslateProductPageHeaderBrandListBox.GetValue(),
		                            LaunchID: TranslateProductPageHeaderLaunchListBox.GetValue(),
		                            TemplateID: TranslateProductPageHeaderTemplateListBox.GetValue(),
		                            WebStatusID: TranslateProductPageHeaderWebStatusListBox.GetValue(),
		                            TranslationStatusID: TranslateProductPageHeaderTranslationStatusListBox.GetValue(),
                                    TargetLanguageID: TargetLanguageID
	                            },
	                            success: function(data) { 
		                            $('#translate-product-page-header-searching-icon').fadeOut('fast');
		                            $('#translate-product-page-header-container').html(data);
                
                                    $('#default-fieldset').slideUp('fast');
                                    $('#translation-fieldset').slideUp('fast');
	                            },
	                            error: function(e, s, a) { 
		                            $('#translate-product-page-header-searching-icon').fadeOut('fast');
		                            alert(e.responseText);
	                            },
	                            timeout: 60000
                            });
                        }";
                    }
                    else if (action == "TranslateCollectionHeaderWebStatusDropDown")
                    {
                        buttonSettings.Name = "TranslateCollectionHeaderWebStatusButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            TranslateCollectionHeaderWebStatusListBox.UnselectAll();
                            TranslateCollectionHeaderWebStatusDD.HideDropDown();
                            var TargetLanguageID = null;
                            if(typeof(TranslationTargetLanguageListBox) != 'undefined' && typeof(TranslationTargetLanguageListBox) != false)
                                TargetLanguageID = TranslationTargetLanguageListBox.GetValue();
                            TranslateCollectionHeaderWebStatusDD.SetText('Product Type');
                            $('#translate-collection-header-searching-icon').fadeIn('fast');
                            $.ajax({
	                            url: '" + Url.Action("TranslateCollectionHeader", "Translations") + @"',
	                            type: 'POST',
	                            traditional: true,
	                            data: { 
		                            ProductTypeID: TranslateCollectionHeaderProductTypeListBox.GetValue(),
		                            BrandID: TranslateCollectionHeaderBrandListBox.GetValue(),
		                            LaunchID: TranslateCollectionHeaderLaunchListBox.GetValue(),
		                            WebStatusID: TranslateCollectionHeaderWebStatusListBox.GetValue(),
		                            TranslationStatusID: TranslateCollectionHeaderTranslationStatusListBox.GetValue(),
                                    TargetLanguageID: TargetLanguageID
	                            },
	                            success: function(data) { 
		                            $('#translate-collection-header-searching-icon').fadeOut('fast');
		                            $('#translate-collection-header-container').html(data);
	                            },
	                            error: function(e, s, a) { 
		                            $('#translate-collection-header-searching-icon').fadeOut('fast');
		                            alert(e.responseText);
	                            },
	                            timeout: 60000
                            });
                        }";
                    }
                    else if (action == "TranslatePageHeaderWebStatusDropDown")
                    {
                        buttonSettings.Name = "TranslatePageHeaderWebStatusButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            TranslatePageHeaderWebStatusListBox.UnselectAll();
                            TranslatePageHeaderWebStatusDD.HideDropDown();
                            TranslatePageHeaderWebStatusDD.SetText('Web Status');
                            $.ajax({
	                            url: '" + Url.Action("TranslatePageHeaderPageDropDown", "Translations") + @"',
	                            type: 'POST',
	                            traditional: true,
	                            data: {
	                                SelectedPageID: TranslateHeaderContentListBox.GetValue(),
	                                SelectedSiteSectionID: TranslatePageHeaderSiteSectionListBox.GetValue(),
	                                SelectedParentPageID: TranslatePageHeaderParentPageListBox.GetValue(),
	                                SelectedWebStatusID: TranslatePageHeaderWebStatusListBox.GetValue(),
	                                SelectedTranslationStatusID: TranslatePageHeaderTranslationStatusListBox.GetValue(),
                                    TranslationTargetLanguageID: TranslationTargetLanguageListBox.GetValue()
	                            },
	                            success: function(data) { 
	                                $('#translate-page-page-drop-down-container').html(data);
	                            },
	                            error: function(e, s, a) { 
	                                alert(e.responseText);
	                            },
	                            timeout: 60000
                                });
                            }";
                    }
                    else if (action == "ProductPage_StatusDropDown")
                    {
                        buttonSettings.Name = "RelatedProductPagePrimaryStatusButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            RelatedProductPagePrimaryStatusListBox.UnselectAll();
                            RelatedProductPagePrimaryStatusDD.SetText('Web Status');
                            RelatedProductPagePrimaryStatusDD.HideDropDown();
                            LoadingPanel.Show();
                                                            
                            var rpppnid = RelatedProductPagePrimaryNameOrIDTextBox.GetValue();

                            if (rpppnid == 'Name, Code or ID')
                                rpppnid = null;

                            LoadingPanel.Show();
                            $.ajax({ 
                                url: '" + @Url.Action("RelatedProductPagePartial", "RelatedProductPages") + @"',
                                type: 'POST',
                                traditional: true,
                                data: { 
                                    PP_NameOrID: rpppnid,
                                    PP_ProductTypeID: RelatedProductPagePrimaryProductTypeListBox.GetValue(),
                                    PP_CollectionID: RelatedProductPagePrimaryCollectionListBox.GetValue(),
                                    PP_BrandID: RelatedProductPagePrimaryBrandListBox.GetValue(),
                                    PP_LaunchID: RelatedProductPagePrimaryLaunchListBox.GetValue(),
                                    PP_TemplateID: RelatedProductPagePrimaryTemplateListBox.GetValue(),
                                    PP_StatusID: RelatedProductPagePrimaryStatusListBox.GetValue(),
                                    RPP_ProductTypeID: RelatedProductPageSecondaryProductTypeListBox.GetValue(),
                                    RPP_CollectionID: RelatedProductPageSecondaryCollectionListBox.GetValue(),
                                    RPP_BrandID: RelatedProductPageSecondaryBrandListBox.GetValue(),
                                    RPP_LaunchID: RelatedProductPageSecondaryLaunchListBox.GetValue(),
                                    RPP_TemplateID: RelatedProductPageSecondaryTemplateListBox.GetValue(),
                                    RPP_StatusID: RelatedProductPageSecondaryStatusListBox.GetValue(),
                                    RPP_Count: RelatedProductPageCount.GetValue(),
                                    RPP_CountOperator: RelatedProductPageCountOperator.GetValue(),
                                    PageLimit: PageLimit.GetValue(),
                                    PageOffset: $('#current-page').val()
                                },
                                success: function(data) { 
                                    $('#ajax-target').html(data);
                                    LoadingPanel.Hide();
                                },
                                error: function(e, s, a) {
                                    LoadingPanel.Hide(); 
                                    alert(s + ' error: e.responseText was: ' + e.responseText);
                                    //log e
                                },
                                timeout: 30000
                            });
                        }";
                    }
                    else if (action == "RelatedProductPage_StatusDropDown")
                    {
                        buttonSettings.Name = "RelatedProductPageSecondaryStatusButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            RelatedProductPageSecondaryStatusListBox.UnselectAll();
                            RelatedProductPageSecondaryStatusDD.SetText('Web Status');
                            RelatedProductPageSecondaryStatusDD.HideDropDown();
                            LoadingPanel.Show();
                                                            
                            var rpppnid = RelatedProductPagePrimaryNameOrIDTextBox.GetValue();

                            if (rpppnid == 'Name, Code or ID')
                                rpppnid = null;

                            LoadingPanel.Show();
                            $.ajax({ 
                                url: '" + @Url.Action("RelatedProductPagePartial", "RelatedProductPages") + @"',
                                type: 'POST',
                                traditional: true,
                                data: { 
                                    PP_NameOrID: rpppnid,
                                    PP_ProductTypeID: RelatedProductPagePrimaryProductTypeListBox.GetValue(),
                                    PP_CollectionID: RelatedProductPagePrimaryCollectionListBox.GetValue(),
                                    PP_BrandID: RelatedProductPagePrimaryBrandListBox.GetValue(),
                                    PP_LaunchID: RelatedProductPagePrimaryLaunchListBox.GetValue(),
                                    PP_TemplateID: RelatedProductPagePrimaryTemplateListBox.GetValue(),
                                    PP_StatusID: RelatedProductPagePrimaryStatusListBox.GetValue(),
                                    RPP_ProductTypeID: RelatedProductPageSecondaryProductTypeListBox.GetValue(),
                                    RPP_CollectionID: RelatedProductPageSecondaryCollectionListBox.GetValue(),
                                    RPP_BrandID: RelatedProductPageSecondaryBrandListBox.GetValue(),
                                    RPP_LaunchID: RelatedProductPageSecondaryLaunchListBox.GetValue(),
                                    RPP_TemplateID: RelatedProductPageSecondaryTemplateListBox.GetValue(),
                                    RPP_StatusID: RelatedProductPageSecondaryStatusListBox.GetValue(),
                                    RPP_Count: RelatedProductPageCount.GetValue(),
                                    RPP_CountOperator: RelatedProductPageCountOperator.GetValue(),
                                    PageLimit: PageLimit.GetValue(),
                                    PageOffset: $('#current-page').val()
                                },
                                success: function(data) { 
                                    $('#ajax-target').html(data);
                                    LoadingPanel.Hide();
                                },
                                error: function(e, s, a) { 
                                    LoadingPanel.Hide();
                                    alert(s + ' error: e.responseText was: ' + e.responseText);
                                    //log e
                                },
                                timeout: 30000
                            });
                        }";
                    }
                    else if (action == "PageComposePageSectionWebStatusDropDown")
                    {
                        buttonSettings.Name = "PageSectionStatusButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            PageSectionWebStatusListBox.UnselectAll();
                            PageSectionWebStatusDD.HideDropDown();
                            PageSectionWebStatusDD.SetText('Status');
                            filterPageSections();
                        }";
                    }
                    else
                    {
                        buttonSettings.Name = "StatusButtonClear";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                            alert('Not Implemented');
                        }";
                    }
                    buttonSettings.Text = "Clear";
                    buttonSettings.Style.Add("float", "left");
                }
            )
            .Render();
            @Html.DevExpress().Button(
                buttonSettings =>
                {
                    if (action == "ProductSearchWebStatusDropDownPartial")
                    {
                        buttonSettings.Name = "ProductSearchWebStatusButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) {
                            ProductSearchWebStatusDD.HideDropDown();
                        }";
                    }
                    else if (action == "ProductPageSearchStatusDropDownPartial")
                    {
                        buttonSettings.Name = "ProductPageSearchStatusButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) {
                            ProductPageSearchStatusDD.HideDropDown();
                        }";
                    }
                    else if (action == "ComposeProductPageHeaderWebStatusDropDownPartial")
                    {
                        buttonSettings.Name = "ComposeProductPageHeaderWebStatusButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            ComposeProductPageHeaderWebStatusDD.HideDropDown();
                        }";
                    }
                    else if (action == "ComposeBannerHeaderWebStatusDropDownPartial")
                    {
                        buttonSettings.Name = "ComposeBannerHeaderWebStatusButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            ComposeBannerHeaderWebStatusDD.HideDropDown();
                        }";
                    }
                    else if (action == "TranslateProductPageHeaderWebStatusDropDown")
                    {
                        buttonSettings.Name = "TranslateProductPageHeaderWebStatusButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            TranslateProductPageHeaderWebStatusDD.HideDropDown();
                        }";
                    }
                    else if (action == "TranslateCollectionHeaderWebStatusDropDown")
                    {
                        buttonSettings.Name = "TranslateCollectionHeaderWebStatusButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            TranslateCollectionHeaderWebStatusDD.HideDropDown();
                        }";
                    }
                    else if (action == "TranslatePageHeaderWebStatusDropDown")
                    {
                        buttonSettings.Name = "TranslatePageHeaderWebStatusButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            TranslatePageHeaderWebStatusDD.HideDropDown();
                        }";
                    }
                    else if (action == "AttributeHeaderWebStatusDropDownPartial")
                    {
                        buttonSettings.Name = "AttributeWebStatusButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            AttributeWebStatusDD.HideDropDown();
                        }";
                    }
                    else if (action == "ProductPage_StatusDropDown")
                    {
                        buttonSettings.Name = "RelatedProductPagePrimaryStatusButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            RelatedProductPagePrimaryStatusDD.HideDropDown();
                        }";
                    }
                    else if (action == "RelatedProductPage_StatusDropDown")
                    {
                        buttonSettings.Name = "RelatedProductPageSecondaryStatusButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            RelatedProductPagePrimaryStatusDD.HideDropDown();
                        }";
                    }
                    else if (action == "PageComposePageSectionWebStatusDropDown")
                    {
                        buttonSettings.Name = "PageSectionStatusButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function (s, e) { 
                            PageSectionWebStatusDD.HideDropDown();
                        }";
                    }
                    else
                    {
                        buttonSettings.Name = "WebStatusButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) {
                            alert('Not Implemented.');
                        }";
                    }
                    buttonSettings.Text = "Close";
                    buttonSettings.Style.Add("float", "right");
                }
            )
            .Render();
            ViewContext.Writer.Write("<div style='clear: both;'></div></div>");
        });
        settings.Properties.AnimationType = AnimationType.None;
    }
).GetHtml()