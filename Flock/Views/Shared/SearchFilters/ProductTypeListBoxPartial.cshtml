                $.ajax({
                    url: '" + Url.Action("AttributeGroupsPartial", "ProductPages") + @"',
                    type: 'POST',
                    traditional: true,
                    data: { 
                        ID: $('#selected-product-page-id').val(), 
                        ProductTypeID: AttributeDetailProductTypeListBox.GetValue()
                    },
                    success: function(data) { 
                        $('#attribute-header-busy-icon').fadeOut('fast');
                        $('#attribute-groups-container').html(data);

                        if(window.Suggestions) {
                            $('#attribute-groups-container input').parent().css('background-color', 'white');
                            AttributeDetailBrandListBox.SetSelectedItem(AttributeDetailBrandListBox.FindItemByValue(window.Suggestions.BrandID));
                            AttributeDetailBrandDD.SetText(AttributeDetailBrandListBox.GetSelectedItem().text);

                            AttributeDetailLaunchListBox.SetSelectedItem(AttributeDetailLaunchListBox.FindItemByValue(window.Suggestions.LaunchID));
                            AttributeDetailLaunchDD.SetText(AttributeDetailLaunchListBox.GetSelectedItem().text);
                
                            $('#attribute-groups-container input:checked').removeAttr('checked');

                            for (var i = 0; i < window.Suggestions.Attributes.Data.length; i++) {
                                $('input[data-attribute-id='+window.Suggestions.Attributes.Data[i].AttributeID+']').prop('checked', true);
                                $('input[data-attribute-id='+window.Suggestions.Attributes.Data[i].AttributeID+']').parent().css('background-color', '#FEE998');
                            }
                            $('#attribute-header-busy-icon').fadeOut('fast');
                            window.Suggestions = null;
                        }
                    },
