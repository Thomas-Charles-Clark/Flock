            CollectionComposeHeaderProductTypeDD.HideDropDown();
            CollectionComposeHeaderProductTypeDD.SetText(s.GetSelectedItem().text);

            var url = '" + @Url.Action("productassociation", "collections", new { id = "-1", ProductTypeid = "-2", brandid = "-3", launchid = "-4" }) + @"';

            url = url.replace('-1', $('#collection-header-hidden-id').val());
            url = url.replace('-2', s.GetSelectedItem().value);
            url = url.replace('-3', CollectionComposeHeaderBrandListBox.GetValue());
            url = url.replace('-4', CollectionComposeHeaderLaunchListBox.GetValue());

            $('#product-association-anchor').attr('href', url);


            $.ajax({
                url: '" + Url.Action("CollectionComposeHeaderCollectionDropDownPartial", "Collections") + @"',
                traditional: true,
                data: {
                    CollectionID: $('#collection-header-hidden-id').val(),
                    ProductTypeID: CollectionComposeHeaderProductTypeListBox.GetValue(),
                    BrandID: CollectionComposeHeaderBrandListBox.GetValue(),
                    LaunchID: CollectionComposeHeaderLaunchListBox.GetValue()
                },
