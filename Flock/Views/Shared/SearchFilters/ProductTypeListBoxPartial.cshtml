                        BrandID: ProductSearchBrandListBox.GetValue(),
                        LaunchID: ProductSearchLaunchListBox.GetValue(),
                        PatternID: ProductSearchPatternListBox.GetValue(),
                        Status: ProductSearchStatusListBox.GetValue(),
                        StatusID: ProductSearchWebStatusListBox.GetValue(),
                        StockStatusID: ProductSearchStockStatusListBox.GetValue(),
                        CollectionID: ProductSearchCollectionListBox.GetValue(),
                        ColourID: ProductSearchColourListBox.GetValue(),
                        SearchString: SearchText,
                        ProductPageAssociation: ProductSearchAssociatedListBox.GetValue(),
