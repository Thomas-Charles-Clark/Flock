                    $('#collection-drop-down-container').html(data);
                },
                error: function(e, s, a) { 
                    alert(e.responseText);
                },
                timeout: 60000
            });
        }";

        listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) { 
            s.SetSelectedItem(s.FindItemByValue(" + ViewBag.CollectionHeaderSelectedProductTypeID + @"));
            if(s.GetSelectedItem() != null && s.GetSelectedItem() != false)
                CollectionComposeHeaderProductTypeDD.SetText(s.GetSelectedItem().text);
        }";
    }
