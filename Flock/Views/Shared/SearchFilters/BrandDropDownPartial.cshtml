		                                $.showError(e, s, a, function() { $('#product-page-searching-icon').fadeOut('fast'); });
	                                },
	                                timeout: 60000
                                });
                            }";
                        }
                        else if (action == "ComposeProductPageHeaderBrandDropDownPartial")
