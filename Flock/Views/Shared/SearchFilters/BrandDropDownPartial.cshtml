                                    },
                                    error: function(e, s, a) { 
                                        $.showError(e, s, a, function() { $('#product-page-header-searching-icon').fadeOut('fast'); });
                                    },
                                    timeout: 60000
                                });
                            }";
                        }
                        else if (action == "AttributeHeaderBrandDropDownPartial")
                        {
                            buttonSettings.Name = "AttributeHeaderBrandButtonClear";
                            buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                                AttributeBrandListBox.UnselectAll();
                                AttributeBrandDD.HideDropDown();
                                AttributeBrandDD.SetText('Product Type');
                                $('#attribute-product-page-select-busy').fadeIn('fast');
