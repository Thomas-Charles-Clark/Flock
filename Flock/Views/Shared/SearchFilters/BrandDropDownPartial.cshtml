@{
    Layout = null;
}
@model List<Flock.Models.Brand>
@Html.DevExpress().DropDownEdit(
    settings =>
    {
        settings.Style.Add("float", "left");
        settings.Style.Add("margin", "0 7px 7px 0");

        settings.Width = System.Web.UI.WebControls.Unit.Pixel(200);
        settings.Height = System.Web.UI.WebControls.Unit.Pixel(35);
        string action = ViewContext.Controller.ValueProvider.GetValue("action").AttemptedValue;

        if (action == "ImageSearchBrandDropDownPartial")
            settings.Name = "ImageSearchBrandDD";
        else if (action == "CollectionSearchBrandDropDownPartial")
            settings.Name = "CollectionBrandDD";
        else if (action == "ProductSearchBrandDropDownPartial")
            settings.Name = "ProductSearchBrandDD";
        else if (action == "CollectionComposeHeaderBrandDropDownPartial")
        {
            settings.Name = "CollectionComposeHeaderBrandDD";
            settings.Style.Remove("margin");
            settings.Style.Add("margin", "0px 7px 0px 0px");
        }
        else if (action == "ProductAssociationHeaderBrandDropDownPartial")
        {
            settings.Name = "ProductAssociationHeaderBrandDD";
            settings.Style.Remove("margin");
            settings.Style.Add("margin", "0px 7px 0px 0px");
        }
        else if (action == "CollectionOverviewBrandDropDownPartial")
        {
            settings.Name = "CollectionOverviewBrandDD";
            settings.Style.Remove("margin");
        }
        else if (action == "ProductPageSearchBrandDropDownPartial")
        {
            settings.Name = "ProductPageSearchBrandDD";
        }
        else if (action == "ComposeProductPageHeaderBrandDropDownPartial")
        {
            settings.Name = "ComposeProductPageHeaderBrandDD";
            settings.Width = System.Web.UI.WebControls.Unit.Pixel(175);
        }
        else if (action == "ProductPageComposeBrandDropDownPartial")
        {
            settings.Name = "ProductPageComposeBrandDD";
        }
        else if (action == "TranslateProductPageHeaderBrandDropDown")
        {
            settings.Name = "TranslateProductPageHeaderBrandDD";
            settings.Width = 180;
        }
        else if (action == "TranslateCollectionHeaderBrandDropDown")
        {
            settings.Name = "TranslateCollectionHeaderBrandDD";
            settings.Width = 180;
        }
        else if (action == "BrochureDetailsBrandDropDownPartial")
        {
            settings.Name = "BrochureDetailsBrandDD";
        }
        else if (action == "AttributeBrandDropDown")
        {
            settings.Name = "AttributeDetailBrandDD";
        }
        else if (action == "AttributeHeaderBrandDropDownPartial")
        {
            settings.Name = "AttributeBrandDD";
            settings.Style.Remove("margin");
            settings.Style.Add("margin", "0px 7px 0px 0px");
            settings.Width = 175;
        }
        else if (action == "ProductPage_BrandDropDown")
        {
            settings.Name = "RelatedProductPagePrimaryBrandDD";
        }
        else if (action == "RelatedProductPage_BrandDropDown")
        {
            settings.Name = "RelatedProductPageSecondaryBrandDD";
        }
        else if (action == "VideoSearchBrandDropDownPartial")
        {
            settings.Name = "VideoSearchBrandDD";
        }
        else if (action == "SalePricesBrandDropDownPartial")
        {
            settings.Name = "SalePricesBrandDD";
        }

        settings.Text = "Brand";
        settings.Properties.DropDownWindowStyle.BackColor = System.Drawing.Color.FromArgb(0xEDEDED);


        settings.Properties.EnableClientSideAPI = true;

        settings.SetDropDownWindowTemplateContent(c =>
        {
            ViewContext.Writer.Write("<div id='brand-listbox'>");
            ViewContext.Writer.Write(@Html.Partial("~/Views/Shared/SearchFilters/BrandListBoxPartial.cshtml", Model));
            ViewContext.Writer.Write("</div>");
            ViewContext.Writer.Write("<div style=\"padding: 6px;\">");
            if (action != "CollectionOverviewBrandDropDownPartial" && action != "ProductPageComposeBrandDropDownPartial" && action != "BrochureDetailsBrandDropDownPartial" && action != "AttributeBrandDropDown")
            {
                @Html.DevExpress().Button(
                    buttonSettings =>
                    {
                        if (action == "ImageSearchBrandDropDownPartial")
                        {
                            buttonSettings.Name = "ImageSearchBrandButtonClear";
                            buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                                ImageSearchBrandListBox.UnselectAll();
                                ImageSearchBrandDD.HideDropDown(); 
                                ImageSearchBrandDD.SetText('Brand');
                                $('#image-searching-icon').fadeIn('fast');
                                $.ajax({
                                    url: '" + Url.Action("ImageSearch", "Images") + @"',
                                    traditional: true,
                                    data: { 
                                        ProductType: ImageSearchProductTypeListBox.GetValue(),
                                        Brand: ImageSearchBrandListBox.GetValue(),
                                        Launch: ImageSearchLaunchListBox.GetValue(),
                                        Collection: ImageSearchCollectionListBox.GetValue(),
                                        AspectRatio: ImageSearchAspectRatioListBox.GetValue(),
                                        ImageType: ImageSearchImageTypeListBox.GetValue(),
                                        Perspective: ImageSearchPerspectiveListBox.GetValue(),
                                        HotspotStatus: ImageSearchHotspotStatusListBox.GetValue(),
                                        Colour: ImageSearchColourListBox.GetValue(),
                                        Room: ImageSearchRoomListBox.GetValue(),
                                        Style: ImageSearchStyleListBox.GetValue(),
                                        NameOrID: ImageSearchNameOrIDTextBox.GetValue(),
                                        SearchWithinHotspots: SearchWithinHotspotsCheckbox.GetValue(),
                                        Resolution: ResolutionListBox.GetValue()
                                    },
                                    success: function(data) {
                                        $('#image-data-view-container').html(data);
                                        $('#image-searching-icon').fadeOut('slow');
                                    },
                                    error: function(e, s, a) {
                                        $.showError(e, s, a, function() { $('#image-searching-icon').fadeOut('slow'); });
                                    },
                                    timeout: 60000
                                });
                            }";
                        }
                        else if (action == "VideoSearchBrandDropDownPartial")
                        {
                            buttonSettings.Name = "VideoSeachBrandButtonClear";
                            buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                                VideoSearchBrandListBox.UnselectAll();
                                VideoSearchBrandDD.HideDropDown(); 
                                VideoSearchBrandDD.SetText('Brand');
                                $('#video-searching-icon').fadeIn('fast');
                                PerformVideoSearch();
                            }";
                        }
                        else if (action == "CollectionSearchBrandDropDownPartial")
                        {
                            buttonSettings.Name = "CollectionBrandButtonClear";
                            buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                                CollectionBrandListBox.UnselectAll();
                                CollectionBrandDD.HideDropDown(); 
                                CollectionBrandDD.SetText('Brand');
                                $('#collection-searching-icon').fadeIn('fast');
                                $.ajax({
                                    url: '" + Url.Action("CollectionSearch", "Collections") + @"',
                                    traditional: true,
                                    data: { 
                                        ProductType: CollectionProductTypeListBox.GetValue(),
                                        Brand: CollectionBrandListBox.GetValue(),
                                        Launch: CollectionLaunchListBox.GetValue(),
                                        NameOrID: CollectionNameOrIDTextBox.GetValue()
                                    },
                                    success: function(data) {
                                        $('#collection-data-view-container').html(data);
                                        $('#collection-searching-icon').fadeOut('slow');
                                    },
                                    error: function(e, s, a) {
                                        $.showError(e, s, a, function() { $('#collection-searching-icon').fadeOut('slow'); });
                                    },
                                    timeout: 60000
                                });
                            }";
                        }
                        else if (action == "ProductSearchBrandDropDownPartial")
