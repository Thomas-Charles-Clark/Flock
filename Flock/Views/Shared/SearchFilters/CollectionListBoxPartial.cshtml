@model List<Flock.Models.Collection>
           
@Html.DevExpress().ListBox(
listBoxSettings =>
{
    string action = ViewContext.Controller.ValueProvider.GetValue("action").AttemptedValue;

    listBoxSettings.ControlStyle.Border.BorderWidth = 0;
    listBoxSettings.ControlStyle.BorderBottom.BorderWidth = 1;
    listBoxSettings.ControlStyle.BorderBottom.BorderColor = System.Drawing.Color.FromArgb(0xDCDCDC);
    listBoxSettings.Width = System.Web.UI.WebControls.Unit.Percentage(100);

    listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.Single;

    if (action == "ProductSearchCollectionDropDownPartial")
    {
        listBoxSettings.Name = "ProductSearchCollectionListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            $('#product-searching-icon').fadeIn('fast');
            ProductSearchCollectionDD.SetText(s.GetSelectedItem().text);
            ProductSearchCollectionDD.HideDropDown();
            $('#product-searching-icon').fadeIn('fast');
            var SearchText = ProductSearchNameOrIDTextBox.GetText();
            $.ajax({
                url: '" + Url.Action("ProductSearch", "Products") + @"',
                traditional: true,
                data: { 
                    ProductTypeID: ProductSearchProductTypeListBox.GetValue(),
                    BrandID: ProductSearchBrandListBox.GetValue(),
                    LaunchID: ProductSearchLaunchListBox.GetValue(),
                    PatternID: ProductSearchPatternListBox.GetValue(),
                    Status: ProductSearchStatusListBox.GetValue(),
                    StatusID: ProductSearchWebStatusListBox.GetValue(),
                    StockStatusID: ProductSearchStockStatusListBox.GetValue(),
                    CollectionID: ProductSearchCollectionListBox.GetValue(),
                    ColourID: ProductSearchColourListBox.GetValue(),
                    SearchString: SearchText,
                    ProductPageAssociation: ProductSearchAssociatedListBox.GetValue(),
                    PriceListID: ProductSearchPriceListListBox.GetValue()
                },
                success: function(data) {
                    $('#product-data-view-container').html(data);
                    $('#product-searching-icon').fadeOut('slow');
                },
                error: function(e, s, a) {
                    $.showError(e, s, a, function() { $('#product-searching-icon').fadeOut('slow'); });
                },
                timeout: 60000
            });
        }";
    }
    else if (action == "ImageSearchCollectionDropDownPartial")
    {
        listBoxSettings.Name = "ImageSearchCollectionListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            $('#image-searching-icon').fadeIn('fast');
            ImageSearchCollectionDD.SetText(s.GetSelectedItem().text);
            ImageSearchCollectionDD.HideDropDown();
            $.ajax({
                url: '" + Url.Action("ImageSearch", "Images") + @"',
                traditional: true,
                data: { 
                    ProductType: ImageSearchProductTypeListBox.GetValue(),
                    Brand: ImageSearchBrandListBox.GetValue(),
                    Launch: ImageSearchLaunchListBox.GetValue(),
                    Collection: ImageSearchCollectionListBox.GetValue(),
                    AspectRatio: ImageSearchAspectRatioListBox.GetValue(),
                    ImageType: ImageSearchImageTypeListBox.GetValue(),
                    Perspective: ImageSearchPerspectiveListBox.GetValue(),
                    HotspotStatus: ImageSearchHotspotStatusListBox.GetValue(),
                    Colour: ImageSearchColourListBox.GetValue(),
                    Room: ImageSearchRoomListBox.GetValue(),
                    Style: ImageSearchStyleListBox.GetValue(),
                    NameOrID: ImageSearchNameOrIDTextBox.GetValue(),
                    SearchWithinHotspots: SearchWithinHotspotsCheckbox.GetValue(),
                    Resolution: ResolutionListBox.GetValue()
                },
                success: function(data) {
                    $('#image-data-view-container').html(data);
                    $('#image-searching-icon').fadeOut('slow');
                },
                error: function(e, s, a) {
                    $.showError(e, s, a, function() { $('#image-searching-icon').fadeOut('slow'); });
                },
                timeout: 60000
            });
        }";
    }
    else if (action == "CollectionComposeHeaderCollectionDropDownPartial")
    {
        listBoxSettings.Name = "CollectionComposeHeaderCollectionListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            CollectionComposeHeaderCollectionDD.HideDropDown();
            CollectionComposeHeaderCollectionDD.SetText(s.GetSelectedItem().text);
            var url = '" + @Url.Action("compose", "collections", new { id = "-1", ProductTypeid = "-2", brandid = "-3", launchid = "-4" }) + @"';
            url = url.replace('-1', s.GetSelectedItem().value);
            url = url.replace('-2', CollectionComposeHeaderProductTypeListBox.GetValue());
            url = url.replace('-3', CollectionComposeHeaderBrandListBox.GetValue());
            url = url.replace('-4', CollectionComposeHeaderLaunchListBox.GetValue());
            window.location.href = url;
        }";
        
        listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) { 
            s.SetSelectedItem(s.FindItemByValue(" + ViewBag.CollectionComposeHeaderSelectedCollectionID + @"));
            if(s.GetSelectedItem() != null && s.GetSelectedItem() != false)
                CollectionComposeHeaderCollectionDD.SetText(s.GetSelectedItem().text);
        }";
    }
    else if (action == "ProductAssociationHeaderCollectionDropDownPartial")
    {
        listBoxSettings.Name = "ProductAssociationHeaderCollectionListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) { 
            ProductAssociationHeaderCollectionDD.HideDropDown();
            ProductAssociationHeaderCollectionDD.SetText(s.GetSelectedItem().text);

            var url = '" + @Url.Action("compose", "collections", new { id = "-1", ProductTypeid = "-2", brandid = "-3", launchid = "-4" }) + @"';

            url = url.replace('-1', s.GetSelectedItem().value);
            url = url.replace('-2', ProductAssociationHeaderProductTypeListBox.GetValue());
            url = url.replace('-3', ProductAssociationHeaderBrandListBox.GetValue());
            url = url.replace('-4', ProductAssociationHeaderLaunchListBox.GetValue());

            $('#collection-compose-anchor').attr('href', url);

            $.ajax({ 
                url: '" + Url.Action("CollectionContents", "Collections") + @"',
                type: 'POST',
                traditional: true,
                data: { CollectionID: s.GetSelectedItem().value },
                success: function(data) {
                    $('#collection-contents').html(data);    
                },
                error: function(e, s, a) { 
                    $.showError(e, s, a);
                },
                timeout: 60000
            });
        }";
        
        listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) { 
            s.SetSelectedItem(s.FindItemByValue(" + ViewBag.ProductAssociationHeaderSelectedCollectionID + @"));
            if(s.GetSelectedItem() != null && s.GetSelectedItem() != false)
                ProductAssociationHeaderCollectionDD.SetText(s.GetSelectedItem().text);
        }";
    }
    else if (action == "ProductPageSearchCollectionDropDownPartial")
    {
        listBoxSettings.Name = "ProductPageSearchCollectionListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            $('#product-page-searching-icon').fadeIn('fast');
            ProductPageSearchCollectionDD.SetText(s.GetSelectedItem().text);
            ProductPageSearchCollectionDD.HideDropDown();
            $.ajax({
	            url: '" + Url.Action("ProductPageSearch", "ProductPages") + @"',
	            traditional: true,
	            data: {
		            ProductTypeID: ProductPageSearchProductTypeListBox.GetValue(),
		            BrandID: ProductPageSearchBrandListBox.GetValue(),
		            LaunchID: ProductPageSearchLaunchListBox.GetValue(),
		            CollectionID: ProductPageSearchCollectionListBox.GetValue(),
		            PatternID: ProductPageSearchPatternListBox.GetValue(),
		            ColourID: ProductPageSearchColourListBox.GetValue(),
                    StatusID: ProductPageSearchStatusListBox.GetValue(),
                    TemplateID: ProductPageSearchTemplateListBox.GetValue(),
		            SearchString: ProductPageSearchNameTextBox.GetValue()
	            },
	            success: function(data) {
		            $('#product-page-searching-icon').fadeOut('fast');
		            $('#product-page-data-view-container').html(data);
	            },
	            error: function(e, s, a) { 
		            $.showError(e, s, a, function() { $('#product-page-searching-icon').fadeOut('fast'); });
	            },
	            timeout: 60000
            });
        }";
    }
    else if (action == "ProductImagesOverviewCollectionDropDownPartial")
    {
        listBoxSettings.Name = "ProductImagesOverviewCollectionCheckComboBox";
        listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.CheckColumn;

        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) { 
            ProductImagesOverviewCollectionDD.HideDropDown();
            var items = s.GetSelectedItems();
            var text = 'Collections';
            if(items.length > 1)
                text = '(' + items.length.toString() + ' Collections Selected)';
            else if(items.length == 1)
                text = items[0].text;    
            ProductImagesOverviewCollectionDD.SetText(text);
            ProductImagesOverviewGridView.Refresh();
        }";
    }
    else if (action == "ProductPagesOverviewCollectionDropDownPartial")
    {
        listBoxSettings.Height = 300;
        listBoxSettings.Name = "ProductPagesOverviewCollectionListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) { 
            ProductPagesOverviewCollectionDD.HideDropDown();
            ProductPagesOverviewCollectionDD.SetText(s.GetSelectedItem().text);
            ProductPagesOverviewGridView.Refresh();
        }";
    }
    else if (action == "QualityComposeCollectionDropDownPartial")
    {
        listBoxSettings.Name = "QualityComposeCollectionListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) { 
            QualityComposeCollectionDD.HideDropDown();
            QualityComposeCollectionDD.SetText(s.GetSelectedItem().text);
            QualityComposeGridSelector.Refresh();
        }";
    }
    else if (action == "ProductOverviewCollectionDropDownPartial")
    {
        listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.CheckColumn;
        listBoxSettings.Name = "ProductOverviewCollectionListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) { 
            ProductOverviewCollectionDD.HideDropDown();
            var items = s.GetSelectedItems();
            var text = 'Collections';
            if(items.length > 1)
                text = '(' + items.length.toString() + ' Collections Selected)';
            else if(items.length == 1)
                text = items[0].text;      
            ProductOverviewCollectionDD.SetText(text);
            ProductOverviewGridView.Refresh();
        }";
    }
    else if (action == "ProductDimensionsCollectionDropDownPartial")
    {
        listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.CheckColumn;
        listBoxSettings.Name = "ProductDimensionsCollectionListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) { 
            ProductDimensionsCollectionDD.HideDropDown();
            var items = s.GetSelectedItems();
            var text = 'Collections';
            if(items.length > 1)
                text = '(' + items.length.toString() + ' Collections Selected)';
            else if(items.length == 1)
                text = items[0].text;      
            ProductDimensionsCollectionDD.SetText(text);
            ProductDimensionsGridView.Refresh();
        }";
    }
    else if (action == "ProductReviewsCollectionDropDownPartial")
    {
        listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.Single;
        listBoxSettings.Name = "ProductReviewsCollectionListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) { 
            ProductReviewsCollectionDD.HideDropDown();
            var items = s.GetSelectedItems();
            var text = 'Collections';
            if(items.length > 1)
                text = '(' + items.length.toString() + ' Collections Selected)';
            else if(items.length == 1)
                text = items[0].text;    
            ProductReviewsCollectionDD.SetText(text);
            $.ajax({
                url: '" + Url.Action("ProductReviewsCollectionListBoxSetSessionVariable", "Reviews") + @"',
                type: 'POST',
                traditional: true,
                data: { CollectionIDs: ProductReviewsCollectionListBox.GetSelectedValues().toString() },
                success: function(data) { 
                    ProductReviewsGridView.Refresh(); 
                },
                error: function(e, s, a) { 
                    $.showError(e, s, a);
                },
                timeout: 60000
            });
        }";
    }
    else if (action == "PricesOverviewCollectionDropDownPartial")
    {
        listBoxSettings.Name = "PricesOverviewCollectionListBox";
        listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.CheckColumn;
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            PricesOverviewCollectionDD.HideDropDown();
            var items = s.GetSelectedItems();
            var text = 'Collections';
            if(items.length > 1)
                text = '(' + items.length.toString() + ' Collections Selected)';
            else if(items.length == 1)
                text = items[0].text;     
            PricesOverviewCollectionDD.SetText(text);
            ProductPricesGridView.Refresh();
        }";
    }
    else if (action == "StockOverviewCollectionDropDownPartial")
    {
        listBoxSettings.Name = "StockOverviewCollectionListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) { 
            alert('needs implementing');
        }";
    }
    else if (action == "TranslateCollectionHeaderCollectionDropDown")
    {
        listBoxSettings.Name = "TranslateHeaderContentListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            TranslateCollectionHeaderCollectionDD.SetText(s.GetSelectedItem().text);
            TranslateCollectionHeaderCollectionDD.HideDropDown();
            
            if(typeof(TranslationTargetLanguageListBox) == 'undefined' || typeof(TranslationTargetLanguageListBox) == false)
            {
                var url = '" + @Url.Action("collection", "translations", new { id = "-1", ProductTypeid = "-2", brandid = "-3", launchid = "-4", webstatusid = "-5", translationstatusid = "-6", targetlanguageid = "-7" }) + @"';
                url = url.replace('-1', s.GetSelectedItem().value);
                url = url.replace('-2', TranslateCollectionHeaderProductTypeListBox.GetValue());
                url = url.replace('-3', TranslateCollectionHeaderBrandListBox.GetValue());
                url = url.replace('-4', TranslateCollectionHeaderLaunchListBox.GetValue());
                url = url.replace('-5', TranslateCollectionHeaderWebStatusListBox.GetValue());
                url = url.replace('-6', TranslateCollectionHeaderTranslationStatusListBox.GetValue());
                window.location.href = url;
            }
            else
            {
                $.ajax({ 
                    url: '" + Url.Action("ChangeCollection", "Translations") + @"',
                    type: 'POST',
                    traditional: true,
                    data: {  
                        CollectionID: s.GetSelectedItem().value,
                        TargetLanguageID: TranslationTargetLanguageListBox.GetValue()
                    },
                    success: function(data) {
alert('offense found');                        
//$('#translate-middle-container').html(data);
                    },
                    error: function(e, s, a) { 
                        $.showError(e, s, a);   
                    },
                    timeout: 60000
                });
            }
            $('#pager-current').html(s.GetSelectedItem().index + 1);
        }";
        listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) { 
            if(s.GetItemCount() == 0) {
                $('#translate-middle-container').html('<h5 style=""display: block; margin: 0px auto 1.5em; width: 90px;"">No Results.</h5>');
                $('#pager-current').html(0);
                $('#pager-total').html(0);
            }
            else {
                s.SetSelectedItem(s.FindItemByValue(" + ViewBag.TranslateCollectionHeaderSelectedCollectionID + @"));

                if(s.GetSelectedItem() != null && s.GetSelectedItem() != false) {
                    TranslateCollectionHeaderCollectionDD.SetText(s.GetSelectedItem().text);
                    $('#pager-current').html(TranslateHeaderContentListBox.GetSelectedItem().index + 1);
                    $('#pager-total').html(TranslateHeaderContentListBox.GetItemCount().toString());
                }
            }
        }";
    }
    else if (action == "ProductPage_CollectionDropDown")
    {
        listBoxSettings.Name = "RelatedProductPagePrimaryCollectionListBox";
        listBoxSettings.Height = 300;
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) { 
            RelatedProductPagePrimaryCollectionDD.SetText(s.GetSelectedItem().text);
            RelatedProductPagePrimaryCollectionDD.HideDropDown();
            LoadingPanel.Show();
            
            var rpppnid = RelatedProductPagePrimaryNameOrIDTextBox.GetValue();

            if (rpppnid == 'Name, Code or ID')
                rpppnid = null;

            LoadingPanel.Show();
            $.ajax({ 
                url: '" + @Url.Action("RelatedProductPagePartial", "RelatedProductPages") + @"',
                type: 'POST',
                traditional: true,
                data: { 
                    PP_NameOrID: rpppnid,
                    PP_ProductTypeID: RelatedProductPagePrimaryProductTypeListBox.GetValue(),
                    PP_CollectionID: RelatedProductPagePrimaryCollectionListBox.GetValue(),
                    PP_BrandID: RelatedProductPagePrimaryBrandListBox.GetValue(),
                    PP_LaunchID: RelatedProductPagePrimaryLaunchListBox.GetValue(),
                    PP_TemplateID: RelatedProductPagePrimaryTemplateListBox.GetValue(),
                    PP_StatusID: RelatedProductPagePrimaryStatusListBox.GetValue(),
                    RPP_ProductTypeID: RelatedProductPageSecondaryProductTypeListBox.GetValue(),
                    RPP_CollectionID: RelatedProductPageSecondaryCollectionListBox.GetValue(),
                    RPP_BrandID: RelatedProductPageSecondaryBrandListBox.GetValue(),
                    RPP_LaunchID: RelatedProductPageSecondaryLaunchListBox.GetValue(),
                    RPP_TemplateID: RelatedProductPageSecondaryTemplateListBox.GetValue(),
                    RPP_StatusID: RelatedProductPageSecondaryStatusListBox.GetValue(),
                    RPP_Count: RelatedProductPageCount.GetValue(),
                    RPP_CountOperator: RelatedProductPageCountOperator.GetValue(),
                    PageLimit: PageLimit.GetValue(),
                    PageOffset: $('#current-page').val()
                },
                success: function(data) { 
                    $('#ajax-target').html(data);
                    LoadingPanel.Hide();
                },
                error: function(e, s, a) { 
                    LoadingPanel.Hide();
                    alert(s + ' error: e.responseText was: ' + e.responseText);
                    //log e
                },
                timeout: 30000
            });
        }";
    }
    else if (action == "RelatedProductPage_CollectionDropDown")
    {
        listBoxSettings.Name = "RelatedProductPageSecondaryCollectionListBox";
        listBoxSettings.Height = 300;
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) { 
            RelatedProductPageSecondaryCollectionDD.SetText(s.GetSelectedItem().text);
            RelatedProductPageSecondaryCollectionDD.HideDropDown();
            LoadingPanel.Show();
            
            var rpppnid = RelatedProductPagePrimaryNameOrIDTextBox.GetValue();

            if (rpppnid == 'Name, Code or ID')
                rpppnid = null;

            LoadingPanel.Show();
            $.ajax({ 
                url: '" + @Url.Action("RelatedProductPagePartial", "RelatedProductPages") + @"',
                type: 'POST',
                traditional: true,
                data: { 
                    PP_NameOrID: rpppnid,
                    PP_ProductTypeID: RelatedProductPagePrimaryProductTypeListBox.GetValue(),
                    PP_CollectionID: RelatedProductPagePrimaryCollectionListBox.GetValue(),
                    PP_BrandID: RelatedProductPagePrimaryBrandListBox.GetValue(),
                    PP_LaunchID: RelatedProductPagePrimaryLaunchListBox.GetValue(),
                    PP_TemplateID: RelatedProductPagePrimaryTemplateListBox.GetValue(),
                    PP_StatusID: RelatedProductPagePrimaryStatusListBox.GetValue(),
                    RPP_ProductTypeID: RelatedProductPageSecondaryProductTypeListBox.GetValue(),
                    RPP_CollectionID: RelatedProductPageSecondaryCollectionListBox.GetValue(),
                    RPP_BrandID: RelatedProductPageSecondaryBrandListBox.GetValue(),
                    RPP_LaunchID: RelatedProductPageSecondaryLaunchListBox.GetValue(),
                    RPP_TemplateID: RelatedProductPageSecondaryTemplateListBox.GetValue(),
                    RPP_StatusID: RelatedProductPageSecondaryStatusListBox.GetValue(),
                    RPP_Count: RelatedProductPageCount.GetValue(),
                    RPP_CountOperator: RelatedProductPageCountOperator.GetValue(),
                    PageLimit: PageLimit.GetValue(),
                    PageOffset: $('#current-page').val()
                },
                success: function(data) { 
                    $('#ajax-target').html(data);
                    LoadingPanel.Hide();
                },
                error: function(e, s, a) { 
                    LoadingPanel.Hide();
                    alert(s + ' error: e.responseText was: ' + e.responseText);
                    //log e
                },
                timeout: 30000
            });
        }";
    }
    listBoxSettings.Properties.TextField = "Name";
    listBoxSettings.Properties.ValueField = "CollectionID";
}
).BindList(Model).GetHtml()