@model List<Flock.Models.Page>
@Html.DevExpress().ListBox(
listBoxSettings =>
{
    listBoxSettings.ControlStyle.Border.BorderWidth = 0;
    listBoxSettings.ControlStyle.BorderBottom.BorderWidth = 1;
    listBoxSettings.ControlStyle.BorderBottom.BorderColor = System.Drawing.Color.FromArgb(0xDCDCDC);
    listBoxSettings.Width = System.Web.UI.WebControls.Unit.Percentage(100);

    listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.Single;
    listBoxSettings.Properties.ValueField = "PageID";
    listBoxSettings.Properties.TextField = "Name";

    string action = ViewContext.Controller.ValueProvider.GetValue("action").AttemptedValue;

    if (action == "ComposePageHeaderParentPageDropDownPartial")
    {
        listBoxSettings.Name = "ComposePageHeaderParentPageListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            ComposePageHeaderParentPageDD.SetText(s.GetSelectedItem().text);
            ComposePageHeaderParentPageDD.HideDropDown();
            $('#page-select-header-busy').fadeIn('fast');
            $.ajax({
                url: '" + Url.Action("ComposePageHeaderPageDropDownPartial", "CMS") + @"',
                type: 'POST',
                traditional: true,
                data: {
                    SelectedSiteSectionID: ComposePageHeaderSiteSectionListBox.GetValue(),
                    SelectedParentPageID: s.GetSelectedItem().value,
                    SelectedPageID: ComposePageHeaderPageListBox.GetValue()
                },
                success: function(data) {
                    $('#page-select-header-busy').fadeOut('fast');
                    $('#page-header-page-drop-down-container').html(data);
                },
                error: function(e, s, a) {
                    $('#page-select-header-busy').fadeOut('fast');
                    alert(e.responseText);
                },
                timeout: 60000
            });
        }";

        if (ViewBag.ComposePageHeaderSelectedParentPageID != null)
        {
            listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) {
            s.SetSelectedItem(s.FindItemByValue(" + ViewBag.ComposePageHeaderSelectedParentPageID + @"));
            if(s.GetSelectedItem() != null && s.GetSelectedItem() != false)
                ComposePageHeaderParentPageDD.SetText(s.GetSelectedItem().text);
            }";
        }
    }

    if (action == "ComposePageHeaderPageDropDownPartial")
    {
        listBoxSettings.Name = "ComposePageHeaderPageListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            ComposePageHeaderPageDD.SetText(s.GetSelectedItem().text);
            ComposePageHeaderPageDD.HideDropDown();
            
            var newurl = '" + Url.Action("compose", "cms", new { id = -1, parentpageid = -2, sitesectionid = -3 }) + @"';
            newurl = newurl.replace('-1', s.GetSelectedItem().value);
            newurl = newurl.replace('-2', ComposePageHeaderParentPageListBox.GetValue());
            newurl = newurl.replace('-3', ComposePageHeaderSiteSectionListBox.GetValue());
            window.location.href = newurl;
        }";

        if (ViewBag.ComposePageHeaderSelectedPageID != null)
        {
            listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) {
            s.SetSelectedItem(s.FindItemByValue(" + ViewBag.ComposePageHeaderSelectedPageID + @"));
            if(s.GetSelectedItem() != null && s.GetSelectedItem() != false)
                ComposePageHeaderPageDD.SetText(s.GetSelectedItem().text);
            }";
        }
    }
    else if (action == "TranslatePageHeaderParentPageDropDown")
    {
        listBoxSettings.Name = "TranslatePageHeaderParentPageListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) { 
            TranslatePageHeaderParentPageDD.SetText(s.GetSelectedItem().text);
            TranslatePageHeaderParentPageDD.HideDropDown();
            
            var TargetLanguageID = null;
            if(typeof(TranslationTargetLanguageListBox) != 'undefined' && typeof(TranslationTargetLanguageListBox) != false)
                TargetLanguageID = TranslationTargetLanguageListBox.GetValue();

            $.ajax({
	            url: '" + Url.Action("TranslatePageHeaderPageDropDown", "Translations") + @"',
	            type: 'POST',
	            traditional: true,
	            data: {
	                ID: TranslateHeaderContentListBox.GetValue(),
	                SiteSectionID: TranslatePageHeaderSiteSectionListBox.GetValue(),
	                ParentPageID: TranslatePageHeaderParentPageListBox.GetValue(),
	                TranslationStatusID: TranslatePageHeaderTranslationStatusListBox.GetValue(),
                    TargetLanguageID: TargetLanguageID
	            },
	            success: function(data) { 
	                $('#translate-page-page-drop-down-container').html(data);
                    if (TranslateHeaderContentListBox.FindItemByValue($('#content-id-label').html()) == null) {
                        TranslateHeaderContentListBox.SetSelectedIndex(0);
                        var e = new ASPxClientProcessingModeEventArgs();
                        if(TranslateHeaderContentListBox.GetItemCount() > 0)
                            TranslateHeaderContentListBox.SelectedIndexChanged.FireEvent(TranslateHeaderContentListBox, e);
                    }
	            },
	            error: function(e, s, a) { 
	                alert(e.responseText);
	            },
	            timeout: 60000
            });
        }";
        listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) {
            s.SetSelectedItem(s.FindItemByValue(" + ViewBag.TranslatePageHeaderSelectedParentPageID + @"));
            if(s.GetSelectedItem() != null && s.GetSelectedItem() != false)
                TranslatePageHeaderParentPageDD.SetText(s.GetSelectedItem().text);
        }";
    }
    else if (action == "TranslatePageHeaderPageDropDown")
    {
        listBoxSettings.Name = "TranslateHeaderContentListBox";

        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) { 
            TranslatePageHeaderPageDD.HideDropDown();

            if(s.GetSelectedItem() != null) {
                TranslatePageHeaderPageDD.SetText(s.GetSelectedItem().text);
                
                if(typeof(TranslationTargetLanguageListBox) == 'undefined' || typeof(TranslationTargetLanguageListBox) == false)
                {//int? id, byte? sitesectionid, int? parentpageid, byte? webstatusid, byte? translationstatusid, byte? targetlanguageid
                    var url = '" + @Url.Action("page", "translations", new { id = "-1", sitesectionid = "-2", parentpageid = "-3", translationstatusid = "-5" }) + @"';
                    url = url.replace('-1', s.GetSelectedItem().value);
                    url = url.replace('-2', TranslatePageHeaderSiteSectionListBox.GetValue());
                    url = url.replace('-3', TranslatePageHeaderParentPageListBox.GetValue());
                    url = url.replace('-5', TranslatePageHeaderTranslationStatusListBox.GetValue());
                    window.location.href = url;
                }
                else
                {
                    $.ajax({ 
                        url: '" + Url.Action("ChangePage", "Translations") + @"',
                        type: 'POST',
                        traditional: true,
                        data: {  
                            PageID: s.GetSelectedItem().value,
                            TargetLanguageID: TranslationTargetLanguageListBox.GetValue()
                        },
                        success: function(data) {
                            $('#translate-middle-container').html(data);
                        
                        },
                        error: function(e, s, a) { 
                            alert(e.responseText);    
                        },
                        timeout: 60000
                    });
                }
                $('#pager-current').html(s.GetSelectedItem().index + 1);
                $('#pager-total').html(s.GetItemCount());
            }
            else {
                $('#pager-current').html(0);
                $('#pager-total').html(0);
            }
        }";
    }
    else if (action == "ComposeBannerHeaderPageDropDownPartial")
    {
        listBoxSettings.Name = "ComposeBannerHeaderPageListBox";
        listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.CheckColumn;
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            ComposeBannerHeaderPageDD.HideDropDown();
            LoadingPanel.Show();
            var items = s.GetSelectedItems();
            var text = 'Page';
            if(items.length > 1)
                text = '(' + items.length.toString() + ' Pages Selected)';
            else if(items.length == 1)
                text = items[0].text;    
            ComposeBannerHeaderPageDD.SetText(text);
            BannerSelectorGridView.Refresh();
        }";
    }
    listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) {
        if(s.GetItemCount() == 0) {
            $('#translate-middle-container').html('<h5 style=""display: block; margin: 0px auto 1.5em; width: 90px;"">No Results.</h5>');
        }
        else {
            s.SetSelectedItem(s.FindItemByValue(" + ViewBag.TranslatePageHeaderSelectedPageID + @"));
            if(s.GetSelectedItem() != null && s.GetSelectedItem() != false) {
                TranslatePageHeaderPageDD.SetText(s.GetSelectedItem().text);
                $('#pager-current').html(s.GetSelectedItem().index + 1);
                $('#pager-total').html(s.GetItemCount().toString());
            }
        }
    }";
}
).BindList(Model).GetHtml()