@model List<Flock.Models.SiteSection>
@Html.DevExpress().ListBox(
listBoxSettings =>
{
    listBoxSettings.Width = System.Web.UI.WebControls.Unit.Percentage(100);

    listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.Single;
    listBoxSettings.Properties.ValueField = "SiteSectionID";
    listBoxSettings.Properties.TextField = "Name";
    
    string action = ViewContext.Controller.ValueProvider.GetValue("action").AttemptedValue;

    if (action == "BannerOverviewSiteSectionDropDownPartial")
    {
        listBoxSettings.Name = "BannerOverviewSiteSectionListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            $('#banner-searching-icon').fadeIn('fast');
            BannerOverviewSiteSectionDD.SetText(s.GetSelectedItem().text);
            BannerOverviewSiteSectionDD.HideDropDown();
            BannerOverviewGridView.Refresh();
        }";
        listBoxSettings.ControlStyle.Border.BorderWidth = 0;
        listBoxSettings.ControlStyle.BorderBottom.BorderWidth = 1;
        listBoxSettings.ControlStyle.BorderBottom.BorderColor = System.Drawing.Color.FromArgb(0xDCDCDC);
    }
    else if (action == "ComposeBannerHeaderSiteSectionDropDownPartial")
    {
        listBoxSettings.Name = "ComposeBannerHeaderSiteSectionListBox";
        listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.CheckColumn;
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            ComposeBannerHeaderSiteSectionDD.HideDropDown();
            var items = s.GetSelectedItems();
            var text = 'Site Section';
            if(items.length > 1)
                text = '(' + items.length.toString() + ' Site Sections Selected)';
            else if(items.length == 1)
                text = items[0].text;    
            ComposeBannerHeaderSiteSectionDD.SetText(text);
            LoadingPanel.Show();
            BannerSelectorGridView.Refresh(); 
        }";
        listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) {
            s.SetSelectedItem(s.FindItemByValue(" + ViewBag.BannerSelectHeaderSelectedSiteSectionID + @"));
            if(s.GetSelectedItem() != null && s.GetSelectedItem() != false)
                ComposeBannerHeaderSiteSectionDD.SetText(s.GetSelectedItem().text);
        }";
        listBoxSettings.ControlStyle.Border.BorderWidth = 0;
        listBoxSettings.ControlStyle.BorderBottom.BorderWidth = 1;
        listBoxSettings.ControlStyle.BorderBottom.BorderColor = System.Drawing.Color.FromArgb(0xDCDCDC);
    }
    else if (action == "ComposeBannerSiteSectionListBoxPartial")
    {
        listBoxSettings.Name = "ComposeBannerSiteSectionListBox";
        listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.CheckColumn;
        listBoxSettings.Style.Add("float", "left");
        listBoxSettings.Height = 200;
        listBoxSettings.ControlStyle.Border.BorderWidth = 0;
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            
        }";

        if (ViewBag.SiteSectionAssignmentSelectedSiteSectionIDs != null && ViewBag.SiteSectionAssignmentSelectedSiteSectionIDs != "")
        {
            listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) {
                var selectedArray = '" + ViewBag.SiteSectionAssignmentSelectedSiteSectionIDs + @"';
                selectedArray = selectedArray.split(',');
                s.SelectValues(selectedArray);
            }";
        }
    }
    else if (action == "PageSearchSiteSectionDropDownPartial")
    {
        listBoxSettings.Name = "PageSearchSiteSectionListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            PageSearchSiteSectionDD.SetText(s.GetSelectedItem().text);
            PageSearchSiteSectionDD.HideDropDown();
            $('#page-searching-icon').fadeIn('fast');
            $.ajax({
	            url: '" + Url.Action("PageSearch", "Pages") + @"',
	            traditional: true,
	            data: {
		            SiteSectionID: PageSearchSiteSectionListBox.GetValue(),
                    //TemplateID: PageSearchTemplateListBox.GetValue(),
                    SearchString: PageSearchNameTextBox.GetValue()
	            },
	            success: function(data) {
		            $('#page-searching-icon').fadeOut('fast');
		            $('#page-data-view-container').html(data);
	            },
	            error: function(e, s, a) { 
		            $('#page-searching-icon').fadeOut('fast');
		            alert(e.responseText);
	            },
	            timeout: 60000
            });
        }";
        listBoxSettings.ControlStyle.Border.BorderWidth = 0;
        listBoxSettings.ControlStyle.BorderBottom.BorderWidth = 1;
        listBoxSettings.ControlStyle.BorderBottom.BorderColor = System.Drawing.Color.FromArgb(0xDCDCDC);
    }
    else if (action == "ComposePageHeaderSiteSectionDropDownPartial")
    {
        listBoxSettings.Name = "ComposePageHeaderSiteSectionListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            ComposePageHeaderSiteSectionDD.SetText(s.GetSelectedItem().text);
            ComposePageHeaderSiteSectionDD.HideDropDown();
            $('#page-select-header-busy').fadeIn('fast');
            $.ajax({ 
                url: '" + Url.Action("ComposePageHeaderPageDropDownPartial", "CMS") + @"',
                type: 'POST',
                traditional: true,
                data: {
                    SelectedSiteSectionID: s.GetSelectedItem().value,
                    SelectedParentPageID: ComposePageHeaderParentPageListBox.GetValue(),
                    SelectedPageID: ComposePageHeaderPageListBox.GetValue()
                },
                success: function(data) { 
                    $('#page-select-header-busy').fadeOut('fast');
                    $('#page-header-page-drop-down-container').html(data);
                },
                error: function(e, s, a) {
                    $('#page-select-header-busy').fadeOut('fast');
                    alert(e.responseText);
                },
                timeout: 60000
            });       
        }";
        
        if (ViewBag.ComposePageHeaderSelectedSiteSectionID != null)
        {
            listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) {
            s.SetSelectedItem(s.FindItemByValue(" + ViewBag.ComposePageHeaderSelectedSiteSectionID + @"));
            if(s.GetSelectedItem() != null && s.GetSelectedItem() != false)
                ComposePageHeaderSiteSectionDD.SetText(s.GetSelectedItem().text);
            }";
        }
        listBoxSettings.ControlStyle.Border.BorderWidth = 0;
        listBoxSettings.ControlStyle.BorderBottom.BorderWidth = 1;
        listBoxSettings.ControlStyle.BorderBottom.BorderColor = System.Drawing.Color.FromArgb(0xDCDCDC);
    }
    else if (action == "CMSOverviewSiteSectionDropDownPartial")
    {
        listBoxSettings.Name = "CMSOverviewSiteSectionListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            CMSOverviewSiteSectionDD.SetText(s.GetSelectedItem().text);
            CMSOverviewSiteSectionDD.HideDropDown();
            CMSOverviewTreeView.PerformCallback();
        }";
        listBoxSettings.SelectedIndex = 0;
        listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) { 
            CMSOverviewSiteSectionDD.SetText(s.GetSelectedItem().text);
        }";
        listBoxSettings.ControlStyle.Border.BorderWidth = 0;
        listBoxSettings.ControlStyle.BorderBottom.BorderWidth = 1;
        listBoxSettings.ControlStyle.BorderBottom.BorderColor = System.Drawing.Color.FromArgb(0xDCDCDC);
    }
    else if (action == "TranslatePageHeaderSiteSectionDropDown")
    {
        listBoxSettings.Name = "TranslatePageHeaderSiteSectionListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) { 
            TranslatePageHeaderSiteSectionDD.SetText(s.GetSelectedItem().text);
            TranslatePageHeaderParentPageListBox.UnselectAll();
            TranslatePageHeaderSiteSectionDD.HideDropDown();
            var TargetLanguageID = null;
            if(typeof(TranslationTargetLanguageListBox) != 'undefined' && typeof(TranslationTargetLanguageListBox) != false)
                TargetLanguageID = TranslationTargetLanguageListBox.GetValue();

            $.ajax({ 
                url: '" + Url.Action("TranslatePageHeaderParentPageDropDown", "Translations") + @"',
                type: 'POST',
                traditional: true,
                data: { 
                    SelectedParentPageID: TranslatePageHeaderParentPageListBox.GetValue(),
                    SelectedSiteSectionID: s.GetSelectedItem().value
                },
                success: function(data) {
                    $('#translate-page-parent-page-drop-down-container').html(data);
                },
                error: function(e, s, a) {
                    alert(e.responseText);
                },
                timeout: 60000
            });

            $.ajax({
	            url: '" + Url.Action("TranslatePageHeaderPageDropDown", "Translations") + @"',
	            type: 'POST',
	            traditional: true,
	            data: {
	                ID: TranslateHeaderContentListBox.GetValue(),
	                SiteSectionID: TranslatePageHeaderSiteSectionListBox.GetValue(),
	                ParentPageID: TranslatePageHeaderParentPageListBox.GetValue(),
	                TranslationStatusID: TranslatePageHeaderTranslationStatusListBox.GetValue(),
                    TargetLanguageID: TargetLanguageID
	            },
	            success: function(data) { 
	                $('#translate-page-page-drop-down-container').html(data);
                    if (TranslateHeaderContentListBox.FindItemByValue($('#content-id-label').html()) == null) {
                        TranslateHeaderContentListBox.SetSelectedIndex(0);
                        var e = new ASPxClientProcessingModeEventArgs();
                        if(TranslateHeaderContentListBox.GetItemCount() > 0)
                            TranslateHeaderContentListBox.SelectedIndexChanged.FireEvent(TranslateHeaderContentListBox, e);
                        else {
                            $('#pager-total').html(0);
                            $('#pager-current').html(0);
                        }
                    }
	            },
	            error: function(e, s, a) { 
	                alert(e.responseText);
	            },
	            timeout: 60000
            });
        }";
        listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) {
            s.SetSelectedItem(s.FindItemByValue(" + ViewBag.TranslatePageHeaderSelectedSiteSectionID + @"));
            if(s.GetSelectedItem() != null && s.GetSelectedItem() != false)
                TranslatePageHeaderSiteSectionDD.SetText(s.GetSelectedItem().text);
        }";
        listBoxSettings.ControlStyle.Border.BorderWidth = 0;
        listBoxSettings.ControlStyle.BorderBottom.BorderWidth = 1;
        listBoxSettings.ControlStyle.BorderBottom.BorderColor = System.Drawing.Color.FromArgb(0xDCDCDC);
    }
}
).BindList(Model).GetHtml()