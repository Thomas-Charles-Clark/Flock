                    $('#collection-drop-down-container').html(data);
                },
                error: function(e, s, a) { 
                    $.showError(e, s, a);
                },
                timeout: 60000
            });
        }";
        
        listBoxSettings.Properties.ClientSideEvents.Init = @"function(s, e) { 
            s.SetSelectedItem(s.FindItemByValue(" + ViewBag.CollectionHeaderSelectedLaunchID + @"));
            if(s.GetSelectedItem() != null && s.GetSelectedItem() != false)
                CollectionComposeHeaderLaunchDD.SetText(s.GetSelectedItem().text);
        }";
    }
    else if (action == "ProductAssociationHeaderLaunchDropDownPartial")
