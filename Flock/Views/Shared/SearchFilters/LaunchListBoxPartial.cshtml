            url = url.replace('-2', CollectionComposeHeaderProductTypeListBox.GetValue());
            url = url.replace('-3', CollectionComposeHeaderBrandListBox.GetValue());
            url = url.replace('-4', s.GetSelectedItem().value);

            $('#product-association-anchor').attr('href', url);


            $.ajax({
                url: '" + Url.Action("CollectionComposeHeaderCollectionDropDownPartial", "Collections") + @"',
