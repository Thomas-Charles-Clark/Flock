            TranslateProductPageHeaderLaunchDD.HideDropDown();
            TranslateProductPageHeaderLaunchDD.SetText(s.GetSelectedItem().text);
            $('#translate-product-page-header-searching-icon').fadeIn('fast');
            var TargetLanguageID = null;
