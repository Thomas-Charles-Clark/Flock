    else if (action == "TranslateCollectionHeaderLaunchDropDown")
    {
        listBoxSettings.Name = "TranslateCollectionHeaderLaunchListBox";
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            TranslateCollectionHeaderLaunchDD.HideDropDown();
            TranslateCollectionHeaderLaunchDD.SetText(s.GetSelectedItem().text);
            var TargetLanguageID = null;
            if(typeof(TranslationTargetLanguageListBox) != 'undefined' && typeof(TranslationTargetLanguageListBox) != false)
                TargetLanguageID = TranslationTargetLanguageListBox.GetValue();
            $('#translate-collection-header-searching-icon').fadeIn('fast');
            $.ajax({
	            url: '" + Url.Action("TranslateCollectionHeader", "Translations") + @"',
	            type: 'POST',
	            traditional: true,
	            data: { 
