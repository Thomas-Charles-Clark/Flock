            $('#collection-contents').html('<div style=\'background-color: white; padding: 1em; height: 1108px; overflow-y: scroll;\' id=\'collection-contents-sortable\'><span id=\'collection-contents-placeholder\' style=\'padding: 0; margin: 0; font-size: 12px; font-weight: 400;\'>Either there are no products in this collection, or you have not selected a collection yet using the drop down lists above.</span></div>');
            ProductAssociationHeaderLaunchDD.SetText(s.GetSelectedItem().text);
            $.ajax({
                url: '" + Url.Action("ProductAssociationHeaderCollectionDropDownPartial", "Collections") + @"',
