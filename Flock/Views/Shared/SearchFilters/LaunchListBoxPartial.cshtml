                $('#translate-middle-container').html('<h5 style=""display: block; margin: 0px auto 1.5em; width: 90px;"">No Results.</h5>');
            }
            else {
                s.SetSelectedItem(s.FindItemByValue(" + ViewBag.TranslateCollectionHeaderSelectedLaunchID + @"));
