@model List<Flock.Models.ProductPage>
@Html.DevExpress().DropDownEdit(
    settings =>
    {
        settings.Style.Add("float", "left");
        settings.Style.Add("margin", "0 7px 7px 0");

        string action = ViewContext.Controller.ValueProvider.GetValue("action").AttemptedValue;

        if (action == "ComposeProductPageHeaderProductPageDropDownPartial")
        {
            settings.Name = "ComposeProductPageHeaderProductPageDD";

            settings.ControlStyle.BackColor = System.Drawing.Color.FromArgb(254, 233, 152);
        }
        else if (action == "TranslateProductPageHeaderProductPageDropDown")
            settings.Name = "TranslateProductPageHeaderProductPageDD";
        else
            settings.Name = "ComposeProductPageHeaderProductPageDD";

        settings.Text = "Product Page";
        settings.Properties.DropDownWindowStyle.BackColor = System.Drawing.Color.FromArgb(0xEDEDED);

        settings.Width = System.Web.UI.WebControls.Unit.Pixel(200);
        settings.Height = System.Web.UI.WebControls.Unit.Pixel(35);
        
        settings.Properties.EnableClientSideAPI = true;

        settings.SetDropDownWindowTemplateContent(c =>
        {
            ViewContext.Writer.Write("<div id='status-listbox'>");
            if (action != "TranslateProductPageHeaderProductPageDropDown")
                ViewContext.Writer.Write(@Html.Partial("~/Views/Shared/SearchFilters/ProductPageListBoxPartial.cshtml", Model));
            else
                ViewContext.Writer.Write(@Html.Partial("~/Views/Translations/ProductPageComboBoxPartial.cshtml", Model));
            ViewContext.Writer.Write("</div>");
            ViewContext.Writer.Write("<div style=\"padding: 6px;\">");
            if(action != "TranslateProductPageHeaderProductPageDropDown")
            { 
                @Html.DevExpress().Button(
                    buttonSettings =>
                    {
                        if (action == "ComposeProductPageHeaderProductPageDropDownPartial")
                        {
                            buttonSettings.Name = "ComposeProductPageHeaderProductPageButtonClear"; 
                            buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                                ComposeProductPageHeaderProductPageListBox.UnselectAll();
                                ComposeProductPageHeaderProductPageDD.HideDropDown(); 
                                ComposeProductPageHeaderProductPageDD.SetText('Product Page');
                                $('#product-page-header-searching-icon').fadeIn('fast');
	                            $.ajax({
		                            url: '" + Url.Action("ComposeProductPageHeaderProductPageDropDownPartial", "ProductPages") + @"',
		                            traditional: true,
		                            data: {
			                            ProductTypeID: ComposeProductPageHeaderProductTypeListBox.GetValue(),
			                            BrandID: ComposeProductPageHeaderBrandListBox.GetValue(),
			                            LaunchID: ComposeProductPageHeaderLaunchListBox.GetValue(),
			                            WebStatusID: ComposeProductPageHeaderWebStatusListBox.GetValue(),
			                            TemplateID: ComposeProductPageHeaderTemplateListBox.GetValue()
		                            },
		                            success: function(data) {
			                            $('#product-page-header-searching-icon').fadeOut('fast');
			                            $('#product-page-header-product-page-drop-down-container').html(data);
		                            },
		                            error: function(e, s, a) { 
			                            $('#product-page-header-searching-icon').fadeOut('fast');
			                            alert(e.responseText);
		                            },
		                            timeout: 60000
	                            });
                            }";
                        }
                        else
                        {
                            buttonSettings.Name = "StatusButtonClear";
                            buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                                alert('Not Implemented');
                            }";
                        }
                        buttonSettings.Text = "Clear";
                        buttonSettings.Style.Add("float", "left");
                    }
                )
                .Render();
            }
            @Html.DevExpress().Button(
                buttonSettings =>
                {
                    if (action == "ComposeProductPageHeaderProductPageDropDownPartial")
                    {
                        buttonSettings.Name = "ComposeProductPageHeaderProductPageButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) {
                            ComposeProductPageHeaderProductPageDD.HideDropDown();
                        }";
                    }
                    else if (action == "TranslateProductPageHeaderProductPageDropDown")
                    {
                        buttonSettings.Name = "TranslateProductPageHeaderProductPageButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                            TranslateProductPageHeaderProductPageDD.HideDropDown();
                        }";
                    }
                    else
                    {
                        buttonSettings.Name = "ProductPageButtonClose";
                        buttonSettings.ClientSideEvents.Click = @"function(s, e) {
                            alert('Not Implemented.');
                        }";
                    }
                    buttonSettings.Text = "Close";
                    buttonSettings.Style.Add("float", "right");
                }
            )
            .Render();
            ViewContext.Writer.Write("<div style='clear: both;'></div></div>");
        });
        settings.Properties.AnimationType = AnimationType.None;
    }
).GetHtml()