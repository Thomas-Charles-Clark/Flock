@model Flock.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Reset Password";
    Layout = "~/Views/Admin/_Layout.cshtml";
}
@section styles {
    @Styles.Render("~/Content/themes/admin/logon.css")
}

<h4 class="page-heading">@ViewBag.Title</h4>

<div>
    <p>
        Please reset your password using the fields beneath.
    </p>
</div>

<div style="width: 400px; margin: 0 auto;">
    <section id="loginForm" style="float: left; width: 400px; margin-right: 30px;">
        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.Code)
            <fieldset>
                <legend style="border-bottom: 0;"></legend>
                <ul>
                    <li>
                        @Html.LabelFor(m => m.Email)
                        @Html.TextBoxFor(m => m.Email)
                    </li>
                    <li>
                        @Html.LabelFor(m => m.Password)
                        @Html.PasswordFor(m => m.Password)
                    </li>
                    <li>
                        @Html.LabelFor(m => m.ConfirmPassword)
                        @Html.PasswordFor(m => m.ConfirmPassword)
                    </li>
                </ul>
                <div style="text-align: right;">
                    <input id="submit" class="btn btn-default" type="submit" value="Submit" />
                </div>
            </fieldset>
        }
    </section>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
