@{
    ViewBag.Title = "Related Product Pages";
    Layout = "~/Views/Admin/_Layout.cshtml";
}
@section styles {

    @Styles.Render("~/Content/jquery-pagination.css")
    @Styles.Render("~/Content/related-product-pages.css")
    @Styles.Render("~/bundles/composer")
}

@section scripts {

    @Scripts.Render("~/Scripts/jquery.pagination.js")
}

<h4 class="page-heading">Related Product Pages</h4>

<div style="float: left;">
    <h5>
        Product Page Filters
    </h5>
    <div id="product-page-filters">
        @Html.Action("ProductPage_ProductTypeDropDown", "RelatedProductPages")
        @Html.Action("ProductPage_CollectionDropDown", "RelatedProductPages")
        @Html.Action("ProductPage_BrandDropDown", "RelatedProductPages")
        @Html.Action("ProductPage_LaunchDropDown", "RelatedProductPages")
        @Html.Action("ProductPage_TemplateDropDown", "RelatedProductPages")
        @Html.Action("ProductPage_StatusDropDown", "RelatedProductPages")
        @Html.Action("ProductPage_NameOrIDTextBox", "RelatedProductPages")
    </div>
    <div style="clear: both;"></div>
    <h5>
        Related Product Page Filters
    </h5>
    <div id="related-product-page-filters">
        @Html.Action("RelatedProductPage_ProductTypeDropDown", "RelatedProductPages")
        @Html.Action("RelatedProductPage_CollectionDropDown", "RelatedProductPages")
        @Html.Action("RelatedProductPage_BrandDropDown", "RelatedProductPages")
        @Html.Action("RelatedProductPage_LaunchDropDown", "RelatedProductPages")
        @Html.Action("RelatedProductPage_TemplateDropDown", "RelatedProductPages")
        @Html.Action("RelatedProductPage_StatusDropDown", "RelatedProductPages")

        @Html.DevExpress().Label(settings =>
        {
            settings.Name = "CountLabel";
            settings.Text = "Count";
            settings.Style.Add("float", "left");
            settings.Style.Add("margin", "0 16px 7px 8px");
            var lProp = settings.Properties as LabelProperties;
            lProp.Style.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Center;
            lProp.Style.Font.Size = 13;
            settings.Width = 50;
            settings.Height = 35;
            settings.Style.Add("line-height", "32px");
        }).GetHtml()
        @Html.DevExpress().DropDownEdit(settings =>
        {
            settings.Name = "OperatorDD";
            settings.Style.Add("float", "left");
            settings.Style.Add("margin", "0 14px 7px 0px");
            settings.Width = 50;
            settings.Height = 35;
            settings.Properties.ClientSideEvents.Init = @"function(s, e) {
                s.SetText(RelatedProductPageCountOperator.GetSelectedItem().text);
            }";
            settings.SetDropDownWindowTemplateContent(s =>
            {
                Html.DevExpress().ListBox(lbSettings =>
                {
                    lbSettings.Name = "RelatedProductPageCountOperator";
                    lbSettings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
                    lbSettings.Properties.Items.Add("=", "=");
                    lbSettings.Properties.Items.Add(">", ">");
                    lbSettings.Properties.Items.Add("<", "<");
                    lbSettings.Properties.Items.Add("<>", "<>");
                    lbSettings.Properties.Items.Add(">=", ">=");
                    lbSettings.Properties.Items.Add("<=", "<=");
                    lbSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
                        OperatorDD.HideDropDown();
                        OperatorDD.SetText(s.GetSelectedItem().text);
                        PageChangeCallback(0, null)
                    }";
                    lbSettings.SelectedIndex = 4;
                }).Render();
            });
        }).GetHtml()
        @Html.DevExpress().DropDownEdit(settings =>
       {
           settings.Name = "RelatedProductPageDD";
           settings.Style.Add("float", "left");
           settings.Style.Add("margin", "0 7px 7px 12px");
           settings.Width = 50;
           settings.Height = 35;
           settings.Properties.ClientSideEvents.Init = @"function(s, e) {
                    s.SetText(RelatedProductPageCount.GetSelectedItem().text);
                }";
           settings.SetDropDownWindowTemplateContent(s =>
           {
               Html.DevExpress().ListBox(lbSettings =>
               {
                   lbSettings.Name = "RelatedProductPageCount";
                   lbSettings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
                   for (int i = 0; i < 10; i++)
                   {
                       lbSettings.Properties.Items.Add(i.ToString(), i);
                   }
                   lbSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
                            RelatedProductPageDD.HideDropDown();
                            RelatedProductPageDD.SetText(s.GetSelectedItem().text);
                            PageChangeCallback(0, null)
                        }";
                   lbSettings.SelectedIndex = 0;
               }).Render();
           });
       }).GetHtml()
    </div>
    <div style="clear: both;"></div>
</div>
<div style="float: right;">
    <table id="swap-table" style="width: 520px; margin: 0 auto;">
        <tr>
            <td>
                <h5>Original</h5>
            </td>
            <td>

            </td>
            <td>
                <h5>Replacement</h5>
            </td>
        </tr>
        <tr>
            <td id="swap-original" style="width: 156px; height: 156px; border: 1px solid #cdcdcd;"></td>
            <td style="border: 0; padding: 1em 0; text-align: center;">
                @Html.DevExpress().Button(settings =>
                {
                    settings.Name = "SwapButton";
                    settings.Text = "»» Swap »»";
                    settings.ClientEnabled = false;
                    settings.Style.Add("margin", "0.5em");
                    settings.Height = System.Web.UI.WebControls.Unit.Pixel(35);
                    settings.Width = System.Web.UI.WebControls.Unit.Pixel(75);
                    settings.ClientSideEvents.Click = @"function(s, e) {
                            $.ajax({
                                url: '" + Url.Action("SwapProductPage", "RelatedProductPages") + @"',
                                type: 'POST',
                                traditional: true,
                                data: {
                                    OriginalProductPage: $('#swap-original').data('product-page-id'),
                                    ReplacementProductPage: $('#swap-replacement').data('product-page-id')
                                },
                                success: function(data) {
                                    PageChangeCallback($('#current-page').val());
                                    $('#swap-original').html('');
                                    $('#swap-replacement').html('');
                                },
                                error: function(e, s, a) {
                                    $.showError(e, s, a, function() { $('#swap-original').html(''); $('#swap-replacement').html(''); });
                                },
                                timeout: 10000
                            });
                        }";
                }).GetHtml()
                @Html.DevExpress().Button(settings =>
                {
                    settings.Name = "SwapClearButton";
                    settings.Text = "Reset";
                    settings.ClientEnabled = true;
                    settings.Style.Add("margin", "0.5em");
                    settings.Height = System.Web.UI.WebControls.Unit.Pixel(35);
                    settings.Width = System.Web.UI.WebControls.Unit.Pixel(75);
                    settings.ClientSideEvents.Click = @"function(s, e) {
                        $('#swap-original').html('');
                        $('#swap-replacement').html('');
                        $('#swap-original').removeData('product-page-id');
                        $('#swap-replacement').removeData('product-page-id');
                        CheckSwapViability();
                    }";
                }).GetHtml()
            </td>
            <td id="swap-replacement" style="width: 156px; height: 156px; border: 1px solid #cdcdcd;"></td>
        </tr>
    </table>
</div>

<div style="clear: both;"></div>

<input id="current-page" value="0" type="hidden" />

<div style="clear: both;"></div>

<div style="margin-top: 1em;">

    <div id="resource-panel-container" style="float: left; width: 986px; position: relative; top: 4px;">
        <div class="resource-panel-container">
            <fieldset id="product-page-search-fieldset">
                <legend>Product Page Search</legend>
                <div id="product-page-dataview" class="hideable-dataview">
                    <div style="padding: 1em 1em 0; background-color: white;">
                        @Html.Action("ProductPageSearchProductTypeDropDownPartial", "ProductPages")
                        @Html.Action("ProductPageSearchBrandDropDownPartial", "ProductPages")
                        @Html.Action("ProductPageSearchLaunchDropDownPartial", "ProductPages")
                        @Html.Action("ProductPageSearchCollectionDropDownPartial", "ProductPages")
                        @Html.Action("ProductPageSearchStatusDropDownPartial", "ProductPages")
                        @Html.Action("ProductPageSearchColourDropDownPartial", "ProductPages")
                        @Html.Action("ProductPageSearchPatternDropDownPartial", "ProductPages")
                        @Html.Action("ProductPageSearchTemplateDropDownPartial", "ProductPages")
                        @Html.Action("ProductPageSearchNameTextBox", "ProductPages")
                        @Html.DevExpress().Button(settings =>
                {
                    settings.Name = "ProductPageClearFiltersButton";
                    settings.Text = "Reset";
                    settings.Style.Add("line-height", "32px");
                    settings.Height = System.Web.UI.WebControls.Unit.Pixel(35);
                    settings.Width = System.Web.UI.WebControls.Unit.Pixel(75);
                    settings.ClientSideEvents.Click = @"function(s, e) {
                        ProductPageSearchProductTypeListBox.UnselectAll();
                        ProductPageSearchProductTypeDD.SetText('Product Type');
                        ProductPageSearchBrandListBox.UnselectAll();
                        ProductPageSearchBrandDD.SetText('Brand');
                        ProductPageSearchLaunchListBox.UnselectAll();
                        ProductPageSearchLaunchDD.SetText('Launch');
                        ProductPageSearchPatternListBox.UnselectAll();
                        ProductPageSearchPatternDD.SetText('Pattern');
                        ProductPageSearchStatusListBox.UnselectAll();
                        ProductPageSearchStatusDD.SetText('Status');
                        ProductPageSearchCollectionListBox.UnselectAll();
                        ProductPageSearchCollectionDD.SetText('Collection');
                        ProductPageSearchColourListBox.UnselectAll();
                        ProductPageSearchColourDD.SetText('Colour');
                        ProductPageSearchTemplateListBox.UnselectAll();
                        ProductPageSearchTemplateDD.SetText('Template');
                        ProductPageSearchNameTextBox.SetText('Product Page Name or ID');

                        $('#product-page-searching-icon').fadeIn('fast');
                        $.ajax({
	                        url: '" + Url.Action("ProductPageSearch", "ProductPages") + @"',
	                        traditional: true,
	                        data: {
		                        ProductTypeID: ProductPageSearchProductTypeListBox.GetValue(),
		                        BrandID: ProductPageSearchBrandListBox.GetValue(),
		                        LaunchID: ProductPageSearchLaunchListBox.GetValue(),
		                        CollectionID: ProductPageSearchCollectionListBox.GetValue(),
		                        PatternID: ProductPageSearchPatternListBox.GetValue(),
		                        ColourID: ProductPageSearchColourListBox.GetValue(),
		                        StatusID: ProductPageSearchStatusListBox.GetValue(),
                                TemplateID: ProductPageSearchTemplateListBox.GetValue(),
		                        SearchString: ProductPageSearchNameTextBox.GetValue()
	                        },
	                        success: function(data) {
		                        $('#product-page-searching-icon').fadeOut('fast');
		                        $('#product-page-data-view-container').html(data);
	                        },
	                        error: function(e, s, a) {
		                        $.showError(e, s, a, function() { $('#product-page-searching-icon').fadeOut('fast'); });
	                        },
	                        timeout: 20000
                        });
                    }";
                }).GetHtml()
                        @Html.DevExpress().Button(button =>
                {
                    button.Text = "Add All";
                    button.Name = "ProductPageAddAllButton";
                    //button.Style.Add("float", "left");
                    button.Style.Add("margin-top", "7px");
                    button.Style.Add("line-height", "32px");
                    button.Height = System.Web.UI.WebControls.Unit.Pixel(35);
                    button.Width = System.Web.UI.WebControls.Unit.Pixel(75);
                    button.Style.Add("text-align", "center");
                    button.ClientSideEvents.Click = @"function(s, e) {
                            if($('#where-dialog').length > 0) {
                                if(ComposeProductPageGridSelector.GetFocusedRowIndex() != -1 && ComposeProductPageGridSelector.GetFocusedRowIndex() != null) {
                                    $('#add-where-select').val(0);
                                    $('#where-dialog').dialog('open');
                                }
                                else
                                    $('#bad-selection-dialog').dialog('open');
                            }
                            else {
                                if(typeof(BulkAddProductPages) == 'function') {
                                    BulkAddProductPages();
                                }
                            }
                        }";
                }).GetHtml()
                        <img id="product-page-searching-icon" style="display: none;" src="/Images/SystemIcons/searching-icon.gif" alt="searching" />
                        <div style="clear: both"></div>
                    </div>
                    <div id="product-page-data-view-container" style="background-color: white;">
                        @Html.Action("ProductPageSearch", "ProductPages")
                    </div>
                </div>
            </fieldset>
            <div style="clear: both"></div>
        </div>
        <script type="text/javascript">
            if (typeof (InitProductPagesDragDrop) == 'function')
                InitProductPagesDragDrop();
        </script>
    </div>



    <div style="float: right; margin-right: 17px">
        <div style="float: left; border: 1px solid #cdcdcd; background-color: #ededed; width: 192px; text-align: center; position: relative; top: 4px; z-index: 10; -webkit-border-radius: 8px 8px 0 0; -moz-border-radius: 8px 8px 0 0; border-radius: 8px 8px 0 0; padding: 0 10px;">
            <h5>Product Page</h5>
        </div>
        <div style="float: left; border: 1px solid #cdcdcd; background-color: #ededed; margin-left: 11px; width: 765px; text-align: center; position: relative; top: 4px; -webkit-border-radius: 8px 8px 0 0; -moz-border-radius: 8px 8px 0 0; border-radius: 8px 8px 0 0; padding: 0 10px; ">
            <h5>Related Product Pages</h5>
        </div>

        <div style="clear: both;"></div>

        <div style="float: left; width: 192px; background-color: #ededed; height: 20px; border: 1px solid #cdcdcd; border-top: 0; position: relative; z-index: 5; "></div>
        <div style="float: left; width: 765px; margin-left: 11px; position: relative; z-index: 100;">
            <div id="top-scroll-wrapper" style="border: 1px solid #cdcdcd">
                <div id="top-scroll-holder">
                    &nbsp;
                </div>
            </div>
        </div>
    </div>
    <div style="float: right; margin-bottom: 2em; width: 986px; border: none !important;">

        <div id="ajax-target" style="float: right; width: 986px; overflow-y: scroll; position: relative; top: -1px; left: 1px; border: none !important; height: 770px !important;">

        </div>
        <div id="resource-panel-container" style="float: right; width: 986px;">
            <div id="pagination" class="jquery-pagination"></div>
            <div id="page-limit-wrapper" style="display: none;">
                @Html.DevExpress().Label(settings =>
                {
                    settings.Name = "PageSizeLabel";
                    settings.Text = "Page Size";
                    settings.Style.Add("float", "left");
                    settings.Style.Add("margin", "0 1em 7px 2em");
                    settings.Height = 35;
                    settings.Style.Add("line-height", "35px");
                }).GetHtml()
                                @Html.DevExpress().DropDownEdit(settings =>
                {
                    settings.Name = "PageLimitDD";
                    settings.Style.Add("float", "left");
                    settings.Style.Add("margin", "0 7px 7px 0");
                    settings.Width = 50;
                    settings.Height = 35;
                    settings.Properties.ClientSideEvents.Init = @"function(s, e) {
                        s.SetText(PageLimit.GetSelectedItem().text);
                    }";
                    settings.SetDropDownWindowTemplateContent(s =>
                    {
                        Html.DevExpress().ListBox(lbSettings =>
                        {
                            lbSettings.Name = "PageLimit";
                            lbSettings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
                            lbSettings.Properties.Items.Add("25", 25);
                            lbSettings.Properties.Items.Add("50", 50);
                            lbSettings.Properties.Items.Add("100", 100);
                            lbSettings.Properties.Items.Add("250", 250);
                            lbSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
                                PageLimitDD.HideDropDown();
                                PageLimitDD.SetText(s.GetSelectedItem().text);
                                PageChangeCallback(0, null)
                            }";
                            lbSettings.SelectedIndex = 0;
                        }).Render();
                    });
                }).GetHtml()
                <div style="clear: both;"></div>
                <div id="total-wrapper">
                    <label>Total Results: <span id="total-results"></span></label>
                </div>
            </div>
            <div style="clear: both;"></div>
        </div>
    </div>

    <div style="clear: both;"></div>
</div>


<script type="text/javascript">

    var $original = $("#swap-original"),
      $replacement = $("#swap-replacement");

    $original.droppable({
        accept: ".productpage",
        activeClass: "ui-state-highlight-product-page-target",
        revert: false,
        drop: function (event, ui) {
            //OriginalAccept(ui.draggable);
            $(".original-placeholder").remove();
            $original.append($(ui.draggable).clone());
            $original.data("product-page-id", $(ui.draggable).data("product-page-id"));
            CheckSwapViability();
            $("#swap-original").children().each(function () {
                $(this).addClass("original-placeholder");
            });
        }
    });

    $replacement.droppable({
        accept: ".productpage",
        activeClass: "ui-state-highlight-product-page-target",
        revert: false,
        drop: function (event, ui) {
            //ReplacementAccept(ui.draggable);
            $(".replacement-placeholder").remove();
            $replacement.append($(ui.draggable).clone());
            $replacement.data("product-page-id", $(ui.draggable).data("product-page-id"));
            CheckSwapViability();
            $("#swap-replacement").children().each(function () {
                $(this).addClass("replacement-placeholder");
            });
        }
    });

    function CheckSwapViability() {
        if ($replacement.data("product-page-id") && $original.data("product-page-id")) {
            if ($replacement.data("product-page-id") != $original.data("product-page-id")) {
                SwapButton.SetEnabled(true);
            }
            else {
                SwapButton.SetEnabled(false);
            }
        }
        else {
            SwapButton.SetEnabled(false);
        }
    }

    function InitProductPagesDragDrop() {
        $(".multidraggable").draggable({
            helper: function (ev, ui) {
                var c = $(this).clone();
                c.addClass("rpp-td");
                c.find("img").css("width", "90%").css("height", "90%");
                c.find(".DataViewItemTitle").remove();
                c.find(".web-status").remove();
                c.css("opacity", "1.0");
                c.css("background-color", "#c5faa0");
                return c
            },//'clone',
            start: function (ev, ui) {
                $(".ui-multiselect-highlight-product-page").removeClass("ui-multiselect-highlight-product-page").css({
                    position: '',
                    width: '',
                    left: '',
                    top: '',
                    zIndex: ''
                });

                $("img", ui.helper).css("width", "100%");
                $("img", ui.helper).css("height", "100%");
                $(ui.helper).addClass('placeholder');
                $(ui.helper).css("background-color", "white");
                $(ui.helper).css("z-index", "300000");
            },
			connectToSortable: ".product-page > div.rpp-tr, #swap-original, #swap-replacement",
			cancel: '.not-sortable'
        });
    }

    function InitRelatedProductPagesDragDrop() {
        //$(".draggable").draggable({
        //    helper: 'clone',
        //    //revert: 'invalid',
        //    start: function (e, ui) {
        //        //$("#related-scroll-wrapper").scrollLeft(0);
        //        $(ui.helper).css("z-index", "300000");
        //    },
        //    connectToSortable: ".product-page > tr, #swap-original, #swap-replacement"
        //});

        $(".related-product-page-row").multidraggable({
            items: 'div.rpp-td',
            distance: 10,
            tolerance: "intersect",
            placeholder: 'placeholder',
            selectedClass: 'ui-multiselect-highlight-product-page',
            connectWith: ".related-product-page-row"
        });

        //$(".related-product-page-row").multisortable({
        //    items: 'td.productpage',
        //    distance: 20,
        //    tolerance: 20,
        //    selectedClass: 'ui-multiselect-highlight-product-page'
        //});
    }


    function RemoveRelatedProductPage(fromPage, ProductPageID) {
        $.ajax({
            url: '@Url.Action("RemoveRelatedProductPage", "ProductPages")',
            type: 'POST',
            traditional: true,
            data: { BaseProductPageID: fromPage, ProductPageID: ProductPageID },
            success: function (data) {
                $("#product-page-" + fromPage).find("[data-product-page-id='" + ProductPageID + "']").remove();

                if ($("#product-page-" + fromPage).children().eq(0).children().length == 0) {
                    $("#product-page-" + fromPage).children().eq(0).append("<td class='placeholder'>&nbsp;</td>");
                }

                var RelatedProductPages = new Array();
                $("#related-products").children("td").not(".placeholder").each(function (index) {
                    RelatedProductPages.push({ ID: $(this).data("product-page-id"), SortOrder: index });
                });

                UpdateRelatedProductPages(fromPage, RelatedProductPages, 1);
            },
            error: function (e, s, a) {
                alert(s + ' error, e.responseText was: ' + e.responseText);
                //log e
            },
            timeout: 20000
        });
    }

    function UpdateRelatedProductPages(ProductPageID, RelatedProductPages, changePageCallback) {
        $.ajax({
            url: '@Url.Action("UpdateRelatedProductPages", "RelatedProductPages")',
            type: 'POST',
            traditional: true,
            data: { BaseProductPageID: ProductPageID, ProductPages: JSON.stringify(RelatedProductPages) },
            success: function (data) {
                //GreenFade($("#product-page-" + ProductPageID + "-related-row"));
                if (typeof changePageCallback != 'undefined') {

                }
                else {
                    PageChangeCallback($("#current-page").val(), null);
                }
            },
            timeout: 60000
        });
    }

    function PageChangeCallback(page_index, jq) {
        if (typeof LoadingPanel == 'object')
            LoadingPanel.Show();

        var rpppnid = RelatedProductPagePrimaryNameOrIDTextBox.GetValue();

        if (rpppnid == "Name, Code or ID")
            rpppnid = null;

        $.ajax({
            url: '@Url.Action("RelatedProductPagePartial", "RelatedProductPages")',
            type: 'POST',
            traditional: true,
            data: {
                PP_NameOrID: rpppnid,
                PP_ProductTypeID: RelatedProductPagePrimaryProductTypeListBox.GetValue(),
                PP_CollectionID: RelatedProductPagePrimaryCollectionListBox.GetValue(),
                PP_BrandID: RelatedProductPagePrimaryBrandListBox.GetValue(),
                PP_LaunchID: RelatedProductPagePrimaryLaunchListBox.GetValue(),
                PP_TemplateID: RelatedProductPagePrimaryTemplateListBox.GetValue(),
                PP_StatusID: RelatedProductPagePrimaryStatusListBox.GetValue(),
                RPP_ProductTypeID: RelatedProductPageSecondaryProductTypeListBox.GetValue(),
                RPP_CollectionID: RelatedProductPageSecondaryCollectionListBox.GetValue(),
                RPP_BrandID: RelatedProductPageSecondaryBrandListBox.GetValue(),
                RPP_LaunchID: RelatedProductPageSecondaryLaunchListBox.GetValue(),
                RPP_TemplateID: RelatedProductPageSecondaryTemplateListBox.GetValue(),
                RPP_StatusID: RelatedProductPageSecondaryStatusListBox.GetValue(),
                RPP_Count: RelatedProductPageCount.GetValue(),
                RPP_CountOperator: RelatedProductPageCountOperator.GetValue(),
                PageLimit: PageLimit.GetValue(),
                PageOffset: page_index
            },
            success: function (data) {
                $('#ajax-target').html(data);
                if (!$("#page-limit-wrapper").is(":visible"))
                    $("#page-limit-wrapper").show();
                if (LoadingPanel)
                    LoadingPanel.Hide();

                InitProductPagesDragDrop();
                InitRelatedProductPagesDragDrop();
            },
            timeout: 30000
        });
        return false;
    }

    function ShareRelatedProductPages(ProductPageID) {
        $.confirm(function () {
            LoadingPanel.Show();
            $.ajax({
                url: '@Url.Action("ShareRelated", "RelatedProductPages")',
                type: 'POST',
                traditional: true,
                data: {
                    ProductPageID: ProductPageID
                },
                success: function (data) {
                    PageChangeCallback($("#current-page").val(), null);
                },
                error: function (e, s, a) {
                    alert(s + ' error, e.responseText was: ' + e.responseText);
                },
                timeout: 60000
            });
        }, function () { }, "are you sure?");
    }

    function LoadSuggestions(ProductPageID) {
        $.ajax({
            url: '@Url.Action("LoadSuggestions", "RelatedProductPages")',
            type: 'POST',
            traditional: true,
            data: {
                ProductPageID: ProductPageID
            },
            success: function (data) {
                $("#product-page-" + ProductPageID + "-related-row").html(data);
            },
            error: function (e, s, a) {
                alert(s + ' error, e.responseText was: ' + e.responseText);
            },
            timeout: 10000
        });
    }

    $(document).ready(function () {
        LoadingPanel.Show();
        PageChangeCallback(0, null);
    });
</script>
