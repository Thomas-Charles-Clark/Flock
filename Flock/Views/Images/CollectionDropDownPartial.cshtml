@{
    Layout = null;
}
@model List<Flock.Models.Collection>
@Html.DevExpress().DropDownEdit(
    settings =>
    {
        settings.Style.Add("float", "left");
        settings.Style.Add("margin", "0 7px 7px 0");
        settings.Name = "CollectionDD";
        settings.Text = "Collection";
        settings.Properties.DropDownWindowStyle.BackColor = System.Drawing.Color.FromArgb(0xEDEDED);

        settings.Width = System.Web.UI.WebControls.Unit.Pixel(200);
        settings.Height = System.Web.UI.WebControls.Unit.Pixel(35);
        
        settings.Properties.EnableClientSideAPI = true;

        settings.SetDropDownWindowTemplateContent(c =>
        {
            ViewContext.Writer.Write("<div id='collection-listbox'>");
            ViewContext.Writer.Write(@Html.Partial("~/Views/Images/CollectionListBoxPartial.cshtml", Model));
            ViewContext.Writer.Write("</div>");
            ViewContext.Writer.Write("<div style=\"padding: 6px;\">");
            @Html.DevExpress().Button(
                buttonSettings =>
                {
                    buttonSettings.Name = "collectionButtonClear";
                    buttonSettings.Text = "Clear";
                    buttonSettings.Style.Add("float", "left");
                    buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                        CollectionListBox.UnselectAll();
                        CollectionDD.HideDropDown(); 
                        CollectionDD.SetText('Collection');
                        $('#searching-icon').fadeIn('fast');
                        $.ajax({
                            url: '" + Url.Action("ImageSearch", "Images") + @"',
                            traditional: true,
                            data: { 
                                ProductType: ProductTypeListBox.GetValue(),
                                Brand: BrandListBox.GetValue(),
                                Launch: LaunchListBox.GetValue(),
                                Collection: CollectionListBox.GetValue(),
                                AspectRatio: AspectRatioListBox.GetValue(),
                                ImageType: ImageTypeListBox.GetValue(),
                                Perspective: PerspectiveListBox.GetValue(),
                                HotspotStatus: HotspotStatusListBox.GetValue(),
                                Colour: ColourListBox.GetValue(),
                                Room: RoomListBox.GetValue(),
                                Style: StyleListBox.GetValue(),
                                NameOrID: NameOrIDTextBox.GetValue(),
                                SearchWithinHotspots: SearchWithinHotspotsCheckbox.GetValue()
                            },
                            success: function(data) {
                                $('#image-data-view-container').html(data);
                                $('#searching-icon').fadeOut('slow');
                            },
                            error: function(e, s, a) {
                                $('#searching-icon').fadeOut('slow');
                                alert(e.responseText);
                            },
                            timeout: 20000
                        });
                    }";
                }
            )
            .Render();
            @Html.DevExpress().Button(
                buttonSettings =>
                {
                    buttonSettings.Name = "collectionButtonClose";
                    buttonSettings.Text = "Close";
                    buttonSettings.Style.Add("float", "right");
                    buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                        CollectionDD.HideDropDown();
                    }";
                }
            )
            .Render();
            ViewContext.Writer.Write("<div style='clear: both;'></div></div>");
        });
        settings.Properties.AnimationType = AnimationType.None;
    }
).GetHtml()