        }
        @if (Model.BrochureID != null)
        {
            @Html.Partial("BrochureSettingsPartial", Model)
        }
    </div>
</div>


    <div id="cover-image-dialog">
        @Html.Action("CoverImageFileManagerPartial", "Assets")
    </div>

    <div id="interactive-brochure-dialog">        
        @Html.Action("InteractiveBrochureFileManagerPartial", "Assets")
    </div>

    <div id="pdf-dialog">
        @Html.Action("PDFFileManagerPartial", "Assets")
    </div>



    <div style="clear: both;"></div>