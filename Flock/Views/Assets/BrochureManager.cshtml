        <div class="content-panel-container">
            <fieldset id="brochure-select-header">
                <legend style="color: black; cursor: default; border-bottom-color: #929292;">Brochure Grid</legend>
                <div id="brochure-select-header-inner" style="background-color: white;">
                    <div id="brochure-header-grid-container">
                        @using (Html.BeginForm())
                        {
                            @Html.Action("BrochureGridViewPartial")
                        }
                    </div>
                    <div style="clear: both"></div>
                </div>
            </fieldset>
        </div>
    </div>
    <div id="brochure-compose-container">
