@{
    ViewBag.Title = "Brochure Manager";
    Layout = "~/Views/Admin/_Layout.cshtml";
}
@model Flock.ViewModels.BrochureViewModel
@section styles {
    @Styles.Render("~/bundles/css/cms")
    @Styles.Render("~/Content/asset-management.css")
    @Styles.Render("~/Content/composition-base.css")
    @Styles.Render("~/Content/product-page-composition.css")
    
    <style type="text/css">
        .flag {
            width: 22px !important;
            height: 22px !important;
        }
        .country-restriction-flag {
            height: 54px;
            width: 54px;
        }
        #country-restriction-container {
            padding: 0.5em;
        }
    </style>
}
@section Scripts
{
    
    @Scripts.Render("~/Scripts/jquery.ui-widget.js")
    @Scripts.Render("~/Scripts/jquery.iframe-transport.js")
    @Scripts.Render("~/Scripts/jquery.fileupload.js")



<script type="text/javascript">
        $(function () {
            $("#cover-image-dialog").dialog({
                title: "Cover Image Selector",
                width: 750,
                height: "auto",
                resizable: false,
                modal: true,
                autoOpen: false,
                buttons: {
                    'Close': function () {
                        $(this).dialog("close");
                    }
                }
            });

            $("#interactive-brochure-dialog").dialog({
                title: "Interactive Brochure Selector",
                width: 750,
                height: "auto",
                resizable: false,
                modal: true,
                autoOpen: false,
                buttons: {
                    'Close': function () {
                        $(this).dialog("close");
                    }
                }
            });

            $("#pdf-dialog").dialog({
                title: "PDF Selector",
                width: 750,
                height: "auto",
                resizable: false,
                modal: true,
                autoOpen: false,
                buttons: {
                    'Close': function () {
                        $(this).dialog("close");
                    }
                }
            });

            $('#fileupload').fileupload({
                url: '@Url.Action("BrochureUpload", "Assets")',
                dataType: 'json',
                maxNumberOfFiles: 1,
                autoUpload: false,
                replaceFileInput: false,
                add: function (e, data) {
                    $(".upload-injected").remove();
                    data.context = $('<button type="button" class="upload-injected"/>').text('Upload')
                    .insertAfter($('#fileupload'))
                    .click(function () {
                        data.context = data.context.replaceAll($(this));
                        data.submit();
                        $('#progress-wrapper').fadeIn("fast");
                    });
                },
                done: function (e, data) {
                    $(".upload-injected").remove();
                    $('#progress-wrapper').fadeOut("fast");
                    if (data._response.result.files[0].name == "error") {
                        $("#alert-span").html(data._response.result.files[0].error);
                        $("#alert-span").css("color", "red");
                        $("#alert-span").fadeIn("fast");
                        window.setTimeout(function () { $("#alert-span").fadeOut("fast"); }, 10000);
                    }
                    else {
                        $("#alert-span").html(data._response.result.files[0].name + " uploaded OK");
                        $("#alert-span").css("color", "green");
                        $("#error-span").fadeIn("fast");
                        window.setTimeout(function () { $("#alert-span").fadeOut("fast"); }, 10000);
                        BrochureGridView.Refresh();
                    }
                },
                progressall: function (e, data) {
                    var progress = parseInt(data.loaded / data.total * 100, 10);
                    $('#progress .bar').css(
                        'width',
                        progress + '%'
                    );
                    $("#progress-text").html(progress + '%');
                }
            });
        });

        function InitCountryDragDrop() {
            $("#country-restriction-section").sortable({
                helper: "clone",
                connectWith: ".country-restriction-flag",
                placeholder: ".ui-state-highlight-country-restriction",
                update: function (ev, ui) {
                    if ($(ui.item).hasClass('country-flag')) {
                        $("#country-restriction-section").sortable("refresh");
                        window.CountryRestrictions = new Array();
                        if ($("#country-restriction-placeholder").length > 0)
                            $("#country-restriction-placeholder").remove();
                        $("#country-restriction-section").children("div").each(function (index) {
                            window.CountryRestrictions.push({ ID: $(this).data("country-id"), SortOrder: 0 });
                        });
                        UpdateCountryRestrictions();
                    }
                }
            });
            $(".country-flag").draggable({
                helper: "clone",
                start: function (e, ui) {
                    $(ui.helper).css("z-index", "300000");
                },
                connectToSortable: "#country-restriction-section"
            });
        }

        function UpdateCountryRestrictions() {
            $("#country-restriction-busy").fadeIn("fast");
            $.ajax({
                url: '@Url.Action("UpdateBrochureCountryRestrictions", "Assets")',
                type: "POST",
                traditional: true,
                data: { BrochureID: $('#selected-brochure-id').val(), Countries: JSON.stringify(window.CountryRestrictions) },
                success: function (data) {
                    $("#country-restriction-busy").fadeOut("fast");
                    $("#country-restriction-container").html(data);
                },
                error: function (e, s, a) {
                    $("#country-restriction-busy").fadeOut("fast");
                    alert(e.responseText);
                },
                timeout: 20000
            });
        }

        function RemoveCountryFromRestriction() {
            $("#country-restriction-section").sortable("refresh");
            window.CountryRestrictions = new Array();
            if ($("#country-restriction-placeholder").length > 0)
                $("#country-restriction-placeholder").remove();
            $("#country-restriction-section").children("div").each(function (index) {
                window.CountryRestrictions.push({ ID: $(this).data("country-id"), SortOrder: 0 });
            });
            UpdateCountryRestrictions();
        }

        function RemoveAllCountryRestrictions() {
            $.confirm(function () {
                window.CountryRestrictions = new Array();
                UpdateCountryRestrictions();
            }, function () { });
        }

        function SaveBrochureDetails() {
            var onDate = null;
            if (OnDate.GetValue() != null)
                onDate = OnDate.GetValue().toGMTString();
            var offDate = null;
            if (OffDate.GetValue() != null)
                offDate = OffDate.GetValue().toGMTString();
            LoadingPanel.Show();
            $.ajax({
                url: '@Url.Action("SaveBrochureDetails", "Assets")',
                type: 'POST',
                traditional: true,
                data: {
                    BrochureID: $("#selected-brochure-id").val(),
                    Name: Name.GetValue(),
                    Description: Description.GetValue(),
                    Code: Code.GetValue(),
                    CoverImagePath: CoverImagePath.GetValue(),
                    PDFPath: PDFPath.GetValue(),
                    InteractiveBrochureURL: InteractiveBrochureURL.GetValue(),
                    FileSizeMB: 0,
                    BrandID: BrandID.GetValue(),
                    LaunchID: LaunchID.GetValue(),
                    ProductTypeIDs: ProductTypesListBox.GetSelectedValues().toString(),
                    LanguageIDs: LanguagesListBox.GetSelectedValues().toString(),
                    OnDate: onDate,
                    OffDate: offDate
                },
                success: function (data) {
                    LoadingPanel.Hide();
                    $("#brochure-compose-container").html(data);
                    BrochureGridView.Refresh();
                    SuccessFade($("#brochure-details-save"));
                },
                error: function (e, s, a) {
                    LoadingPanel.Hide();
                    $("#brochure-compose-container").html(e.responseText);
                    FailureFade($("#brochure-details-save"));
                },
                timeout: 30000
            });
        }
</script>


}

<input type="hidden" id="selected-brochure-id" value="@(Model.BrochureID)" />

<h4 class="page-heading">
    Brochures
</h4>

