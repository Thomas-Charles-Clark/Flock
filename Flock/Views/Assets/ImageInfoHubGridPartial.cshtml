        MVCxGridViewColumn HotspotColumn = new MVCxGridViewColumn();
        HotspotColumn.Name = "HotspotCount";
        HotspotColumn.FieldName = "HotspotCount";
        HotspotColumn.Caption = "Hotspot Count";
        HotspotColumn.Settings.AllowAutoFilter = DefaultBoolean.True;
        HotspotColumn.Settings.ShowFilterRowMenu = DefaultBoolean.True;
        HotspotColumn.EditFormSettings.Visible = DefaultBoolean.False;
        HotspotColumn.HeaderStyle.Wrap = DefaultBoolean.True;
        HotspotColumn.Width = 60;
        settings.Columns.Add(HotspotColumn);

        MVCxGridViewColumn CreatedDT = new MVCxGridViewColumn();
        CreatedDT.Name = "CreatedDT";
        CreatedDT.FieldName = "CreatedDT";
        CreatedDT.Caption = "Date Created";
        CreatedDT.Settings.AllowAutoFilter = DefaultBoolean.True;
        CreatedDT.Settings.ShowFilterRowMenu = DefaultBoolean.True;
        CreatedDT.EditFormSettings.Visible = DefaultBoolean.False;
        CreatedDT.HeaderStyle.Wrap = DefaultBoolean.True;
        CreatedDT.Width = 60;
        settings.Columns.Add(CreatedDT);

        MVCxGridViewColumn ImportedDT = new MVCxGridViewColumn();
        ImportedDT.Name = "MergedDT";
        ImportedDT.FieldName = "MergedDT";
        ImportedDT.Caption = "Date Imported";
        ImportedDT.Settings.AllowAutoFilter = DefaultBoolean.True;
        ImportedDT.Settings.ShowFilterRowMenu = DefaultBoolean.True;
        ImportedDT.EditFormSettings.Visible = DefaultBoolean.False;
        ImportedDT.HeaderStyle.Wrap = DefaultBoolean.True;
        ImportedDT.Width = 60;
        settings.Columns.Add(ImportedDT);

        MVCxGridViewColumn DeleteRecommended = new MVCxGridViewColumn();
        DeleteRecommended.Name = "DeletedRecommended";
        DeleteRecommended.FieldName = "DeleteRecommended";
        DeleteRecommended.Caption = "Delete Recommended";
        DeleteRecommended.HeaderStyle.Wrap = DefaultBoolean.True;
        DeleteRecommended.Settings.AllowAutoFilter = DefaultBoolean.False;
        DeleteRecommended.Settings.AllowHeaderFilter = DefaultBoolean.True;
        DeleteRecommended.Settings.HeaderFilterMode = HeaderFilterMode.List;
        DeleteRecommended.EditFormSettings.Visible = DefaultBoolean.False;
        DeleteRecommended.SetDataItemTemplateContent(c =>
        {
            var i = Convert.ToByte(DataBinder.Eval(c.DataItem, "DeleteRecommended"));
            if (i == 0)
                ViewContext.Writer.Write("No");
            else if (i == 1)
                ViewContext.Writer.Write("Yes");
        });
        settings.Columns.Add(DeleteRecommended);

        settings.HeaderFilterFillItems = (s, e) =>
        {
            switch (e.Column.Name)
            {
                case "AspectRatioID":
                    e.Values.Clear();
                    foreach (var i in UoW.GetRepository<AspectRatio>().GetAll())
                        e.AddValue(i.Name, i.AspectRatioID.ToString());
                    e.AddShowAll();
                    break;
                case "PerspectiveID":
                    e.Values.Clear();
                    foreach (var i in UoW.GetRepository<Perspective>().GetAll())
                        e.AddValue(i.Name, i.PerspectiveID.ToString());
                    e.AddShowAll();
                    break;
                case "ImageTypeID":
                    e.Values.Clear();
                    foreach (var i in UoW.GetRepository<ImageType>().GetAll())
                        e.AddValue(i.Name, i.ImageTypeID.ToString());
                    e.AddShowAll();
                    break;
                case "DeletedRecommended":
                    e.Values.Clear();
                    e.AddValue("Yes", "true");
                    e.AddValue("No", "false");
                    e.AddShowAll();
                    break;
                default:
                    break;
            }
        };
    }).BindToLINQ("", "", (s, e) =>
    {
        var dataContext = new Flock.DAL.UnitOfWork<Flock.Models.FlockDataContext>();
        var source = dataContext.GetRepository<Flock.Models.vwImage>().GetAll().Where(p => p.DeletedDT == null);

        e.KeyExpression = "ImageID";
        e.QueryableSource = source;
    });
}
@grid.GetHtml()