@model List<Flock.Models.Country>
@if (Model.Count == 0)
{
    <div id="country-restriction-section" style="height: 120px;">
        <div id="country-restriction-placeholder" style="padding: 1em; font-size: 1.0em; background-color: white;">
            By default, Messages are available to all countries.<br /><br />Only add countries to this list if you<br/>want to restrict which countries can view this Message.
        </div>
    </div>
}
else
{
    <div id="country-restriction-section">
        @foreach (Flock.Models.Country Country in Model)
        {
            <div class="country-restriction-flag" data-country-id="@(Country.CountryID)" onmouseover="$(this).find('.image-remove-icon').stop().animate({opacity: 0.8}, 300)" onmouseout="$(this).find('.image-remove-icon').stop().animate({opacity: 0.0}, 300)">
                <img class="flag" src="~/Images/Icons/CountryFlags/30px/@(Country.CountryID).png" title="@(Country.LocalName)" />
                <img src="~/Images/SystemIcons/remove-icon.png" class="image-remove-icon" onclick="$(this).parent().remove(); RemoveCountryFromRestriction()" />
                <br />
                <label style="margin-top: 5px">@(Country.LocalName)</label>
            </div>
        }
        <div style='clear: both'></div>
    </div>
}

<script type="text/javascript">
    if (typeof (InitCountryDragDrop) == "function")
        InitCountryDragDrop();
</script>