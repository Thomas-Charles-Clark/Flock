@model Flock.ViewModels.ImageManagerViewModel
@{
    ViewBag.Title = "Image Manager";
    Layout = "~/Views/Admin/_Layout.cshtml";
}

@section styles {
    @Styles.Render("~/bundles/css/cms")
    @Styles.Render("~/Content/asset-management.css")
    @Styles.Render("~/Content/composition-base.css")
    
    @Styles.Render("~/bundles/composer")
    <style type="text/css">
        #ImageInfoGridView_tcFC0 {
            text-align: center;
        }
        #container {
            width: 1560px;
        }
        .ui-state-highlight-product-page {
            position: relative;
            display: table-cell;
            vertical-align: middle;
            opacity: 0.4;
            height: 190px;
            width: 191px;
            background-color: #f7dd88;
            box-sizing: border-box;
            -moz-box-sizing: border-box;
