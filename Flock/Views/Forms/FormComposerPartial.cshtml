@using Flock.Models
@model Flock.ViewModels.FormViewModel

<table id="form-details-table">
                <tr>
                    <td>
                        <label>Internal Name</label>
                    </td>
                    <td>
                        @Html.TextBoxFor(m => Model.Name, new { id = "FormInternalName" })
                        @Html.HiddenFor(m => Model.FormID, new { id = "FormID" })
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Display Title</label>
                    </td>
                    <td>
                        @Html.TextBoxFor(m => Model.DisplayTitle, new { id = "FormTitle" })
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Form Description</label>
                    </td>
                    <td>
                        @Html.TextAreaFor(m => Model.DescriptionText, new { cols = "45", rows = "3", id = "FormDescription" })
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Form Type</label>
                    </td>
                    <td>
                        @Html.DropDownListFor(m => Model.FormType, new[] { new SelectListItem() { Text = "Newsletter", Value = "1" }, new SelectListItem { Text = "Competition", Value = "2" } }, 
                            new { id = "form-type-select", onclick = "ToggleAffiliateSegment();" })
                    </td>
                </tr>
                <tr>
                    <td>
                        &nbsp;
                    </td>
                </tr>
                <tbody id="affiliate-segment" style="display: none;">
                    <tr>
                        <td>
                            <label>Affiliate</label>
                        </td>
                        <td>
                            @Html.DropDownList("MarketingPartnerID", new SelectList(Model.MarketingPartners, "MarketingPartnerID", "MarketingPartnerName"), "No Partner Selected")
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <Label>
                                Affiliate Text
                            </Label>
                        </td>
                        <td>
                            @Html.TextAreaFor(m => Model.MarketingPartnerText, new { cols = "45", rows = "3", id = "MarketingPartnerText" })
                        </td>
                    </tr>
                </tbody>
            </table>
             <input type="submit" style="margin-top: 2em;" value="Save" name="save-form-button" onclick="SaveForm(); return false;" />

<script type="text/javascript">
    if ($("#form-type-select").val() == "2")
        $("#affiliate-segment").show();
</script>