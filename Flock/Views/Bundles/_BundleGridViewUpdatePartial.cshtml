//    cbSettings.Style.Add("padding", "0");
//    cbSettings.Style.Add("display", "none");
//}).BindList(new List<ProductBundle>()).Render();
        } 
    </div>
</div>

<div class="clearfix"></div>

<table class="bundled-products">
    <thead>
        <tr>
            <th style="width: 50px;">

            </th>
            <th colspan="2" style="width: auto">
                Qty
            </th>
            <th>
                Code
            </th>
            <th>
                Name
            </th>
            <th>

            </th>
        </tr>
    </thead>
    <tbody id="products-list" data-bundle-product-id="@(Model.BundleID)">
        @foreach (var p in Model.BundledProducts)
        {
            long? imgId = p.Product.Product_Images.Where(q => q.PerspectiveID == 1).Select(q => q.ImageID).SingleOrDefault();

            <tr data-product-id="@p.ProductID">
                <td>
                    @if (imgId != null && imgId >= 0)
                    {
                        <img src="https://flock.designersguild.com/imagelibrary/32/@(imgId).jpeg" />
                    }
                </td>
                <td class="qty quantity">
                    @p.Quantity
                </td>
                <td class="quantity">
                    <div class="bundle-qty">
                        <span class="qty-inc-icon pointer material-icons" onclick="increaseQty($(this))" title="Add One">add</span>
                        <span class="qty-dec-icon pointer material-icons" onclick="decreaseQty($(this))" title="Remove One">remove</span>
                    </div>
                </td>
                <td>
                    @p.Product.Code
                </td>
                <td>
                    @p.Product.OrderFormName
                </td>
                <td class="quantity">
                    <span class="glyphicon glyphicon-remove" onclick="$(this).closest('tr').remove()"></span>
                </td>
            </tr>
        }
    </tbody>
</table>

<div style="display: flex; justify-content: space-between; align-items: center">
    @{
        Html.DevExpress().ValidationSummary().Render();
    }
    <div style="text-align: right; margin-left: auto">
        @{
            Html.DevExpress().Button(bSettings =>
            {
                bSettings.Name = "UpdateBtn";
                bSettings.Text = "Update";
                bSettings.ControlStyle.CssClass = "btn btn-success";
                bSettings.ClientSideEvents.Click = @"function(s, e) {
                BundleGridView.UpdateEdit();
            }";
                bSettings.Style.Add("margin-right", "12px");
            }).Render();

            Html.DevExpress().Button(bSettings =>
            {
                bSettings.Name = "CancelBtn";
                bSettings.Text = "Cancel";
                bSettings.ControlStyle.CssClass = "btn btn-danger";
                bSettings.ClientSideEvents.Click = @"function(s, e) {
                BundleGridView.CancelEdit();
            }";
            }).Render();
        }
    </div>
</div>


<script id="dxss_bundleAutocomplete" type="text/javascript">
    $("#product-search").autocomplete({
        //classes: {
        //    'account-no': 'account-no'
        //},
        appendTo: '#autocomplete-container',
        source: function (request, response) {
            $.ajax({
                url: "/Admin/Bundles/ProductCodeAutocomplete",
                type: "POST",
                dataType: "json",
                data: {
                    term: request.term
                },
                success: function (data) {
                    response($.map(data, function (item) {
                        return {
                            label: item.Code + " - " + item.OrderFormName,
                            value: item.Code,
                            imageId: item.ImageID || -1,
                            quantity: 1,
                            orderFormName: item.OrderFormName,
                            productId: item.ProductID
                        };
                    }));
                },
                error: function (xhr, textStatus, errorThrown) {
                    $.showError(xhr, textStatus, errorThrown);
                }
            });
        },
        minLength: 1,
        select: function (event, ui) {
            $("#products-list").append("<tr data-product-id='" + ui.item.productId + "'>" +
                "<td><img src='https://flock.designersguild.com/imagelibrary/32/" + ui.item.imageId + ".jpeg' /></td>" +
                "<td class='qty quantity'>" + ui.item.quantity + "</td>" +
                "<td class='quantity'>" +
                    "<div class='bundle-qty'>" +
                        "<span class='qty-inc-icon pointer material-icons' onclick='increaseQty($(this))' title='Add One'>add</span>" +
                        "<span class='qty-dec-icon pointer material-icons'  onclick='decreaseQty($(this))' title='Remove One'>remove</span>" +
                    "</div>" +
                "</td>" +
                "<td>" + ui.item.value + "</td>" +
                "<td>" + ui.item.orderFormName + "</td>" +
                "<td class='quantity'><span class='glyphicon glyphicon-remove' onclick='$(this).closest(\"tr\").remove()'></span></td>" +
                "</tr>");

            return false;
        },
        autoFocus: true,
    });
</script>