@using Flock.ViewModels;
@using Flock.Models;
@model BundleEditModel

@{ 
    Html.DevExpress().TextBoxFor(m => Model.BundleID, tbSettings => {
        tbSettings.ClientVisible = false;
    }).Render();

    Html.DevExpress().TextBoxFor(m => Model.Code, tbSettings =>
    {
        //tbSettings.Name = "Code";
        tbSettings.Properties.MaxLength = 50;
        tbSettings.Properties.Caption = "Code";
        tbSettings.Properties.CaptionCellStyle.Width = 112;
        tbSettings.Style.Add("margin", "4px 0px");
        tbSettings.Properties.ClientSideEvents.KeyDown = @"function(s,e) {
            OnCodeKeyDown(e.htmlEvent, s.GetInputElement(), s);
        }";
        if (Model.Code == null || Model.Code == "")
        {
            tbSettings.Properties.ClientSideEvents.Init = @"function(s, e) {
                s.SetText('BUND')
            }";
        }
        tbSettings.ShowModelErrors = true;
    }).Render();

    Html.DevExpress().ComboBoxFor(m => Model.BrandID, cbSettings =>
    {
        //cbSettings.Name = "BrandID";
        cbSettings.Properties.Caption = "Brand";
        cbSettings.Properties.CaptionCellStyle.Width = 112;
        cbSettings.Style.Add("margin", "4px 0px");
        cbSettings.Properties.ValueType = typeof(byte);
        cbSettings.Properties.ValueField = "BrandID";
        cbSettings.Properties.TextField = "Name";
        cbSettings.ShowModelErrors = true;
    }).BindList(Model.Brands).Render();

    Html.DevExpress().ComboBoxFor(m => Model.LaunchID, cbSettings =>
    {
        //cbSettings.Name = "LaunchID";
        cbSettings.Properties.Caption = "Launch";
        cbSettings.Properties.CaptionCellStyle.Width = 112;
        cbSettings.Style.Add("margin", "4px 0px");
        cbSettings.Properties.ValueType = typeof(short);
        cbSettings.Properties.ValueField = "LaunchID";
        cbSettings.Properties.TextField = "Name";
        cbSettings.ShowModelErrors = true;
    }).BindList(Model.Launches).Render();

    Html.DevExpress().ComboBoxFor(m => Model.ProductTypeID, cbSettings =>
    {
        //cbSettings.Name = "ProductTypeID";
        cbSettings.Properties.Caption = "Product Type";
        cbSettings.Properties.CaptionCellStyle.Width = 112;
        cbSettings.Style.Add("margin", "4px 0px");
        cbSettings.Properties.ValueType = typeof(byte);
        cbSettings.Properties.ValueField = "ProductTypeID";
        cbSettings.Properties.TextField = "Name";
        cbSettings.ShowModelErrors = true;
    }).BindList(Model.ProductTypes).Render();

    Html.DevExpress().TextBoxFor(m => Model.OrderFormName, tbSettings =>
    {
        //tbSettings.Name = "OrderFormName";
        tbSettings.Properties.CaptionCellStyle.Width = 112;
        tbSettings.Style.Add("margin", "4px 0px");
        tbSettings.Width = 300;
        tbSettings.Properties.MaxLength = 100;
        tbSettings.Properties.Caption = "Order Form Name";
        tbSettings.ShowModelErrors = true;
    }).Render();

    Html.DevExpress().TextBoxFor(m => Model.BasketName, tbSettings =>
    {
        //tbSettings.Name = "BasketName";
        tbSettings.Properties.CaptionCellStyle.Width = 112;
        tbSettings.Style.Add("margin", "4px 0px");
        tbSettings.Width = 300;
        tbSettings.Properties.MaxLength = 100;
        tbSettings.Properties.Caption = "Basket Name";
        tbSettings.ShowModelErrors = true;
    }).Render();

    Html.DevExpress().TextBoxFor(m => Model.ProductBundle, tbSettings => {
        tbSettings.ClientVisible = false;
        tbSettings.ShowModelErrors = true;
    }).Render();
}

<div class="clearfix"></div>

<div id="autocomplete-container">
    <div style="display: inline-flex; align-items: center; justify-content: space-between; gap: 1rem;">
        <label style="display: block;">Product Search</label>
        <input id="product-search" placeholder="Code / Name..."/>
        @{

