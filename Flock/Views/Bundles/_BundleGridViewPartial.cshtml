            column.Settings.HeaderFilterMode = HeaderFilterMode.CheckedList;
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.SetDataItemTemplateContent(c =>
            {
                bool enabledState = (bool)DataBinder.Eval(c.DataItem, "Enabled");
                if (enabledState)
                    ViewContext.Writer.Write("<span style='color: green'>" + DataBinder.Eval(c.DataItem, "Enabled") + "</span>");
                else
                    ViewContext.Writer.Write("<span style='color: red'>" + DataBinder.Eval(c.DataItem, "Enabled") + "</span>");
            });
        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "Status";
            column.Name = "Status";
            column.Caption = "Status";
            column.CellStyle.CssClass = "hideable-column";
            column.FilterCellStyle.CssClass = "hideable-column";
            column.HeaderStyle.CssClass = "hideable-column";
            column.Settings.HeaderFilterMode = HeaderFilterMode.CheckedList;
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.SetDataItemTemplateContent(c =>
            {
                char enabledState = '?';
                if (DataBinder.Eval(c.DataItem, "Status") != DBNull.Value && DataBinder.Eval(c.DataItem, "Status") != null)
                    enabledState = (char)DataBinder.Eval(c.DataItem, "Status");
                switch (enabledState)
                {
                    case 'C':
                        ViewContext.Writer.Write("<span style='color: green'>" + enabledState + "</span>");
                        break;
                    case 'D':
                        ViewContext.Writer.Write("<span style='color: red'>" + enabledState + "</span>");
                        break;
                    case 'L':
                        ViewContext.Writer.Write("<span style='color: orange'>" + enabledState + "</span>");
                        break;
                    case 'Y':
                        ViewContext.Writer.Write("<span style='color: orange'>" + enabledState + "</span>");
                        break;
                    default:
                        ViewContext.Writer.Write("<span style='color: black'>" + enabledState + "</span>");
                        break;
                }
            });
        });
        settings.Columns.Add(column =>
        {
            column.FieldName = "StatusID";
            column.Name = "StatusID";
            column.Caption = "Web Status";
            column.CellStyle.CssClass = "hideable-column";
            column.FilterCellStyle.CssClass = "hideable-column";
            column.HeaderStyle.CssClass = "hideable-column";
            column.Settings.HeaderFilterMode = HeaderFilterMode.CheckedList;
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.Width = 50;
            column.HeaderStyle.Wrap = DefaultBoolean.True;
            column.SetDataItemTemplateContent(c =>
            {
                var i = Convert.ToByte(DataBinder.Eval(c.DataItem, "StatusID"));
                string colour = "black";
                string statusText = "unknown";
                statusText = UoW.GetRepository<Status>().GetAll().Where(p => p.StatusID == i).Select(p => p.Name).Single();
                switch (i)
                {
                    case 0:
                        colour = "green";
                        break;
                    case 1:
                        colour = "orange";
                        break;
                    case 2:
                        colour = "orange";
                        break;
                    case 3:
                        colour = "green";
                        break;
                    case 4:
                        colour = "red";
                        break;
                    default: break;
                }
                string res = "<span style='float: left; color: " + colour + " '>" + statusText + "</span>";
                ViewContext.Writer.Write(res);
            });
            //settings.Columns.Add(WebStatusColumn);
        });

