@model Flock.ViewModels.BannerLocation_PageSection
@using Flock.DAL;
@using Flock.Models;
@{  
    switch(Model.BannerLocationGroup.BannerLocationGroupID) 
    {
        case 1:
            for (int i = 0; i < Model.Locations.Count; i++)
            {
                <div style="text-align: center; width: 100%; height: 160px; padding-top: 26px; background-color: #FEE998">
                    <img src="/images/icons/64/o_collection/pin2.png" title="Banner Location" />
                    <h4 style="color: #4D82B8;">BannerLocationID: @(Model.Locations[i].BannerLocationID)</h4>
                </div>
            }
            break;

        case 2:
        case 14:
            for (int i = 0; i < Model.Locations.Count; i++)
            {
                <div style="text-align: center; width: 49.4%; height: 160px; padding-top: 26px; float: @(i == (Model.Locations.Count - 1) ? "right" : "left"); background-color: #FEE998; ">
                    <img src="/images/icons/64/o_collection/pin2.png" title="Banner Location" />
                    <h4 style="color: #4D82B8">BannerLocationID: @(Model.Locations[i].BannerLocationID)</h4>
                </div>
            }
            break;

        case 3:
        case 15:
        case 16:
            for (int i = 0; i < Model.Locations.Count; i++)
            {
                <div style="text-align: center; width:  @(i == (Model.Locations.Count - 1) ? "33.5%" : "32.5%"); height: 160px; padding-top: 26px; float: left; margin-right: @(i == (Model.Locations.Count - 1) ? "0px" : "6px"); background-color: #FEE998; ">
                    <img src="/images/icons/64/o_collection/pin2.png" title="Banner Location" />
                    <h4 style="color: #4D82B8; font-size: 14.5px;">BannerLocationID: @(Model.Locations[i].BannerLocationID)</h4>
                </div>
            }
            break;

        case 4:
            for (int i = 0; i < Model.Locations.Count; i++)
            {
                <div style="text-align: center; width:  @(i == (Model.Locations.Count - 1) ? "23.5%" : "24%"); height: 160px; padding-top: 26px; float: left; margin-right: @(i == (Model.Locations.Count - 1) ? "0px" : "13px"); background-color: #FEE998; ">
                    <img src="/images/icons/64/o_collection/pin2.png" title="Banner Location" />
                    <h4 style="color: #4D82B8; font-size: 14.5px;">BannerLocationID: @(Model.Locations[i].BannerLocationID)</h4>
                </div>
            }
            break;

        case 9:
            for (int i = 0; i < Model.Locations.Count; i++)
            {
                <div style="text-align: center; width: 100%; height: 160px; padding-top: 26px; background-color: #FEE998">
                    <img src="/images/icons/64/o_collection/pin2.png" title="Banner Location" />
                    <h4 style="color: #4D82B8;">BannerLocationID: @(Model.Locations[i].BannerLocationID)</h4>
                </div>
            }
            break;


        case 11:
            for (int i = 0; i < Model.Locations.Count; i++)
            {
                <div style="text-align: center; width:  @(i == (Model.Locations.Count - 1) ? "23.5%" : "24%"); height: 160px; padding-top: 26px; float: left; margin-right: @(i == (Model.Locations.Count - 1) ? "0px" : "13px"); background-color: #FEE998; ">
                    <img src="/images/icons/64/o_collection/pin2.png" title="Banner Location" />
                    <h4 style="color: #4D82B8;">BannerLocationID: @(Model.Locations[i].BannerLocationID)</h4>
                </div>
            }
            break;


        case 13:
            for (int i = 0; i < Model.Locations.Count; i++)
            {
                <div style="text-align: center; width:  @(i == (Model.Locations.Count - 1) ? "23.5%" : "24%"); height: 160px; padding-top: 26px; float: left; margin-right: @(i == (Model.Locations.Count - 1) ? "0px" : "13px"); background-color: #FEE998; ">
                    <img src="/images/icons/64/o_collection/pin2.png" title="Banner Location" />
                    <h4 style="color: #4D82B8;">BannerLocationID: @(Model.Locations[i].BannerLocationID)</h4>
                </div>
            }
            break;

        default: break;
    }
}