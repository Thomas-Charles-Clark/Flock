                                    break;
                                case 4:
                                    colour = "red";
                                    break;
                                default: break;
                            }
                    }

                    <span class="product-page-cell-info">Status: <span style="color: @(colour); float: right;">@(Status.Select(p => p).FirstOrDefault())</span></span>
                    @if (PP.Clearance)
                    {
                        <span class="product-page-cell-info" style="color: red; font-weight: bold; letter-spacing: 0; float: right;">Clearance</span>
                    }
                    else
                    {
                        <br />
                    }

                    <div class="clearfix"></div>
                </div>
                <p style="font-size: 1.5em; height: 40px; margin: 5px 0;">@(PP.Name)</p>

                <div style="float: right; width: 50%;">
                    @{
                    decimal? avg = PP.ProductRating;
                    decimal pixelShift = 0;
                    if (avg.HasValue)
                    {
                        //that ^ is out of 4, need out of 110
                        pixelShift = (avg.Value * 110) / 5;
                        //pixelShift = avg * 2;
                        avg = (avg * 100) / 5; // to percentage
                        avg /= 20;
                        var niceAvg = Math.Round(avg.Value * 100) / 100;
                    }

                    <span class="product-page-cell-info" style="float: right; font-size: 1em; line-height: 15px;">
                        (@(PP.ProductRatingCount.HasValue ? PP.ProductRatingCount.Value : 0))
                    </span>

                        <div class='starRatingMaskWrapper' style="position: relative; float: right; width: 110px; top: 1px; margin-right: 0.25em;">
                            <div class='fiveStarRating' style='width: @(pixelShift)px'></div>

