@model Flock.ViewModels.HTML_PageSection

<textarea id="pagesection-@(Model.PageSectionID)-htmlEditor">@(Model.Contents)</textarea>

<script type="text/javascript">
    window["PageSection@(Model.PageSectionID)HTMLEditor"] = CodeMirror.fromTextArea(document.getElementById('pagesection-@(Model.PageSectionID)-htmlEditor'), {
        lineNumbers: true,
        autoCloseTags: true,
        mode: "htmlmixed"
    });
    window["PageSection@(Model.PageSectionID)HTMLEditor"].HTMLSectionID = @(Model.HTMLSectionID);
</script>

