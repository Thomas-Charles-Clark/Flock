@Html.DevExpress().ComboBox(settings =>
{
    settings.Name = "Form" + ViewBag.FormID + "PromotionCodeID";
    settings.CallbackRouteValues = new { Controller = "CMS", Action = "PromotionCodeIDComboBoxPartial" };
    settings.Properties.ClientSideEvents.BeginCallback = @"function (s, e) { 
        e.customArgs['formId'] = "+ViewBag.FormID+@";
    }";
    settings.Properties.CallbackPageSize = 15;
    settings.Properties.ValueField = "PromotionCodeID";
    settings.Properties.ValueType = typeof(short);
    settings.Properties.TextField = "Description";
    settings.Properties.IncrementalFilteringMode = IncrementalFilteringMode.StartsWith;
    settings.Properties.IncrementalFilteringDelay = 1000;
    settings.Height = 35;
    settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
    //settings.Properties.DropDownWidth = 350;
    //settings.Properties.DropDownStyle = DropDownStyle.DropDown;
    //settings.Properties.Columns.Add("PageID", "Page ID", 60);
    //settings.Properties.Columns.Add("Name", "Name", 270);
    settings.ShowModelErrors = true;
    settings.Properties.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.ImageWithTooltip;
}).BindList(Flock.ViewModels.LargeDatabaseDataProvider.GetPromotionCodes, Flock.ViewModels.LargeDatabaseDataProvider.GetPromotionCodeByID).Bind((short?)ViewBag.PromotionCodeID).GetHtml()

