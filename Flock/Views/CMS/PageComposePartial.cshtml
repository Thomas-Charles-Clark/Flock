@model Flock.ViewModels.PageComposeViewModel
    <div id="page-basic-details-container">
    @Html.Partial("PageBasicInfoPartial", Model)
</div>
<div id="page-detail-container">
    @Html.Partial("PageDetailsPartial", Model)
</div>
<div id="page-country-restrictions-container">
    @Html.Partial("PageCountryRestrictionsPartial", Model.CountryRestrictions)
</div>
<div id="related-pages-container">
    @Html.Partial("PageRelatedPagesPartial", Model.RelatedPages)
</div>

<script type="text/javascript">
    function filterPageSections() {
        LoadingPanel.Show();
        var data = {
            pageId: $('#page-compose-section').data('page-id'),
            countryId: PageSectionCountryListBox.GetValue(),
            pageSectionTypeId: PageSectionTypeListBox.GetValue(),
            tradeSwitch: PageSectionAudienceListBox.GetValue(),
            platformSwitch: PageSectionPlatformListBox.GetValue(),
            webStatus: PageSectionWebStatusListBox.GetValue()
        };
        $.ajax({
            url: '/admin/cms/PageSectionsPartial',
            type: 'GET',
            data: data,
            success: function (data) {
                $('#page-sections-container').html(data);
                LoadingPanel.Hide();
            }
        });
    }
</script>

<div id="shuffle-button" class="shuffle-page-section-button" onclick="ReloadSectionsForShuffle();">
    <fieldset>
        <legend id="shuffle-label">
            Shuffle Page Sections
        </legend>
    </fieldset>
</div>

<div class="add-page-section-button" style="width: 80%" onclick="OpenAddPageSectionDialog();">
    <fieldset>
        <legend>
            Add Page Section
        </legend>
    </fieldset>
</div>

<div style="clear: both;"></div>

@if (Model.PageSections.Count > 0)
{
    <div class="well" style="padding: 10px 5px 5px 5px;">
        @Html.Action("GlobalCountryLanguageSelector", "Home")
        @Html.Action("PageComposePageSectionTypeDropDown", "CMS")
        @Html.Action("PageComposePageSectionAudienceDropDown", "CMS")
        @Html.Action("PageComposePageSectionPlatformDropDown", "CMS")
        @Html.Action("PageComposePageSectionWebStatusDropDown", "CMS")
        <div class="clearfix"></div>
    </div>

    <div id="expand-all-button" style="float: left; margin-bottom: 2em;" class="expando-all-button" onclick="ExpandLHS();">
        <fieldset>
            <legend id="expand-label">
                Expand All
            </legend>
        </fieldset>
    </div>

    <div id="collapse-all-button" style="float: right; margin-bottom: 2em;" class="expando-all-button" onclick="CollapseLHS();">
        <fieldset>
            <legend id="collapse-label">
                Collapse All
            </legend>
        </fieldset>
    </div>
    <div style="clear: both"></div>
}
<div id="page-sections-container">
    @Html.Partial("PageSectionsPartial", Model.PageSections)
</div>

