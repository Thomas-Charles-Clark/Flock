@using Flock.ViewModels
@model Animation_PageSection
@if(Model.Animation == null) 
{
    
}
else
{

    @Html.DevExpress().ImageSlider(settings =>
    {
        settings.Name = "PageSectionAnimation" + Model.PageSectionID;
        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
        settings.Height = System.Web.UI.WebControls.Unit.Percentage(100);
        settings.EnableTheming = true;
        settings.ShowNavigationBar = true;
        settings.SettingsImageArea.ImageSizeMode = ImageSizeMode.FitProportional;
        settings.SettingsImageArea.ItemTextVisibility = ElementVisibilityMode.OnMouseOver;
        settings.SettingsImageArea.NavigationButtonVisibility = ElementVisibilityMode.None;
        settings.SettingsImageArea.NavigationDirection = NavigationDirection.Horizontal;
        settings.SettingsImageArea.AnimationDuration = 600;
        settings.SettingsBehavior.AllowMouseWheel = true;
        settings.SettingsBehavior.EnablePagingByClick = AutoBoolean.True;
        settings.SettingsBehavior.EnablePagingGestures = true;
        settings.SettingsBehavior.ExtremeItemClickMode = ExtremeItemClickMode.SelectAndSlide;
        settings.SettingsBehavior.ImageLoadMode = ImageLoadMode.Auto;
        settings.SettingsNavigationBar.ItemSpacing = 8;
        settings.SettingsNavigationBar.Mode = NavigationBarMode.Dots;
        settings.SettingsNavigationBar.PagingMode = NavigationBarPagingMode.Single;
        settings.SettingsNavigationBar.Position = NavigationBarPosition.Bottom;
        settings.SettingsNavigationBar.ThumbnailsModeNavigationButtonVisibility = ElementVisibilityMode.None;
        settings.SettingsNavigationBar.VisibleItemsCount = 10;
        settings.SettingsSlideShow.AutoPlay = true;
        settings.SettingsSlideShow.Interval = 4000;
        settings.SettingsSlideShow.PausePlayingWhenMouseOver = true;
        settings.SettingsSlideShow.PlayPauseButtonVisibility = ElementVisibilityMode.OnMouseOver;
        settings.SettingsSlideShow.StopPlayingWhenPaging = true;

        var operation = "*";
        if (Convert.ToDecimal(Model.Animation.AspectRatio.AspectRatio1) > 1)
        {
            operation = "/";
        }
        
        var desiredWidth = 980;

        if (Model.Animation.AspectRatio.AspectRatio1 == 1.869M || Model.Animation.AspectRatio.AspectRatio1 == 3.000M)
        {
            desiredWidth = 726;
        }

        settings.ClientSideEvents.Init = @"function(s, e) {
            var width = " + desiredWidth + @"; //$('#page-section-" + Model.PageSectionID + @"-slideshow').width();
            var desiredHeight = width / " + Model.Animation.AspectRatio.AspectRatio1 + @";
            $('#page-section-" + Model.PageSectionID + @"-slideshow').css('height', desiredHeight + 'px');
            $('#page-section-" + Model.PageSectionID + @"-panel').css('height', desiredHeight + 'px');
            s.AdjustControl();
        }";
        

        settings.ClientSideEvents.ActiveItemChanged = @"function(s, e) {
            $('.hotspot-reveal').stop(true).css('display', 'none');
        }";
        if (Model.Animation.Slides.Where(p => p.DeletedDT == null && p.Image?.DeletedDT == null).Count() == 0)
        {
            settings.Items.Add(
                item =>
                {
                    item.ImageUrl = "/images/admin/ar" + Model.Animation.AspectRatioID.ToString() + "-placeholder.png";
                    item.NavigateUrl = null;
                    item.SetTextTemplateContent("");
                });
        }
        else
        {
            foreach(var s in Model.Animation.Slides.Where(p => p.DeletedDT == null && p.Image?.DeletedDT == null).OrderBy(p => p.SortOrder))
            {
                settings.Items.Add(
                item =>
                {
                    if (s.ImageID != null)
                    {
                        item.ImageUrl = "https://flock.designersguild.com/imagelibrary/986/" + s.ImageID + ".jpeg";
                    }
                    if (s.VideoID != null)
                    {
                        var vidCode = s.Video.EmbedCode;
                        
                        item.ImageUrl = null;
                        item.SetTemplateContent(c => {
                            ViewContext.Writer.Write(vidCode);
                        });
                    }
                    item.NavigateUrl = null;
                });
            }
        }
    }).GetHtml()
}