@model Flock.Controllers.CMSController.BrochurePageSection
@Html.DevExpress().ComboBox(settings =>
{
    settings.Name = "ComposePageBrochureComboBox" + Model.PageSectionID.ToString();
    settings.Properties.NullDisplayText = "Find Brochure...";
    settings.Properties.NullText = "Find Brochure...";
    settings.Style.Add("margin", "0");
    settings.Width = 200;
    settings.Height = 35;
    settings.Properties.DropDownStyle = DropDownStyle.DropDown;
    settings.CallbackRouteValues = new { Controller = "CMS", Action = "PageSectionBrochureSelectPartial" };
    settings.Properties.CallbackPageSize = 10;
    settings.Properties.DropDownRows = 10;
    settings.Properties.TextField = "Name";
    settings.Properties.TextFormatString = "{0}";
    settings.Properties.ValueField = "BrochureID";
    settings.Properties.ValueType = typeof(int);
    settings.Properties.EnableClientSideAPI = true;
    settings.Properties.FilterMinLength = 2;
    settings.Properties.IncrementalFilteringMode = IncrementalFilteringMode.Contains;

    if (Model.Brochure != null)
    {
        settings.Properties.ClientSideEvents.BeginCallback = @"function(s, e) {
            e.customArgs['PageSectionID'] = " + Model.PageSectionID + @"
            e.customArgs['BrochureID'] = " + Model.BrochureID + @"
        }";
    }
    else
    {
        settings.Properties.ClientSideEvents.BeginCallback = @"function(s, e) {
            e.customArgs['PageSectionID'] = " + Model.PageSectionID + @"
        }";
    }

    settings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
        s.SetText(s.GetSelectedItem().text);
        s.HideDropDown();
    }";

    if (Model.Brochure != null)
    {
        settings.Properties.ClientSideEvents.Init = @"function(s, e) {
        s.SetSelectedItem(s.FindItemByValue(" + Model.BrochureID + @"));
        s.SetText(s.GetSelectedItem().text);
    }";
    }
}).BindList(args =>
{
    return Flock.ViewModels.LargeDatabaseDataProvider.BrochureHelper(args, Model.Brochure == null ? null : (object)Model.BrochureID);
}, Flock.ViewModels.LargeDatabaseDataProvider.GetBrochureByID).GetHtml()
@*.BindList(Flock.ViewModels.LargeDatabaseDataProvider.GetBrochureList, Flock.ViewModels.LargeDatabaseDataProvider.GetBrochureByID).GetHtml()*@