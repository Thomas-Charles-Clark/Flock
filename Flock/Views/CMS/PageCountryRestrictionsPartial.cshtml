@model List<Flock.Models.Country>
<div class="content-panel-container">
    <fieldset id="country-restriction-fieldset">
        <legend onclick="$('#country-restriction-section').slideToggle('fast');">
            Country Restrictions (click to expand / contract)
            <img id="country-restriction-busy" src="~/Images/SystemIcons/busy-icon-purple.gif" />
            <a id="country-restriction-remove-all" href="#" onclick="RemoveAllCountryRestrictions(); return false;">
                Remove All
            </a>
        </legend>
        @if (Model.Count == 0)
        {
            <div id="country-restriction-section" class="fieldset-inner">
                <div id="country-restriction-placeholder" class="page-country-restriction-placeholder">
                    By default, Pages are available to all countries.<br /><br />Only add countries to this list if you want to restrict which countries can view this Page.
                </div>
            </div>
        }
        else
        {
            <div id="country-restriction-section" class="fieldset-inner">
                @foreach (Flock.Models.Country Country in Model)
                {
                    <div class="country-restriction-flag" data-country-id="@(Country.CountryID)" onmouseover="$(this).find('.image-remove-icon').stop().animate({opacity: 0.8}, 300)" onmouseout="$(this).find('.image-remove-icon').stop().animate({opacity: 0.0}, 300)">
                        <img class="flag" src="~/Images/Icons/CountryFlags/256px/@(Country.CountryID).png" title="@(Country.LocalName)" />
                        <img src="~/Images/SystemIcons/remove-icon.png" class="image-remove-icon" onclick="$(this).parent().remove(); RemoveCountryFromRestriction()" />
                        <br />
                        <label style="margin-top: 5px">@(Country.LocalName)</label>
                    </div>
                }
                <div style="clear:both;" class="page-country-restriction-placeholder"></div>
            </div>
        }
    </fieldset>
</div>

<script type="text/javascript">
    if (typeof (InitCountryDragDrop) == "function")
        InitCountryDragDrop();
</script>