 @using Flock.ViewModels
@model HTML_PageSection
<div class="content-panel-container" data-page-section-type="@(Model.PageSectionTypeID)" data-page-section-id="@(Model.PageSectionID)">
    <fieldset>
        <legend onclick="@(ViewBag.IsUserShuffling ? "" : "$('#page-section-" + Model.PageSectionID + "').slideToggle('fast');")">
            HTML @(ViewBag.IsUserShuffling ? "(click and drag to reorder)" : "(click to expand / contract)")
            <span style="margin: 0 4px;">Page SectionID: @(Model.PageSectionID)</span>
            <span style="margin: 0 4px;">HTML SectionID: @(Model.HTMLSectionID)</span>
            <img id="page-section-@(Model.PageSectionID)-remove" title="Remove" class="pagesection-remove-icon" src="/images/systemicons/remove-icon.png" onclick="event.stopPropagation(); RemovePageSection(@(Model.PageSectionID));" />
            <img id="page-section-@(Model.PageSectionID)-save" title="Save" class="pagesection-save-icon" src="/images/icons/32/save.png" onclick="event.stopPropagation(); saveHTMLSection(@(Model.PageSectionID)); SavePageSectionDetails(@(Model.PageSectionID));" />
            <img id="page-section-@(Model.PageSectionID)-advanced" title="Advanced" class="pagesection-advanced-icon" src="/images/admin/gear.png" onclick="event.stopPropagation(); ShowAdvancedSettings(@(Model.PageSectionID), @(Model.PageSectionTypeID));" />
            <img id="pagesection-@(Model.PageSectionID)-clone" src="~/Images/icons/32/o_collection/element_copy.png" class="pagesection-clone-icon" title="Clone Page Section" onclick="event.stopPropagation(); $('#clone-popup-page-section-id').val(@(Model.PageSectionID)); ClonePageSectionPopup.Show();" />
            <img id="page-section-@(Model.PageSectionID)-busy" class="fieldset-busy" src="/images/systemicons/busy-icon.gif" />
        </legend>
        <div id="page-section-@(Model.PageSectionID)-header-details" class="pagesection-header">
            @Html.Partial("PageSectionHeaderDetails", Model)
        </div>
        <div data-page-section-id="@(Model.PageSectionID)" data-page-section-type="@(Model.PageSectionTypeID)" style="padding: 1em; padding-bottom: 0; background-color: white;">
            @Html.Partial("CountryLanguageRestrictionPartial", Model.CountryLanguageRestrictions)
        </div>
        <div id="page-section-@(Model.PageSectionID)" style="@(ViewBag.IsUserShuffling ? "display: none;" : "")" class="fieldset-inner page-section-hideable">
            <div id="page-section-@(Model.PageSectionID)-html-editor">
                @using (Html.BeginForm()) { 
                    @(ViewBag.IsUserShuffling ? MvcHtmlString.Empty : Html.Partial("PageSectionHtmlEditor", Model))
                }
            </div>
        </div>
    </fieldset>
</div>
