@model Flock.ViewModels.PageComposeViewModel
    <input type="hidden" id="current-page-id" value="@(Model.PageID)" />
<script type="text/javascript">
    function EnableFilterIndexingChanged(s, e) {
        // we need to check if there are > 1 product page grids on this page, if so refuse the check

        // this is trivial and insufficient: we need to check that there is one product page grid CURRENTLY AVAILABLE
        // per SET OF COUNTRY RESTRICTIONS... ugh.

        let unset = false;
        if ($('.product-page-grid-container').length == 0 ||
            $('.product-page-grid-container').length > 1) {
            $.info('Sorry', 'Only pages with exactly 1 product page grid may perform filter indexing.');
            unset = true;
        } else {
            let pageSectionId = $('.product-page-grid-container').first().data('page-section-id');
            let productTypeId = window[`PageSection${pageSectionId}ProductTypeID`].GetValue();
            if (!productTypeId) {
                $.info('Sorry', `Page Section ${pageSectionId} must have a Product Type set to permit filter indexing.`);
                unset = true;
            }
        }

        if (unset) {
            EnableFilterIndexing.SetValue(false);
        }
    }
</script>

<script type="text/javascript">
    function PageProductTypeIDChanged(s, e) {
        let selectedProductTypeId = s.GetValue();
        let update = false;
        if (selectedProductTypeId) {
            let grids = document.querySelectorAll('.product-page-grid-container');
            let nonConformingTypes = [];
            grids.forEach(grid => {
                nonConformingTypes = nonConformingTypes.concat([...grid.querySelectorAll('.product-page-cell:not([data-product-type-id="' + selectedProductTypeId + '"])')]);
            });
            if (nonConformingTypes.length) {
                window.nonConforming = $.info('Sorry', 'You have ' + grids.length + ' Product Page Grid(s) on this page containing a total of ' + nonConformingTypes.length + ' product(s) which do not match that type. Please remove them before selecting a single product type for the page. <a href="javascript:;" style="color: #0072c6" onclick="PageRemoveNonConformingProductTypes(' + nonConformingTypes.length + ')">Click here</a> to remove them automatically.', () => {
                    PageProductTypeID.SetValue(null);
                });
            } else {
                update = true;
            }
        } else {
            update = true;
        }

        if (update) {
            $.ajax({
                url: '/admin/cms/getProductTypeURLKeywordsById',
                type: 'POST',
                data: {
                    productTypeId: selectedProductTypeId
                },
                success: (d) => {
                    URLKeywords.SetValue(d);
                    if (selectedProductTypeId)
                        URLKeywords.SetEnabled(false);
                    else
                        URLKeywords.SetEnabled(true);
                    SavePageDetails(@(Model.PageID));
                    SavePageBasicDetails();
                }
            });
        }
    }
    function PageRemoveNonConformingProductTypes(count) {
        $.confirm(() => {
            let selectedProductTypeId = PageProductTypeID.GetValue();
            if (window.nonConforming) {
                $(window.nonConforming).dialog('close');
            }
            let grids = document.querySelectorAll('.product-page-grid-container');
            grids.forEach(grid => {
                grid.querySelectorAll('.product-page-cell:not([data-product-type-id="' + selectedProductTypeId + '"])').forEach(e => {
                    e.remove();
                });
                UpdateProductPageGrid(grid.dataset.pageSectionId);
            });
            setTimeout(() => {
                PageProductTypeID.SetValue(selectedProductTypeId);
                PageProductTypeIDChanged(PageProductTypeID);
            });
        }, null, null, 'This will remove a total of ' + count + ' product pages across the grids on this page.');
    }
</script>

