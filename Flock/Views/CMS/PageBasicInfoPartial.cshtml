                                @(a.Name)
                            </span>
                        }
                        @(Model.CanonicalPage?.ProductType?.NamePlural)
                    </a>
                }
                else
                {
                    <a id="page-@(Model.PageID)-canonical-name" class="page-canonical-name" href="javascript:;" onclick="LoadCanonicalPageAttributeSettings(CanonicalPageID.GetValue(), @(Model.PageID))">
                        @(Model.CanonicalPage?.ProductType?.NamePlural)
                    </a>
                }
            <div style="clear: both;"></div>
            <hr class="margin-bottom-15"/>
            <img id="page-basic-details-save" class="pagesection-save-icon" src="/images/icons/32/save.png" style="margin-right: 0;" onclick="SavePageBasicDetails();" />
            <div style="clear: both;"></div>
        </div>
