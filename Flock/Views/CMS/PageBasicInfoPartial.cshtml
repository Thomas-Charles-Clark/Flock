</div>
<script type="text/javascript">
    function SavePageBasicDetails() {
        $("#page-basic-details-busy").fadeIn("fast");
        let cpid = CanonicalPageID.GetValue();
        console.log(cpid);
        $.ajax({
            url: '@Url.Action("UpdatePageBasicDetails", "CMS")',
            type: 'POST',
            traditional: true,
            data: {
                PageID: '@Model.PageID',
                Name: PageName.GetValue(),
                New: New.GetValue(),
                //RelatedFilterFontColour: RelatedFilterFontColour.GetValue(),
                //RelatedFilterBold: RelatedFilterBold.GetValue(),
                SiteSectionID: SiteSectionID.GetValue(),
                CalculateDiscount: CalculateDiscount.GetValue(),
                ProductTypeID: PageProductTypeID.GetValue(),
                Clearance: Clearance.GetValue(),
                ShowRecentlyViewed: ShowRecentlyViewed.GetValue(),
                NoIndex: NoIndex.GetValue(),
                NoFollow: NoFollow.GetValue(),
                CanonicalPageID: cpid,
                EnableFilterIndexing: EnableFilterIndexing.GetValue()
            },
            success: function (data) {
                $("#page-basic-details-container").html(data);
                $("#page-basic-details-busy").fadeOut("fast");
                SuccessFade($("#page-basic-details-save"));
            },
            error: function (e, s, a) {
                $("#page-basic-details-container").html(e.responseText);
                $("#page-basic-details-busy").fadeOut("fast");
                FailureFade($("#page-basic-details-save"));
            },
            timeout: 20000
        });
    }
</script>