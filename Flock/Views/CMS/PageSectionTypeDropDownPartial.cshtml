@model List<Flock.Models.PageSectionType>
@Html.DevExpress().DropDownEdit(
    settings =>
    {
        settings.Style.Add("float", "left");
        settings.Style.Add("margin", "0 7px 7px 0");

        settings.Name = "PageSectionTypeDD";
        settings.Text = "Page Section Type";
        settings.Properties.DropDownWindowStyle.BackColor = System.Drawing.Color.FromArgb(0xEDEDED);

        settings.Width = System.Web.UI.WebControls.Unit.Pixel(200);
        settings.Height = System.Web.UI.WebControls.Unit.Pixel(35);

        settings.Properties.EnableClientSideAPI = true;

        settings.SetDropDownWindowTemplateContent(c =>
        {
            @Html.DevExpress().ListBox(
                listBoxSettings =>
                {
                    listBoxSettings.Name = "PageSectionTypeListBox";
                    listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.Single;
                    listBoxSettings.Height = 200;
                    listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function (s, e) {
                        filterPageSections();
                        PageSectionTypeDD.HideDropDown();
                        PageSectionTypeDD.SetText(s.GetSelectedItem().text);
                    }";

                    listBoxSettings.ControlStyle.Border.BorderWidth = 0;
                    listBoxSettings.ControlStyle.BorderBottom.BorderWidth = 1;
                    listBoxSettings.ControlStyle.BorderBottom.BorderColor = System.Drawing.Color.FromArgb(0xDCDCDC);
                    listBoxSettings.Width = System.Web.UI.WebControls.Unit.Percentage(100);


                    listBoxSettings.Properties.TextField = "Name";
                    listBoxSettings.Properties.ValueField = "PageSectionTypeID";
                }).BindList(Model).Render();

            ViewContext.Writer.Write("<div style=\"padding: 6px;\">");

            @Html.DevExpress().Button(buttonSettings => {
                buttonSettings.Name = "PageSectionTypeButtonClear";
                buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                    PageSectionTypeListBox.UnselectAll();
                    PageSectionTypeDD.HideDropDown(); 
                    PageSectionTypeDD.SetText('Page Section Type');
                    filterPageSections();
                }";
                buttonSettings.Text = "Clear";
                buttonSettings.Style.Add("float", "left");
            }).Render();

            @Html.DevExpress().Button(buttonSettings => {
                buttonSettings.Name = "PageSectionTypeButtonClose";
                buttonSettings.ClientSideEvents.Click = @"function(s, e) { 
                    PageSectionTypeDD.HideDropDown();
                }";
                buttonSettings.Text = "Close";
                buttonSettings.Style.Add("float", "right");
            }).Render();
            ViewContext.Writer.Write("<div style='clear: both;'></div></div>");
        });
        settings.Properties.AnimationType = AnimationType.None;
    }
).GetHtml()