                    </div>
                    <div id="page-section-@(sect.PageSectionID)" style="@(ViewBag.IsUserShuffling ? "display: none" : "")" class="fieldset-inner page-section-hideable">
                        <div id="brochure-section-@(sect.PageSectionID)" style="position: relative;" data-page-section-name="@(sect.PageSectionName)" data-page-section-id="@(sect.PageSectionID)">
                            @(ViewBag.IsUserShuffling ? MvcHtmlString.Empty : Html.Action("PageSectionBrochure", new { sect.PageSectionID }))
                        </div>
                        <div style="clear: both"></div>
                    </div>
                </fieldset>
            </div>
            break;
            case 8:
            <div class="content-panel-container" data-page-section-type="@(sect.PageSectionTypeID)" data-page-section-id="@(sect.PageSectionID)">
                <fieldset>
                    <legend onclick="@(ViewBag.IsUserShuffling ? "" : "$('#page-section-" + sect.PageSectionID + "').slideToggle('fast');")">
