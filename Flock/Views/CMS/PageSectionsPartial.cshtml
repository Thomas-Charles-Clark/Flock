@if(ViewBag.IsUserShuffling != null)
{
    if (ViewBag.IsUserShuffling)
    {
        <script type="text/javascript">
            $("#page-sections-container").sortable({
                helper: 'clone',
                scroll: false,
                placeholder: "ui-state-highlight-pagesection",
                update: function (ev, ui) {
                    UpdatePageSectionSortOrder();
                }
            });
        </script>
    }
