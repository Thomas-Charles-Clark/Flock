@using Flock.ViewModels
@model List<BasePageSection>

@foreach (BasePageSection sect in Model)
{
    switch (sect.PageSectionTypeID)
    {
        case 1:
            HTML_PageSection hps = sect as HTML_PageSection;
            @Html.Partial("PageSection_HtmlPartial", hps)
            break;
        case 2:
            Slideshow_PageSection sps = sect as Slideshow_PageSection;
            <div id="page-section-@(sps.PageSectionID)" class="content-panel-container" data-slideshow-id="@(sps.SlideshowID)" data-page-section-type="@(sps.PageSectionTypeID)" style="width: 986px;" data-page-section-id="@(sps.PageSectionID)">
                @Html.Partial("PageSection_SlideshowPartial", sps)
            </div>
            break;
        case 3:
            @*Form*@
            Form_PageSection fps = sect as Form_PageSection;
            <div id="page-section-@(fps.PageSectionID)-update-target" class="content-panel-container" data-form-id="@(fps.FormID)" data-page-section-type="@(fps.PageSectionTypeID)" data-page-section-id="@(sect.PageSectionID)" style="position: relative;">
                @Html.Partial("PageSection_FormPartial", fps)
            </div>
            break;
        case 4:
            @*Product Page Grid*@
            <div class="content-panel-container" data-page-section-type="@(sect.PageSectionTypeID)" data-page-section-id="@(sect.PageSectionID)">
                <fieldset>
                    <legend onclick="@(ViewBag.IsUserShuffling ? "" : "$('#page-section-" + sect.PageSectionID + "').slideToggle('fast');")">
                        Product Page Grid @(ViewBag.IsUserShuffling ? "(click and drag to reorder)" : "(click to expand / contract)")
                        <span style="margin: 0 4px;">Page Section ID: @(sect.PageSectionID)</span>
                        <img id="page-section-@(sect.PageSectionID)-remove" title="Remove" class="pagesection-remove-icon" src="/images/systemicons/remove-icon.png" onclick="event.stopPropagation(); RemovePageSection(@(sect.PageSectionID));" />
                        <img id="page-section-@(sect.PageSectionID)-save" title="Save" class="pagesection-save-icon" src="/images/icons/32/save.png" onclick="event.stopPropagation(); SavePageSectionDetails(@(sect.PageSectionID), @(sect.PageSectionTypeID));" />
                        <img id="page-section-@(sect.PageSectionID)-advanced" title="Advanced" class="pagesection-advanced-icon" src="/images/admin/gear.png" onclick="event.stopPropagation(); ShowAdvancedSettings(@(sect.PageSectionID), @(sect.PageSectionTypeID));" />
                        <img id="pagesection-@(sect.PageSectionID)-clone" src="~/Images/icons/32/o_collection/element_copy.png" class="pagesection-clone-icon" title="Clone Page Section" onclick="event.stopPropagation(); $('#clone-popup-page-section-id').val(@(sect.PageSectionID)); ClonePageSectionPopup.Show();" />
                        <img id="pagesection-@(sect.PageSectionID)-merge" src="/images/icons/32/o_collection/copy.png" class="pagesection-copy-icon" alt="copyto" title="Copy Products To" onclick="event.stopPropagation(); $('#merge-productpages-page-section-id').val(@(sect.PageSectionID)); MergeGridPopup.Show();" />
                        <img id="page-section-@(sect.PageSectionID)-busy" class="fieldset-busy" src="/images/systemicons/busy-icon.gif" />
                    </legend>
                    <div id="page-section-@(sect.PageSectionID)-header-details" class="pagesection-header">
                        @Html.Partial("PageSectionHeaderDetails", sect)
                    </div>
                    <div data-page-section-id="@(sect.PageSectionID)" data-page-section-type="@(sect.PageSectionTypeID)" style="padding: 1em; padding-bottom: 0; background-color: white;">
                        @Html.Partial("CountryLanguageRestrictionPartial", sect.CountryLanguageRestrictions)
                    </div>
                    <div id="page-section-@(sect.PageSectionID)" style="@(ViewBag.IsUserShuffling ? "display: none" : "")" class="fieldset-inner page-section-hideable">
                        <div id="page-section-@(sect.PageSectionID)-grid" data-page-section-name="@(sect.PageSectionName)" data-page-section-id="@(sect.PageSectionID)" style="padding-left: 0" class="product-page-grid-container multisortable-container">
                            @(ViewBag.IsUserShuffling ? MvcHtmlString.Empty : Html.Action("LoadProductPageGrid", new { sect.PageSectionID }))
                        </div>
                        <div style="clear: both"></div>
                    </div>
                </fieldset>

                <div id="page-section-@(sect.PageSectionID)-advanced-settings" class="page-section-advanced-container">
                    @Html.DevExpress().Label(settings => { settings.Text = "Display Multiple Pod Images?"; }).GetHtml()
                    @Html.DevExpress().CheckBoxFor(m => sect.MultiplePodImages, settings => { settings.Name = "PageSection" + sect.PageSectionID + "MultiplePodImages"; settings.Properties.ClientInstanceName = "PageSection" + sect.PageSectionID + "MultiplePodImages"; }).GetHtml()
                    <div style="clear: both;"></div>
                    @Html.DevExpress().Label(settings => { settings.Text = "Display Filters?"; }).GetHtml()
                    @Html.DevExpress().CheckBoxFor(m => sect.ShowFilters, settings => { settings.Name = "PageSection" + sect.PageSectionID + "DisplayFilters"; settings.Properties.ClientInstanceName = "PageSection" + sect.PageSectionID + "DisplayFilters"; }).GetHtml()
                    <div style="clear: both;"></div>
                    @Html.DevExpress().Label(settings => { settings.Text = "Is this a Lifestyle Gallery?"; }).GetHtml()
                    @Html.DevExpress().CheckBoxFor(m => sect.IsLifestyleGallery, settings => { settings.Name = "PageSection" + sect.PageSectionID + "IsLifestyle"; settings.Properties.ClientInstanceName = "PageSection" + sect.PageSectionID + "IsLifestyle"; }).GetHtml()
                    <div style="clear: both;"></div>
                    @Html.DevExpress().Label(settings => { settings.Text = "Display Paging?"; }).GetHtml()
                    @Html.DevExpress().CheckBoxFor(m => sect.Paging, settings => { settings.Name = "PageSection" + sect.PageSectionID + "Paging"; settings.Properties.ClientInstanceName = "PageSection" + sect.PageSectionID + "Paging"; }).GetHtml()
                    <div style="clear: both;"></div>
                    @Html.DevExpress().Label(settings => { settings.Text = "Preview Colourways?"; }).GetHtml()
                    @Html.DevExpress().CheckBoxFor(m => sect.PreviewColourways, settings => { settings.Name = "PageSection" + sect.PageSectionID + "PreviewColourways"; settings.Properties.ClientInstanceName = "PageSection" + sect.PageSectionID + "PreviewColourways"; }).GetHtml()
                    <div style="clear: both;"></div>
                    @Html.DevExpress().Label(settings => { settings.Text = "Preview Colourways Circular Clip?"; }).GetHtml()
                    @Html.DevExpress().CheckBoxFor(m => sect.PreviewColourwaysCircularClip, settings => { settings.Name = "PageSection" + sect.PageSectionID + "PreviewColourwaysCircularClip"; settings.Properties.ClientInstanceName = "PageSection" + sect.PageSectionID + "PreviewColourwaysCircularClip"; }).GetHtml()
                </div>
            </div>
            break;
        case 5:
            @*Collection Grid*@
            <div class="content-panel-container" data-page-section-id="@(sect.PageSectionID)" data-page-section-type="@(sect.PageSectionTypeID)">
                <fieldset>
                    <legend onclick="@(ViewBag.IsUserShuffling ? "" : "$('#page-section-" + sect.PageSectionID + "').slideToggle('fast');")">
