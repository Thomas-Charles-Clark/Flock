                        </div>
                        <div style="clear: both"></div>
                    </div>
                </fieldset>

                <div id="page-section-@(sect.PageSectionID)-advanced-settings" class="page-section-advanced-container">
                    @Html.DevExpress().Label(settings => { settings.Text = "Display Multiple Pod Images?"; }).GetHtml()
