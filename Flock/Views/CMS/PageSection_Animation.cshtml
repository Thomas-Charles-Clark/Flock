            }).BindList(UoW.GetRepository<Flock.Models.Animation>().GetAll().Where(p => p.DeletedDT == null).ToList()).GetHtml()*@
            <button class="btn btn-primary" onclick="LoadAnimationEditor(@(Model.Animation.AnimationID))">Edit</button>
        </div>
        <div data-page-section-id="@(Model.PageSectionID)" style="padding: 1em; padding-top: 0;">
            @Html.Partial("CountryLanguageRestrictionPartial", Model.CountryLanguageRestrictions)
        </div>
    </div>
</fieldset>





