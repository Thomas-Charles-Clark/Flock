@{
    Layout = "~/Views/Admin/_Layout.cshtml";
    ViewBag.Title = "Menu Items Builder";
}

@section scripts {
    <script type="text/javascript">
        function InitalizejQuery() {
            $('.draggable').draggable({
                helper: 'clone',
                start: function (ev, ui) {
                    var $draggingElement = $(ui.helper);
                    $draggingElement.width(window[$(this).closest('[data-grid-view-name]').data("grid-view-name")].GetWidth());
                }
            });

            $('.draggable').droppable({
                activeClass: "menu-hover",
                tolerance: "intersect",
                hoverClass: "menu-activeHover",
                drop: function (event, ui) {
                    var draggingSortIndex = ui.draggable.data("sort-order");
                    var targetSortIndex = $(this).data("sort-order");

                    if (targetSortIndex == undefined || targetSortIndex == null)
                        targetSortIndex = 0;

                    var menuItemID = ui.draggable.data("menu-item-id");

                    window.ForceUpdate = true;
                    window.ForceUpdateGridView = $(ui.draggable).closest('[data-grid-view-name]').data("grid-view-name");

                    window[$(this).closest('[data-grid-view-name]').data("grid-view-name")].PerformCallback({ CommandType: "DragRow", MenuItemID: menuItemID, DraggingSI: draggingSortIndex, TargetSI: targetSortIndex });
                    //"DRAGROW|" + draggingSortIndex + '|' + targetSortIndex);
                }
            });
        }

        //function UpdatedGridViewButtonsState(grid) {
        //    btMoveUp.SetEnabled(grid.cpbtMoveUp_Enabled);
        //    btMoveDown.SetEnabled(grid.cpbtMoveDown_Enabled);
        //}

        function gridView_Init(s, e) {
            UpdatedGridViewButtonsState(s);
        }

        function gridView_EndCallback(s, e) {
            UpdatedGridViewButtonsState(s);
        }

        function btMoveUp_Click(s, e) {
            gridView.PerformCallback("MOVEUP");
        }

        function btMoveDown_Click(s, e) {
            gridView.PerformCallback("MOVEDOWN");
        }
    </script>
}

