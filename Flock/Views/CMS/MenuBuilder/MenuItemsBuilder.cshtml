                useDate = UseDate.GetDate().toDateString()

            $.ajax({
                url: '" + Url.Action("MenuItemsBuilderWrapperPartial", "CMS") + @"',
                type: 'POST',
                traditional: true,
                data: {
                    CountryID: CountryPrefilter.GetSelectedItem().value,
                    UseDate: useDate,
                    TradeSwitch: s.GetSelectedItem().value
                },
                success: function(data) {
                    $('#ajax-container').html(data);
                    LoadingPanel.Hide();
                },
                timeout: 30000
            });
        }";
   }).BindList(new List<object> {
                        new { name = "Both", value = (bool?)null },
                        new { name = "Retail", value = (bool?)false },
                        new { name = "Trade", value = (bool?)true } }).GetHtml()
        
    <div class="clearfix"></div>
</div>

