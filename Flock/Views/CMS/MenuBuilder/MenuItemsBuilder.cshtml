<script type="text/javascript">
    function RevealLinkSelector(index) {
        $(".link-selector").hide();
        $("#link-selector-" + index).show();
        switch (index) {
            case 1:
                MenuBuilderPageSelectorGrid.AdjustControl();
                break;
            case 2:
                MenuBuilderProductPageSelectorGrid.AdjustControl();
                break;
            case 3:
                MenuBuilderCollectionSelectorGrid.AdjustControl();
                break;
            case 4:
                MenuBuildArticleSelectorGrid.AdjustControl();
                break;
            default: break;
        }
    }

    function InitPageDragDrop() {
        $(".page").draggable({
            helper: 'clone',
            start: function (e, ui) {
                $(ui.helper).css("z-index", "300000");
            },
            connectToSortable: "#menu-builder-container"
        });

        $("#menu-builder-container").sortable({
            helper: 'clone',
            placeholder: "ui-state-highlight-cms-page",
            connectWith: ".page",
            update: function (ev, ui) {
                $("#menu-builder-container").sortable("refresh");
                UpdateMenu();
            }
        });
    }

    function UpdateMenu() {

    }
</script>
