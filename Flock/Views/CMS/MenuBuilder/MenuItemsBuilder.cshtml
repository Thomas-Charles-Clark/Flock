@{
    var UoW = new Flock.DAL.UnitOfWork<Flock.Models.FlockDataContext>();

    var Linker = UoW.GetRepository<Flock.Models.Country_Language>().GetAll().Select(p => p.CountryID).ToList();

    // get all menus who do not feature in menu_country table
    // display all of these
    // get all menus who do feature in menu_country where countryid == x


    var Menus = UoW.GetRepository<Flock.Models.Menu>().GetAll().Where(p => p.DeletedDT == null && (UoW.Context.fnc_DateControl(p.OnDate, p.OffDate, DateTime.Now) == true)).ToList();
    /* where countryrestrictions are null or countryrestrictions contains country */
    var MenuLinker = UoW.GetRepository<Flock.Models.Menu_Country>().GetAll().ToList();

    var unrestrictedMenuIDs = Menus.Select(p => p.MenuID).Where(p => !MenuLinker.Select(q => q.MenuID).Contains(p)).ToList();

    var restrictedMenuIDs = MenuLinker.Where(p => p.CountryID == 81).Select(p => p.MenuID).ToList();

    var menusToDisplay = unrestrictedMenuIDs.Concat(restrictedMenuIDs).Distinct().ToList();

    Menus = Menus.Where(p => menusToDisplay.Contains(p.MenuID)).OrderBy(p => p.SortOrder).ToList();
}

<h4 class="page-heading">Menu Items Builder</h4>

<div class="page-subheading">
    @{
        @* && (UoW.Context.fnc_DateControl(p.OnDate, p.OffDate, DateTime.Now) == true)*@
    var countryList = UoW.GetRepository<Flock.Models.Country_Language>().GetAll().Where(p => (Linker.Contains(p.CountryID) || p.CountryID == 73 || p.CountryID == 175)).Select(p => new { CountryID = p.CountryID, Name = p.Country.Name + " " + p.Language.Code.ToUpper() }).ToList();

    countryList.Insert(0, new { CountryID = Convert.ToInt16(-1), Name = "Unrestricted" });
    var index = countryList.IndexOf(countryList.Where(p => p.Name == "United Kingdom EN").SingleOrDefault());


    }
    @Html.DevExpress().ComboBox(settings =>
{
    settings.Name = "CountryPrefilter";
    settings.Properties.TextField = "Name";
    settings.Properties.ValueField = "CountryID";
    settings.Properties.ValueType = typeof(short);
    settings.Style.Add("float", "left");
    settings.SelectedIndex = index;
    settings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            LoadingPanel.Show();

            var useDate = null;
            if (UseDate.GetDate() != null)
                useDate = UseDate.GetDate().toDateString()

            $.ajax({
                url: '" + Url.Action("MenuItemsBuilderWrapperPartial", "CMS") + @"',
                type: 'POST',
                traditional: true,
                data: {
                    CountryID: s.GetSelectedItem().value,
                    UseDate: useDate,
                    TradeSwitch: TradeSwitchPrefilter.GetSelectedItem().value
                },
                success: function(data) {
                    $('#ajax-container').html(data);
                    LoadingPanel.Hide();
                },
                timeout: 30000
            });
        }";
}).BindList(
        countryList
    ).GetHtml()

    @Html.DevExpress().DateEdit(settings =>
    {
        settings.Name = "UseDate";
        settings.Date = DateTime.Today;
        settings.Style.Add("float", "left");
        settings.Properties.ClientSideEvents.DateChanged = @"function(s, e) {
            LoadingPanel.Show();

            var useDate = null;
            if (UseDate.GetDate() != null)
                useDate = UseDate.GetDate().toDateString()

            $.ajax({
                url: '" + Url.Action("MenuItemsBuilderWrapperPartial", "CMS") + @"',
                type: 'POST',
                traditional: true,
                data: {
                    CountryID: CountryPrefilter.GetSelectedItem().value,
                    UseDate: useDate,
                    TradeSwitch: TradeSwitchPrefilter.GetSelectedItem().value
                },
                success: function(data) {
                    $('#ajax-container').html(data);
                    LoadingPanel.Hide();
                },
                timeout: 30000
            });
        }";
    }).GetHtml()

        @Html.DevExpress().ComboBox(cbSettings =>
   {
       cbSettings.Name = "TradeSwitchPrefilter";
       cbSettings.Style.Add("float", "left");
       cbSettings.Properties.TextField = "name";
       cbSettings.Properties.ValueField = "value";
       cbSettings.Properties.ValueType = typeof(bool?);
       cbSettings.Style.Add("margin-right", "1em");
       cbSettings.SelectedIndex = 0;
       cbSettings.ShowModelErrors = false;
       cbSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
