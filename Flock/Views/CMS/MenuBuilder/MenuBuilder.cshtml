@using Flock.ViewModels
@{
    Layout = "~/Views/Admin/_Layout.cshtml";
    ViewBag.Title = "Menu Builder";
}
@section styles{
    @Styles.Render("~/bundles/composer")
    @Styles.Render("~/Content/product-page-composition.css")
    @Styles.Render("~/Content/menu-builder.css")
    <style type="text/css">
        #container {
            width: 1380px !important;
        }
        input.dxb-hb {
            font-size: 0 !important;
        }

        .dxgvFooter_MetropolisBlue td.dxgv {
            border-top: 1px solid #c0c0c0 !important;
        }
        .country-restriction-flag {
            float: left;
            vertical-align: top;
            margin-right: 1em;
            position: relative;
            width: 48px;
            height: 82px;
        }
        .flag {
            width: 22px;
            height: 22px;
        }
        .resource-panel-container {
            width: 500px;
            float: right;
        }
        #grid-container {
            width: 860px;
            float: left;
        }
        #country-restriction-busy {
            width: 22px;
            height: 22px;
            top: 4px;
            right: 4px;
        }
    </style>
}
@section scripts {
<script type="text/javascript">
    function InitalizejQuery() {
        $('.dxgvDataRow_MetropolisBlue.draggable').draggable({
            helper: 'clone',
            start: function (ev, ui) {
                var $draggingElement = $(ui.helper);
                $draggingElement.width(window[$(this).closest('[data-grid-view-name]').data("grid-view-name")].GetWidth());
            }
        });

        $('.dxgvDataRow_MetropolisBlue.draggable').droppable({
            activeClass: "menu-hover",
            tolerance: "intersect",
            hoverClass: "menu-activeHover",
            drop: function (event, ui) {
                var draggingSortIndex = ui.draggable.data("sort-order");
                var targetSortIndex = $(this).data("sort-order");

                if (targetSortIndex == undefined || targetSortIndex == null)
                    targetSortIndex = 0;

                var menuID = ui.draggable.data("menu-id");

                window[$(this).closest('[data-grid-view-name]').data("grid-view-name")].PerformCallback({ CommandType: "DragRow", MenuID: menuID, DraggingSI: draggingSortIndex, TargetSI: targetSortIndex });
                //"DRAGROW|" + draggingSortIndex + '|' + targetSortIndex);
            }
        });
    }

    function MenuItemCopy() {

        OriginMenuSelector.Validate();

        if (OriginMenuSelector.GetIsValid()) {
            $.ajax({
                url: '/admin/cms/MenuCopy',
                type: 'POST',
                data: {
                    originMenuID: OriginMenuSelector.GetValue(),
                    destinationMenuID: DestinationMenuSelector.GetValue()
                },
                success: function (data) {
                    MenuCopyPopup.Hide();
                    MenuBuilderGridView.Refresh();
                    $.info('Info', 'Copy Completed');
                },
                timeout: 20000
            });
        }
    }
</script>

