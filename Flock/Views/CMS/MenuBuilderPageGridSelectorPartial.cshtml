@using Flock.Models
@model Flock.ViewModels.PageComposeViewModel
@{
    var grid = Html.DevExpress().GridView(settings =>
    {
        var UoW = new Flock.DAL.UnitOfWork<FlockDataContext>();


        settings.Name = "ComposePageGridSelector";
        settings.CallbackRouteValues = new { Controller = "CMS", Action = "ComposePageHeaderPageGridSelectorPartial" };

        settings.ClientSideEvents.EndCallback = @"function(s, e)
        {

        }";

        settings.PreRender = (sender, e) =>
        {
            MVCxGridView gv = (MVCxGridView)sender;
            gv.FocusedRowIndex = -1;
        };

        settings.ClientSideEvents.RowClick = @"function(s, e) {
//        var id = s.GetRowKey(e.visibleIndex);
//        $('#selected-page-id').val(id);
//        CollapseLHS();
//        LoadingPanel.Show();
//            $.ajax({
//                url: '" + @Url.Action("ChangePage", "CMS") + @"',
//                type: 'POST',
//                traditional: true,
//                data: {
//                    ID: id
//                },
//                success: function(data) {
//                    $('#page-compose-container').html(data);
//                    LoadingPanel.Hide();
//                },
//                error: function(e, s, a) {
//                    LoadingPanel.Hide();
//                    alert(s + ' error: e.responseText was: ' + e.responseText);
//                    //log e
//                },
//                timeout: 20000
//            });
        }";


        settings.TotalSummary.Add(DevExpress.Data.SummaryItemType.Count, "PageID").DisplayFormat = "Total: {0:n0}";
        settings.Settings.ShowFooter = true;

        settings.SettingsBehavior.EnableRowHotTrack = true;
        settings.Styles.Row.Cursor = "pointer";
        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
        settings.CommandColumn.Visible = false;
        settings.CommandColumn.ShowClearFilterButton = false;
        settings.Settings.ShowFilterRow = true;

        settings.SettingsPager.Mode = GridViewPagerMode.EndlessPaging;
        // property to EndlessPaging, and the Settings.VerticalScrollBarMode
        settings.Settings.VerticalScrollBarMode = ScrollBarMode.Visible;

        settings.SettingsBehavior.ConfirmDelete = true;
        settings.CommandColumn.ShowSelectCheckbox = false;
        settings.SettingsEditing.Mode = GridViewEditingMode.EditFormAndDisplayRow;
        settings.SettingsPager.PageSizeItemSettings.Visible = false;
        settings.SettingsPager.PageSize = 10;

        settings.SettingsBehavior.AllowFocusedRow = true;

        settings.KeyFieldName = "PageID";

        settings.Columns.Add(column =>
        {
            column.Name = "PageID";
            column.FieldName = "PageID";
            column.Caption = "ID";
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.Width = 50;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
            column.EditFormSettings.Visible = DefaultBoolean.False;
        });


        settings.Columns.Add(column =>
        {
            column.Name = "SiteSectionID";
            column.FieldName = "SiteSectionID";
            column.Caption = "Site Section";
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.False;
            column.Settings.AllowHeaderFilter = DefaultBoolean.True;
            column.Settings.HeaderFilterMode = HeaderFilterMode.List;
            column.HeaderStyle.Wrap = DefaultBoolean.True;
            column.Width = 75;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.SetDataItemTemplateContent(c =>
            {
                int SiteSectionID = 0;
                string SiteSection = "<i>Unknown</i>";

                if (DataBinder.Eval(c.DataItem, "SiteSectionID") != DBNull.Value && DataBinder.Eval(c.DataItem, "SiteSectionID") != null)
                {
                    SiteSectionID = Convert.ToByte(DataBinder.Eval(c.DataItem, "SiteSectionID"));
                    SiteSection = UoW.GetRepository<Flock.Models.SiteSection>().GetAll().Where(p => p.SiteSectionID == SiteSectionID).Select(p => p.Name).Single();
                }

                ViewContext.Writer.Write("<span style='float: left;'>" + SiteSection + "</span>");
            });
        });

        settings.Columns.Add(column =>
        {
            column.Name = "Name";
            column.FieldName = "Name";
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.EditFormSettings.Visible = DefaultBoolean.True;
            column.Width = 280;
            column.SetEditItemTemplateContent(c =>
            {
                Html.DevExpress().TextBox(
                    edtSettings =>
                    {
                        edtSettings.Name = "Name";
                        edtSettings.Properties.NullDisplayText = "Product Page Name";
                        edtSettings.ShowModelErrors = true;
                        edtSettings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
                    }
                )
                .Bind(DataBinder.Eval(c.DataItem, "Name"))
                .Render();
            });

            column.EditFormCaptionStyle.CssClass = "editform-label";
            column.EditCellStyle.CssClass = "editform-cell";
        });

        settings.Columns.Add(column =>
        {
            column.Name = "CreatedDT";
            column.FieldName = "CreatedDT";
            column.Caption = "Created DT";
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.ColumnType = MVCxGridViewColumnType.DateEdit;
            column.Width = 70;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
        });

        settings.Columns.Add(column =>
        {
            column.Name = "ModifiedDT";
            column.FieldName = "ModifiedDT";
            column.Caption = "Modified DT";
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.ColumnType = MVCxGridViewColumnType.DateEdit;
            column.Width = 70;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
        });

        settings.HeaderFilterFillItems = (sender, e) =>
        {
            MVCxGridView gridView = (MVCxGridView)sender;
            switch (e.Column.Name)
            {
                case "LaunchID":
                    e.Values.Clear();
                    foreach (var pt in UoW.GetRepository<Flock.Models.Launch>().GetAll().OrderByDescending(p => p.LaunchDate))
                    {
                        e.AddValue(pt.Name, pt.LaunchID.ToString());
                    }
                    e.AddShowAll();
                    break;

                case "SiteSectionID":
                    e.Values.Clear();
                    foreach (var pt in UoW.GetRepository<Flock.Models.SiteSection>().GetAll().OrderBy(p => p.Name))
                    {
                        e.AddValue(pt.Name, pt.SiteSectionID.ToString());
                    }
                    e.AddShowAll();
                    break;

                case "ProductTypeID":
                    e.Values.Clear();
                    foreach (var pt in UoW.GetRepository<Flock.Models.ProductType>().GetAll().OrderBy(p => p.Name))
                    {
                        e.AddValue(pt.Name, pt.ProductTypeID.ToString());
                    }
                    e.AddShowAll();
                    break;

                case "BrandID":
                    e.Values.Clear();
                    foreach (var pt in UoW.GetRepository<Flock.Models.Brand>().GetAll().OrderBy(p => p.Name))
                    {
                        e.AddValue(pt.Name, pt.BrandID.ToString());
                    }
                    e.AddShowAll();
                    break;

                case "StatusID":
                    e.Values.Clear();
                    foreach (var pt in UoW.GetRepository<Flock.Models.Status>().GetAll().OrderBy(p => p.StatusID).ToList())
                    {
                        e.AddValue(pt.Name, pt.StatusID.ToString());
                    }
                    e.AddShowAll();
                    break;

                default: break;
            }
        };
    });

    if (ViewData["EditError"] != null)
    {
        grid.SetEditErrorText((string)ViewData["EditError"]);
    }
}
@grid.BindToLINQ("", "", (s, e) =>
{
    var dataContext = new Flock.DAL.UnitOfWork<Flock.Models.FlockDataContext>();

    var source = dataContext.GetRepository<Flock.Models.Page>().GetAll().Where(p => p.DeletedDT == null);

    e.QueryableSource = source;

    e.KeyExpression = "PageID";
}).GetHtml()
