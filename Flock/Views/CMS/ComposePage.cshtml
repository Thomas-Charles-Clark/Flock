<script type="text/javascript">

    const pagePodViewModel = ((pageSectionId, pageId) => {
        var self = {
            pageSectionId: pageSectionId,
            pageId: pageId
        };

        self.attributeGroups = ko.observableArray(getAttributeGroups().map(ag => attributeGroupViewModel(ag)));

        self.getAttributeGroup = (id) => {
            return self.attributeGroups().filter(ag => ag.AttributeGroupID == id)[0];
        }

        self.selectedAttributes = ko.pureComputed(() => {
            let attributeIds = ko.unwrap(self.attributeGroups()).flatMap(ag => ag.attributeId() ? [ag.attributeId()] : []);
            return getAttributes().filter(at => attributeIds.indexOf(at.AttributeID) > -1);
        }, self);

        self.attributeIds = ko.pureComputed(() => {
            return self.selectedAttributes().map(a => {
                return {
                    id: a.AttributeID
                }
            });
        }, self);

        self.nameDisplay = ko.pureComputed(() => {
            let attributes = self.selectedAttributes();

            let names = [];

            attributes.forEach(a => {
                names.push(a.Name);
            });

            let name = `${names.join(' ')} ${getProductTypeNamePlural()}`;

            document.querySelector(`#pagesection-${self.pageSectionId}-page-${self.pageId}-name`).innerHTML = name
                
            return name;
        })

        self.urlDisplay = ko.pureComputed(() => {
            let attributes = self.selectedAttributes();

            let urlSegments = [];

            attributes.forEach(a => {
                urlSegments.push(a.FormValue);
            });

            urlSegments.push(getProductTypeURLKeywords());

            let url = urlSegments.join('-');

            return `${decodeURI(url)}/l${self.pageId}`;

        }, self);

        self.save = () => {
            $.ajax({
                url: '/api/CMS_GeneralAPI/SavePagePodAttributes',
                type: 'POST',
                dataType: 'json',
                data: {
                    pageSectionId: self.pageSectionId,
                    pageId: self.pageId,
                    attributeIds: self.attributeIds()
                },
                success: () => {
                    $('#page-pod-advanced-settings-modal').modal('hide');
                    $.info('Ok', 'Saved successfully', null);
                },
                error: (x, s, a) => {
                    $.showError(x, s, a);
                }
            });
        }

        return self;
    });

    
    const canonicalPagePodViewModel = ((pageId, parentPageId) => {
        var self = {
            pageId: pageId,
            parentPageId: parentPageId
        };

        self.attributeGroups = ko.observableArray(getAttributeGroups().map(ag => attributeGroupViewModel(ag)));

        self.getAttributeGroup = (id) => {
            return self.attributeGroups().filter(ag => ag.AttributeGroupID == id)[0];
        }

        self.selectedAttributes = ko.pureComputed(() => {
            let attributeIds = ko.unwrap(self.attributeGroups()).flatMap(ag => ag.attributeId() ? [ag.attributeId()] : []);
            return getAttributes().filter(at => attributeIds.indexOf(at.AttributeID) > -1);
        }, self);

        self.attributeIds = ko.pureComputed(() => {
            return self.selectedAttributes().map(a => {
                return {
                    id: a.AttributeID
                }
            });
        }, self);

        self.nameDisplay = ko.pureComputed(() => {
            let attributes = self.selectedAttributes();

            let names = [];

            attributes.forEach(a => {
                names.push(a.Name);
            });

            let name = `${names.join(' ')} ${getProductTypeNamePlural()}`;

            document.querySelector(`#page-${self.parentPageId}-canonical-name`).innerHTML = name;

            return name;
        })

        self.urlDisplay = ko.pureComputed(() => {
            let attributes = self.selectedAttributes();

            let urlSegments = [];

            attributes.forEach(a => {
                urlSegments.push(a.FormValue);
            });

            urlSegments.push(getProductTypeURLKeywords());

            let url = urlSegments.join('-');

            return `${decodeURI(url)}/l${self.pageId}`;

        }, self);

        self.save = () => {
            $.ajax({
                url: '/api/CMS_CanonicalAPI/SaveCanonicalPageAttributes',
                type: 'POST',
                dataType: 'json',
                data: {
                    pageId: self.parentPageId,
                    destinationPageId: self.pageId,
                    attributeIds: self.attributeIds()
                },
                success: () => {
                    $('#page-pod-advanced-settings-modal').modal('hide');
                    $.info('Ok', 'Saved successfully', null);
                },
                error: (x, s, a) => {
                    $.showError(x, s, a);
                }
            });
        }

        return self;
    });

    const attributeGroupViewModel = ((data) => {
        let self = Object.assign(data, {

        });

        self.attributeId = ko.observable();

        self.attributeId.subscribe(nv => {
            console.log('attributeId changed', nv);
        });

        return self;
    });
</script>

