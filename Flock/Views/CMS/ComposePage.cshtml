@Html.DevExpress().PopupControl(settings =>
{
    settings.Name = "ClonePageSectionPopup";

    settings.PopupElementID = "pagesection-clone-icon";

    settings.Width = 400;
    settings.ShowFooter = false;
    settings.HeaderText = "Clone Page Section";
    settings.Modal = true;
    settings.PopupHorizontalAlign = PopupHorizontalAlign.WindowCenter;
    settings.PopupVerticalAlign = PopupVerticalAlign.WindowCenter;
    
    settings.SetContent(() =>
    {
        ViewContext.Writer.Write("<label style='float: left; margin: 0; line-height: 22px;'>Target Page (Name or ID) <sub style='bottom: 0;'>(leave blank to copy to this page)</sub></label>");

        ViewContext.Writer.Write(Html.Action("PageSectionClonePageIDComboBoxPartial").ToHtmlString());
        
        ViewContext.Writer.Write("<div style='clear: both;'></div>");

        ViewContext.Writer.Write("<label style='margin-top: 10px; margin-bottom: 0; line-height: 22px;'>Clone's On Date</label>");

        Html.DevExpress().DateEdit(deSettings =>
        {
            deSettings.Name = "PageSectionCloneOnDate";
        }).Render();

        ViewContext.Writer.Write("<div style='clear: both;'></div>");

        ViewContext.Writer.Write("<label style='margin-top: 10px; margin-bottom: 0; line-height: 22px;'>Copy Contents?</label>");

        Html.DevExpress().CheckBox(cbSettings =>
        {
            cbSettings.Name = "PageSectionCloneCopyContents";
            cbSettings.Properties.ValueType = typeof(bool);
            cbSettings.Properties.ValueChecked = true;
            cbSettings.Properties.ValueUnchecked = false;

        }).Render();

        ViewContext.Writer.Write("<input type='hidden' id='clone-popup-page-section-id' />");

        ViewContext.Writer.Write("<div style='clear: both;'></div>");

        Html.DevExpress().Button(bSettings => {
            bSettings.Name = "PageSectionCloneOKButton";
            bSettings.Text = "Clone";
            bSettings.Style.Add("margin-top", "10px");
            bSettings.ClientSideEvents.Click = @"function(s, e) { 
                ClonePageSection($('#clone-popup-page-section-id').val());
            }";
        }).Render();
    });
}).GetHtml()

@Html.DevExpress().PopupControl(settings => {
    settings.Name = "MergeGridPopup";

    settings.Width = 400;
    settings.ShowFooter = false;
    settings.HeaderText = "Merge Products";

    settings.Modal = true;
    settings.PopupHorizontalAlign = PopupHorizontalAlign.WindowCenter;
    settings.PopupVerticalAlign = PopupVerticalAlign.WindowCenter;
    
    settings.SetContent(() => {
        Html.DevExpress().Label(lSettings =>
        {
            lSettings.Name = "ProductPageMergeLbl";
            lSettings.Text = "Page Section ID";
            lSettings.Style.Add("float", "left");
            lSettings.Style.Add("margin", "0 7px 7px 0");
            lSettings.Style.Add("line-height", "32px");
        }).Render();

        Html.DevExpress().TextBox(tbSettings =>
        {
            tbSettings.Name = "TargetPageSectionID";
            tbSettings.Properties.ClientInstanceName = "TargetPageSectionID";
            tbSettings.Style.Add("float", "left");
            tbSettings.Style.Add("margin", "0 7px 7px 0");
            tbSettings.Properties.ClientSideEvents.KeyDown = @"function(s, e) {
                if (!((e.htmlEvent.keyCode >= 48 && e.htmlEvent.keyCode <= 57) || (e.htmlEvent.keyCode >= 97 && e.htmlEvent.keyCode <= 105) || (e.htmlEvent.keyCode == 8 || e.htmlEvent.keyCode == 46 || e.htmlEvent.keyCode == 37 || e.htmlEvent.keyCode == 39)))
                    ASPxClientUtils.PreventEventAndBubble(e.htmlEvent);
            }";
        }).Render();

        Html.DevExpress().Button(bSettings =>
        {
            bSettings.Name = "ProductPageMergeGoBtn";
            bSettings.Text = "Go";
            bSettings.Style.Add("float", "left");
            bSettings.Style.Add("line-height", "32px");
            bSettings.Height = System.Web.UI.WebControls.Unit.Pixel(34);
            bSettings.Width = 44;
            bSettings.ClientSideEvents.Click = @"function(s, e) {
                PageSectionProductPageMerge($('#merge-productpages-page-section-id').val());
            }";
        }).Render();

        ViewContext.Writer.Write("<div class='clearfix'></div>");
        
        Html.DevExpress().Label(lSettings =>
        {
            lSettings.Name = "ProductPageMergeReplaceLbl";
            lSettings.Text = "Replace?";
            lSettings.Style.Add("float", "left");
            lSettings.Style.Add("margin", "0 7px 7px 0");
            lSettings.Style.Add("line-height", "30px");
        }).Render();

        Html.DevExpress().CheckBox(cbSettings =>
        {
            cbSettings.Name = "ProductPageMergeReplace";
            cbSettings.Style.Add("float", "left");
            cbSettings.Style.Add("margin", "0 7px 7px 0");
            cbSettings.Style.Add("line-height", "22px");
            cbSettings.Properties.ValueChecked = true;
            cbSettings.Properties.ValueUnchecked = false;
            cbSettings.Checked = false;
        }).Render();

        ViewContext.Writer.Write("<input type='hidden' id='merge-productpages-page-section-id' />");
    });
    
}).GetHtml()

