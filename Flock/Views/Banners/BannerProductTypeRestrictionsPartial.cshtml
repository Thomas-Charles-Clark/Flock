@model Flock.ViewModels.BannerComposeViewModel
<div class="content-panel-container">
    <fieldset id="product-type-restriction-fieldset">
        <legend onclick="$('#product-type-restriction-section').slideToggle('fast');">Product Type Restrictions (click to expand / contract)</legend>
        <div id="site-section-restriction-section" style="position: relative; background-color: white; padding: 1em;">
            @Html.Action("ComposeBannerProductTypeListBoxPartial", "Banners", new { ProductTypeAssignmentSelectedProductTypeDs = Model.ProductTypeIDs })
            <div style="clear: both;"></div>
            <div style="width: 100%; height: 32px;"></div>
            <img id="banner-producttype-save" class="pagesection-save-icon" src="/images/icons/32/save.png" style="margin-right: 0; position: absolute; bottom: 10px; right: 10px;" onclick="SaveBannerProductTypes();" />
            <div style="clear: both;"></div>
        </div>
    </fieldset>
</div>