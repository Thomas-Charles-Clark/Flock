@model Flock.ViewModels.BannerComposeViewModel
<div class="content-panel-container">
    <fieldset id="site-section-restriction-fieldset">
        <legend onclick="$('#site-section-restriction-section').slideToggle('fast');">Site Section Restrictions (click to expand / contract)</legend>
        <div id="site-section-restriction-section" style="position: relative; background-color: white; padding: 1em;">
            @Html.Action("ComposeBannerSiteSectionListBoxPartial", "Banners", new { SiteSectionAssignmentSelectedSiteSectionIDs = Model.SiteSectionIDs })
            <div style="clear: both;"></div>
            <div style="width: 100%; height: 32px;"></div>
            <img id="banner-sitesection-save" class="pagesection-save-icon" src="/images/icons/32/save.png" style="margin-right: 0; position: absolute; bottom: 10px; right: 10px;" onclick="SaveBannerSiteSections();" />
            <div style="clear: both;"></div>
        </div>
    </fieldset>
</div>