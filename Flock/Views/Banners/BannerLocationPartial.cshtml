@model Flock.ViewModels.BannerComposeViewModel
@using Flock.DAL;
@using Flock.Models;
@{

        using(var UoW = new UnitOfWork<FlockDataContext>())
        {
            var BannerLocations = UoW.GetRepository<vwBannerLocation>().GetAll().ToList();

            var TemplateLocations = BannerLocations.Where(p => p.BannerLocationTypeID == 1 || p.BannerLocationTypeID == 3).OrderBy(p => p.BannerLocationID).OrderBy(p => p.BannerLocationGroupSortOrder).ToList();

            var TemplateGroups = TemplateLocations.GroupBy(p => p.BannerLocationGroupID).ToList();

            var PageSectionLocations = BannerLocations.Where(p => p.BannerLocationTypeID == 2).OrderBy(p => p.BannerLocationID).OrderBy(p => p.BannerLocationGroupSortOrder).ToList();

            var PageSectionGroups = PageSectionLocations.GroupBy(prop => prop.BannerLocationGroupID).ToList();

            List<byte> AllowedLocations = new List<byte>();

            if (Model.ImageWidth == 256)
            {
                AllowedLocations = new List<byte>() { 12, 13, 14, 15, 16, 17, 8, 9, 10, 11, 50, 51, 52, 53, 60, 61, 62, 63, 64, 65, 66, 67 };
            }
            else if (Model.ImageWidth == 342)
            {
                AllowedLocations = new List<byte>() { 12, 13, 14, 15, 16, 17, 8, 9, 10, 11, 50, 51, 52, 53, 2, 3, 4, 5, 6, 7, 40, 41, 42, 43, 44, 45, 54, 55, 60, 61, 62, 63, 64, 65, 66, 67, 68, 69, 70 };
            }
            else if (Model.ImageWidth == 512)
            {
                //AllowedLocations = new List<byte>() { 12, 13, 14, 15, 16, 17, 8, 9, 10, 11, 50, 51, 52, 53, 2, 3, 4, 5, 6, 7, 40, 41, 42, 43, 44, 45, 30, 31, 32, 33, 54, 55, 60, 61, 62, 63, 64, 65, 66, 67 };
                AllowedLocations = new List<byte>() { 12, 13, 14, 15, 16, 17, 8, 9, 10, 11, 50, 51, 52, 53, 2, 3, 4, 5, 6, 7, 40, 41, 42, 43, 44, 45, 54, 55, 60, 61, 62, 63, 64, 65, 66, 67, 68, 69, 70 }; // removed 512 wide locations; Tom 14/04/2020
            }
            else if (Model.ImageWidth == 1024 || Model.ImageWidth == 1546 || Model.ImageWidth == null)
            {
                AllowedLocations = new List<byte>() { 12, 13, 14, 15, 16, 17, 8, 9, 10, 11, 50, 51, 52, 53, 2, 3, 4, 5, 6, 7, 40, 41, 42, 43, 44, 45, 30, 31, 32, 33, 20, 21, 54, 55, 60, 61, 62, 63, 64, 65, 66, 67, 68, 69, 70, 71 };
            }

            if (Model.BannerLocations.Count() == 1)
            {
                if (Model.BannerLocations.Select(p => p.BannerLocationID).ToList().Contains(55))
                {
                    AllowedLocations = new List<byte>() { 55 };
                }
            }

            <div class="content-panel-container">
                <fieldset id="banner-location-sitesection-fieldset">
                    <legend style="color: black; border-bottom-color: #929292;" onclick="$('#template-location-section').slideToggle('fast');">
                        Banner Location Details (click to expand / contract)
                        <img id="banner-location-busy" class="fieldset-busy" src="~/Images/SystemIcons/busy-icon.gif" />
                    </legend>
                    <div id="template-location-section" style="background-color: white; padding: 1em; position: relative;">
                        <div style="float: left; width: 40%; height: 100%;">
                            <label style="display: block; text-decoration: underline;"><span style="font-weight: 700;">Template Banner Locations</span> (built-in on every page)</label>
                            @foreach (var TG in TemplateGroups)
                            {
                                <label style="display: block; margin-left: 1em; font-size: 1em;">
                                    <span style="font-weight: 700;">@(TG.ElementAt(0).BannerLocationGroupName)</span>
                                    @if (TG.ElementAt(0).BannerLocationGroupNotes != null)
                                    {
                                        ViewContext.Writer.Write('('); @(TG.ElementAt(0).BannerLocationGroupNotes) ViewContext.Writer.Write(')');
                                    }
                                </label>
                                foreach (var G in TG.OrderBy(p => p.BannerLocationSortOrder))
                                {
                                    var allowed = AllowedLocations.Contains(G.BannerLocationID);
                                    
                                    @Html.DevExpress().CheckBox(settings => { 
                                       settings.Name = "BannerLocation" + G.BannerLocationID.ToString(); 
                                       settings.Style.Add("float", "left"); 
                                       settings.Style.Add("margin-left", "1em");
                                       if (allowed)
                                       {
                                           settings.ClientEnabled = true;
                                       }
                                       else
                                       {
                                           settings.ClientEnabled = false;
                                       }
                                    }).Bind(Model.BannerLocations.Any(p => p.BannerLocationID == G.BannerLocationID)).GetHtml()
    <label style="float: left; font-size: 1em; margin-bottom: 5px; margin-top: 1px; line-height: 20px; @(allowed ? "" : "text-decoration: line-through")"
           @{ if (allowed) { ViewContext.Writer.Write(""); } else { ViewContext.Writer.Write("title=\"Location Unavailable: the set image is not wide enough to fit here.\""); }}>
        @(G.BannerLocationID). @(G.BannerLocationName)
        @if (G.AllowMultiple) { ViewContext.Writer.Write('*'); }

        @if (G.BannerLocationID == 55)
        {
            <span class="glyphicon glyphicon-question-sign" style="cursor: pointer; font-size: 16px; font-weight: normal;" onclick="$('#email-schematic-dialog').dialog('open')" ></span>
        }
    </label>
                                    <div style="clear: both;"></div>
                                }
                            }
                        </div>
                        <div style="float: left; width: 51%; height: 100%; margin-left: 2em;">
                            <label style="display: block; text-decoration: underline;"><span style="font-weight: 700;">Page Section Banner Locations</span> (can be added to a page at will)</label>
                            <div style="height: 100%;">
                                @foreach (var PG in PageSectionGroups)
                                {
                                    <label style="display: block; margin-left: 1em; font-size: 1em;">
                                        <span style="font-weight: 700;">@(PG.ElementAt(0).BannerLocationGroupName)</span>
                                        @if (PG.ElementAt(0).BannerLocationGroupNotes != null)
                                        {
                                            ViewContext.Writer.Write('('); @(PG.ElementAt(0).BannerLocationGroupNotes) ViewContext.Writer.Write(')');
                                        }
                                    </label>
                                    foreach (var G in PG.OrderBy(p => p.BannerLocationSortOrder))
                                    {
                                        var allowed = AllowedLocations.Contains(G.BannerLocationID);
                                    
                                        @Html.DevExpress().CheckBox(settings => { 
                                            settings.Name = "BannerLocation" + G.BannerLocationID.ToString(); 
                                            settings.Style.Add("float", "left");
                                            settings.Style.Add("margin-left", "1em");
                                            if (allowed)
                                            {
                                                settings.ClientEnabled = true;
                                            }
                                            else
                                            {
                                                settings.ClientEnabled = false;
                                            }
                                        }).Bind(Model.BannerLocations.Any(p => p.BannerLocationID == G.BannerLocationID)).GetHtml()
                                        <label style="float: left; font-size: 1em; margin-bottom: 5px; margin-top: 1px; line-height: 20px; @(allowed ? "" : "text-decoration: line-through")"
                                               @{ if(allowed) { ViewContext.Writer.Write(""); } else { ViewContext.Writer.Write("title=\"Location Unavailable: the set image is not wide enough to fit here.\""); }} >
                                            @(G.BannerLocationID). @(G.BannerLocationName)
                                            @if (G.AllowMultiple) { ViewContext.Writer.Write('*'); }
                                        </label>
                                        <div style="clear: both;"></div>
                                    }
                                }
                            </div>
                        </div>
                        <div style="position: absolute; right: 4em; top: 60px; width: 20%; height: auto;">
                            <div style="height: 100%;">
                                <img id="banner-location-schematic" src="/images/admin/schematic-sml.png?v=1" style="width: 100%;" onclick="$('#schematic-dialog').dialog('open')" />
                                <a href="javascript:;" style="display: block; margin-top: 0.5em; text-align: center;" onclick="$('#schematic-dialog').dialog('open');">Banner Location Schematic<br />(click to expand)</a>
                            </div>
                        </div>
                        <div style="clear: both;"></div>
                        <i style="text-align: right; display: block; margin-right: 32px;">* Can display multiple banners in a slideshow</i>
                        <img id="banner-location-save" class="pagesection-save-icon" src="/images/icons/32/save.png" style="margin-right: 0; position: absolute; bottom: 10px; right: 10px;" onclick="SaveBannerLocations();" />
                    </div>
                </fieldset>
            </div>
        }
    }
         @*<div class="content-panel-container">
            <fieldset id="banner-location-sitesection-fieldset">
                <legend style="color: black; border-bottom-color: #929292;" onclick="$('#template-location-section').slideToggle('fast');">
                    Banner Location Details (click to expand / contract)
                    <img id="banner-location-busy" class="fieldset-busy" src="~/Images/SystemIcons/busy-icon.gif" />
                </legend>
                <div id="template-location-section" style="background-color: white; padding: 1em; position: relative;">
                    <div style="float: left; width: 40%; height: 100%;">
                        <label style="display: block; text-decoration: underline;"><span style="font-weight: 700;">You must specify an image before electing banner locations.</span></label>
                        </div>
                    <div style="clear: both;"></div>
                </div>
            </fieldset>
        </div>*@
