@model Flock.ViewModels.BannerSelectGridSettings
@using Flock.Models
@{
    var grid = Html.DevExpress().GridView(settings =>
    {
        var UoW = new Flock.DAL.UnitOfWork<FlockDataContext>();

        settings.Name = "BannerSelectorGridView";
        settings.CallbackRouteValues = new { Controller = "Banners", Action = "BannerComposeGridSelectorPartial" };

        settings.ClientSideEvents.BeginCallback = @"function(s, e) {
            //e.customArgs['BannerLocationIDs'] = ComposeBannerHeaderLocationListBox.listBox.GetSelectedItem().value.toString();
            e.customArgs['BannerLocationIDs'] = ComposeBannerHeaderLocationListBox.GetSelectedValues().toString();
            e.customArgs['CountryIDs'] = ComposeBannerHeaderCountryListBox.GetSelectedValues().toString();
            e.customArgs['SiteSectionIDs'] = ComposeBannerHeaderSiteSectionListBox.GetSelectedValues().toString();

            if (ComposeBannerHeaderPageListBox.GetSelectedItem()) {
                e.customArgs['PageIDs'] = ComposeBannerHeaderPageListBox.GetSelectedItem().value;
            }
        }";

        settings.ClientSideEvents.EndCallback = @"function(s, e) {
            LoadingPanel.Hide();
        }";

        settings.PreRender = (sender, e) =>
        {
            MVCxGridView gv = (MVCxGridView)sender;
            gv.FocusedRowIndex = -1;
        };

        settings.ClientSideEvents.RowClick = @"function(s, e) {
            var id = s.GetRowKey(e.visibleIndex);
            $('#selected-banner-id').val(id);
            LoadingPanel.Show();
            $.ajax({
                url: '" + @Url.Action("ChangeBanner", "Banners") + @"',
                type: 'POST',
                traditional: true,
                data: {
                    ID: id
                },
                success: function(data) {
                    $('#banner-compose-section').html(data);
                    LoadingPanel.Hide();
                },
                error: function(e, s, a) {
                    $.showError(e, s, a);
                },
                timeout: 20000
            });
        }";

        settings.TotalSummary.Add(DevExpress.Data.SummaryItemType.Count, "BannerID").DisplayFormat = "Total: {0:n0}";
        settings.Settings.ShowFooter = true;

        settings.SettingsBehavior.EnableRowHotTrack = true;
        settings.Styles.Row.Cursor = "pointer";
        settings.Width = 978;//System.Web.UI.WebControls.Unit.Percentage(100);
        settings.CommandColumn.Visible = false;
        settings.CommandColumn.ShowClearFilterButton = false;
        settings.Settings.ShowFilterRow = true;

        settings.SettingsPager.Mode = GridViewPagerMode.EndlessPaging;
        //property to EndlessPaging, and the Settings.VerticalScrollBarMode
        settings.Settings.VerticalScrollBarMode = ScrollBarMode.Visible;

        settings.SettingsBehavior.ConfirmDelete = true;
        settings.CommandColumn.ShowSelectCheckbox = false;
        settings.SettingsEditing.Mode = GridViewEditingMode.EditFormAndDisplayRow;
        settings.SettingsPager.PageSizeItemSettings.Visible = false;
        settings.SettingsPager.PageSize = 5;

        settings.SettingsBehavior.AllowFocusedRow = true;

        settings.KeyFieldName = "BannerID";

        settings.Columns.Add(column =>
        {
            column.Name = "BannerID";
            column.FieldName = "BannerID";
            column.Caption = "ID";
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.Width = 50;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.SortDescending();
        });

        settings.Columns.Add(column =>
        {
            column.Name = "Image";
            column.FieldName = "Image";
            column.Caption = "Image";
            column.UnboundType = DevExpress.Data.UnboundColumnType.String;
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.False;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.Width = 75;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.SetDataItemTemplateContent(c =>
            {
                if (System.IO.File.Exists(AppDomain.CurrentDomain.BaseDirectory + "//bannerimages//256//" + c.KeyValue.ToString() + ".jpeg"))
                {
                    ViewContext.Writer.Write("<img style='width: 24px;' id='banner-image-preview' src='/bannerimages/256/"+ c.KeyValue.ToString() +".jpeg?v="  + DataBinder.Eval(c.DataItem, "version").ToString() + ".jpeg' />");
                }
                else if (System.IO.File.Exists(AppDomain.CurrentDomain.BaseDirectory + "//bannerimages//256//" + c.KeyValue.ToString() + ".gif"))
                {
                    ViewContext.Writer.Write("<img style='width: 24px;' id='banner-image-preview' src='/bannerimages/256/" + c.KeyValue.ToString() + ".gif?v=" + DataBinder.Eval(c.DataItem, "version").ToString() + ".jpeg' />");
                }
            });
        });

        settings.Columns.Add(column =>
        {
            column.Name = "Name";
            column.FieldName = "Name";
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.Settings.AutoFilterCondition = AutoFilterCondition.Contains;
            column.Width = 140;
        });

        settings.Columns.Add(column =>
        {
            column.Name = "OverlayText";
            column.FieldName = "OverlayText";
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.Settings.AutoFilterCondition = AutoFilterCondition.Contains;
            column.Width = 140;
        });

        settings.Columns.Add(column =>
        {
            column.Name = "LanguageID";
            column.FieldName = "LanguageID";
            column.Caption = "Language";
            column.Settings.HeaderFilterMode = HeaderFilterMode.List;
            column.Settings.AllowHeaderFilter = DefaultBoolean.True;
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
            column.HeaderStyle.Wrap = DefaultBoolean.True;
            column.Width = 110;
            column.SetDataItemTemplateContent(c =>
            {
                byte LanguageID = 0;
                string Language = "<i>Unknown</i>";

                if (DataBinder.Eval(c.DataItem, "LanguageID") != DBNull.Value && DataBinder.Eval(c.DataItem, "LanguageID") != null)
                {
                    LanguageID = Convert.ToByte(DataBinder.Eval(c.DataItem, "LanguageID"));
                    Language = UoW.GetRepository<Flock.Models.Language>().GetAll().Where(p => p.LanguageID == LanguageID).Select(p => p.Name).Single();
                }
                ViewContext.Writer.Write("<span>" + Language + "</span>");
            });
        });

        settings.Columns.Add(column =>
        {
            column.Name = "CollectionID";
            column.FieldName = "CollectionID";
            column.Caption = "Collection";
            column.Width = 130;
            column.Settings.HeaderFilterMode = HeaderFilterMode.List;
            column.Settings.AllowHeaderFilter = DefaultBoolean.True;
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.Visible = false;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
            column.SetDataItemTemplateContent(c =>
            {
                int CollectionID = 0;
                string Collection = "<i>Unknown</i>";

                if (DataBinder.Eval(c.DataItem, "CollectionID") != DBNull.Value && DataBinder.Eval(c.DataItem, "CollectionID") != null)
                {
                    CollectionID = Convert.ToInt16(DataBinder.Eval(c.DataItem, "CollectionID"));
                    Collection = UoW.GetRepository<Flock.Models.Collection>().GetAll().Where(p => p.CollectionID == CollectionID).Select(p => p.Name).Single();
                }

                ViewContext.Writer.Write("<span>" + Collection + "</span>");
            });
        });

        //settings.Columns.Add(column =>
        //{
        //    column.Name = "LaunchID";
        //    column.FieldName = "LaunchID";
        //    column.Caption = "Launch";
        //    column.Width = 120;
        //    column.Settings.HeaderFilterMode = HeaderFilterMode.List;
        //    column.Settings.AllowHeaderFilter = DefaultBoolean.True;
        //    column.Settings.AllowAutoFilter = DefaultBoolean.False;
        //    column.EditFormSettings.Visible = DefaultBoolean.False;
        //    column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
        //    column.SetDataItemTemplateContent(c =>
        //    {
        //        int LaunchID = 0;
        //        string Launch = "<i>Unknown</i>";

        //        if (DataBinder.Eval(c.DataItem, "LaunchID") != DBNull.Value && DataBinder.Eval(c.DataItem, "LaunchID") != null)
        //        {
        //            LaunchID = Convert.ToByte(DataBinder.Eval(c.DataItem, "LaunchID"));
        //            Launch = UoW.GetRepository<Flock.Models.Launch>().GetAll().Where(p => p.LaunchID == LaunchID).Select(p => p.Name).Single();
        //        }

        //        ViewContext.Writer.Write("<span style='float: left;'>" + Launch + "</span>");
        //    });
        //});

        settings.Columns.Add(column =>
        {
            column.Name = "CreatedDT";
            column.FieldName = "CreatedDT";
            column.Caption = "Created DT";
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.ColumnType = MVCxGridViewColumnType.DateEdit;
            column.Width = 70;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
        });

        settings.Columns.Add(column =>
        {
            column.Name = "OnDate";
            column.FieldName = "OnDate";
            column.Caption = "On Date";
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.ColumnType = MVCxGridViewColumnType.DateEdit;
            column.Width = 70;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
        });

        settings.Columns.Add(column =>
        {
            column.Name = "OffDate";
            column.FieldName = "OffDate";
            column.Caption = "Off Date";
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.ColumnType = MVCxGridViewColumnType.DateEdit;
            column.Width = 70;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
        });

        MVCxGridViewColumn TradeColumn = new MVCxGridViewColumn();
        TradeColumn.Name = "TradeSwitch";
        TradeColumn.FieldName = "TradeSwitch";
        TradeColumn.Caption = "Trade / Retail";
        TradeColumn.Width = 90;
        TradeColumn.EditFormSettings.Visible = DefaultBoolean.False;
        TradeColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        TradeColumn.Settings.AllowHeaderFilter = DefaultBoolean.False;
        TradeColumn.SetDataItemTemplateContent(c =>
        {
            var i = (bool?)(DataBinder.Eval(c.DataItem, "TradeSwitch"));

            switch (i)
            {
                case true:
                    ViewContext.Writer.Write("Trade");
                    break;
                case false:
                    ViewContext.Writer.Write("Retail");
                    break;
                default:
                    ViewContext.Writer.Write("Both");
                    break;
            }

        });
        settings.Columns.Add(TradeColumn);

        MVCxGridViewColumn WebStatusColumn = new MVCxGridViewColumn();
        WebStatusColumn.FieldName = "StatusID";
        WebStatusColumn.Name = "StatusID";
        WebStatusColumn.Caption = "Web Status";
        WebStatusColumn.Settings.HeaderFilterMode = HeaderFilterMode.List;
        WebStatusColumn.Settings.AllowHeaderFilter = DefaultBoolean.True;
        WebStatusColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        WebStatusColumn.Width = 80;
        WebStatusColumn.SetFilterTemplateContent(c =>
        {
            ViewContext.Writer.Write("<a class='dxgvCommandColumnItem_MetropolisBlue dxgv__cci' style='display: block; text-align: center; font-weight: bold;' href='javascript:;' onclick='CreateNewBanner();'>New</a>");
        });
        WebStatusColumn.HeaderStyle.Wrap = DefaultBoolean.True;
        WebStatusColumn.SetDataItemTemplateContent(c =>
        {
            var i = Convert.ToByte(DataBinder.Eval(c.DataItem, "StatusID"));
            string colour = "black";
            string statusText = "unknown";
            statusText = UoW.GetRepository<Flock.Models.Status>().GetAll().Where(p => p.StatusID == i).Select(p => p.Name).Single();
            switch (i)
            {
                case 0:
                    colour = "green";
                    break;
                case 1:
                    colour = "orange";
                    break;
                case 2:
                    colour = "orange";
                    break;
                case 3:
                    colour = "green";
                    break;
                case 4:
                    colour = "red";
                    break;
                default: break;
            }
            string res = "<span style='color: " + colour + " '>" + statusText + "</span>";
            ViewContext.Writer.Write(res);
        });
        settings.Columns.Add(WebStatusColumn);

        settings.HeaderFilterFillItems = (sender, e) =>
        {
            MVCxGridView gridView = (MVCxGridView)sender;
            switch (e.Column.Name)
            {
                case "LaunchID":
                    e.Values.Clear();
                    foreach (var pt in UoW.GetRepository<Flock.Models.Launch>().GetAll().OrderByDescending(p => p.LaunchDate))
                    {
                        e.AddValue(pt.Name, pt.LaunchID.ToString());
                    }
                    e.AddShowAll();
                    break;

                case "TemplateID":
                    e.Values.Clear();
                    foreach (var pt in UoW.GetRepository<Flock.Models.Template>().GetAll().OrderBy(p => p.Name))
                    {
                        e.AddValue(pt.Name, pt.TemplateID.ToString());
                    }
                    e.AddShowAll();
                    break;

                case "ProductTypeID":
                    e.Values.Clear();
                    foreach (var pt in UoW.GetRepository<Flock.Models.ProductType>().GetAll().OrderBy(p => p.Name))
                    {
                        e.AddValue(pt.Name, pt.ProductTypeID.ToString());
                    }
                    e.AddShowAll();
                    break;

                case "BrandID":
                    e.Values.Clear();
                    foreach (var pt in UoW.GetRepository<Flock.Models.Brand>().GetAll().OrderBy(p => p.Name))
                    {
                        e.AddValue(pt.Name, pt.BrandID.ToString());
                    }
                    e.AddShowAll();
                    break;

                case "StatusID":
                    e.Values.Clear();
                    foreach (var pt in UoW.GetRepository<Flock.Models.Status>().GetAll().OrderBy(p => p.StatusID).ToList())
                    {
                        e.AddValue(pt.Name, pt.StatusID.ToString());
                    }
                    e.AddShowAll();
                    break;

                default: break;
            }
        };
    });

    if (ViewData["EditError"] != null)
    {
        grid.SetEditErrorText((string)ViewData["EditError"]);
    }
}
@grid.BindToLINQ("", "", (s, e) =>
{
    var dataContext = new Flock.DAL.UnitOfWork<Flock.Models.FlockDataContext>();

    var source = dataContext.GetRepository<Flock.Models.vwBannerOverview>().GetAll().Where(p => p.DeletedDT == null);

    var x = new List<int>(); // BannerLocation Linker

    var y = new List<int>(); // Country Linker

    var z = new List<int>(); // SiteSection Linker

    var w = new List<int>(); // Page Linker
    
    if (Model.BannerLocationIDs != null)
    {
        foreach (byte i in Model.BannerLocationIDs)
        {
            x = x.Concat(dataContext.GetRepository<Banner_BannerLocation>().GetAll().Where(p => i == p.BannerLocationID).Select(p => p.BannerID)).ToList();
        }
        source = source.InRange(a => a.BannerID, 2000, x).AsQueryable();
    }

    if (Model.CountryIDs != null)
    {
        foreach (short i in Model.CountryIDs)
        {
            y = y.Concat(dataContext.GetRepository<Banner_Country>().GetAll().Where(p => i == p.CountryID).Select(p => p.BannerID)).ToList();
        }
        source = source.InRange(a => a.BannerID, 2000, y).AsQueryable();
    }

    if (Model.SiteSectionIDs != null)
    {
        foreach (byte i in Model.SiteSectionIDs)
        {
            z = z.Concat(dataContext.GetRepository<Banner_SiteSection>().GetAll().Where(p => i == p.SiteSectionID).Select(p => p.BannerID)).ToList();
        }
        source = source.InRange(a => a.BannerID, 2000, z).AsQueryable();
    }

    if (Model.PageIDs != null)
    {
        foreach (int i in Model.PageIDs)
        {
            w = w.Concat(dataContext.GetRepository<Banner_Page>().GetAll().Where(p => i == p.PageID).Select(p => p.BannerID)).ToList();
        }
        source = source.InRange(a => a.BannerID, 2000, w).AsQueryable();
    }
    
    e.QueryableSource = source.OrderByDescending(p => p.BannerID);

    e.KeyExpression = "BannerID";
}).GetHtml()