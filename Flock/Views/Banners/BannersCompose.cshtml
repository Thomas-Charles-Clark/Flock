<input type="hidden" id="selected-banner-id" value="@(Model.BannerID)" />

<h4 class="page-heading">
    Compose Banner
</h4>

<div id="resource-panels" style="float: right; width: 986px;">
    @Html.Partial("~/Views/ProductPages/ProductPageSearchPartial.cshtml")
    @Html.Partial("~/Views/Collections/CollectionSearchPartial.cshtml")
    @Html.Partial("~/Views/Pages/PageSearchPartial.cshtml")
    @Html.Partial("~/Views/Articles/ArticleSearchPartial.cshtml")
    @Html.Partial("~/Views/Shared/CountrySearch.cshtml")
    @Html.Partial("~/Views/Images/ImageSearchPartial.cshtml")
</div>

<div style="float: left; width: 986px;">
    <div id="banner-select-header-container">
        <div class="content-panel-container">
            <fieldset id="banner-select-header">
                <legend style="color: black; border-bottom-color: #929292;" onclick="$('#banner-select-header-inner').slideToggle('fast');">
                    Banner Selector (click to expand / contract)
                </legend>
                <div id="banner-select-header-inner" style="padding-top: 4px; padding-bottom: 0;">
                    @Html.Action("ComposeBannerHeaderBannerLocationDropDownPartial", "Banners")
                    @Html.Action("ComposeBannerHeaderSiteSectionDropDownPartial", "Banners")
                    @Html.Action("ComposeBannerHeaderCountryDropDownPartial", "Banners")
                    @Html.Action("ComposeBannerHeaderPageComboBoxPartial", "Banners")
                    @Html.Action("ComposeBannerHeaderTradeComboBoxPartial", "Banners")
                    <div style="clear: both;"></div>
                    <div id="banner-header-banner-drop-down-container">
                        @Html.Partial("BannerSelectGridViewPartial", new Flock.ViewModels.BannerSelectGridSettings())
                    </div>
                    <div style="clear: both"></div>
                </div>
            </fieldset>
        </div>
    </div>

    <div id="banner-compose-section" data-banner-id="@(Model.BannerID)">
        @if (ViewData["InvalidBannerIDError"] != null)
        {
            <h5>@(ViewData["InvalidBannerIDError"])</h5>
        }
        @if (Model.BannerID != null)
        {
            @Html.Partial("BannerComposePartial", Model)
        }
    </div>
</div>

<div style="clear: both"></div>
