@grid.BindToLINQ("", "", (s, e) =>
{
    var dataContext = new Flock.DAL.UnitOfWork<Flock.Models.FlockDataContext>();
    var source = dataContext.GetRepository<Flock.Models.vwProductPageOverview>().GetAll();
    e.QueryableSource = source;
    e.KeyExpression = "ProductPageID";
}).GetHtml()