        settings.ClientSideEvents.RowClick = @"function(s, e) {
            var id = s.GetRowKey(e.visibleIndex);
            $('#selected-product-page-id').val(id);
            LoadingPanel.Show();
            $('#attribute-page-link').attr('href', '/admin/productpages/attributes/' + id.toString());
                $.ajax({ 
                    url: '" + @Url.Action("ChangeProductPage", "ProductPages") + @"',
                    type: 'POST',
                    traditional: true,
                    data: { 
                        ID: id
                    },
                    success: function(data) {
                        if (typeof FurnitureFabricOptions == 'object')
                            FurnitureFabricOptions = undefined;
                    
                        var States = {};
                        States.ProductPageInfoVisiblity = true;
                        States.ProductPageDetailsVisiblity = true;
                        States.ProductPageTextSlideshowVisiblity = true;
                        States.ProductPagePrimaryProductsVisiblity = true;
                        States.ProductPageSecondaryProductsVisiblity = true;
                        States.ProductPageRelatedProductsVisiblity = true;
                        States.ProductPageCountryRestrictionsVisiblity = true

                        if($('#product-page-info-inner').length > 0) {
                            States.ProductPageInfoVisiblity = $('#product-page-info-inner').is(':visible');
                            States.ProductPageDetailsVisiblity = $('#product-page-details-inner').is(':visible');
                            States.ProductPageTextSlideshowVisiblity = $('#product-page-text-slideshow-inner').is(':visible');
                            States.ProductPagePrimaryProductsVisiblity = $('#primary-products').is(':visible');
                            States.ProductPageSecondaryProductsVisiblity = $('#secondary-products').is(':visible');
                            States.ProductPageRelatedProductsVisiblity = $('#related-products').is(':visible');
                            States.ProductPageCountryRestrictionsVisiblity = $('#country-restriction-section').is(':visible');
                        }

                        $('#product-page-compose-container').hide();

                        if(States.ProductPageInfoVisibility == false)           
                            $('#product-page-info-inner').slideUp();
                        if(States.ProductPageDetailsVisibility == false)
                            $('#product-page-details-inner').slideUp();
                        if(States.ProductPageTextSlideshowVisibility == false)
                            $('#product-page-text-slideshow-inner').slideUp();
                        if(States.ProductPagePrimaryProductsVisibility == false)
                            $('#primary-products').slideUp();
                        if(States.ProductPageSecondaryProductsVisibility == false)
                            $('#secondary-products').slideUp();
                        if(States.ProductPageRelatedProductsVisibility == false)
                            $('#related-products').slideUp();
                        if(States.ProductPageCountryRestrictionsVisibility == false)
                            $('#country-restriction-section').slideUp();
                    
                        $('#product-page-compose-container').html(data);

                        LoadingPanel.Hide();
                        $('#product-page-compose-container').show();
                    },
                    error: function(e, s, a) { 
                        $.showError(e, s, a);
                    },
                    timeout: 20000
                });
        }";


