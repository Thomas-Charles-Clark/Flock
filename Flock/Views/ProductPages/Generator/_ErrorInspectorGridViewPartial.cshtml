        settings.HeaderFilterFillItems = (sender, e) =>
        {
            MVCxGridView gridView = (MVCxGridView)sender;
            switch (e.Column.Name)
            {
                case "ProductTypeID":
                    e.Values.Clear();
                    foreach (var v in productTypes)
                    {
                        e.AddValue(v.Name, v.ProductTypeID.ToString());
                    }
                    e.AddShowAll();
                    break;

                case "LaunchID":
                    e.Values.Clear();
                    foreach (var pt in UoW.GetRepository<Flock.Models.Launch>().GetAll().OrderByDescending(p => p.LaunchDate))
                    {
                        e.AddValue(pt.Name, pt.LaunchID.ToString());
                    }
                    e.AddShowAll();
                    break;

                case "NamingConventionID":
                    e.Values.Clear();
                    foreach (var v in namingConventions)
                    {
                        e.AddValue(v.Name, v.NamingConventionID.ToString());
                    }
                    e.AddShowAll();
                    break;

                case "TemplateID":
                    e.Values.Clear();
                    foreach (var v in templates)
                    {
                        e.AddValue(v.Name, v.TemplateID.ToString());
                    }
                    e.AddShowAll();
                    break;

                default: break;
            }
        };
