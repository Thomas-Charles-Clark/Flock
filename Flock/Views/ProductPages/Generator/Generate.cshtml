@{
    ViewBag.Title = "Product Page Generator";
    Layout = "~/Views/Admin/_Layout.cshtml";
}
@section scripts {
    <script type="text/javascript">

        var shouldDisplay = false;

        var selectedIDs = [];

        function Process() {
            console.log(selectedIDs.toString());
            $.ajax({
                url: '@(Url.Action("GenerateSelected", "ProductPages"))',
                type: 'POST',
                traditional: true,
                data: {
                    IDsToGenerate: selectedIDs.toString(),
                    OnDate: OnDate.GetValue() ? OnDate.GetValue().toGMTString() : null
                },
                success: function (data) {
                    console.log("success");
                    GridView.Refresh();
                },
                timeout: 1800000
            });
        }

        function runPreflightCheck() {
            $.ajax({
                url: '@Url.Action("FireGeneratorPreflightCheck", "ProductPages")',
                type: 'POST',
                traditional: true,
                data: {
                    merchandiserIDs: GridView.GetSelectedKeysOnPage() ? GridView.GetSelectedKeysOnPage().toString() : null,
                    launchID: ProductPageGenerateLaunchListBox.GetValue()
                },
                success: function (data) {
                    $.info("Result", data.toString());
                    console.log(data);
                },
                timeout: 30000
            });
        }

        function OnSelectionChanged(s, e) {
            s.GetSelectedFieldValues("MerchandiserID", GetSelectedFieldValuesCallback);
        }

        function GetSelectedFieldValuesCallback(values) {
            //Capture all selected keys
            selectedIDs = values.join(',');
        }

        function openCategorySettings() {
            $("#category-settings").dialog('open');
        }

        function openErrorInspector() {
            if (typeof ErrorInspectorGridView === 'object')
                ErrorInspectorGridView.Refresh();
            else {
                ErrorInspectorLoadingPanel.Show();
                $.ajax({
                    url: '/admin/productpages/ErrorInspectorGridViewPartial',
                    type: 'GET',
                    data: {
                        LaunchID: ProductPageGenerateLaunchListBox.GetValue()
                    },
                    success: function (data) {
                        $("#error-inspector-inner").html(data);
                        ErrorInspectorLoadingPanel.Hide();
                    }
                });
            }
            $("#error-inspector").dialog('open');
        }

        $(document).ready(function () {
            $("#category-settings").dialog({
                autoOpen: false,
                width: 700,
                height: 'auto',
                title: 'Category Settings'
            });

            $("#error-inspector").dialog({
                autoOpen: false,
                width: 1100,
                height: 'auto',
                title: 'Reasons Products weren\'t Imported'
            });

            $('[data-toggle="tooltip"]').tooltip({
                position: { my: "left top", at: "left bottom", collision: "flipfit" },
                content: function () {
                    return $(this).prop('title');
                }
            });
        });

    </script>
}

@section styles {
    <style type="text/css">
        .dxgvDetailCell_MetropolisBlue, .dxgvDetailCell_Aqua {
            padding: 0 !important;
            border-top: 0;
        }

        .ui-dialog {
            z-index: 5000 !important;
        }

            .ui-dialog, .ui-dialog .ui-dialog-content {
                overflow: visible !important;
            }

        :root .dxeTextBox_MetropolisBlue td.dxic .dxeEditArea_MetropolisBlue, :root .dxeButtonEdit_MetropolisBlue td.dxic .dxeEditArea_MetropolisBlue {
            height: auto !important;
        }

        .ui-tooltip {
            z-index: 60000 !important;
            padding: 1em;
            display: inline-block;
        }
    </style>
    @*@Styles.Render("~/Content/product-page-merchandiser.css")*@
}

<h4 class="page-heading">Product Page Generator</h4>

<div id="category-settings">
    <div id="category-settings-inner" style="height: 500px; overflow-y: scroll;">
        @Html.Action("CategorySettingsGridViewPartial")
    </div>
</div>

<div id="error-inspector">
    @Html.DevExpress().LoadingPanel(settings =>
    {
        settings.Name = "ErrorInspectorLoadingPanel";
        settings.ContainerElementID = "category-settings-inner";
        settings.Modal = true;
    }).GetHtml()
        <div id="error-inspector-inner" style="width: 100%; height: 500px; overflow-y: scroll;">
            @*@Html.Action("ErrorInspectorGridViewPartial")*@
        </div>
    </div>

    <div id="page-subheading" class="page-subheading">
        @Html.Action("ProductPage_Generate_LaunchPreFilter")

        @Html.DevExpress().DateEdit(settings =>
    {
        settings.Name = "OnDate";
        settings.Style.Add("margin", "0 7px 7px 0");
        settings.Style.Add("float", "left");
        settings.Width = System.Web.UI.WebControls.Unit.Pixel(200);
        settings.Height = System.Web.UI.WebControls.Unit.Pixel(35);
        settings.Properties.NullText = "Select On Date";
    }).GetHtml()

        <button type="button" value="Run Check" style="float: left; height: 35px; margin: 0 7px 7px 0;" onclick="runPreflightCheck();">Run Preflight Check</button>

        <button type="button" value="Run Check" style="float: left; height: 35px; margin: 0 7px 7px 0;" onclick="openCategorySettings();">Category Settings</button>

        <button type="button" value="Run Check" style="float: left; height: 35px; margin: 0 7px 7px 0;" onclick="openErrorInspector();">Error Inspector</button>

        <button id="gridview-go-button" type="button" value="Go" style="float: left; display: none; height: 35px;" onclick="$.confirm(function () { Process() }, function () { }, null, 'Selection from all pages will be generated. Ok?');">Create Product Pages</button>
        <div class="clearfix"></div>
    </div>

    <div id="gridview-container" style="float: left; display: none;">
        @Html.Action("GeneratorGridViewPartial")
    </div>

    <div class="clearfix"></div>