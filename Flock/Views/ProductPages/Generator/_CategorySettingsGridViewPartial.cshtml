@using Flock.DAL;
@using Flock.Models;
@{
	var grid = Html.DevExpress().GridView(settings => {
        var UoW = new UnitOfWork<FlockDataContext>();
        
        var productTypes = UoW.GetRepository<ProductType>().GetAll().OrderBy(p => p.ProductTypeID);
        foreach(var pt in productTypes)
        {
            pt.Name = pt.ProductTypeID + ": " + pt.Name;
        }
        
        var namingConventions = UoW.GetRepository<NamingConvention>().GetAll().OrderBy(p => p.NamingConventionID);
        foreach(var nc in namingConventions)
        {
            nc.Name = nc.NamingConventionID + ": " + nc.Name;
        }
        
        var templates = UoW.GetRepository<Template>().GetAll().Where(p => p.TemplateTypeID == 1);
        foreach (var t in templates)
        {
            t.Name = t.TemplateID + ": " + t.Name;
        }

        settings.ClientSideEvents.EndCallback = @"function(s, e) { 
            $('[data-toggle=""tooltip""]').tooltip({
                position: { my: ""left top"", at: ""left bottom"", collision: ""flipfit"" },
                content: function () {
                    return $(this).prop('title');
                }
            });
        }";
        
        
        settings.Name = "CategorySettingsGridView";
        settings.CallbackRouteValues = new { Controller = "ProductPages", Action = "CategorySettingsGridViewPartial" };
        settings.SettingsEditing.BatchUpdateRouteValues = new { Controller = "ProductPages", Action = "CategorySettingsGridViewBatchEditingUpdate" };
        settings.SettingsEditing.Mode = GridViewEditingMode.Batch;
        settings.SettingsBehavior.ConfirmDelete = true;

		settings.CommandColumn.Visible = false;
        settings.CommandColumn.ShowNewButton = false;
        settings.CommandColumn.ShowDeleteButton = false;
        settings.CommandColumn.ShowEditButton = false;
        settings.Settings.ShowFilterRowMenu = true;

        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
        
        settings.HtmlDataCellPrepared += (sender, e) => {
            var g = (MVCxGridView)sender;
            if (e.CellValue == null)
            {
                e.Cell.BackColor = System.Drawing.ColorTranslator.FromHtml("#ff5c5c");
            }
        };
        
		settings.KeyFieldName = "ProductCategoryID";

		//settings.SettingsPager.Visible = true;
        settings.SettingsPager.Mode = GridViewPagerMode.ShowAllRecords;
		settings.Settings.ShowGroupPanel = false;
		settings.Settings.ShowFilterRow = true;
		settings.SettingsBehavior.AllowSelectByRowClick = false;

        //settings.Columns.Add("ProductCategoryID").EditFormSettings.Visible = DefaultBoolean.False;
        settings.Columns.Add("Name").EditFormSettings.Visible = DefaultBoolean.False;
        var nColumn = settings.Columns["Name"] as MVCxGridViewColumn;
        nColumn.Caption = "Product Category";
        nColumn.Width = System.Web.UI.WebControls.Unit.Percentage(20);
        nColumn.CellStyle.BackColor = System.Drawing.ColorTranslator.FromHtml("#f2f2f2");
        
		settings.Columns.Add("ProductTypeID");
		settings.Columns.Add("NamingConventionID");
		settings.Columns.Add("TemplateID");

        var ptColumn = settings.Columns["ProductTypeID"] as MVCxGridViewColumn;
        ptColumn.Name = "ProductTypeID";
        ptColumn.Caption = "Product Type";
        ptColumn.Width = System.Web.UI.WebControls.Unit.Percentage(20);
        ptColumn.EditFormSettings.Visible = DefaultBoolean.True;
        ptColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        ptColumn.Settings.AllowHeaderFilter = DefaultBoolean.True;
        ptColumn.Settings.HeaderFilterMode = HeaderFilterMode.List;
        ptColumn.ColumnType = MVCxGridViewColumnType.ComboBox;
        var ptProp = ptColumn.PropertiesEdit as ComboBoxProperties;
        ptProp.TextField = "Name";
        ptProp.ValueField = "ProductTypeID";
        ptProp.ValueType = typeof(byte);
        ptProp.DataSource = productTypes;

        var ncColumn = settings.Columns["NamingConventionID"] as MVCxGridViewColumn;
        ncColumn.Name = "NamingConventionID";
        ncColumn.Caption = "Naming Convention";
        ncColumn.Width = System.Web.UI.WebControls.Unit.Percentage(40);
        ncColumn.EditFormSettings.Visible = DefaultBoolean.True;
        ncColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        ncColumn.Settings.AllowHeaderFilter = DefaultBoolean.True;
        ncColumn.Settings.HeaderFilterMode = HeaderFilterMode.List;
        ncColumn.ColumnType = MVCxGridViewColumnType.ComboBox;
        ncColumn.SetDataItemTemplateContent(c => {
            var thisNc = namingConventions.Where(p => p.NamingConventionID == (byte?)DataBinder.Eval(c.DataItem, "NamingConventionID")).SingleOrDefault();
            if(thisNc != null)
            {
                ViewContext.Writer.Write("<span>" + thisNc.Name + "</span>");
                ViewContext.Writer.Write("<span class='glyphicon glyphicon-info-sign' style='float: right;' data-toggle='tooltip' data-placement='left' title='<strong>Sources</strong><br/><br/>" + Html.Raw(thisNc.DataSource) + "<br/><br/><br/><br/><strong>Formulae</strong><br/><br/><strong>Heading:</strong> " + thisNc.HeadingFormula + "<br/><br/><strong>SubHeading:</strong> " + thisNc.SubHeadingFormula + "<br/><br/><strong>Title Tag:</strong> " + thisNc.TitleTagFormula + "<br/><br/><strong>URL Keywords:</strong> " + thisNc.URLKeywordsFormula + "<br/><br/><strong>Basket Name:</strong> " + thisNc.BasketNameFormula + "'></span>");
            }
        });
        
        var ncProp = ncColumn.PropertiesEdit as ComboBoxProperties;
        ncProp.TextField = "Name";
        ncProp.ValueField = "NamingConventionID";
        ncProp.ValueType = typeof(byte);
        ncProp.DataSource = namingConventions;
        
        
        var tColumn = settings.Columns["TemplateID"] as MVCxGridViewColumn;
        tColumn.Name = "TemplateID";
        tColumn.Caption = "Template";
        tColumn.Width = System.Web.UI.WebControls.Unit.Percentage(20);
        tColumn.EditFormSettings.Visible = DefaultBoolean.True;
        tColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        tColumn.Settings.AllowHeaderFilter = DefaultBoolean.True;
        tColumn.Settings.HeaderFilterMode = HeaderFilterMode.List;
        tColumn.ColumnType = MVCxGridViewColumnType.ComboBox;
        var tProp = tColumn.PropertiesEdit as ComboBoxProperties;
        tProp.TextField = "Name";
        tProp.ValueField = "TemplateID";
        tProp.ValueType = typeof(byte);
        tProp.DataSource = templates;
        

        settings.HeaderFilterFillItems = (sender, e) =>
        {
            MVCxGridView gridView = (MVCxGridView)sender;
            switch (e.Column.Name)
            {
                case "ProductTypeID":
                    e.Values.Clear();
                    foreach (var v in productTypes)
                    {
                        e.AddValue(v.Name, v.ProductTypeID.ToString());
                    }
                    e.AddShowAll();
                    break;

                case "NamingConventionID":
                    e.Values.Clear();
                    foreach (var v in namingConventions)
                    {
                        e.AddValue(v.Name, v.NamingConventionID.ToString());
                    }
                    e.AddShowAll();
                    break;

                case "TemplateID":
                    e.Values.Clear();
                    foreach (var v in templates)
                    {
                        e.AddValue(v.Name, v.TemplateID.ToString());
                    }
                    e.AddShowAll();
                    break;
                
                default: break;
            }
        };
	});
    if (ViewData["EditError"] != null){
        grid.SetEditErrorText((string)ViewData["EditError"]);
    }
}
@grid.Bind(Model).GetHtml()