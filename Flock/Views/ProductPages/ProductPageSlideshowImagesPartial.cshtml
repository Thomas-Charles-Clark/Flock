@model List<Flock.Models.ProductPage_Image>
<div id="slideshow-list" class="sortable-list" style="width: 100%; height: 100%;">
    @for (int i = 0; i < Model.Count; i++)
    {
        <div class="product-page-slideshow-item" data-image-id="@(Model[i].ImageID)" onmouseover="$(this).find('.image-remove-icon').stop().animate({opacity: 0.8}, 300)" onmouseout="$(this).find('.image-remove-icon').stop().animate({opacity: 0.0}, 300)">
            <img src="~/Images/SystemIcons/remove-icon.png" class="image-remove-icon" onclick="RemoveImageFromProductPageArea(2, @(Model[i].ImageID))" />
            <img style="width: 200px; height: 200px;" src="https://flock.designersguild.com/ImageLibrary/322/@(Model[i].ImageID).jpeg" />
            @if (Model[i].Image.DeletedDT != null)
            {
                <span class="pod-image-deleted-strip"></span>
            }
        </div>
    }
    @if (Model.Count == 0)
    {
        <div class="product-page-slideshow-placeholder">
            There are no images associated to this product page's slideshow.
        </div>
    }
</div>
<script type="text/javascript">
    if(typeof(InitSlideshowDragDrop) == 'function')
        InitSlideshowDragDrop();
</script>