@Html.DevExpress().DropDownEdit(ddSettings =>
{
    ddSettings.Name = "ToggleDD";
    ddSettings.Text = "is";
    ddSettings.Style.Add("float", "left");
    ddSettings.Style.Add("margin", "0 7px 7px 0");
    ddSettings.Properties.DropDownWindowStyle.BackColor = System.Drawing.Color.FromArgb(0xEDEDED);
    ddSettings.Width = 120;
    ddSettings.Height = System.Web.UI.WebControls.Unit.Pixel(35);
    
    ddSettings.SetDropDownWindowTemplateContent(c =>
    {
        ViewContext.Writer.Write("<div id='attribute-group-listbox'>");
        Html.DevExpress().ListBox(lbSettings =>
        {
            lbSettings.Name = "ToggleListBox";
            lbSettings.Properties.Items.Add("is", 1);
            lbSettings.Properties.Items.Add("is not", 0);
            lbSettings.Properties.Items.Add("is not configured", 2);
            lbSettings.SelectedIndex = 0;
            lbSettings.ControlStyle.Border.BorderWidth = 0;
            lbSettings.ControlStyle.BorderBottom.BorderWidth = 1;
            lbSettings.ControlStyle.BorderBottom.BorderColor = System.Drawing.Color.FromArgb(0xDCDCDC);
            lbSettings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
            lbSettings.Height = 69;
            lbSettings.Properties.SelectionMode = ListEditSelectionMode.Single;
            lbSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
                ToggleDD.SetText(s.GetSelectedItem().text);
                ToggleDD.HideDropDown();
                
                var ProductTypeID = ClassifierProductTypeListBox.GetSelectedItem() == null ? null : ClassifierProductTypeListBox.GetSelectedItem().value;
                var AttributeGroupID = AttributeGroupListBox.GetSelectedItem() ==  null ? null : AttributeGroupListBox.GetSelectedItem().value;
                var AttributeID = null;
                if (AttributeDD.IsVisible())
                    AttributeID = AttributeListBox.GetSelectedItem() == null ? null : AttributeListBox.GetSelectedItem().value;
                var ToggleState = ToggleListBox.GetSelectedItem() == null ? null : ToggleListBox.GetSelectedItem().value;

                if(ProductTypeID == null || AttributeGroupID == null)
                    return;

                $.ajax({
                    url: '" + Url.Action("ClassifierHeader", "ProductPages") + @"',
                    type: 'POST',
                    traditional: true,
                    data: {
                        ProductTypeID: ProductTypeID,
                        AttributeGroupID: AttributeGroupID,
                        AttributeID: AttributeID,
                        Toggle: ToggleState
                    },
                    success: function(data) {
                        $('#page-subheading').html(data);
                            
                        var ProductTypeID = ClassifierProductTypeListBox.GetSelectedItem() == null ? null : ClassifierProductTypeListBox.GetSelectedItem().value;
                        var AttributeGroupID = AttributeGroupListBox.GetSelectedItem() ==  null ? null : AttributeGroupListBox.GetSelectedItem().value;
                         var AttributeID = null;
                        if (AttributeDD.IsVisible())
                            var AttributeID = AttributeListBox.GetSelectedItem() == null ? null : AttributeListBox.GetSelectedItem().value;
                        var ToggleState = ToggleListBox.GetSelectedItem() == null ? null : ToggleListBox.GetSelectedItem().value;

                        if(AttributeID != null || ToggleState == 2) {
                            LoadingPanel.Show();                        

                            $.ajax({
                                url: '" + Url.Action("ClassificationResultsPartial", "ProductPages") + @"',
                                type: 'POST',
                                traditional: true,
                                data: { 
                                    ProductTypeID: ProductTypeID,
                                    AttributeGroupID: AttributeGroupID,
                                    AttributeID: AttributeID,
                                    Toggle: ToggleState
                                },
                                success: function(data) {
                                    $('#ajax-target').html(data);
                                    LoadingPanel.Hide();
                                }
                            });
                        }
                    }
                });
            }";
            lbSettings.Properties.ClientSideEvents.Init = @"function(s, e) { 
                s.SetSelectedItem(s.FindItemByValue(" + ViewBag.SelectedToggleState + @"));
                if(s.GetSelectedItem() != null && s.GetSelectedItem() != false)
                    ToggleDD.SetText(s.GetSelectedItem().text);
            }";
        }).Render();
        ViewContext.Writer.Write("</div>");
    });
}).GetHtml()