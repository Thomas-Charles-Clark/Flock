@model List<Flock.Models.ProductPage_Image>
@if (Model.Count == 0)
{
    <div id="product-page-pod-placeholder" class="placeholder">
        There are no images associated to this product page's pod area.
    </div>
}
else
{
    foreach (Flock.Models.ProductPage_Image i in Model)
    {
        <div data-image-id="@i.ImageID" class="pod-sortable" onmouseover="$(this).find('.image-remove-icon').stop().animate({opacity: 0.8}, 300)" onmouseout="$(this).find('.image-remove-icon').stop().animate({opacity: 0.0}, 300)">
            <img style="width: 190px;" src="https://flock.designersguild.com/imagelibrary/239/@(i.ImageID).jpeg" alt="@(i.AltText)" title="@(i.TitleText)" />
            <img src="~/Images/SystemIcons/remove-icon.png" class="image-remove-icon" onclick="RemoveImageFromProductPageArea(1, @(i.ImageID))" />
            @if (i.Image.DeletedDT != null)
            {
                <span class="pod-image-deleted-strip"></span>
            }
        </div>
    }
}
<script type="text/javascript">
    if (typeof(InitPodDragDrop) == "function")
        InitPodDragDrop();
</script>