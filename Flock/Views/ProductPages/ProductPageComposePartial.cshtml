    function UpdateProductPageImageArea(TemplateImageID, ui) {
        switch (TemplateImageID) {
            case 1:
                $("#product-page-pod-busy").fadeIn("fast");
                $.ajax({
                    url: '@Url.Action("UpdateProductPageImageArea", "ProductPages")',
                    traditional: true,
                    type: "POST",
                    data: { ProductPageID: Number($("#selected-product-page-id").val()), Images: JSON.stringify(window.podImages), TemplateImageID: TemplateImageID },
                    success: function (data) {
                        $("#product-page-pod-busy").fadeOut("fast");
                        $('#pod-list').html(data)
                        return false;
                    },
                    error: function (e, s, a) {
                        $("#product-page-pod-busy").fadeOut("fast");
                        alert(e.responseText);
                        return false;
                    },
                    timeout: 20000
                });
                break;
            case 2:
                $("#product-page-slideshow-busy").fadeIn("fast");
                $.ajax({
                    url: '@Url.Action("UpdateProductPageImageArea", "ProductPages")',
                    traditional: true,
                    type: "POST",
                    data: { ProductPageID: Number($("#selected-product-page-id").val()), Images: JSON.stringify(window.slideshowImages), TemplateImageID: TemplateImageID },
                    success: function (data) {
                        $("#product-page-slideshow-busy").fadeOut("fast");
                        if ($("#slideshow-images-container").length > 0)
                            $("#slideshow-images-container").html(data);
                        else
                            $("#product-page-slideshow-container").html(data)
                        return false;
                    },
                    error: function (e, s, a) {
                        $("#product-page-slideshow-busy").fadeOut("fast");
                        alert(e.responseText);
                        return false;
                    },
                    timeout: 20000
                });
                break;
            case 3:
                //$("#product-page-slideshow-busy").fadeIn("fast");
                $.ajax({
                    url: '@Url.Action("UpdateProductPageImageArea", "ProductPages")',
                    traditional: true,
                    type: "POST",
                    data: { ProductPageID: Number($("#selected-product-page-id").val()), Images: JSON.stringify(window.slideshowImages), TemplateImageID: TemplateImageID },
                    success: function (data) {
                        //$("#product-page-slideshow-busy").fadeOut("fast");
                        if ($("#details-and-pod-images-container").length > 0)
                            $("#details-and-pod-images-container").html(data);
                        return false;
                    },
                    error: function (e, s, a) {
                        //$("#product-page-slideshow-busy").fadeOut("fast");
                        alert(e.responseText);
                        return false;
                    },
                    timeout: 20000
                });
                break;
            case 4:
                $.ajax({
                    url: '@Url.Action("UpdateProductPageImageArea", "ProductPages")',
                    traditional: true,
                    type: 'post',
                    data: {
                        ProductPageID: Number($("#selected-product-page-id").val()),
                        Images: JSON.stringify([{
                            ID: $(ui.draggable).data("image-id"),
                            SortOrder: 0
                        }]),
                        TemplateImageID: 3
                    },
                    success: function (data) {
                        $("#furniture-page-cutout-image-target").html(data);
                    },
                    error: function (e, s, a) {
                        alert(e.responseText);
                    },
                    timeout: 20000
                });
                break;
            case 5:
                $.ajax({
                    url: '@Url.Action("UpdateProductPageImageArea", "ProductPages")',
                    traditional: true,
                    type: 'post',
                    data: {
                        ProductPageID: Number($("#selected-product-page-id").val()),
                        Images: JSON.stringify([{
                            ID: $(ui.item).data("image-id"),
                            SortOrder: 0
                        }]),
                        TemplateImageID: 5
                    },
                    success: function (data) {
                        $("#slideshow-and-html-editor-container").html(data);
                    },
                    error: function (e, s, a) {
                        alert(e.responseText);
                    },
                    timeout: 20000
                });
                break;
            case 6:
                $.ajax({
                    url: '@Url.Action("UpdateProductPageImageArea", "ProductPages")',
                    traditional: true,
                    type: 'post',
                    data: {
                        ProductPageID: Number($("#selected-product-page-id").val()),
                        Images: JSON.stringify([{
                            ID: $(ui.item).data("image-id"),
                            SortOrder: 0
                        }]),
                        TemplateImageID: 6
                    },
                    success: function (data) {
                        $("#product-page-info-container").html(data);
                    },
                    error: function (e, s, a) {
                        alert(e.responseText);
                    },
                    timeout: 20000
                });
                break;
            default: break;
        }
    }

    function RemoveImageFromProductPageArea(TemplateImageID, ImageID) {
        switch (TemplateImageID) {
            case 1: $("#product-page-pod-busy").fadeIn("fast"); break;
            case 2: $("#product-page-slideshow-busy").fadeIn("fast"); break;
            case 3: $("#product-page-cutout-busy").fadeIn("fast"); break;
            case 5: $("#product-page-slideshow-busy").fadeIn("fast"); break;
            case 6: $("#product-page-info-busy").fadeIn("fast"); break;
            default: return;
        }
        $.confirm(function () {
            switch (TemplateImageID) {
                case 1:
                    $("#product-page-pod-busy").fadeIn("fast");
                    $('#pod-list').find("[data-image-id='" + ImageID + "']").remove();
                    $('#pod-list').sortable('refresh');
                    window.podImages = new Array();
                    if ($("#product-page-pod-placeholder").length > 0)
                        $("#product-page-pod-placeholder").remove();
                    $("#pod-list").children("div").each(function (index) {
                        window.podImages.push({ ID: $(this).data("image-id"), SortOrder: index });
                    });
                    UpdateProductPageImageArea(1);
                    break;
                case 2:
                    $("#product-page-slideshow-busy").fadeIn("fast");
                    $('#slideshow-list').find("[data-image-id='" + ImageID + "']").remove();
                    $("#slideshow-list").sortable("refresh");
                    window.slideshowImages = new Array();
                    $(".product-page-slideshow-placeholder").remove();
                    $("#slideshow-list").children("div").each(function (index) {
                        window.slideshowImages.push({ ID: $(this).data("image-id"), SortOrder: index });
                    });
                    UpdateProductPageImageArea(2);
                    break;
                case 3:
                    $("#product-page-cutout-busy").fadeIn("fast");
                    $.ajax({
                        url: '@Url.Action("RemoveImageFromProductPageArea", "ProductPages")',
                        traditional: true,
                        type: "POST",
                        data: { ProductPageID: Number($("#selected-product-page-id").val()), TemplateImageID: TemplateImageID, ImageID: ImageID },
                        success: function (data) {
                            switch (TemplateImageID) {
                                case 3:
                                    $("#product-page-cutout-busy").fadeOut("fast");
                                    $("#furniture-page-cutout-image-target").html(data);
                                    break;
                                default:
                                    return false;
                            }
                            return false;
                        },
                        error: function (e, s, a) {
                            $.showError(e, s, a, function () {
                                $("#product-page-cutout-busy").fadeOut("fast");
                            });
                            return false;
                        },
                        timeout: 20000
                    });
                    break;
                case 5:
                    $.ajax({
                        url: '@Url.Action("RemoveImageFromProductPageArea", "ProductPages")',
                        traditional: true,
                        type: 'post',
                        data: {
                            ProductPageID: Number($("#selected-product-page-id").val()),
                            ImageID: ImageID,
                            TemplateImageID: 5
                        },
                        success: function (data) {
                            $("#slideshow-and-html-editor-container").html(data);
                        },
                        error: function (e, s, a) {
                            alert(e.responseText);
                        },
                        timeout: 20000
                    });
                break;
                case 6:
                    $.ajax({
                        url: '@Url.Action("RemoveImageFromProductPageArea", "ProductPages")',
                        traditional: true,
                        type: 'post',
                        data: {
                            ProductPageID: Number($("#selected-product-page-id").val()),
                            ImageID: ImageID,
                            TemplateImageID: 6
                        },
                        success: function (data) {
                            $("#product-page-info-container").html(data);
                        },
                        error: function (e, s, a) {
                            alert(e.responseText);
                        },
                        timeout: 20000
                    });
                break;
                default: return;
            }
            @*else
            {
                $.ajax({
                    url: '@Url.Action("RemoveImageFromProductPageArea", "ProductPages")',
                    traditional: true,
                    type: "POST",
                    data: { ProductPageID: Number($("#selected-product-page-id").val()), TemplateImageID: TemplateImageID, ImageID: ImageID },
                    success: function (data) {
                        switch (TemplateImageID) {
                            case 1: $("#product-page-pod-busy").fadeOut("fast"); $('#pod-list').html(data); break;
                            case 2: $("#product-page-slideshow-busy").fadeOut("fast"); $("#slideshow-images-container").html(data); $('#product-page-slideshow-container').html(data); break;
                            case 3: $("#product-page-cutout-busy").fadeOut("fast"); $("#product-page-cutout-container").html(data); break;
                            default: return false;
                        }
                        return false;
                    },
                    error: function (e, s, a) {
                        switch (TemplateImageID) {
                            case 1: $("#product-page-pod-busy").fadeOut("fast"); break;
                            case 2: $("#product-page-slideshow-busy").fadeOut("fast"); break;
                            case 3: $("#product-page-cutout-busy").fadeOut("fast"); break;
                            default: return false;
                        }
                        alert(e.responseText);
                        return false;
                    },
                    timeout: 20000
                });
            }*@
        }, function () {
            switch (TemplateImageID) {
                case 1: $("#product-page-pod-busy").fadeOut("fast"); break;
                case 2: $("#product-page-slideshow-busy").fadeOut("fast"); break;
                case 3: $("#product-page-cutout-busy").fadeOut("fast"); break;
                default: return false;
            }
        });
    }

    function InitCountryDragDrop() {
        $("#country-restriction-section").sortable({
            helper: "clone",
            connectWith: ".country-restriction-flag",
            placeholder: ".ui-state-highlight-country-restriction",
            update: function (ev, ui) {
                if ($(ui.item).hasClass('country-flag')) {
                    $("#country-restriction-section").sortable("refresh");
                    window.CountryRestrictions = new Array();
                    if ($("#country-restriction-placeholder").length > 0)
                        $("#country-restriction-placeholder").remove();
                    $("#country-restriction-section").children("div").each(function (index) {
                        window.CountryRestrictions.push({ ID: $(this).data("country-id"), SortOrder: 0 });
                    });
                    UpdateCountryRestrictions();
                }
            }
        });
        $(".country-flag").draggable({
            helper: "clone",
            start: function (e, ui) {
                $(ui.helper).css("z-index", "300000");
            },
            connectToSortable: "#country-restriction-section"
        });
    }

    function UpdateCountryRestrictions() {
        $("#country-restriction-busy").fadeIn("fast");
        $.ajax({
            url: '@Url.Action("UpdateProductPageCountryRestrictions", "ProductPages")',
            type: "POST",
            traditional: true,
            data: { ProductPageID: Number($("#selected-product-page-id").val()), Countries: JSON.stringify(window.CountryRestrictions) },
            success: function (data) {
                $("#country-restriction-busy").fadeOut("fast");
                $("#country-restriction-container").html(data);
            },
            error: function (e, s, a) {
                $("#country-restriction-busy").fadeOut("fast");
                alert(e.responseText);
            },
            timeout: 20000
        });
    }

    function RemoveCountryFromRestriction() {
        $("#country-restriction-section").sortable("refresh");
        window.CountryRestrictions = new Array();
        if ($("#country-restriction-placeholder").length > 0)
            $("#country-restriction-placeholder").remove();
        $("#country-restriction-section").children("div").each(function (index) {
            window.CountryRestrictions.push({ ID: $(this).data("country-id"), SortOrder: 0 });
        });
        UpdateCountryRestrictions();
    }

    function RemoveAllCountryRestrictions() {
        var confirm = window.confirm("Are you sure?");
        if (confirm) {
            window.CountryRestrictions = new Array();
            UpdateCountryRestrictions();
        }
    }

    function InitPrimaryProductDragDrop() {

        var fixHelper = function (e, ui) {
            ui.children().each(function () {
                $(this).width($(this).width());
            });
            return ui;
        };

        $("#primary-products-table > tbody").sortable({
            helper: fixHelper,
            connectWith: '.product',
            placeholder: 'products-table-row-placeholder',
            beforeStop: function (event, ui) {
                if ($(ui.item).data("associated-product-page") != null && $(ui.item).data("associated-product-page") != "null") {
                    var confirm = window.confirm("Warning! This action will remove the existing Primary association this Product has to Product Page " + $(ui.item).data("associated-product-page") + ". Continue?");
                    if (!confirm) {
                        $(ui.helper).remove();
                        $(ui.item).remove();
                        window.cancelPrimaryDrop = true;
                    }
                }
            },
            receive: function (event, ui) {
                if (window.cancelPrimaryDrop) {
                    window.cancelPrimaryDrop = false;
                    $(ui.sender).sortable("cancel");
                }
                var newItem = $(this).data("ui-sortable").currentItem;
                //if ($("#primary-products-placeholder").length > 0) {
                //$("#primary-products-placeholder").remove();
                var tr = $("<tr data-product-id='" + $(ui.item).data("product-id") + "'><td colspan='8'>" + $(ui.item).find('label').html() + "</td></tr>");//.append("<td colspan='8'>" + $(ui.item).find('label').clone() + "</td>");
                $(newItem).replaceWith($(tr));
                //}
                //else {
                //    var tr = $("<tr data-product-id='" + $(ui.item).data("product-id") + "'><td colspan='8'>" + $(ui.item).find('label').html() + "</td></tr>");//.append("<td colspan='8'>" + $(ui.item).find('label').clone() + "</td>");
                //    $(newItem).replaceWith($(tr));
                //}

                //ui.helper.html(newItem);
            },
            update: function (ev, ui) {
                //if ($(ui.item).hasClass('product')) {
                window.PrimaryProducts = new Array();
                //if ($("#primary-products-placeholder").length > 0)
                $("#primary-products-placeholder").remove();
                $("#primary-products-table > tbody").sortable("refresh");
                $("#primary-products-table > tbody > tr ").each(function (index) {
                    window.PrimaryProducts.push({ ID: $(this).data("product-id"), SortOrder: index });
                });
                UpdatePrimaryProducts();
                //}
            }
        }).disableSelection();

        $(".product").draggable({
            helper: 'clone',
            start: function (e, ui) {
                $(ui.helper).css("z-index", "300000");
            },
            connectToSortable: "#primary-product-sortable, #secondary-product-sortable"
        });
    }

    function RemovePrimaryProduct(ProductID) {
        $.ajax({
            url: '@Url.Action("RemoveProductPagePrimaryProduct", "ProductPages")',
            type: 'POST',
            traditional: true,
            data: { ProductPageID: Number($("#selected-product-page-id").val()), ProductID: ProductID },
            success: function (data) {
                if (data == "success") {
                    $("#primary-products-table > tbody").find("[data-product-id='" + ProductID + "']").remove();

                    window.PrimaryProducts = new Array();
                    $("#primary-product-sortable > tr").each(function (index) {
                        window.PrimaryProducts.push({ ID: $(this).data("product-id"), SortOrder: index });
                    });

                    UpdatePrimaryProducts();
                }
                else {
                    alert(data)
                }
            },
            error: function (e, s, a) {
                alert(e.responseText);
            },
            timeout: 20000
        });
    }

