    function SaveProductPageInfo() {
        var id = Number($("#selected-product-page-id").val());
        $.ajax({
            url: '@Url.Action("SaveProductPageInfo", "ProductPages")',
            type: 'POST',
            traditional: true,
            data: {
                ProductPageID: id,
                Name: Name.GetValue(),
                OnDate: $("input[name='OnDate']").val(),
                OffDate: $("input[name='OffDate']").val(),
                New: New.GetValue(),
                BrochureID: BrochureID.GetSelectedItem().value,
                TradeSwitch: TradeSwitch.GetValue()
            },
            success: function (data) {
                $("#product-page-info-container").html(data);
                SuccessFade($("#product-page-info-save"));
            },
            error: function (e, s, a) {
                $("#product-page-info-container").html(e.responseText);
                FailureFade($("#product-page-info-save"));
            },
            timeout: 20000
        });
    }

    function SaveProductPageDetails() {
        URLKeywords.Validate();
        if (URLKeywords.GetIsValid()) {
            $.ajax({
                url: '@Url.Action("SaveProductPageDetails", "ProductPages")',
                type: 'POST',
                traditional: true,
                data: {
                    ProductPageID: Number($("#selected-product-page-id").val()),
                    Name: Name.GetValue(),
                    TitleTag: TitleTag.GetValue(),
                    URLKeywords: URLKeywords.GetValue(),
                    MetaDescription: MetaDescription.GetValue()
                },
                success: function (data) {
                    $("#product-page-details-container").html(data);
                    SuccessFade($("#product-page-details-save"));
                },
                error: function (e, s, a) {
                    $("#product-page-details-container").html(e.responseText);
                    FailureFade($("#product-page-details-save"));
                },
                timeout: 20000
            });
        }
    }

    function SaveProductPageText() {

        var ffo = null;
        var flo = null;
        var fls = null;
        var flf = null;
        var fso = null;

        if (typeof FurnitureFabricOptions == "object") {
            ffo = FurnitureFabricOptions.GetValue();
            flo = FurnitureLeatherOptions.GetValue();
            fls = FurnitureLegStyles.GetValue();
            flf = FurnitureLegFinishes.GetValue();
            fso = FurnitureStitchingOptions.GetValue();
        }

        $.ajax({
            url: '@Url.Action("SaveProductPageText", "ProductPages")',
            type: 'POST',
            traditional: true,
            data: {
                ProductPageID: Number($("#selected-product-page-id").val()),
                Name: Name.GetValue(),
                Heading: ProductPageHeading.GetValue(),
                SubHeading: ProductPageSubHeading.GetValue(),
                Description: ProductPageHtmlEditor.GetValue(),
                FurnitureFabricOptions: ffo,
                FurnitureLeatherOptions: flo,
                FurnitureLegStyles: fls,
                FurnitureLegFinishes: flf,
                FurnitureStitchingOptions: fso,
                VideoURL: typeof ProductPageVideoURL === 'object' ? ProductPageVideoURL.GetValue() : null
            },
            success: function (data) {
                if ($("#text-and-cutout-image-container").length > 0) {
                    $("#text-and-cutout-image-container").html(data);
                    window.setTimeout(function () { SuccessFade($("#product-page-text-save")); }, 1000);
                }
                else {
                    $("#slideshow-and-html-editor-container").html(data);
                    SuccessFade($("#product-page-text-save"));
                }
            },
            error: function (e, s, a) {
                if ($("#text-and-cutout-image-container").length > 0) {
                    $("#text-and-cutout-image-container").html(e.responseText);
                    FailureFade($("#product-page-text-save"));
                }
                else {
                    $("#slideshow-and-html-editor-container").html(e.responseText);
                    FailureFade($("#product-page-text-save"));
                }
            },
            timeout: 20000
        });
    }


    function ExpandLHS() {
        $('#product-select-header-inner').slideDown('fast');
        $('#product-page-info-inner').slideDown('fast');
        $('#product-page-details-inner').slideDown('fast');
        $('#product-page-text-slideshow-inner').slideDown('fast');
        $('#primary-products').slideDown('fast');
        if ($('#slideshow-list').length > 0)
            $('#slideshow-list').slideDown('fast');
        if ($('#product-page-cutout-inner').length > 0)
            $('#product-page-cutout-inner').slideDown('fast');
        if ($('#secondary-products').length > 0)
            $('#secondary-products').slideDown('fast');
        $('#related-products').slideDown('fast');
        $('#country-restriction-section').slideDown('fast');
    }

    function CollapseLHS() {
        $('#product-select-header-inner').slideUp('fast');
        $('#product-page-info-inner').slideUp('fast');
        $('#product-page-details-inner').slideUp('fast');
        $('#product-page-text-slideshow-inner').slideUp('fast');
        if ($('#slideshow-list').length > 0)
            $('#slideshow-list').slideUp('fast');
        $('#primary-products').slideUp('fast');
        if ($('#product-page-cutout-inner').length > 0)
            $('#product-page-cutout-inner').slideUp('fast');
        if ($('#secondary-products').length > 0)
            $('#secondary-products').slideUp('fast');
        $('#related-products').slideUp('fast');
        $('#country-restriction-section').slideUp('fast');
    }

</script>

<div id="product-page-info-container">
    @Html.Partial("ProductPageInfoPartial", Model)
</div>

<div id="product-page-details-container">
    @Html.Partial("ProductPageDetailsPartial", Model)
</div>

@if (Model.TemplateID != 4)
{
    <div id="slideshow-and-html-editor-container">
        @Html.Partial("ProductPageSlideshowPartial", Model)
    </div>
}
else
{
    <div id="slideshow-images-container">
        @Html.Partial("ProductPageFurnitureSlideshowImagesPartial", Model.Images.Where(p => p.TemplateImageID == 2).ToList())
    </div>   
    
    <div id="text-and-cutout-image-container" class="content-panel-container">
        @Html.Partial("ProductPageFurnitureCutOutImagePartial", Model)
    </div>
}

<div id="primary-products-container">
    @Html.Partial("ProductPagePrimaryProductsPartial", Model.PrimaryProducts)
</div>

@if (Model.TemplateID != 4)
{
    <div id="secondary-products-container">
        @Html.Partial("ProductPageSecondaryProductsPartial", Model.SecondaryProducts)
    </div>
}

<div id="related-product-pages-container">
    @Html.Partial("ProductPageRelatedProductPagesPartial", Model.RelatedProductPages)
</div>

<div id="country-restriction-container">
    @Html.Partial("ProductPageCountryRestrictionPartial", Model.CountryRestrictions)
</div>

@Html.HiddenFor(m => Model.ProductPageID)
@Html.HiddenFor(m => Model.TemplateID)

<div id="expand-all-button" style="float: left;" class="expando-all-button" onclick="ExpandLHS();">
    <fieldset>
        <legend id="expand-label">
            Expand All
        </legend>
    </fieldset>
</div>

<div id="collapse-all-button" style="float: right;" class="expando-all-button" onclick="CollapseLHS();">
    <fieldset>
        <legend id="collapse-label">
            Collapse All
        </legend>
    </fieldset>
</div>