    function CopyPodToSlideshow() {
        $.confirm(function () { ConfirmedCopyPodToSlideshow(); }, function () { })
    }

    function ConfirmedCopyPodToSlideshow() {
        LoadingPanel.Show();
        $.ajax({
            url: '@Url.Action("CopyImages", "ProductPages")',
            type: 'POST',
            traditional: true,
            data: {
                ProductPageID: $("#selected-product-page-id").val(),
                Direction: "PodSlideshow"
            },
            success: function (data) {
                LoadingPanel.Hide();
                $("#product-page-slideshow-container").html(data);
            },
            error: function (e, s, a) {
                LoadingPanel.Hide();
                $.showError(e, s, a);
            },
            timeout: 20000
        });
    }

    function CopySlideshowToPod() {
