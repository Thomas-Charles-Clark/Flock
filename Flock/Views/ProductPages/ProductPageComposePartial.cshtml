    function InitRelatedProductPagesDragDrop() {
        $("#related-products").sortable({
            placeholder: 'related-product-placeholder',
            helper: 'clone',
            connectWith: '.productpage',
            beforeStop: function (event, ui) {
                var productpageid = ui.item.data("product-page-id");
                if (productpageid == $("#selected-product-page-id").val()) {
                    $(ui.helper).remove();
                    $(ui.item).remove();
                    window.cancelRelatedDrop = true;
                }
            },
            receive: function (event, ui) {
                if (window.cancelRelatedDrop) {
                    window.cancelRelatedDrop = false;
                    $(ui.sortable).sortable("cancel");
                }
            },
            update: function (ev, ui) {
                window.RelatedProductPages = new Array();
                $("#related-product-page-placeholder").remove();
                $("#related-products").sortable("refresh");
                $("#related-products").children("div").each(function (index) {
                    window.RelatedProductPages.push({ ID: $(this).data("product-page-id"), SortOrder: index });
                });
                UpdateRelatedProductPages();
            }
        });

        $(".productpage").draggable({
            helper: 'clone',
            start: function (e, ui) {
                $(ui.helper).css("z-index", "300000");
            },
            connectToSortable: "#related-products"
        });
    }

    function UpdateRelatedProductPages() {
        $.ajax({
            url: '@Url.Action("UpdateRelatedProductPages", "ProductPages")',
            type: 'POST',
            traditional: true,
            data: { BaseProductPageID: Number($("#selected-product-page-id").val()), ProductPages: JSON.stringify(window.RelatedProductPages) },
            success: function (data) {
                $("#related-product-pages-container").html(data);
            },
            error: function (e, s, a) {
                alert(e.responseText);
            },
            timeout: 20000
        });
    }

    function RemoveRelatedProductPage(ProductPageID) {
        $.ajax({
            url: '@Url.Action("RemoveRelatedProductPage", "ProductPages")',
            type: 'POST',
            traditional: true,
            data: { BaseProductPageID: Number($("#selected-product-page-id").val()), ProductPageID: ProductPageID },
            success: function (data) {
                $("#related-products").find("[data-product-page-id='" + ProductPageID + "']").remove();

                window.RelatedProductPages = new Array();
                $("#related-products").children("div").each(function (index) {
                    window.RelatedProductPages.push({ ID: $(this).data("product-page-id"), SortOrder: index });
                });

                UpdateRelatedProductPages();
            },
            error: function (e, v, a) { alert(e.responseText); },
            timeout: 20000
        });
    }

    function htmlEncode(value) {
        return String(value)
                .replace(/&/g, '&amp;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
    }

    function htmlDecode(value) {
        return String(value)
            .replace(/&quot;/g, '"')
            .replace(/&#39;/g, "'")
            .replace(/&lt;/g, '<')
            .replace(/&gt;/g, '>')
            .replace(/&amp;/g, '&');
    }

