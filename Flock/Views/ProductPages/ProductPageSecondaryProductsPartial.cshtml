@model List<Flock.Models.vwProductPage_SecondaryProduct>
<div class="content-panel-container">
    <fieldset>
        <legend style="color: black; border-bottom-color: #929292;" onclick="$('#secondary-products').slideToggle('fast')">
            Secondary Product(s) (click to expand / contract)
            <img id="secondary-products-page-busy" class="busy" src="/Images/SystemIcons/busy-icon.gif" alt="busy icon" title="Working..."/>
        </legend>
        <div id="secondary-products" style="background-color: white; padding: 1em;">
            <table id="secondary-products-table">
                <thead>
                    <tr>
                                                @*
                                <th style="width: 53px;"/>
                                <th style="width: 290px;">
                                <th style="width: 187px">
                                <th style="width: 139px">
                                <th style="width: 130px">
                                <th style="width: 82px">
                                <th style="width: 45px">
                        *@
                        <th style="width: 53px;"></th>
                        <th style="width: 290px;">
                            Order Form Group
                        </th>
                        <th style="width: 187px;">
                            Order Form Name
                        </th>
                        <th style="width: 139px;">
                            Product Code
                        </th>
                        <th style="width: 130px;">
                            Stock Status
                        </th>
                        <th style="width: 82px;">
                            Enabled
                        </th>
                        <th style="width: 42px;">

                        </th>
                    </tr>
                </thead>
                <tbody id="secondary-product-sortable">
                    @if (Model.Count == 0)
                    {
                        <tr id="secondary-products-placeholder">
                        <td style="width: 28px;"></td>
                        <td colspan="7">
                            <div style="padding: 1em; padding-left: 0px; font-size: 1.4em; background-color: white;">
                                No Secondary Products have been set.
                            </div>
                        </td>
                    </tr>
                    }
                    else
                    {
                        foreach (Flock.Models.vwProductPage_SecondaryProduct i in Model)
                        {
                            <tr data-product-id="@i.ProductID">
                                @if (i.ImageID != null)
                                {
                                    <td>
                                        <div data-product-page-id="@i.ProductPageID" class="related-collection-sortable" onmouseover="$(this).find('.image-remove-icon').stop().animate({opacity: 0.8}, 300)" onmouseout="$(this).find('.image-remove-icon').stop().animate({opacity: 0.0}, 300)">
                                            <img style="height: 64px; width: 64px;" src="https://flock.designersguild.com/imagelibrary/90/@(i.ImageID).jpeg" alt="@(i.Name)" title="Product ID: @(i.ProductID) - @(i.Name)" />
                                            <img src="~/Images/SystemIcons/remove-icon.png" class="image-remove-icon" onclick="RemoveSecondaryProductFromProductPage(@(i.ProductPageID))"/>
                                        </div>
                                    </td>
                                }
                                else
                                {
                                    <td>
                                        <div data-collection-id="@i.ProductPageID" class="related-collection-sortable" onmouseover="$(this).find('.image-remove-icon').stop().animate({opacity: 0.8}, 300)" onmouseout="$(this).find('.image-remove-icon').stop().animate({opacity: 0.0}, 300)">
                                            <img style="height: 64px; width: 64px;" src="/Images/Admin/image-not-set.png" alt="@(i.Name)" title="Product ID: @(i.ProductID) - @(i.Name)" />
                                            <img src="~/Images/SystemIcons/remove-icon.png" class="image-remove-icon" onclick="RemoveSecondaryProductPageFromProductPage(@(i.ProductPageID))"/>
                                        </div>
                                    </td>
                                }
                                <td>
                                    @if (i.OrderFormGroup == "" || i.OrderFormGroup == null)
                                    {
                                        i.OrderFormGroup = "Not Set";
                                    }
                                    @Html.Action("SecondaryOrderFormGroupDropDownPartial", "ProductPages", new { ProductID = i.ProductID, ProductPageID = i.ProductPageID, SelectedOrderFormGroupID = i.OrderFormGroupID })
                                </td>
                                <td>
                                    @i.OrderFormName
                                </td>
                                <td>
                                    @i.Code
                                </td>
                                <td>
                                    @i.StockStatus
                                </td>
                                <td>
                                    @if (i.Enabled)
                                    {
                                        <span style="color: green">@i.Enabled.ToString()</span>
                                    }
                                    else
                                    {
                                        <span style="color: red">@i.Enabled.ToString()</span>
                                    }
                                </td>
                                <td>
                                    <img src="~/Images/SystemIcons/remove-icon.png" class="product-remove-icon" title="Remove Product" alt="" onclick="RemoveSecondaryProduct(@i.ProductID)"/>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <script type="text/javascript">
                if (typeof (InitSecondaryProductDragDrop) == 'function')
                    InitSecondaryProductDragDrop();
            </script>
        </div>
    </fieldset>
</div>