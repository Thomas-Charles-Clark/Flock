@{
    ViewBag.Title = "Product Page Colours";
    Layout = "~/Views/Admin/_Layout.cshtml";
}
@section styles {
    <style type="text/css">
        #container {
            width: auto;
            max-width: 1180px;
        }
    </style>
}

<script type="text/javascript">
    function refresh() {
        $.ajax({
            url: '/productpages/loadProductPagesOfColour',
            type: 'POST',
            data: {
                colourId: ColourFilter.GetValue()
            },
            success: function (data) {
                console.log(data);
            },
            error: function (xhr, e, s) {
                $.showError(xhr, e, s);
            }
        });
    }
</script>

<h4 class="page-heading">Product Page Primary Colour</h4>

@Html.Action("ColourGridViewPartial")
