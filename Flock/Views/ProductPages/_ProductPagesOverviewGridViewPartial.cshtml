            //            edtSettings.Properties.TextField = "Name";
            //            edtSettings.Properties.ValueField = "TemplateID";
            //            edtSettings.Properties.ValueType = typeof(byte);
            //            edtSettings.ShowModelErrors = true;
            //        }
            //    )
            //    .BindList(UoW.GetRepository<Flock.Models.Template>().GetAll().Where(p => p.TemplateTypeID == 1).ToList())
            //    .Bind(DataBinder.Eval(c.DataItem, "TemplateID"))
            //    .Render();
            //});

            column.SetDataItemTemplateContent(c =>
            {
                int TemplateID = 0;
                string Template = "<i>Unknown</i>";

                if (DataBinder.Eval(c.DataItem, "TemplateID") != DBNull.Value && DataBinder.Eval(c.DataItem, "TemplateID") != null)
                {
                    TemplateID = Convert.ToByte(DataBinder.Eval(c.DataItem, "TemplateID"));
                    Template = UoW.GetRepository<Flock.Models.Template>().GetAll().Where(p => p.TemplateID == TemplateID).Select(p => p.Name).Single();
                }

                ViewContext.Writer.Write("<span style='color: black'>" + Template + "</span>");
            });
        });

        settings.Columns.Add(column =>
        {
            column.Name = "BrandID";
            column.FieldName = "BrandID";
            column.Caption = "Brand";
            column.Width = 120;
            column.Settings.HeaderFilterMode = HeaderFilterMode.List;
            column.Settings.AllowHeaderFilter = DefaultBoolean.True;
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
            column.SetDataItemTemplateContent(c =>
