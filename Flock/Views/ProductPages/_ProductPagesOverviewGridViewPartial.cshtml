        settings.Columns.Add(column =>
        {
            column.Name = "OnDate";
            column.FieldName = "OnDate";
            column.Caption = "On Date";
            column.ColumnType = MVCxGridViewColumnType.DateEdit;
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.Width = 90;
        });

        settings.Columns.Add(column =>
        {
            column.Name = "OffDate";
            column.FieldName = "OffDate";
            column.Caption = "Off Date";
            column.ColumnType = MVCxGridViewColumnType.DateEdit;
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.Width = 90;
        });

        MVCxGridViewColumn WebStatusColumn = new MVCxGridViewColumn();
        WebStatusColumn.Name = "StatusID";
        WebStatusColumn.FieldName = "StatusID";
        WebStatusColumn.Caption = "Web Status";
        WebStatusColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        WebStatusColumn.Settings.AllowHeaderFilter = DefaultBoolean.True;
        WebStatusColumn.EditFormSettings.Visible = DefaultBoolean.False;
        //WebStatusColumn.HeaderStyle.Wrap = DefaultBoolean.True;
        //WebStatusColumn.Width = 50;
        WebStatusColumn.SetDataItemTemplateContent(c =>
        {
            var i = Convert.ToByte(DataBinder.Eval(c.DataItem, "StatusID"));
            string colour = "black";
            string statusText = "unknown";
            statusText = UoW.GetRepository<Flock.Models.Status>().GetAll().Where(p => p.StatusID == i).Select(p => p.Name).Single();
            switch (i)
            {
                case 0:
                    colour = "green";
                    break;
                case 1:
                    colour = "orange";
                    break;
                case 2:
                    colour = "orange";
                    break;
                case 3:
                    colour = "green";
                    break;
                case 4:
                    colour = "red";
                    break;
                default: break;
            }
            string res = "<span style='color: " + colour + " '>"+statusText + "</span>";
            ViewContext.Writer.Write(res);
        });
        settings.Columns.Add(WebStatusColumn);

        settings.Columns.Add(column => {
            column.Name = "New";
            column.FieldName = "New";
            column.Caption = "New";
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.False;
            column.Settings.AllowHeaderFilter = DefaultBoolean.True;
            column.EditFormSettings.Visible = DefaultBoolean.False;
        });

        settings.Columns.Add(column => {
            column.Name = "TradeSwitch";
            column.FieldName = "TradeSwitch";
            column.Caption = "Audience";
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.False;
            column.Settings.AllowHeaderFilter = DefaultBoolean.True;
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.SetDataItemTemplateContent(c =>
            {
                bool? ts = DataBinder.Eval(c.DataItem, "TradeSwitch") == null ? (bool?)null : Convert.ToBoolean(DataBinder.Eval(c.DataItem, "TradeSwitch"));

                switch (ts)
                {
                    case null:
                        ViewContext.Writer.Write("Both");
                        break;
                    case false:
                        ViewContext.Writer.Write("Retail Only");
                        break;
                    case true:
                        ViewContext.Writer.Write("Trade Only");
                        break;
                }
            });
        });

    settings.Columns.Add(column => {
        column.Name = "Countries";
        column.FieldName = "Countries";
        column.Caption = "Country Restrictions";
        column.Settings.AllowAutoFilter = DefaultBoolean.False;
        column.UnboundType = DevExpress.Data.UnboundColumnType.String;
        column.SetDataItemTemplateContent(c => {
            var countries = UoW.GetRepository<ProductPage_Country>().GetAll().Where(p => p.ProductPageID == Convert.ToInt32(c.KeyValue)).Select(p => p.Country).OrderByDescending(p => p.CountryID).ToList();

            foreach (var country in countries)
            {
                ViewContext.Writer.Write("<img src='/images/icons/countryflags/22px/" + country.CountryID + ".png' title='" + country.Name + "' style='float: left; width: 16px; margin-right: 4px;' />");
            }
        });
    });

    settings.Columns.Add(column =>
    {
        column.UnboundType = DevExpress.Data.UnboundColumnType.Object;
        column.Name = "Compose";
        column.Caption = "";
        column.Width = 126;
        column.Settings.AllowAutoFilter = DefaultBoolean.False;
        column.Settings.AllowHeaderFilter = DefaultBoolean.False;
        column.EditFormSettings.Visible = DefaultBoolean.False;
        column.SetDataItemTemplateContent(c => {
            ViewContext.Writer.Write("<a class='productpage-compose' title='Compose' href='" + Url.Action("compose", "productpages", new { id = DataBinder.Eval(c.DataItem, "ProductPageID") }) + "'></a>");
            ViewContext.Writer.Write("<a class='attribute-compose' title='Attributes' href='" + Url.Action("attributes", "productpages", new { id = DataBinder.Eval(c.DataItem, "ProductPageID") }) + "'></a>");
            ViewContext.Writer.Write("<a class='productpage-translate' title='Translate' href='" + Url.Action("productpage", "translations", new { id = DataBinder.Eval(c.DataItem, "ProductPageID") }) + "'></a>");
        });
    });

    settings.HeaderFilterFillItems = (sender, e) =>
    {
        MVCxGridView gridView = (MVCxGridView)sender;
        switch (e.Column.Name)
        {
            case "New":
                e.Values.Clear();
                e.AddValue("Yes", "True");
                e.AddValue("No", "False");
                e.AddShowAll();
                break;
            case "ImagePreview":
                e.Values.Clear();
                e.Values.Add(FilterValue.CreateShowNonBlanksValue(ImageColumn, "Has Image"));
                e.Values.Add(FilterValue.CreateShowBlanksValue(ImageColumn, "Doesn't have Image"));
                e.AddShowAll();
                break;
            case "LaunchID":
                e.Values.Clear();
                foreach (var pt in UoW.GetRepository<Flock.Models.Launch>().GetAll().OrderByDescending(p => p.LaunchDate))
                {
                    e.AddValue(pt.Name, pt.LaunchID.ToString());
                }
                e.AddShowAll();
                break;
            case "StatusID":
                e.Values.Clear();
                e.AddValue("On", "0");
                e.AddValue("Pending Off (On)", "1");
                e.AddValue("Pending On (Off)", "2");
                e.AddValue("Pre-Launch", "3");
                e.AddValue("Off","4");
                e.AddShowAll();
                break;

            case "TemplateID":
                e.Values.Clear();
                foreach (var pt in UoW.GetRepository<Flock.Models.Template>().GetAll().OrderBy(p => p.Name))
                {
                    e.AddValue(pt.Name, pt.TemplateID.ToString());
                }
                e.AddShowAll();
                break;
            case "ProductTypeID":
                e.Values.Clear();
                foreach (var pt in UoW.GetRepository<Flock.Models.ProductType>().GetAll().OrderBy(p => p.Name))
                {
                    e.AddValue(pt.Name, pt.ProductTypeID.ToString());
                }
                e.AddShowAll();
                break;

            case "TradeSwitch":
                e.Values.Clear();
                e.AddValue("Retail Only", "False");
                e.AddValue("Trade Only", "True");
                e.AddShowAll();
                break;

            case "BrandID":
                e.Values.Clear();
                foreach (var pt in UoW.GetRepository<Flock.Models.Brand>().GetAll().OrderBy(p => p.Name))
                {
                    e.AddValue(pt.Name, pt.BrandID.ToString());
                }
                e.AddShowAll();
                break;

            default: break;
        }
    };
    });

    if (ViewData["EditError"] != null)
    {
        grid.SetEditErrorText((string)ViewData["EditError"]);
    }
}
@grid.Bind(Model).GetHtml()

@*.BindToLINQ("", "", (s, e) => {
        var UoW = new UnitOfWork<FlockDataContext>();
