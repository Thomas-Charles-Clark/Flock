            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
            column.ColumnType = MVCxGridViewColumnType.ComboBox;
            var cbProperties = column.PropertiesEdit as ComboBoxProperties;
            cbProperties.DataSource = UoW.GetRepository<Flock.Models.Template>().GetAll().Where(p => p.TemplateTypeID == 1).ToList();
            cbProperties.ValueField = "TemplateID";
            cbProperties.TextField = "Name";
            cbProperties.ValueType = typeof(byte);

            //column.SetEditItemTemplateContent(c =>
            //{
            //    Html.DevExpress().ComboBox(
            //        edtSettings =>
            //        {
            //            edtSettings.Name = "TemplateID";
