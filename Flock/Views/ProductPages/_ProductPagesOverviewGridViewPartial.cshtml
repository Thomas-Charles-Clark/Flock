        ImageColumn.Name = "ImagePreview";
        ImageColumn.Caption = "Image";
        ImageColumn.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Center;
        ImageColumn.EditFormSettings.Visible = DefaultBoolean.False;
        ImageColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        ImageColumn.Settings.AllowHeaderFilter = DefaultBoolean.True;
        ImageColumn.Settings.HeaderFilterMode = HeaderFilterMode.List;
        ImageColumn.Width = System.Web.UI.WebControls.Unit.Pixel(62);
        ImageColumn.SetDataItemTemplateContent(c =>
        {
            if (DataBinder.Eval(c.DataItem, "ImageID") != null)
                ViewContext.Writer.Write("<img src='https://flock.designersguild.com/imagelibrary/156/" + DataBinder.Eval(c.DataItem, "ImageID") + ".jpeg' style='width: 50px; height: auto;' />");
            else
                ViewContext.Writer.Write("<img src='/Images/admin/image-not-set.png' style='width: 50px; height: auto' />");
        });
        settings.Columns.Add(ImageColumn);


        settings.Columns.Add(column =>
        {
            column.Name = "Name";
            column.FieldName = "Name";
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
