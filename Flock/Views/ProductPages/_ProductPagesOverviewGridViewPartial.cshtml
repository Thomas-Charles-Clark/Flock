        settings.SettingsEditing.DeleteRowRouteValues = new { Controller = "ProductPages", Action = "ProductPagesOverviewGridViewPartialDelete" };
        settings.CustomActionRouteValues = new { Controller = "ProductPages", Action = "ProductPagesOverviewGridViewPartialCustomCommand" };

        settings.ClientSideEvents.BeginCallback = @"function(s, e) { 
            e.customArgs['CollectionID'] = ProductPagesOverviewCollectionListBox.GetValue();
            e.customArgs['CountryIDs'] = ProductPagesOverviewCountryListBox.GetSelectedValues() == null ? null : ProductPagesOverviewCountryListBox.GetSelectedValues().toString(); 
        }";

        settings.ClientSideEvents.CallbackError = @"function(s, e) {
            alert(e.message);
            e.handled = true;
            s.Refresh();
        }";
        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
        settings.CommandColumn.Visible = true;
        settings.CommandColumn.VisibleIndex = 100;
        settings.CommandColumn.ShowDeleteButton = false;
        settings.CommandColumn.ShowSelectCheckbox = true;
        settings.Settings.ShowFilterRow = true;
        settings.CommandColumn.SetHeaderTemplateContent(c =>
        {
            Html.DevExpress().CheckBox(settingsCheckBox =>
            {
                settingsCheckBox.Name = "cbSelectAll";
                settingsCheckBox.Properties.ClientSideEvents.CheckedChanged = string.Format("function(s, e) {{ if(s.GetChecked()) {0}.SelectAllRowsOnPage(s.GetChecked()); else {0}.UnselectAllRowsOnPage(s.GetChecked()); }}", settings.Name);
                settingsCheckBox.Checked = c.Grid.VisibleRowCount == c.Grid.Selection.Count;
            }).Render();
        });
        settings.SettingsBehavior.ConfirmDelete = true;
        settings.CommandColumn.ShowSelectCheckbox = true;
        settings.SettingsEditing.Mode = GridViewEditingMode.EditFormAndDisplayRow;
        settings.SettingsPager.PageSizeItemSettings.Visible = true;
        settings.SettingsPager.PageSizeItemSettings.Position = PagerPageSizePosition.Right;
        settings.SettingsPager.PageSizeItemSettings.ShowAllItem = false;

        settings.SettingsEditing.ShowModelErrorsForEditors = true;

        settings.CommandColumn.SetHeaderTemplateContent(c =>
        {
            Html.DevExpress().CheckBox(settingsCheckBox =>
            {
                settingsCheckBox.Name = "cbSelectAll";
                settingsCheckBox.Properties.ClientSideEvents.CheckedChanged = string.Format("function(s, e) {{ if(s.GetChecked()) {0}.SelectAllRowsOnPage(s.GetChecked()); else {0}.UnselectAllRowsOnPage(s.GetChecked()); }}", settings.Name);
                settingsCheckBox.Checked = c.Grid.VisibleRowCount == c.Grid.Selection.Count;
            }).Render();
        });

        settings.KeyFieldName = "ProductPageID";

        settings.Columns.Add(column =>
        {
            column.Name = "ProductPageID";
            column.FieldName = "ProductPageID";
