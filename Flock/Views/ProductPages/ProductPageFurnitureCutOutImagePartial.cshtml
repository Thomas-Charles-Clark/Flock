@model Flock.ViewModels.ProductPageComposeViewModel
    <fieldset>
        <legend style="color: black; border-bottom-color: #929292;" onclick="$('#product-page-cutout-inner').slideToggle('fast')">
            Product Page Text & Cut-Out Image (click to expand / contract)
            <img id="product-cutout-busy" class="busy" src="/Images/SystemIcons/busy-icon.gif" alt="busy icon" title="Working..." />
        </legend>
        <div id="product-page-cutout-inner" style="background-color: white; padding: 1em; position: relative;">
            <div style="clear: both;"></div>
            <div style="width: 55%; float: right; margin-bottom: 32px;">
                <label style="font-size: 11px;" for="furniture-page-cutout-image-target">Cut-Out Image (Landscape - Feature only)</label>
                <div id="furniture-page-cutout-image-target" data-product-page-id="@(Model.ProductPageID)">
                    @Html.Partial("FurnitureCutOutImagePartial", Model.Images.Where(p => p.TemplateImageID == 3).ToList())
                </div>

