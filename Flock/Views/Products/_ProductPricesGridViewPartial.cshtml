@grid.BindToLINQ(string.Empty, string.Empty, (s, e) =>
{
    var dataContext = new Flock.DAL.UnitOfWork<Flock.Models.FlockDataContext>();
    var source = dataContext.GetRepository<Flock.Models.vwProductPrice>().GetAll();

    if (Model.PriceListID != null)
    {
        source = source.Where(p => p.PriceListID == Model.PriceListID);
    }
    else
    {
        source = source.Where(p => p.PriceListID == 1);
    }
    
    var x = new List<int>(); // Collection linker
    var y = new List<int>();
    
    if (Model.CollectionIDs != null)
    {
        foreach (short c in Model.CollectionIDs)
        {
