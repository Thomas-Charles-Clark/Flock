@{
    var dataContext = new Flock.DAL.UnitOfWork<Flock.Models.FlockDataContext>();
    var grid = Html.DevExpress().GridView(settings =>
    {
        settings.Name = "ProductStockGridView";
        settings.CallbackRouteValues = new { Controller = "Products", Action = "ProductStockGridViewPartial" };

        settings.SettingsEditing.AddNewRowRouteValues = new { };//Controller = "Products", Action = "ProductStockGridViewPartialAddNew" };
        settings.SettingsEditing.UpdateRowRouteValues = new { };//Controller = "Products", Action = "ProductStockGridViewPartialUpdate" };
        settings.SettingsEditing.DeleteRowRouteValues = new { };//Controller = "Products", Action = "ProductStockGridViewPartialDelete" };
        settings.SettingsEditing.Mode = GridViewEditingMode.EditFormAndDisplayRow;
        settings.SettingsBehavior.ConfirmDelete = true;

        settings.CustomActionRouteValues = new { Controller = "Products", Action = "ProductStockGridViewCustomCommand" };

        settings.CommandColumn.Visible = true;
        settings.CommandColumn.ShowClearFilterButton = true;
        settings.CommandColumn.ShowSelectCheckbox = true;
        settings.CommandColumn.SetHeaderTemplateContent(c =>
        {
            Html.DevExpress().CheckBox(settingsCheckBox =>
            {
                settingsCheckBox.Name = "cbSelectAll";
                settingsCheckBox.Properties.ClientSideEvents.CheckedChanged = string.Format("function(s, e) {{ if(s.GetChecked()) {0}.SelectAllRowsOnPage(s.GetChecked()); else {0}.UnselectAllRowsOnPage(s.GetChecked()); }}", settings.Name);
                settingsCheckBox.Checked = c.Grid.VisibleRowCount == c.Grid.Selection.Count;
            }).Render();
        });

        settings.KeyFieldName = "ProductID";

        settings.SettingsPager.Visible = true;
        settings.SettingsPager.PageSize = 20;
        settings.SettingsPager.PageSizeItemSettings.Visible = true;

        settings.Settings.ShowGroupPanel = true;
        settings.Settings.ShowFilterRow = true;
        settings.Settings.ShowFilterRowMenu = true;

        settings.SettingsBehavior.AllowSelectByRowClick = false;
        settings.SettingsBehavior.AllowSelectSingleRowOnly = false;

        settings.SettingsDetail.ShowDetailButtons = true;

        settings.Settings.ShowHeaderFilterButton = true;

        settings.SettingsDetail.AllowOnlyOneMasterRowExpanded = false;
        settings.SettingsDetail.ShowDetailRow = true;

        settings.SetDetailRowTemplateContent(c =>
        {
            ViewContext.Writer.Write(Html.Action("ProductStockGridDetailPartial", "Products", new { ProductID = c.KeyValue }));
        });

        settings.Columns.Add("ProductID").Settings.AllowHeaderFilter = DefaultBoolean.False;

        settings.Columns.Add(column => {
            column.FieldName = "ProductPageID";
            column.Name = "ProductPageID";
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;

            column.SetDataItemTemplateContent(c => {
                if(DataBinder.Eval(c.DataItem, "ProductPageID") != null)
                    ViewContext.Writer.Write("<a href='/admin/productpages/compose/" + DataBinder.Eval(c.DataItem, "ProductPageID").ToString() +
                        "' target='_blank'>"+DataBinder.Eval(c.DataItem, "ProductPageID").ToString()+"</a>");
            });
        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "Enabled";
            column.Name = "Enabled";
            column.Caption = "Enabled";
            column.Settings.HeaderFilterMode = HeaderFilterMode.CheckedList;
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.SetDataItemTemplateContent(c =>
            {
                bool? enabledState = (bool?)DataBinder.Eval(c.DataItem, "Enabled");
                if (enabledState != null)
                {
                    if (enabledState == true)
                        ViewContext.Writer.Write("<span style='color: green'>" + DataBinder.Eval(c.DataItem, "Enabled") + "</span>");
                    else
                        ViewContext.Writer.Write("<span style='color: red'>" + DataBinder.Eval(c.DataItem, "Enabled") + "</span>");
                }
                else
                {
                    ViewContext.Writer.Write("<span style='color: goldenrod'>NULL STATUS</span>");
                }
            });
        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "Status";
            column.Name = "Status";
            column.Caption = "Status";
            column.Settings.HeaderFilterMode = HeaderFilterMode.CheckedList;
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.SetDataItemTemplateContent(c =>
            {
                char enabledState = '?';
                if (DataBinder.Eval(c.DataItem, "Status") != DBNull.Value && DataBinder.Eval(c.DataItem, "Status") != null)
                    enabledState = (char)DataBinder.Eval(c.DataItem, "Status");
                switch (enabledState)
                {
                    case 'C':
                        ViewContext.Writer.Write("<span style='color: green'>" + enabledState + "</span>");
                        break;
                    case 'D':
                        ViewContext.Writer.Write("<span style='color: red'>" + enabledState + "</span>");
                        break;
                    case 'L':
                        ViewContext.Writer.Write("<span style='color: orange'>" + enabledState + "</span>");
                        break;
                    case 'Y':
                        ViewContext.Writer.Write("<span style='color: orange'>" + enabledState + "</span>");
                        break;
                    default:
                        ViewContext.Writer.Write("<span style='color: black'>" + enabledState + "</span>");
                        break;
                }
            });
        });

        MVCxGridViewColumn WebStatusColumn = new MVCxGridViewColumn();
        WebStatusColumn.Name = "StatusID";
        WebStatusColumn.FieldName = "StatusID";
        WebStatusColumn.Caption = "Web Status";
        WebStatusColumn.UnboundType = DevExpress.Data.UnboundColumnType.String;
        WebStatusColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        WebStatusColumn.Settings.AllowHeaderFilter = DefaultBoolean.True;
        WebStatusColumn.SetDataItemTemplateContent(c =>
        {
            string colour = "black";
            string statusText = "unknown";
            var i = Convert.ToByte(DataBinder.Eval(c.DataItem, "StatusID"));
            statusText = dataContext.GetRepository<Flock.Models.Status>().GetAll().Where(p => p.StatusID == i).Select(p => p.Name).Single();
            switch (i)
            {
                case 0:
                    colour = "green";
                    break;
                case 1:
                    colour = "orange";
                    break;
                case 2:
                    colour = "orange";
                    break;
                case 3:
                    colour = "green";
                    break;
                case 4:
                    colour = "red";
                    break;
                default: break;
            }
            string res = "<span style='color: " + colour + " '>" + statusText + "</span>";
            ViewContext.Writer.Write(res);
        });
        settings.Columns.Add(WebStatusColumn);



        settings.Columns.Add(column =>
        {
            column.Name = "ToggleColumn";
            column.FieldName = "ToggleColumn";
            column.FieldName = "Toggle Web Status";
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.HeaderStyle.Wrap = DefaultBoolean.True;
            column.UnboundType = DevExpress.Data.UnboundColumnType.String;
            column.SetDataItemTemplateContent(c =>
            {
                byte webStatus = Convert.ToByte(DataBinder.Eval(c.DataItem, "StatusID"));
                if (DataBinder.Eval(c.DataItem, "ProductPageID") != null)
                {
                    if (webStatus == 4)
                    {
                        ViewContext.Writer.Write("<input type='button' value='Turn On' onclick='ToggleProductPage(" + DataBinder.Eval(c.DataItem, "ProductPageID").ToString() + ", "+c.KeyValue.ToString()+")'/>");
                    }
                    else
                    {
                        ViewContext.Writer.Write("<input type='button' value='Turn Off' onclick='ToggleProductPage(" + DataBinder.Eval(c.DataItem, "ProductPageID").ToString() + ", " + c.KeyValue.ToString() + ")'/>");
                    }
                }
            });
        });

        MVCxGridViewColumn StockStatusColumn = new MVCxGridViewColumn();
        StockStatusColumn.FieldName = "StockStatus";
        StockStatusColumn.Name = "StockStatus";
        StockStatusColumn.Caption = "Stock";
        StockStatusColumn.Settings.HeaderFilterMode = HeaderFilterMode.CheckedList;
        StockStatusColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        StockStatusColumn.SetDataItemTemplateContent(c =>
        {
            int StockStatusID = 0;
            if (DataBinder.Eval(c.DataItem, "StockStatusID") != DBNull.Value && DataBinder.Eval(c.DataItem, "StockStatusID") != null)
                StockStatusID = Convert.ToInt16(DataBinder.Eval(c.DataItem, "StockStatusID"));
            string stockStatus = "";

            if (DataBinder.Eval(c.DataItem, "StockStatus") != DBNull.Value && DataBinder.Eval(c.DataItem, "StockStatus") != null)
                stockStatus = DataBinder.Eval(c.DataItem, "StockStatus").ToString();


            switch (StockStatusID)
            {
                case 1:
                    ViewContext.Writer.Write("<span style='color: green'>" + stockStatus + "</span>");
                    break;
                case 2:
                case 3:
                case 4:
                    ViewContext.Writer.Write("<span style='color: orange'>" + stockStatus + "</span>");
                    break;
                case 5:
                case 6:
                case 7:
                    ViewContext.Writer.Write("<span style='color: red'>" + stockStatus + "</span>");
                    break;

                default:
                    ViewContext.Writer.Write("<span style='color: black'>" + stockStatus + "</span>");
                    break;
            }
        });
        settings.Columns.Add(StockStatusColumn);

        MVCxGridViewColumn ProductTypeColumn = new MVCxGridViewColumn();
        ProductTypeColumn.FieldName = "ProductType";
        ProductTypeColumn.Name = "ProductType";
        ProductTypeColumn.Caption = "Product Type";
        settings.Columns.Add(ProductTypeColumn);
        //ProductTypeColumn
        MVCxGridViewColumn BrandColumn = new MVCxGridViewColumn();
        BrandColumn.FieldName = "Brand";
        BrandColumn.Name = "Brand";
        BrandColumn.Caption = "Brand";
        settings.Columns.Add(BrandColumn);
        MVCxGridViewColumn LaunchColumn = new MVCxGridViewColumn();
        LaunchColumn.FieldName = "LaunchID";
        LaunchColumn.Name = "LaunchID";
        LaunchColumn.Caption = "Launch";
        LaunchColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        LaunchColumn.SetDataItemTemplateContent(c => {
            ViewContext.Writer.Write(DataBinder.Eval(c.DataItem, "Launch") == null ? "" : DataBinder.Eval(c.DataItem, "Launch").ToString());
        });
        settings.Columns.Add(LaunchColumn);
        MVCxGridViewColumn DesignColumn = new MVCxGridViewColumn();
        DesignColumn.FieldName = "Design";
        DesignColumn.Name = "Design";
        DesignColumn.Caption = "Design";
        settings.Columns.Add(DesignColumn);

        settings.Columns.Add("Code").Settings.AllowHeaderFilter = DefaultBoolean.False;

        settings.Columns.Add(column =>
        {
            column.FieldName = "Name";
            column.Name = "Name";
            column.Caption = "Name";
            column.Width = 260;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "FreeStock";
            column.Name = "FreeStock";
            column.Caption = "Free Stock";
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "PODueDate";
            column.Name = "PODueDate";
            column.Caption = "PO Due Date";
            column.PropertiesEdit.DisplayFormatString = "g"; //"dd/MM/yy";
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.ColumnType = MVCxGridViewColumnType.DateEdit;
        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "POFreeStock";
            column.Name = "POFreeStock";
            column.Caption = "PO Free Stock";
            column.Width = System.Web.UI.WebControls.Unit.Pixel(60);
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "ModifiedDT";
            column.Name = "ModifiedDT";
            column.Caption = "Last Updated";
            //column.ColumnType = MVCxGridViewColumnType.DateEdit;
            column.ReadOnly = true;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "SiblingsTotal";
            column.Name = "SiblingsTotal";
            column.Caption = "Siblings Total";
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
        });
        settings.Columns.Add(column =>
        {
            column.FieldName = "SiblingsEnabled";
            column.Name = "SiblingsEnabled";
            column.Caption = "Siblings Enabled";
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
        });
        settings.Columns.Add(column =>
        {
            column.FieldName = "SiblingsDisabled";
            column.Name = "SiblingsDisabled";
            column.Caption = "Siblings Disabled";
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "PriceListRestrictions";
            column.Name = "PriceListRestrictions";
            column.Caption = "Sell To";
            column.UnboundType = DevExpress.Data.UnboundColumnType.Object;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.Width = 160;
            column.SetDataItemTemplateContent(c =>
            {
                var PriceList = dataContext.GetRepository<Flock.Models.Price>().GetAll().Where(p => p.ProductID == (int)DataBinder.Eval(c.DataItem, "ProductID")).OrderBy(p => p.PriceListID).ToList();

                foreach (Flock.Models.Price price in PriceList)
                {
                    var pl = dataContext.GetRepository<Flock.Models.PriceList>().GetAll().Where(p => p.PriceListID == price.PriceListID).Single();

                    ViewContext.Writer.Write("<img src='/images/icons/32/pricelists/" + price.PriceListID.ToString() + ".png' title='" + pl.Name + "' style='float: left; margin-right: 4px; width: 24px;' />");
                }
            });
        });

        settings.ClientSideEvents.DetailRowExpanding = @"function(s, e) {
        }";

        //        settings.HeaderFilterFillItems = (sender, e) =>
        //        {
        //            MVCxGridView gridView = (MVCxGridView)sender;
        //            switch (e.Column.Name)
        //            {
        //                case "StockStatus":
        //                    break;
        //                default:
        //                    break;
        //            }
        //        };
        settings.HeaderFilterFillItems = (sender, e) => {
            MVCxGridView gridView = (MVCxGridView)sender;
            switch (e.Column.Name)
            {
                case "LaunchID":
                    e.Values.Clear();
                    foreach (var pt in dataContext.GetRepository<Flock.Models.Launch>().GetAll().OrderByDescending(p => p.LaunchDate))
                    {
                        e.AddValue(pt.Name, pt.LaunchID.ToString());
                    }
                    e.AddShowAll();
                    break;
                case "StatusID":
                    e.Values.Clear();
                    foreach (var pt in dataContext.GetRepository<Flock.Models.Status>().GetAll().OrderBy(p => p.StatusID).ToList())
                    {
                        e.AddValue(pt.Name, pt.StatusID.ToString());
                    }
                    e.AddShowAll();
                    break;

                default:
                    break;
            }
        };

    });
    if (ViewData["EditError"] != null)
    {
        grid.SetEditErrorText((string)ViewData["EditError"]);
    }
}
@grid.BindToLINQ(string.Empty, string.Empty, (s, e) =>
{
    var source = dataContext.GetRepository<Flock.Models.vwProductStock>().GetAll();

    e.KeyExpression = "ProductID";
    e.QueryableSource = source;
}).GetHtml()