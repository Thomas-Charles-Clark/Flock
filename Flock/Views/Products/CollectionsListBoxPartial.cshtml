@Html.DevExpress().ListBox(
listBoxSettings =>
{
    listBoxSettings.Name = "collectionCheckComboBox";
    listBoxSettings.ControlStyle.Border.BorderWidth = 0;
    listBoxSettings.ControlStyle.BorderBottom.BorderWidth = 1;
    listBoxSettings.ControlStyle.BorderBottom.BorderColor = System.Drawing.Color.FromArgb(0xDCDCDC);
    listBoxSettings.Width = System.Web.UI.WebControls.Unit.Percentage(100);

    string action = ViewContext.Controller.ValueProvider.GetValue("action").AttemptedValue;

    if (action.ToLower() != "productcollection")
    {
        listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.CheckColumn;
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            if($('#ProductOverviewGridContainer').length > 0)
            {
                $.ajax({
                    url: '" + @Url.Action("ProductOverviewGridViewPartial", "Products") + @"',
                    data: { Collections: collectionCheckComboBox.GetSelectedValues().toString(), Colours: coloursCheckComboBox.GetSelectedValues().toString() },
                    success: function(data) { 
                        $('#ProductOverviewGridContainer').html(data) 
                        $('.inlinesparkline').each(function () {
                            $(this).html($(this).data('sparkline'));
                            $(this).sparkline();
                        });
                    },
                    error: function(e, s, a) { alert(e.responseText); }
                 });
            }
            else if ($('#productpricesgridcontainer').length > 0)
            {
                $.ajax({
                    url: '" + @Url.Action("ProductPricesGridViewPartial", "Products") + @"',
                    data: { Collections: collectionCheckComboBox.GetSelectedValues().toString(), Colours: coloursCheckComboBox.GetSelectedValues().toString() },
                    success: function(data) { 
                        $('#productpricesgridcontainer').html(data) 
                    },
                    error: function(e, s, a) { alert(e.responseText); }
                 });
            }
            else if ($('#ProductStockGridContainer').length > 0)
            {
                $.ajax({
                    url: '" + @Url.Action("ProductStockGridViewPartial", "Products") + @"',
                    data: { Collections: collectionCheckComboBox.GetSelectedValues().toString(), Colours: coloursCheckComboBox.GetSelectedValues().toString() },
                    success: function(data) { 
                        $('#ProductStockGridContainer').html(data) 
                    },
                    error: function(e, s, a) { alert(e.responseText); }
                 });
            }
            else if ($('#ProductPricesGridContainer').length > 0)
            {
                $.ajax({
                    url: '" + @Url.Action("ProductPricesGridViewPartial", "Products") + @"',
                    data: { Collections: collectionCheckComboBox.GetSelectedValues().toString(), Colours: coloursCheckComboBox.GetSelectedValues().toString(), ProductPriceListID: priceListsListBox.GetSelectedValues().toString() },
                    success: function(data) { 
                        $('#ProductPricesGridContainer').html(data) 
                    },
                    error: function(e, s, a) { alert(e.responseText); }
                 });
            }
        }";
    }
    else
    {
        listBoxSettings.Properties.SelectionMode = ListEditSelectionMode.Single;
        listBoxSettings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
            CollectionDD.SetText(s.GetSelectedItem().text);
            CollectionDD.HideDropDown();
            $.ajax({
                url: '" + Url.Action("ProductToCollection_CollectionDataViewPartial", "Products") + @"',
                traditional: true,
                data: { collectionID: s.GetSelectedItem().value },
                success: function(data) {
                    $('#collection-container').html(data);
                },
                error: function(e, s, a) {
                    alert(e.responseText);
                }
            });
        }";
    }
    listBoxSettings.Properties.TextField = "Name";
    listBoxSettings.Properties.ValueField = "CollectionID";
    
}
).BindList(Model).GetHtml()