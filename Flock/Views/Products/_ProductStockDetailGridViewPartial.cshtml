@{
    var grid = Html.DevExpress().GridView(settings =>
    {
        settings.Name = "ProductStockDetailGridView" + Guid.NewGuid().ToString("N");
        settings.CallbackRouteValues = new { Controller = "Products", Action = "ProductStockDetailGridViewPartial" };

        settings.ClientSideEvents.Init = @"function(s, e) { 
            if(window.DetailGrids) {
                window.DetailGrids.push(s);
            }
            else {
                window.DetailGrids = new Array();
                window.DetailGrids.push(s);
            }
        }";
        
        settings.SettingsEditing.AddNewRowRouteValues = new { Controller = "Products", Action = "ProductStockDetailGridViewPartialAddNew" };
        settings.SettingsEditing.UpdateRowRouteValues = new { Controller = "Products", Action = "ProductStockDetailGridViewPartialUpdate" };
        settings.SettingsEditing.DeleteRowRouteValues = new { Controller = "Products", Action = "ProductStockDetailGridViewPartialDelete" };
        settings.SettingsEditing.Mode = GridViewEditingMode.EditFormAndDisplayRow;
        settings.SettingsBehavior.ConfirmDelete = true;

        settings.CommandColumn.Visible = true;
        settings.CommandColumn.ShowNewButton = false;
        settings.CommandColumn.ShowDeleteButton = false;
        settings.CommandColumn.ShowEditButton = false;
        settings.SettingsDetail.AllowOnlyOneMasterRowExpanded = true;
        settings.CommandColumn.ShowSelectCheckbox = true;
        settings.CommandColumn.SetHeaderTemplateContent(c =>
        {
            Html.DevExpress().CheckBox(settingsCheckBox =>
            {
                settingsCheckBox.Name = "cbDetailSelectAll" +Guid.NewGuid().ToString("N");
                settingsCheckBox.Properties.ClientSideEvents.CheckedChanged = string.Format("function(s, e) {{ if(s.GetChecked()) {0}.SelectAllRowsOnPage(s.GetChecked()); else {0}.UnselectAllRowsOnPage(s.GetChecked()); }}", settings.Name);
                settingsCheckBox.Checked = false;
            }).Render();
        });
        
        settings.KeyFieldName = "ProductID";
        settings.SettingsPager.Mode = GridViewPagerMode.ShowAllRecords;
        settings.SettingsPager.Visible = false;
        settings.Settings.ShowGroupPanel = false;
        settings.Settings.ShowFilterRow = false;
        settings.SettingsBehavior.AllowSelectByRowClick = false;

        settings.Columns.Add("ProductID");
        settings.Columns.Add(column =>
        {
            column.FieldName = "Status";
            column.Caption = "Status";
            column.Settings.HeaderFilterMode = HeaderFilterMode.CheckedList;
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.SetDataItemTemplateContent(c =>
            {
                char enabledState = (char)DataBinder.Eval(c.DataItem, "Status");
                switch (enabledState)
                {
                    case 'C':
                        ViewContext.Writer.Write("<span style='color: green'>" + enabledState + "</span>");
                        break;
                    case 'D':
                        ViewContext.Writer.Write("<span style='color: red'>" + enabledState + "</span>");
                        break;
                    case 'L':
                        ViewContext.Writer.Write("<span style='color: orange'>" + enabledState + "</span>");
                        break;
                    case 'Y':
                        ViewContext.Writer.Write("<span style='color: orange'>" + enabledState + "</span>");
                        break;
                    default:
                        ViewContext.Writer.Write("<span style='color: black'>" + enabledState + "</span>");
                        break;
                }
            });
        });
        settings.Columns.Add(column =>
        {
            column.FieldName = "Enabled";
            column.Caption = "Enabled";
            column.Settings.HeaderFilterMode = HeaderFilterMode.CheckedList;
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.SetDataItemTemplateContent(c =>
            {
                bool enabledState = (bool)DataBinder.Eval(c.DataItem, "Enabled");
                if (enabledState)
                    ViewContext.Writer.Write("<span style='color: green'>" + DataBinder.Eval(c.DataItem, "Enabled") + "</span>");
                else
                    ViewContext.Writer.Write("<span style='color: red'>" + DataBinder.Eval(c.DataItem, "Enabled") + "</span>");
            });
        });
        settings.Columns.Add("Code");
        settings.Columns.Add("Name").Caption = "Name";
        settings.Columns.Add(column =>
        {
            column.FieldName = "StockStatus";
            column.Caption = "Stock";
            column.Settings.HeaderFilterMode = HeaderFilterMode.CheckedList;
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.SetDataItemTemplateContent(c =>
            {
                int StockStatusID = Convert.ToInt16(DataBinder.Eval(c.DataItem, "StockStatusID"));

                string stockStatus = "<i>Unknown</i>";

                if (DataBinder.Eval(c.DataItem, "StockStatus") != DBNull.Value && DataBinder.Eval(c.DataItem, "StockStatus") != null)
                    stockStatus = DataBinder.Eval(c.DataItem, "StockStatus").ToString();
                switch (StockStatusID)
                {
                    case 1:
                        ViewContext.Writer.Write("<span style='color: green'>" + stockStatus + "</span>");
                        break;
                    case 2:
                    case 3:
                    case 4:
                        ViewContext.Writer.Write("<span style='color: orange'>" + stockStatus + "</span>");
                        break;
                    case 5:
                    case 6:
                    case 7:
                        ViewContext.Writer.Write("<span style='color: red'>" + stockStatus + "</span>");
                        break;

                    default:
                        ViewContext.Writer.Write("<span style='color: black'>" + stockStatus + "</span>");
                        break;
                }
            });
        });
        settings.Columns.Add("FreeStock");
        settings.Columns.Add("PODueDate");
        settings.Columns.Add("POFreeStock");
        settings.Columns.Add("ModifiedDT").Caption = "Last Updated";
    });
    if (ViewData["EditError"] != null)
    {
        grid.SetEditErrorText((string)ViewData["EditError"]);
    }
}
@grid.Bind(Model).GetHtml()