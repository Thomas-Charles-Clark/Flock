@model Flock.ViewModels.ProductImagesViewModel

@{
    ViewBag.Title = "Product Images";
    Layout = "~/Views/Admin/_Layout.cshtml";
}
@section styles{
    @Styles.Render("~/bundles/composer")
<style type="text/css">
    .container {
        width: 2080px !important;
    }
    </style>
}

<h4 class="page-heading">Product Images</h4>

@using (Html.BeginForm("ProductImagesGridViewExportToXlsx", "Products"))
{
    <div class="page-subheading">
        @Html.Action("ProductImagesOverviewCollectionDropDownPartial", "Products")
        @Html.Action("ProductImagesOverviewColourDropDownPartial", "Products")
        <img id="images-overview-busy" src="~/Images/SystemIcons/busy-icon.gif"/>

        <input id="export-button" type="submit" value="Export to Xlsx" title="Please be aware that the Collection and Colour pre-filters will not be taken into account for the exported result set.
               \r\n\r\nUse the filters in the grid itself to arrive at a result set you wish to export." />

        <div class="clearfix"></div>
    </div>

    <div id="ProductImagesGridContainer" style="width: 900px; float: left; margin-right: 20px;">
        @Html.Action("ProductImagesGridViewPartial", new Flock.ViewModels.ProductImagesOverviewSettings())
    </div>
}
<div style="width: 986px; float: right;">
    @Html.Partial("~/Views/Images/ImageSearchPartial.cshtml")
</div>
