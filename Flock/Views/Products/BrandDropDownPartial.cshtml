@{
    Layout = null;
}
@model List<Flock.Models.Brand>

@Html.DevExpress().DropDownEdit(
    settings =>
    {
        settings.Style.Add("margin", "0 7px 7px 0");
        settings.Name = "BrandDD";
        settings.Text = "Brand";
        settings.Properties.DropDownWindowStyle.BackColor = System.Drawing.Color.FromArgb(0xEDEDED);

        settings.Height = System.Web.UI.WebControls.Unit.Pixel(35);
        
        settings.Properties.EnableClientSideAPI = true;

        string action = ViewContext.Controller.ValueProvider.GetValue("action").AttemptedValue;

        if (action.ToLower() != "compose")
        {
            settings.Width = System.Web.UI.WebControls.Unit.Percentage(30);
            settings.Style.Add("float", "left");
            settings.Properties.ClientSideEvents.CloseUp = @"function(s, e) {
                s.SetText('Brand');
            }";
        }
        else
        {
            settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
        }
        settings.SetDropDownWindowTemplateContent(c =>
        {
            ViewContext.Writer.Write("<div id='brand-listbox'>");
            ViewContext.Writer.Write(@Html.Partial("~/Views/Products/BrandListBoxPartial.cshtml", Model));
            ViewContext.Writer.Write("</div>");
            ViewContext.Writer.Write("<div style=\"padding: 6px;\">");

            if (action.ToLower() != "compose")
            {
                @Html.DevExpress().Button(
                    buttonSettings =>
                    {
                        buttonSettings.Name = "BrandButtonClear";
                        buttonSettings.Text = "Clear";
                        buttonSettings.Style.Add("float", "left");
                        buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                        BrandCheckComboBox.UnselectAll(); 
                        BrandDD.HideDropDown(); 
                        BrandDD.SetText('Brand');
                        var textSearch = '';
                        if(typeof(ProductCollectionFreeTextSearchBox) != 'undefined' && ProductCollectionFreeTextSearchBox != false)
                            if(ProductCollectionFreeTextSearchBox.GetValue() != null)                
                                textSearch = ProductCollectionFreeTextSearchBox.GetValue();
                        if($('#product-data-view-container').length > 0) {
                            $.ajax({
                                url: '" + @Url.Action("ProductToCollection_ProductDataViewFilter", "Products") + @"',
                                data: { Brands: BrandCheckComboBox.GetSelectedValues().toString(), Launches: LaunchCheckComboBox.GetSelectedValues().toString(), ProductTypes: ProductTypeCheckComboBox.GetSelectedValues().toString(), TextSearch: textSearch.GetValue().toString() },
                                success: function(data) { 
                                    $('#product-data-view-container').html(data);
                                },
                                error: function(e, s, a) { alert(e.responseText); }
                             });
                        }
                    }";
                    }
                ).Render();
            }
            @Html.DevExpress().Button(
                buttonSettings =>
                {
                    buttonSettings.Name = "BrandButtonClose";
                    buttonSettings.Text = "Close";
                    buttonSettings.Style.Add("float", "right");
                    buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                        BrandDD.HideDropDown();
                        BrandDD.SetText('Brand');
                    }";
                }
            )
            .Render();
            ViewContext.Writer.Write("<div style='clear: both;'></div></div>");
        });
        settings.Properties.AnimationType = AnimationType.None;
        settings.Properties.ClientSideEvents.TextChanged = "";
        settings.Properties.ClientSideEvents.DropDown = "";
    }
).GetHtml()