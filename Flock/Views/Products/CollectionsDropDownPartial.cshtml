@{
    Layout = null;
}
@model List<Flock.Models.Collection>
@Html.DevExpress().DropDownEdit(
    settings =>
    {
        settings.Style.Add("float", "left");
        settings.Style.Add("margin", "0 7px 7px 0");
        settings.Name = "CollectionDD";
        settings.Text = "Collections";
        settings.Properties.DropDownWindowStyle.BackColor = System.Drawing.Color.FromArgb(0xEDEDED);

        settings.Width = System.Web.UI.WebControls.Unit.Pixel(200);
        settings.Height = System.Web.UI.WebControls.Unit.Pixel(35);
        
        settings.Properties.EnableClientSideAPI = true;
        settings.Properties.ClientSideEvents.GotFocus = @"function(s, e) {
            s.SetText('');
        }";

        settings.Properties.ClientSideEvents.KeyUp = @"function(s, e) {
            //if(s.GetText().length > 1)
            //{
                $.ajax({
                        url: '"+Url.Action("CollectionsListBoxPartial", "Products")+ @"',
                        traditional: true,
                        data: { FilterText: s.GetText() },
                        success: function(data) {
                            $('#collections-listbox').html(data)
                        },
                        error: function(e, s, a) {
                            alert(e.responseText);
                        }
                    });
            //}
        }";

        settings.Properties.ClientSideEvents.CloseUp = @"function(s, e) {
            s.SetText('Collections');
        }";
        
        settings.SetDropDownWindowTemplateContent(c =>
        {
            ViewContext.Writer.Write("<div id='collections-listbox'>"); 
            ViewContext.Writer.Write(@Html.Partial("CollectionsListBoxPartial", Model));
            ViewContext.Writer.Write("</div>");
            ViewContext.Writer.Write("<div style=\"padding: 6px;\">");
            @Html.DevExpress().Button(
                buttonSettings =>
                {
                    buttonSettings.Name = "collectionsButtonClear";
                    buttonSettings.Text = "Clear";
                    buttonSettings.Style.Add("float", "left");
                    buttonSettings.ClientSideEvents.Click = @"function(s, e){ 
                        collectionCheckComboBox.UnselectAll(); 
                        CollectionDD.HideDropDown(); 
                        CollectionDD.SetText('Collections');
                        if($('#ProductOverviewGridContainer').length > 0) {
                            $.ajax({
                                url: '" + @Url.Action("ProductOverviewGridViewPartial", "Products") + @"',
                                data: { Collections: collectionCheckComboBox.GetSelectedValues().toString(), Colours: coloursCheckComboBox.GetSelectedValues().toString() },
                                success: function(data) { 
                                    $('#ProductOverviewGridContainer').html(data);
                                    $('.inlinesparkline').each(function () {
                                        $(this).html($(this).data('sparkline'));
                                        $(this).sparkline();
                                    });
                                },
                                error: function(e, s, a) { alert(e.responseText); }
                             });
                        }
                        else if ($('#ProductPricesGridContainer').length > 0) {
                            $.ajax({
                                url: '" + @Url.Action("ProductPricesGridViewPartial", "Products") + @"',
                                data: { Collections: collectionCheckComboBox.GetSelectedValues().toString(), Colours: coloursCheckComboBox.GetSelectedValues().toString() },
                                success: function(data) { 
                                    $('#ProductPricesGridContainer').html(data);
//                                    $('.inlinesparkline').each(function () {
//                                        $(this).html($(this).data('sparkline'));
//                                        $(this).sparkline();
//                                    });
                                },
                                error: function(e, s, a) { alert(e.responseText); }
                             });
                        }
                        else if ($('#ProductStockGridContainer').length > 0) {
                            $.ajax({
                                url: '" + @Url.Action("ProductStockGridViewPartial", "Products") + @"',
                                data: { Collections: collectionCheckComboBox.GetSelectedValues().toString(), Colours: coloursCheckComboBox.GetSelectedValues().toString() },
                                success: function(data) { 
                                    $('#ProductStockGridContainer').html(data);
//                                    $('.inlinesparkline').each(function () {
//                                        $(this).html($(this).data('sparkline'));
//                                        $(this).sparkline();
//                                    });
                                },
                                error: function(e, s, a) { alert(e.responseText); }
                             });
                        }
                        else if ($('#ProductPricesGridContainer').length > 0) {
                            $.ajax({
                                url: '" + @Url.Action("ProductPricesGridViewPartial", "Products") + @"',
                                data: { Collections: collectionCheckComboBox.GetSelectedValues().toString(), Colours: coloursCheckComboBox.GetSelectedValues().toString(), ProductPriceListID: priceListsListBox.GetSelectedValues().toString() },
                                success: function(data) { 
                                    $('#ProductPricesGridContainer').html(data);
                                },
                                error: function(e, s, a) { alert(e.responseText); }
                             });
                        }
                    }";
                }
            )
            .Render();
            @Html.DevExpress().Button(
                buttonSettings =>
                {
                    buttonSettings.Name = "collectionsButtonClose";
                    buttonSettings.Text = "Close";
                    buttonSettings.Style.Add("float", "right");
                    buttonSettings.ClientSideEvents.Click = @"function(s, e){ CollectionDD.HideDropDown(); CollectionDD.SetText('Collections');
                    }";
                }
            )
            .Render();
            ViewContext.Writer.Write("<div style='clear: both;'></div></div>");
        });
        settings.Properties.AnimationType = AnimationType.None;
        settings.Properties.ClientSideEvents.TextChanged = "";// "SynchronizeListBoxValues";
        settings.Properties.ClientSideEvents.DropDown = "";// "SynchronizeListBoxValues";
    }
).GetHtml()