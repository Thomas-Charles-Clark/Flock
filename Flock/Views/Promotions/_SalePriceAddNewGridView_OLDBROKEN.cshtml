@grid.BindToLINQ(string.Empty, string.Empty, (s, e) =>
{
    var dataContext = new Flock.DAL.UnitOfWork<Flock.Models.FlockDataContext>();
    var source = dataContext.GetRepository<Flock.Models.vwSalePriceAdd>().GetAll();

    if (Session["SalePricePriceListID"] != null)
    {
        var x = Convert.ToByte(Session["SalePricePriceListID"]);
        source = source.Where(p => p.PriceListID == x);
    }
    else
    {
        source = source.Where(p => p.PriceListID == 1);
    }
    e.KeyExpression = "ProductID";
    e.QueryableSource = source;
}).GetHtml()