            column.CellStyle.BackColor = System.Drawing.Color.FromArgb(236, 244, 251);
            column.HeaderStyle.BackColor = System.Drawing.Color.FromArgb(236, 244, 251);
            column.ColumnType = MVCxGridViewColumnType.SpinEdit;
            column.PropertiesEdit.DisplayFormatString = "{0:F2}";
            var spineditproperties = column.PropertiesEdit as SpinEditProperties;
            spineditproperties.DisplayFormatInEditMode = true;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            //spineditproperties.ClientInstanceName
            spineditproperties.ClientSideEvents.NumberChanged = @"function(s, e) {
                // can't get the rowkeyaler that the spinedit is sitting on.
                var rowIndex = $('#SalePriceAddNewGridView tr.add-new-data-row').index($(s.GetInputElement()).parent().parent().parent().parent().parent().parent().parent()) - 1;
                // get SalePriceTypeID
                var saleType = '';
                if($('#SalePriceAddNewGridView_DXDataRow'+rowIndex).children().eq(18).children().length == 0)
                    saleType = $('#SalePriceAddNewGridView_DXDataRow'+rowIndex).children().eq(18).html();
                else
                    saleType = $('#SalePriceAddNewGridView_DXDataRow'+rowIndex).children().eq(18).children().eq(0).html();

                var ExRate = $('#price-list-exchange-rate').html();
                var costSterling = $('#SalePriceAddNewGridView_DXDataRow' + (rowIndex)).children().eq(16).html().replace('£', '');
                var costCurrency = costSterling * ExRate;

                if(saleType == 'Amount Off') {
                    var currentPriceInc = $('#SalePriceAddNewGridView_DXDataRow'+rowIndex).children().eq(13).html();
                    var currentPriceEx = $('#SalePriceAddNewGridView_DXDataRow'+rowIndex).children().eq(14).html();

                    var newPriceInc = currentPriceInc - s.GetValue();
                    var newPriceEx = currentPriceEx - s.GetValue();

                    $('#SalePriceAddNewGridView_DXDataRow'+rowIndex).children().eq(19).html((Math.round(newPriceInc * 100 ) / 100).toFixed(2));
                    $('#SalePriceAddNewGridView_DXDataRow'+rowIndex).children().eq(19).css('background-color', '#D7F9C7');

                    $('#SalePriceAddNewGridView_DXDataRow'+rowIndex).children().eq(20).html((Math.round(newPriceEx * 100 ) / 100).toFixed(2));
                    $('#SalePriceAddNewGridView_DXDataRow'+rowIndex).children().eq(20).css('background-color', '#D7F9C7');

                    var GM = (((newPriceEx - costCurrency) / newPriceEx) * 100);
                    GM = Math.round(GM);
                    $('#SalePriceAddNewGridView_DXDataRow' + (rowIndex)).children().eq(21).html(GM + '%');
                    $('#SalePriceAddNewGridView_DXDataRow' + (rowIndex)).children().eq(21).css('background-color', '#D7F9C7');
                }

                if(saleType == 'Percent Off') {
                    var currentPriceInc = $('#SalePriceAddNewGridView_DXDataRow'+rowIndex).children().eq(13).html();
                    var currentPriceEx = $('#SalePriceAddNewGridView_DXDataRow'+rowIndex).children().eq(14).html();

                    var newPriceInc = currentPriceInc * (1 - (s.GetValue() / 100));
                    var newPriceEx = currentPriceEx * (1 - (s.GetValue() / 100));

                    $('#SalePriceAddNewGridView_DXDataRow'+rowIndex).children().eq(19).html((Math.round(newPriceInc * 100 ) / 100).toFixed(2));
                    $('#SalePriceAddNewGridView_DXDataRow'+rowIndex).children().eq(19).css('background-color', '#D7F9C7');

                    $('#SalePriceAddNewGridView_DXDataRow'+rowIndex).children().eq(20).html((Math.round(newPriceEx * 100 ) / 100).toFixed(2));
                    $('#SalePriceAddNewGridView_DXDataRow'+rowIndex).children().eq(20).css('background-color', '#D7F9C7');

                    var GM = (((newPriceEx - costCurrency) / newPriceEx) * 100);
                    GM = Math.round(GM);
                    $('#SalePriceAddNewGridView_DXDataRow' + (rowIndex)).children().eq(21).html(GM + '%');
                    $('#SalePriceAddNewGridView_DXDataRow' + (rowIndex)).children().eq(21).css('background-color', '#D7F9C7');
                }
            }";
        });

