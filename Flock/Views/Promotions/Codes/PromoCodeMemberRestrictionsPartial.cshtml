@model List<Flock.Models.Member>
@{
    foreach(var m in Model)
    {
        <div class="member-restriction-icon" data-member-id="@(m.MemberID)" onmouseover="$(this).find('.image-remove-icon').stop().animate({ opacity: 1.0 }, 300);" onmouseout="$(this).find('.image-remove-icon').stop().animate({ opacity: 0.0 }, 300);">
            <img src="/images/admin/member_sml.png"/>
            <p>@(m.FullName)</p>
            <img src="/images/systemicons/remove-icon.png" class="image-remove-icon" onclick="removeMemberRestriction($(this));"/>
        </div>
    }
    if(Model.Count == 0)
    {
        <div id="member-restrictions-placeholder">
            <p style="font-style: italic;">This promo code is not restricted to any particular members.</p>
        </div>
    }
}