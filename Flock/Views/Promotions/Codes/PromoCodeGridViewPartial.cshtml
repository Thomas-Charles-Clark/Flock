        giftBoxPriceExProp.MinValue = 0;
        giftBoxPriceExProp.MaxValue = 99999;
        giftBoxPriceExProp.NumberFormat = SpinEditNumberFormat.Custom;
        giftBoxPriceExProp.DisplayFormatString = "F2";
        giftBoxPriceExProp.DisplayFormatInEditMode = true;
        giftBoxPriceExProp.DecimalPlaces = 2;
