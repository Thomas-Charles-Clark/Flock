        DiscountFullPriceColumn.Caption = "Discount Full Price Products";
        DiscountFullPriceColumn.Width = 60;
        DiscountFullPriceColumn.HeaderStyle.Wrap = DefaultBoolean.True;
        DiscountFullPriceColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        DiscountFullPriceColumn.Settings.ShowFilterRowMenu = DefaultBoolean.False;
        DiscountFullPriceColumn.Settings.AllowHeaderFilter = DefaultBoolean.True;
        DiscountFullPriceColumn.Settings.HeaderFilterMode = HeaderFilterMode.List;
        DiscountFullPriceColumn.ColumnType = MVCxGridViewColumnType.ComboBox;
        var discFullProp = DiscountFullPriceColumn.PropertiesEdit as ComboBoxProperties;
        discFullProp.ValueType = typeof(bool);
        discFullProp.Items.Add("Yes", true);
        discFullProp.Items.Add("No", false);
        DiscountFullPriceColumn.EditFormSettings.VisibleIndex = 100;

        MVCxGridViewColumn DiscountSalePriceColumn = new MVCxGridViewColumn();
