@using Flock.DAL
@using Flock.Models
@model Flock.ViewModels.PromoCodeViewModel
@{
    var UoW = new UnitOfWork<FlockDataContext>();

    var grid = Html.DevExpress().GridView(settings => {
        settings.Name = "PromotionCodeGridView";
        settings.CallbackRouteValues = new { Controller = "Promotions", Action = "PromoCodeGridViewPartial" };
        settings.SettingsEditing.AddNewRowRouteValues = new { Controller = "Promotions", Action = "PromoCodeGridViewPartialAddNew" };
        settings.SettingsEditing.UpdateRowRouteValues = new { Controller = "Promotions", Action = "PromoCodeGridViewPartialUpdate" };

        settings.SettingsPager.PageSize = 20;
        settings.SettingsPager.PageSizeItemSettings.Visible = true;
        settings.SettingsPager.PageSizeItemSettings.Position = PagerPageSizePosition.Right;

        settings.ClientSideEvents.BeginCallback = @"function(s, e) { 
            if($('#member-restrictions').length > 0) {
                var memberRestrictions = [];
                $('#member-restriction-placeholder').remove();
                $('#member-restrictions > div').each(function() { 
                    memberRestrictions.push($(this).data('member-id'));
                });
                e.customArgs['memberRestrictions'] = memberRestrictions.toString();
            }
            if($('#product-restrictions').length > 0) {
                var productRestrictions = [];
                $('#product-restriction-placeholder').remove();
                $('#product-restrictions > div').each(function() { 
                    productRestrictions.push($(this).data('product-id'));
                });
                e.customArgs['productRestrictions'] = productRestrictions.toString();
            }
            if (typeof (InitMemberDragDrop) == 'function')
                InitMemberDragDrop();
            if (typeof (InitProductDragDrop) == 'function')
                InitProductDragDrop();
        }";

        settings.ClientSideEvents.EndCallback = @"function(s, e) { 
            if (typeof (InitMemberDragDrop) == 'function')
                InitMemberDragDrop();
            if (typeof (InitProductDragDrop) == 'function')
                InitProductDragDrop();
        }";

        settings.ClientSideEvents.Init = @"function(s, e) { 
            if (typeof (InitMemberDragDrop) == 'function')
                InitMemberDragDrop();
            if (typeof (InitProductDragDrop) == 'function')
                InitProductDragDrop();
        }";

        settings.CommandColumn.Visible = true;
        settings.CommandColumn.ShowEditButton = true;
        settings.CommandColumn.ShowNewButtonInHeader = true;
        settings.CommandColumn.VisibleIndex = 100;

        settings.Settings.ShowFilterRow = true;

        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);

        settings.KeyFieldName = "PromotionCodeID";

