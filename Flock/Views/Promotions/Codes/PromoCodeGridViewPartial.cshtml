        CreatedDTColumn.Settings.AllowHeaderFilter = DefaultBoolean.False;
        CreatedDTColumn.EditFormSettings.Visible = DefaultBoolean.False;

        settings.Columns.Add(PromotionCodeIDColumn);
        settings.Columns.Add(PromotionGroupIDColumn);
        settings.Columns.Add(CodeColumn);
        settings.Columns.Add(DescriptionColumn);
        settings.Columns.Add(MinimumSpendColumn);
        settings.Columns.Add(MaxUsesColumn);
        settings.Columns.Add(TransactionSequenceRestrictionColumn);
        settings.Columns.Add(UsedColumn);
        settings.Columns.Add(PriceListIDColumn);
        settings.Columns.Add(DiscountColumn);
        settings.Columns.Add(DiscountTypeColumn);
        settings.Columns.Add(DiscountFullPriceColumn);
        settings.Columns.Add(DiscountSalePriceColumn);
        settings.Columns.Add(DiscountTradePriceColumn);
        settings.Columns.Add(DiscountBundlesColumn);
        settings.Columns.Add(DiscountSamplesColumn);
        settings.Columns.Add(GiftBoxPriceIncColumn);
        settings.Columns.Add(GiftBoxPriceExColumn);
        //settings.Columns.Add(CreatedDTColumn);
        settings.Columns.Add(OnDateColumn);
        settings.Columns.Add(OffDateColumn);
        settings.Columns.Add(WebStatusColumn);

        settings.SetEditFormTemplateContent(c => {
            if (Model == null)
                ViewContext.Writer.Write(Html.Action("PromoCodeEditFormPartial", "Promotions", new { promotionCodeID = c.KeyValue }));
            else
                ViewContext.Writer.Write(Html.Partial("Codes/PromoCodeEditFormPartial", Model));

            Html.DevExpress().Button(btnSettings =>
            {
                btnSettings.Name = "CancelEditBtn";
                btnSettings.Text = "Cancel";
                btnSettings.Style.Add("float", "right");
                btnSettings.ClientSideEvents.Click = @"function(s, e) { 
                    if($('#product-panel-target').children().length > 0) {
                        var d = $('#product-panel').detach();
                        $('#product-panel-start-marker').append(d);
                    }
                    PromotionCodeGridView.CancelEdit();
                }";
            }).Render();
            Html.DevExpress().Button(btnSettings =>
            {
                btnSettings.Name = "UpdateBtn";
                btnSettings.Text = "Update";
                btnSettings.Style.Add("float", "right");
                btnSettings.Style.Add("margin-right", "10px");
                btnSettings.ClientSideEvents.Click = @"function(s, e) {
                    if($('#product-panel-target').children().length > 0) {
                        var d = $('#product-panel').detach();
                        $('#product-panel-start-marker').append(d);
                    }
                    PromotionCodeGridView.UpdateEdit();
                }";
            }).Render();
        });

        settings.HeaderFilterFillItems = (sender, e) =>
        {
            MVCxGridView gridView = (MVCxGridView)sender;
            switch (e.Column.Name)
            {
                case "WebStatusID":
                    e.Values.Clear();
                    foreach (var pt in UoW.GetRepository<Flock.Models.Status>().GetAll().OrderBy(p => p.StatusID).ToList())
                    {
                        e.AddValue(pt.Name, pt.StatusID.ToString());
                    }
                    e.AddShowAll();
                    break;

                default: break;
            }
        };

        settings.CellEditorInitialize = (sender, e) =>
        {
            if ((sender as MVCxGridView).IsNewRowEditing)
            {
                if (e.Column.FieldName == "ApplyDiscountToSalePrice")
                {
                    (e.Editor as ASPxCheckBox).Checked = false;
                }
                if (e.Column.FieldName == "ApplyDiscountToFullPrice")
                {
                    (e.Editor as ASPxCheckBox).Checked = false;
                }
                if (e.Column.FieldName == "ApplyDiscountToTradePrice")
                {
                    (e.Editor as ASPxCheckBox).Checked = false;
                }
                if (e.Column.FieldName == "DiscountBundles")
                {
                    (e.Editor as ASPxCheckBox).Checked = true;
                }
                if (e.Column.FieldName == "DiscountSamples")
                {
                    (e.Editor as ASPxCheckBox).Checked = false;
                }
            }
        };

        PromotionCodeIDColumn.SortDescending();
    });

    if (ViewData["EditError"] != null)
    {
        grid.SetEditErrorText((string)ViewData["EditError"]);
    }
}
@grid.BindToLINQ("", "", (s, e) => {
    e.KeyExpression = "PromotionCodeID";
    e.QueryableSource = UoW.GetRepository<vwPromotionCode>().GetAll().OrderByDescending(p => p.PromotionCodeID);
}).GetHtml()