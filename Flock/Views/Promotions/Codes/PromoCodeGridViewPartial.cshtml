        WebStatusColumn.Caption = "Web Status";
        WebStatusColumn.SetDataItemTemplateContent(c =>
        {
            var WebStatusID = Convert.ToByte(DataBinder.Eval(c.DataItem, "WebStatusID"));
            var WebStatus = UoW.GetRepository<Status>().GetAll().Where(p => p.StatusID == WebStatusID).Select(p => p.Name).Single();
            var colour = "black";
            switch (WebStatusID)
            {
                case 0:
                    colour = "green";
                    break;
                case 1:
                    colour = "orange";
                    break;
                case 2:
                    colour = "orange";
                    break;
                case 3:
                    colour = "green";
                    break;
                case 4:
                    colour = "red";
                    break;
                default: break;
            }
            ViewContext.Writer.Write("<span style='color: " + colour + "'>" + WebStatus + "</span>");
        });
        WebStatusColumn.Settings.AllowHeaderFilter = DefaultBoolean.True;
        WebStatusColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        WebStatusColumn.Settings.HeaderFilterMode = HeaderFilterMode.List;
        WebStatusColumn.EditFormSettings.Visible = DefaultBoolean.False;

