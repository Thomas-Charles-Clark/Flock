        DiscountTradePriceColumn.Settings.AllowHeaderFilter = DefaultBoolean.True;
        DiscountTradePriceColumn.Settings.HeaderFilterMode = HeaderFilterMode.List;
        DiscountTradePriceColumn.ColumnType = MVCxGridViewColumnType.ComboBox;
        var discTradeProp = DiscountTradePriceColumn.PropertiesEdit as ComboBoxProperties;
        discTradeProp.ValueType = typeof(bool);
        discTradeProp.Items.Add("Yes", true);
        discTradeProp.Items.Add("No", false);
        DiscountTradePriceColumn.EditFormSettings.VisibleIndex = 100;

        MVCxGridViewColumn DiscountSamplesColumn = new MVCxGridViewColumn();
        DiscountSamplesColumn.Name = "DiscountSamples";
        DiscountSamplesColumn.FieldName = "DiscountSamples";
        DiscountSamplesColumn.Caption = "Discount Sample Cuttings";
        DiscountSamplesColumn.Width = 60;
        DiscountSamplesColumn.HeaderStyle.Wrap = DefaultBoolean.True;
        DiscountSamplesColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        DiscountSamplesColumn.Settings.ShowFilterRowMenu = DefaultBoolean.False;
        DiscountSamplesColumn.Settings.AllowHeaderFilter = DefaultBoolean.True;
        DiscountSamplesColumn.Settings.HeaderFilterMode = HeaderFilterMode.List;
        DiscountSamplesColumn.ColumnType = MVCxGridViewColumnType.ComboBox;
        var discSamplesProp = DiscountSamplesColumn.PropertiesEdit as ComboBoxProperties;
        discSamplesProp.ValueType = typeof(bool);
        discSamplesProp.Items.Add("Yes", true);
        discSamplesProp.Items.Add("No", false);
        DiscountSamplesColumn.EditFormSettings.VisibleIndex = 100;

        MVCxGridViewColumn DiscountBundlesColumn = new MVCxGridViewColumn();
        DiscountBundlesColumn.Name = "DiscountBundles";
        DiscountBundlesColumn.FieldName = "DiscountBundles";
        DiscountBundlesColumn.Caption = "Discount Bundles";
        DiscountBundlesColumn.Width = 50;
        DiscountBundlesColumn.HeaderStyle.Wrap = DefaultBoolean.True;
        DiscountBundlesColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        DiscountBundlesColumn.Settings.ShowFilterRowMenu = DefaultBoolean.False;
        DiscountBundlesColumn.Settings.AllowHeaderFilter = DefaultBoolean.True;
