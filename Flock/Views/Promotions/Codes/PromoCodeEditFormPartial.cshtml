        <div id="member-restrictions-tab">
            <table id="promo-code-member-segment-table">
                <tr>
                    <td style="vertical-align: top; width: 69px;">
                        @Html.DevExpress().Label(settings => { settings.Name = "PromoMemberSegmentsLbl"; settings.Text = "Member Segments"; }).GetHtml()
                    
                        @if (((List<Flock.Models.MemberSegment>)Flock.ViewModels.LargeDatabaseDataProvider.GetMemberSegments()).Count == 0)
                        {
                            <div style="width: 100%; height: 100%; border: 1px solid #c0c0c0; padding: 7px 5px 6px 11px;">
                                <p style="font-style: italic;">There are currently no member segments.</p>
                            </div>
                        }
                        else
                        {
                            @Html.DevExpress().CheckBoxList(settings =>
                    {
                        settings.Name = "PromoCodeMemberSegmentsUnbound";
                        settings.Properties.RepeatLayout = System.Web.UI.WebControls.RepeatLayout.Table;
                        settings.Properties.RepeatDirection = System.Web.UI.WebControls.RepeatDirection.Horizontal;
                        settings.Properties.RepeatColumns = 5;
                        settings.Height = 250;
                        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
                        settings.Properties.TextField = "Name";
                        settings.Properties.ValueField = "MemberSegmentID";
                        settings.Properties.ValueType = typeof(byte);
                        settings.PreRender = (sender, e) =>
                        {
                            ASPxCheckBoxList cbl = (ASPxCheckBoxList)sender;
                            foreach (ListEditItem item in cbl.Items)
                            {
                                item.Selected = Model.PromoCode_MemberSegments.Select(p => p.MemberSegmentID).Contains((byte)item.Value);
                            }
                        };
                    }).BindList(Flock.ViewModels.LargeDatabaseDataProvider.GetMemberSegments()).GetHtml()
                        }   
                    </td>
                </tr>
                <tr>
                    <td>
                        @Html.DevExpress().Label(settings => { settings.Name = "PromoMembersLbl"; settings.Text = "Member Restrictions"; }).GetHtml()
                        <div id="member-restrictions" style="padding: 1em;">
                            @Html.Partial("Codes/PromoCodeMemberRestrictionsPartial", Model.PromoCode_Members)
                        </div>
                    </td>
                </tr>
            </table>
            @Html.Partial("~/Views/Shared/MemberSearch.cshtml")

            <div style="clear: both;"></div>
        </div>
        <div style="clear: both;"></div>
    </div>
    <div style="clear: both;"></div>
</div>

