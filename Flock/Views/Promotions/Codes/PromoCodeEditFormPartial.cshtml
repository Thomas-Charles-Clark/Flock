                                settings.Properties.DisplayFormatInEditMode = true;
                                settings.Properties.DecimalPlaces = 2;
                                settings.ShowModelErrors = true;
                            }).GetHtml()
                        </td>
                    </tr>
                    <tr>
                        <td>
                            @Html.DevExpress().Label(settings => { settings.Name = "GiftBoxPriceExLbl"; settings.Text = "Gift Box Price Ex"; settings.ControlStyle.CssClass = "detail-label"; }).GetHtml()
                        </td>
                        <td>
