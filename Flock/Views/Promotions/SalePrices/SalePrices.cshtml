        @Html.Action("SalePricesBrandDropDownPartial", "Promotions")
        @Html.Action("SalePricesMarketDropDownPartial", "Promotions")

        @Html.DevExpress().SpinEdit(settings =>
       {
           settings.Name = "MarginThreshold";
           settings.Properties.NullText = "Enter Margin Threshold";
           settings.Style.Add("float", "left");
           settings.Style.Add("margin", "0 7px 7px 0");
           settings.Width = System.Web.UI.WebControls.Unit.Pixel(200);
           settings.Height = System.Web.UI.WebControls.Unit.Pixel(35);
           settings.Properties.MinValue = 0;
           settings.Properties.MaxValue = 100;
           settings.Properties.NumberType = SpinEditNumberType.Integer;
           settings.Properties.DisplayFormatString = "{0:#\\%}";
       }).GetHtml()
