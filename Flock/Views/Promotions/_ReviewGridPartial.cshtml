            MVCxGridView g = (MVCxGridView)sender;
            g.DetailRowGetButtonVisibility += (s, detailEvents) =>
            {
                bool contains = Model.Tables[1].AsEnumerable()
                   .Any(row => (int)detailEvents.KeyValue == row.Field<int>("ProductID"));

                if (ViewData["SuccessfulSave"] != null)
                {
                    if (Convert.ToBoolean(ViewData["SuccessfulSave"]) == true)
                    {
                        g.DetailRows.CollapseRowByKey(detailEvents.KeyValue);
                        detailEvents.ButtonState = GridViewDetailRowButtonState.Hidden;
                    }
                }
                else
                {
                    if (!contains)
                    {
                        g.DetailRows.CollapseRowByKey(detailEvents.KeyValue);
                        detailEvents.ButtonState = GridViewDetailRowButtonState.Hidden;
                    }
                }
            };
