        settings.SetDetailRowTemplateContent(c =>
        {
            // pass entire dataset to this grid, bind only to the first table,
            // inspect the second table utilising the KeyValue for the given row, if present THEN build the small grid display
            // fetching the conflicting saleprice rows by their IDs located in the second table.
            //c.KeyValue;

            if (Model.Tables[1] != null)
            {
                bool contains = Model.Tables[1].AsEnumerable()
                   .Any(row => (int)c.KeyValue == row.Field<int>("ProductID"));

                if (contains)
                {
                    var SalePriceIDs = Model.Tables[1].AsEnumerable()
                        .Where(row => (int)c.KeyValue == row.Field<int>("ProductID")).Select(p => p.Field<long>("SalePriceID")).ToList();

                    var DetailModel = UoW.GetRepository<vwSalePriceOverview>().GetAll().Where(p => p.ProductID == (int)c.KeyValue && SalePriceIDs.Contains(p.SalePriceID)).ToList();

                    Html.RenderPartial("_ReviewGridDetailPartial", DetailModel);// ViewContext.Writer.Write(Html.Partial("_ReviewGridDetailPartial", DetailModel));
                }
            }
        });

