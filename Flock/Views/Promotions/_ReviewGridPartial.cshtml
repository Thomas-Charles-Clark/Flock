        settings.HeaderFilterFillItems = (sender, e) =>
        {
            MVCxGridView gridView = (MVCxGridView)sender;
            switch (e.Column.Name)
            {
                case "Enabled":
                    e.AddShowAll();
                    break;
                case "Discrepancy":
                    e.Values.Clear();
                    e.AddValue("Yes", "Yes");
                    e.AddValue("No", "No");
                    e.AddShowAll();
                    break;
                default: break;
            }
        };

        settings.HtmlRowPrepared = (s, e) =>
        {
            if (e.RowType != GridViewRowType.Data) return;

            if (ViewData["SuccessfulSave"] == null)
            {
                if (Model.Tables[1] != null)
                {
                    bool contains = Model.Tables[1].AsEnumerable()
                       .Any(row => (int)e.KeyValue == row.Field<int>("ProductID"));

                    if (contains)
                    {
                        GridViewDataColumn col = ((ASPxGridView)s).Columns["Detail"] as GridViewDataColumn;
                        e.Row.BackColor = System.Drawing.Color.FromArgb(255, 241, 241);
                    }
                }
            }
            else
            {
                if ((bool)ViewData["SuccessfulSave"] == true)
                {
                    GridViewDataColumn col = ((ASPxGridView)s).Columns["Detail"] as GridViewDataColumn;
                    e.Row.BackColor = System.Drawing.Color.FromArgb(148, 233, 148);
                }
            }
        };

        settings.HtmlRowCreated = (s, e) =>
        {

        };


        settings.HeaderFilterFillItems = (sender, e) =>
        {
            MVCxGridView gridView = (MVCxGridView)sender;
            switch (e.Column.Name)
            {
                case "WebStatus":
                case "SalePriceStatusID":
                    e.Values.Clear();
                    foreach (var pt in UoW.GetRepository<Flock.Models.Status>().GetAll().OrderBy(p => p.StatusID).ToList())
                    {
                        e.AddValue(pt.Name, pt.StatusID.ToString());
                    }
                    e.AddShowAll();
                    break;
                case "ProductTypeID":
                    e.Values.Clear();
                    foreach (var pt in UoW.GetRepository<Flock.Models.ProductType>().GetAll().OrderBy(p => p.Name))
                    {
                        e.AddValue(pt.Name, pt.ProductTypeID.ToString());
                    }
                    e.AddShowAll();
                    break;
                case "BrandID":
                    e.Values.Clear();
                    foreach (var pt in UoW.GetRepository<Flock.Models.Brand>().GetAll().OrderBy(p => p.Name))
                    {
                        e.AddValue(pt.Name, pt.BrandID.ToString());
                    }
                    e.AddShowAll();
                    break;
                case "LaunchID":
                    e.Values.Clear();
                    foreach (var pt in UoW.GetRepository<Flock.Models.Launch>().GetAll().OrderByDescending(p => p.LaunchDate))
                    {
                        e.AddValue(pt.Name, pt.LaunchID.ToString());
                    }
                    e.AddShowAll();
                    break;
                default: break;
            }
        };
    });
