@using Flock.ViewModels
@model SelectionComposeViewModel

<div id="details-and-pod-images-container" class="content-panel-container">
    <fieldset>
        <legend style="color: black; border-bottom-color: #929292;" onclick="$('#selection-details-inner').slideToggle('fast')">
            Selection Details & Pod Images (click to expand / contract)
            <span style="float: right; margin: 0 0.5em">Selection ID: @(Model.SelectionID)</span>
            <img id="selection-details-busy" class="busy" src="/Images/SystemIcons/busy-icon.gif" alt="busy icon" title="Working..." />
        </legend>
        <div id="selection-details-inner" style="background-color: white; padding: 1em; position: relative;">
            <div style="clear: both;"></div>
            <div style="width: 66%; float: right">
                <div id="selection-pod-container" class="droppable" data-selection-id="@(Model.SelectionID)">
                    <span style="margin-bottom: 7px; display: inline-block;">Pod Images: Square only</span>
                    <img id="selection-pod-busy" class="busy" style="float: right; width: 20px;" src="/Images/SystemIcons/busy-icon.gif" alt="busy icon" title="Working..." />
                    <div style="clear: both"></div>
                    <div id="pod-list" class="sortable-list">
                        @Html.Partial("SelectionPodImagesPartial", Model.Images.Where(p => p.TemplateImageID == 1).OrderBy(o => o.SortOrder).ToList())
                    </div>
                </div>
            </div>
            <div style="width: 33.2%; float: left;">
                @Html.DevExpress().LabelFor(m => Model.Name, settings => {}).GetHtml()
                @Html.DevExpress().TextBoxFor(m => Model.Name, settings =>
                {
                    settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
                    settings.Properties.MaxLength = 100;
                    settings.ShowModelErrors = true;
                }).GetHtml()
                @Html.DevExpress().LabelFor(m => Model.TitleTag, settings =>
                {
                    settings.Style.Add("margin-top", "1em");
                    settings.Style.Add("margin-bottom", "2px");
                }).GetHtml()
                @Html.DevExpress().TextBoxFor(m => Model.TitleTag, settings =>
                {
                    settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
                    settings.ShowModelErrors = true;
                    settings.Properties.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.ImageWithTooltip;
                    settings.Properties.MaxLength = 70;
                }).GetHtml()
                @Html.DevExpress().LabelFor(m => Model.URLKeywords, settings =>
                {
                    settings.Style.Add("margin-top", "1em");
                    settings.Style.Add("margin-bottom", "2px");
                }).GetHtml()
                @Html.DevExpress().TextBoxFor(m => Model.URLKeywords, settings =>
                {
                    settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
                    settings.ShowModelErrors = true;
                    settings.Properties.MaxLength = 100;
                    settings.Properties.ValidationSettings.ValidateOnLeave = true;
                    settings.Properties.ValidationSettings.RegularExpression.ValidationExpression = "^([a-z]|[a-z]-|[a-z]/)+[a-z]$";
                    settings.Properties.ValidationSettings.RegularExpression.ErrorText = @"Regular Expression Validation Failed.
        URLs must not begin or end with a slash.
        URL segments must not contain accented characters, such as é or ë.
        URL segments may only contain the lower case letters 'a' through 'z', as well as hyphens.
        URL segments must not begin or end with a hyphen.";
                    settings.Properties.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.ImageWithTooltip;
                }).GetHtml()


                @Html.DevExpress().LabelFor(m => Model.Heading, settings =>
                    {
                        settings.Style.Add("margin-top", "1em");
                        settings.Style.Add("margin-bottom", "2px");
                    }).GetHtml()
                @Html.DevExpress().TextBoxFor(m => Model.Heading, settings =>
                    {
                        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
                        settings.Properties.MaxLength = 70;
                        settings.ShowModelErrors = true;
                    }).GetHtml()
                @Html.DevExpress().LabelFor(m => Model.SubHeading, settings =>
                    {
                        settings.Style.Add("margin-top", "1em");
                        settings.Style.Add("margin-bottom", "2px");
                    }).GetHtml()
                @Html.DevExpress().TextBoxFor(m => Model.SubHeading, settings =>
                    {
                        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
                        settings.Properties.MaxLength = 150;
                        settings.ShowModelErrors = true;
                    }).GetHtml()

                @Html.DevExpress().LabelFor(m => Model.MetaDescription, settings =>
                {
                    settings.Style.Add("margin-top", "1em");
                    settings.Style.Add("margin-bottom", "2px");
                }).GetHtml()
                @Html.DevExpress().MemoFor(m => Model.MetaDescription, settings =>
                {
                    settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
                    settings.Height = System.Web.UI.WebControls.Unit.Pixel(75);
                    settings.Properties.MaxLength = 155;
                    settings.ShowModelErrors = true;
                    settings.Properties.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.ImageWithTooltip;
                }).GetHtml()

                @Html.DevExpress().LabelFor(m => Model.Description, settings =>
                {
                    settings.Style.Add("margin-top", "1em");
                    settings.Style.Add("margin-bottom", "2px");
                }).GetHtml()
                @Html.DevExpress().MemoFor(m => Model.Description, settings =>
                {
                    settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
                    settings.Height = System.Web.UI.WebControls.Unit.Pixel(145);
                    settings.Properties.MaxLength = 2000;
                    settings.ShowModelErrors = true;
                    settings.Properties.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.ImageWithTooltip;
                }).GetHtml()
            </div>
            <div style="clear: both;"></div>
            <img id="selection-details-save" class="pagesection-save-icon" src="/images/icons/32/save.png" style="margin-right: 0; position: absolute; bottom: 10px; right: 10px;" onclick="SaveSelectionDetails();" />
        </div>
    </fieldset>
</div> 

<div id="selection-productpages-container" class="content-panel-container">
    <fieldset>
        <legend style="color: black; border-bottom-color: #929292;" onclick="$('#selection-productpages-inner').slideToggle('fast')">
            Selection Product Pages (click to expand / contract)
            <img id="selection-productpages-busy" class="busy" src="/Images/SystemIcons/busy-icon.gif" alt="busy icon" title="Working..." />
        </legend>
        <div id="selection-productpages-inner" style="background-color: white; padding: 1em; position: relative;">
            @Html.Partial("ComposeSelectionProductPagesPartial", Model.ProductPages)
            <div style="clear: both;"></div>
        </div>
    </fieldset>
</div>