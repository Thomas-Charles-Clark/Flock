@model List<Flock.Models.vwSelection_ProductPage>
<div class="content-panel-container">
    <fieldset>
        <legend style="color: black; border-bottom-color: #929292;" onclick="$('#selection-productpages-inner').slideToggle('fast')">
            Selection Product Pages (click to expand / contract)
            <img id="related-product-page-busy" class="busy" src="/Images/SystemIcons/busy-icon.gif" alt="busy icon" title="Working..." />
        </legend>
        <div id="selection-productpages-inner" style="background-color: white; padding: 1em;">
            @if (Model.Count == 0)
            {
                <div id="selection-product-page-placeholder" style="padding: 1em; font-size: 1.4em; background-color: white;">
                    No Product Pages have been set for this Selection.
                </div>
            }
            else
            {
                foreach (Flock.Models.vwSelection_ProductPage i in Model)
                {
                    if (i.ImageID != 0 && i.ImageID != null)
                    {
                        <div data-product-page-id="@(i.ProductPageID)" class="related-product-sortable" onmouseover="$(this).find('.image-remove-icon').stop().animate({opacity: 0.8}, 300)" onmouseout="$(this).find('.image-remove-icon').stop().animate({opacity: 0.0}, 300)">
                            <div style="height: 195px; width: 195px; display: table-cell; vertical-align: middle;">
                                <img src="http://flock.designersguild.com/imagelibrary/195/@(i.ImageID).jpeg" alt="@(i.ImageID)" title="@(i.ImageID)" />
                            </div>
                            <img src="~/Images/SystemIcons/remove-icon.png" class="image-remove-icon" onclick="RemoveRelatedProductPage(@(i.ProductPageID))" />
                            <label>@i.Name</label>
                        </div>
                    }
                    else
                    {
                        <div data-product-page-id="@(i.ProductPageID)" class="related-product-sortable" onmouseover="$(this).find('.image-remove-icon').stop().animate({opacity: 0.8}, 300)" onmouseout="$(this).find('.image-remove-icon').stop().animate({opacity: 0.0}, 300)">
                            <div style="height: 195px; width: 195px; display: table-cell; vertical-align: middle;">
                                <img src="/Images/Admin/image-not-set.png" alt="@(i.ImageID)" title="@(i.ImageID)" />
                            </div>
                            <img src="~/Images/SystemIcons/remove-icon.png" class="image-remove-icon" onclick="RemoveRelatedProductPage(@(i.ProductPageID))" />
                            <label>@i.Name</label>
                        </div>
                    }
                }
            }
            <script type="text/javascript">
                if (typeof (InitRelatedProductPagesDragDrop) == 'function')
                    InitRelatedProductPagesDragDrop();
            </script>
        </div>
    </fieldset>
</div>
