@model List<Flock.Models.Collection_Image>
@if(Model.Count == 0)
{
    <img src="/Images/admin/image-not-set.png" alt="Image not set." title="You must set a primary image for this collection." /> 
} 
else 
{
    foreach(Flock.Models.Collection_Image i in Model)
    {
        <div data-image-id="@i.ImageID" class="pod-sortable" onmouseover="$(this).find('.image-remove-icon').stop().animate({opacity: 0.8}, 300)" onmouseout="$(this).find('.image-remove-icon').stop().animate({opacity: 0.0}, 300)">
            <img style="width: 295px;" src="https://flock.designersguild.com/imagelibrary/322/@(i.ImageID).jpeg" alt="@(i.AltText)" title="@(i.TitleText)" /> 
            <img src="~/Images/SystemIcons/remove-icon.png" class="image-remove-icon" onclick="RemoveImageFromCollectionArea(1, @(i.ImageID))"/>
        </div>
    }
    <script type="text/javascript">
        initDragDrop();
    </script>
}