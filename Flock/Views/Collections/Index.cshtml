@model Flock.ViewModels.CollectionViewModel
@{
    Layout = "~/Views/Public/_Layout.cshtml";
}
<!-- breadcrumbs -->
<div id="container-inner">
    <h3>@Model.Name - @Model.Season by @Model.BrandName</h3>
    <div id="page-chassis" class="pure-g">
        <div class="pure-u-1-3">
            <div class="section-inner">
                <div class="section text-section">
                    <a href="javascript:;" style="display: block">See all Fabrics in this Collection</a>
                    @Model.Description
                </div>
            </div>
        </div>
        <div class="pure-u-2-3">
            <div class="section-inner" style="height: 360px">
                <div class="section" style="height: 100%;">
                    <!-- Slideshow -->
                    @Html.DevExpress().ImageSlider(settings =>
                    {
                        settings.Name = "CollectionSlider";
                        settings.SettingsNavigationBar.Mode = NavigationBarMode.Dots;

                        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
                        settings.Height = System.Web.UI.WebControls.Unit.Percentage(100);
                        settings.Style.Add("display", "block");
                        
                        for(int i = 0; i < Model.CollectionImages.Count; i++) 
                        {
                            settings.Items.Add(item => 
                            {
                                item.ImageUrl = "../ImageLibrary/654/" + Model.CollectionImages[i] + ".jpeg";
                                item.Text = "";
                            });
                        }
                    }).GetHtml()
                    <div id="collection-connections">
                        <a href="javascript:;" style="font-size: 12px; line-height: 35px; float: left">View all lifestyle images from this collection in the Inspiration gallery</a>
                        <img src="/Images/orderedList5.png" alt="Email" title="Email" />
                        <img src="/Images/orderedList4.png" alt="Print" title="Print" />
                        <img src="/Images/orderedList3.png" alt="Google Plus" title="Google Plus" />
                        <img src="/Images/orderedList2.png" alt="Facebook" title="Facebook" />
                        <img src="/Images/orderedList1.png" alt="Pinterest" title="Pinterest" />
                        <img src="/Images/orderedList0.png" alt="Twitter" title="Twitter" />
                        <div style="clear: both"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="pure-u-1-2">
            <div class="section-inner">
                <div class="section">
                    <h1>Products in Collection</h1>
                </div>
            </div>
        </div>
        <div class="pure-u-1-4">
            <div class="section-inner">
                <div class="section">
                    <h1>Brochure!</h1>
                </div>
            </div>
        </div>
        <div class="pure-u-1-4">
            <div class="section-inner">
