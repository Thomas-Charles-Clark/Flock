            success: function (data) {
                $("#collection-related-busy").fadeOut("fast");
                $("#related-collections").html(data);
            },
            error: function (data) {
                $("#collection-related-busy").fadeOut("fast");
            },
            timeout: 20000
        });
    }

    function ShiftDXToHidden() {
        $('#collection-description-hidden').val(CollectionHtmlEditor.GetHtml());
        $('#collection-heading-hidden').val(CollectionHeading.GetValue());
        $('#collection-subheading-hidden').val(CollectionSubHeading.GetValue());
    }
</script>

<input type="hidden" id="selected-collection-id" value="@(Model.CollectionID)" />

<h4 class="page-heading">
    Compose Collection
    <a id="association-link" class="link-img" target="_blank" title="Product Associations" href="/admin/collections/productassociation/@(Model.CollectionID)"></a>
</h4>

<div style="float: right; width: 986px;">
    @Html.Partial("~/Views/Images/ImageSearchPartial.cshtml")
    @Html.Partial("CollectionSearchPartial")
    @Html.Partial("~/Views/Shared/CountrySearch.cshtml")
</div>

<div style="float: left; width: 986px;">
    <div id="collection-select-header-container">
        <div class="content-panel-container">
            <fieldset id="collection-select-header">
                <legend style="color: black; border-bottom-color: #929292;" onclick="$('#collection-select-header-inner').slideToggle('fast');">Collection Selector (click to expand / contract)</legend>
                <div id="collection-select-header-inner" style="">
                    <div id="collection-header-grid-container">
                        @Html.Action("ComposeCollectionGridSelectorPartial", "Collections")
                    </div>
                    <div style="clear: both"></div>
                </div>
            </fieldset>
        </div>
    </div>
    <div id="collection-compose-container">
        @if (ViewData["InvalidCollectionIDError"] != null)
        {
            <h5>@(ViewData["InvalidCollectionIDError"])</h5>
        }
        @if (Model.CollectionID != null)
