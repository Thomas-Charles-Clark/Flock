    function RemoveImageFromCollectionArea(TemplateImageID, ImageID) {
        switch (TemplateImageID) {
            case 1: $("#collection-pod-busy").fadeIn("fast"); break;
            case 2: $("#collection-slideshow-busy").fadeIn("fast"); break;
            case 3: $("#collection-sp1-busy").fadeIn("fast"); break;
            case 4: $("#collection-sp2-busy").fadeIn("fast"); break;
            case 5: $("#collection-viewall-busy").fadeIn("fast"); break;
            case 6: $("#collection-brochure-busy").fadeIn("fast"); break;
            case 7: $("#collection-sp3-busy").fadeIn("fast"); break;
            case 8: $("#collection-video-busy").fadeIn("fast"); break;
            default: return;
        }
        var confirm = window.confirm("Are you sure?");
        if (confirm) {
            $.ajax({
                url: '@Url.Action("RemoveImageFromCollectionArea", "Collections")',//"/Products/UpdateCollectionAddProduct",
                traditional: true,
                type: "POST",
                data: { CollectionID: Number($("#selected-collection-id").val()), TemplateImageID: TemplateImageID, ImageID: ImageID },
                success: function (data) {
                    switch (TemplateImageID) {
                        case 1: $("#collection-pod-busy").fadeOut("fast"); $('#pod-list').html(data); break;
                        case 2: $("#collection-slideshow-busy").fadeOut("fast"); $('#collection-slideshow-container').html(data); break;
                        case 3: $("#collection-sp1-busy").fadeOut("fast"); $('#collection-sp1-container').html(data); break;
                        case 4: $("#collection-sp2-busy").fadeOut("fast"); $('#collection-sp2-container').html(data); break;
                        case 5: $("#collection-viewall-busy").fadeOut("fast"); $('#collection-viewall-container').html(data); break;
                        case 6: $("#collection-brochure-busy").fadeOut("fast"); $('#collection-brochure-container').html(data); break;
                        case 7: $("#collection-sp3-busy").fadeOut("fast"); $('#collection-sp3-container').html(data); break;
                        case 8: $("#collection-video-busy").fadeOut("fast"); $('#collection-video-container').html(data); break;
                        default: return false;
                    }
                    return false;
                },
                error: function (e, s, a) {
                    switch (TemplateImageID) {
                        case 1: $("#collection-pod-busy").fadeOut("fast"); break;
                        case 2: $("#collection-slideshow-busy").fadeOut("fast"); break;
                        case 3: $("#collection-sp1-busy").fadeOut("fast"); break;
                        case 4: $("#collection-sp2-busy").fadeOut("fast"); break;
                        case 5: $("#collection-viewall-busy").fadeOut("fast"); break;
                        case 6: $("#collection-brochure-busy").fadeOut("fast"); break;
                        case 7: $("#collection-sp3-busy").fadeOut("fast"); break;
                        case 8: $("#collection-video-busy").fadeOut("fast"); break;
                        default: return false;
                    }
                    alert(e.responseText);
                    return false;
                },
                timeout: 20000
            });
        }
        else {
            switch (TemplateImageID) {
                case 1: $("#collection-pod-busy").fadeOut("fast"); break;
                case 2: $("#collection-slideshow-busy").fadeOut("fast"); break;
                case 3: $("#collection-sp1-busy").fadeOut("fast"); break;
                case 4: $("#collection-sp2-busy").fadeOut("fast"); break;
                case 5: $("#collection-viewall-busy").fadeOut("fast"); break;
                case 6: $("#collection-brochure-busy").fadeOut("fast"); break;
                case 7: $("#collection-sp3-busy").fadeOut("fast"); break;
                case 8: $("#collection-video-busy").fadeOut("fast"); break;
                default: return false;
            }
        }
    }

    function BulkAddCollections() {
        // must prompt for potential targets...

        $("#related-collection-inner").sortable("refresh");
        window.relatedCollections = new Array();
        if ($("#collection-placeholder").length > 0)
            $("#collection-placeholder").remove();
        $("#related-collection-inner").children("div").each(function (index) {
            window.relatedCollections.push({ ID: $(this).data("collection-id"), SortOrder: index });
        });

        $(".collection").each(function (index) {
            if ($(this).data("collection-id") != $("#collection-slideshow-container").data("collection-id")) {
                window.relatedCollections.push({ ID: $(this).data("collection-id"), SortOrder: (window.relatedCollections.length + index) });
            }
        })

        $("#collection-related-busy").fadeIn("fast");
        $.ajax({
            url: '@Url.Action("UpdateCollectionRelatedCollections", "Collections")',
            traditional: true,
            type: "POST",
            data: { CollectionID: Number($("#selected-collection-id").val()), Collections: JSON.stringify(window.relatedCollections) },
            success: function (data) {
                $("#collection-related-busy").fadeOut("fast");
                $('#related-collections').html(data)
                return false;
            },
            error: function (e, s, a) {
                $("#collection-related-busy").fadeOut("fast");
                alert(e.responseText);
                return false;
            },
            timeout: 20000
        });
    }

