    function SaveCollectionInfo() {
        var id = Number($("#selected-collection-id").val());
        $.ajax({
            url: '@Url.Action("SaveCollectionInfo", "Collections")',
            type: 'POST',
            traditional: true,
            data: {
                CollectionID: id,
                Name: Name.GetValue(),
                Code: Code.GetValue(),
                PatternBookCode: PatternBookCode.GetValue(),
                OnDate: $("input[name='OnDate']").val(),
                OffDate: $("input[name='OffDate']").val(),
                BrandID: CollectionBrand.GetValue(),
                LaunchID: CollectionLaunch.GetValue(),
                New: New.GetValue(),
                PreviewColourways: PreviewColourways.GetValue()
            },
            success: function (data) {
                $("#collection-info-container").html(data);
                SuccessFade($("#collection-info-save"));
            },
            error: function (e, s, a) {
                $("#collection-info-container").html(e.responseText);
                FailureFade($("#collection-info-save"));
            },
            timeout: 20000
        });
    }

