@model List<Flock.Models.Collection_Image> 
<div id="slideshow-list" class="sortable-list" style="width: 100%; height: 100%;">
    @for (int i = 0; i < Model.Count; i++)
    {
        <div class="collection-slideshow-item" data-image-id="@(Model[i].ImageID)" onmouseover="$(this).find('.image-remove-icon').stop().animate({opacity: 0.8}, 300)" 
            onmouseout="$(this).find('.image-remove-icon').stop().animate({opacity: 0.0}, 300)">
            <img src="~/Images/SystemIcons/remove-icon.png" class="image-remove-icon" onclick="RemoveImageFromCollectionArea(2, @(Model[i].ImageID))" />
            <img style="width: 100%; height: auto;" src="https://flock.designersguild.com/ImageLibrary/322/@(Model[i].ImageID).jpeg" />
        </div>
    }
    @if (Model.Count == 0)
    {
        <div id="placeholder-div">
            <h5 style="float: none;"><i>There are no images associated to this collection's slideshow.</i></h5>
        </div>
    }
</div>
<script type="text/javascript">
    initDragDrop();
</script>