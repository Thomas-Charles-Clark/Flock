@model List<Flock.Models.Collection_Image>
<div onmouseover="$(this).find('.image-remove-icon').stop().animate({opacity: 0.8}, 300)" onmouseout="$(this).find('.image-remove-icon').stop().animate({opacity: 0.0}, 300)">
    @if(Model == null || Model.Count == 0)
    {
        <img id="sp2-placeholder" src="/Images/admin/image-not-set.png" style="margin-top: 22px;" alt="Image not set." title="You must set a second spacer image for this collection." /> 
    } 
    else 
    {          
        <img src="https://flock.designersguild.com/imagelibrary/239/@(Model[0].ImageID).jpeg" alt="@(Model[0].AltText)" title="@(Model[0].TitleText)"/> 
        <img src="~/Images/SystemIcons/remove-icon.png" class="image-remove-icon" onclick="RemoveImageFromCollectionArea(4, @(Model[0].ImageID))" />
    }
</div>