@model Flock.ViewModels.BaseViewModel
@using System.Web.Mvc

@{
    var currentController = ViewContext.RouteData.Values["controller"] as string ?? "Home";
    var currentAction = ViewContext.RouteData.Values["action"] as string ?? "Index";
    var currentPage = (currentController + "-" + currentAction).ToLower();

    var isActiveController = new Func<string[], string[], string, string, string>((ctrl, act, activeStyle, inactiveStyle) => ctrl.Contains(currentController.ToLower()) && act.Contains(currentAction.ToLower()) ? activeStyle : inactiveStyle);
}

