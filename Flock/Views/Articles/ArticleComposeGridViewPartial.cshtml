@using Flock.Models
@{
    var grid = Html.DevExpress().GridView(settings =>
    {
        var UoW = new Flock.DAL.UnitOfWork<FlockDataContext>();

        settings.Name = "ArticleComposeGridView";
        settings.CallbackRouteValues = new { Controller = "Articles", Action = "ArticleComposeGridViewPartial" };
        settings.SettingsEditing.AddNewRowRouteValues = new { Controller = "Articles", Action = "ArticleComposeGridViewAddNew" };
        settings.SettingsEditing.DeleteRowRouteValues = new { Controller = "Articles", Action = "ArticleComposeGridViewDelete" };

        settings.PreRender = (sender, e) =>
        {
            MVCxGridView gv = (MVCxGridView)sender;
            gv.FocusedRowIndex = -1;
        };

        settings.ClientSideEvents.RowClick = @"function(s, e) {
            var id = s.GetRowKey(e.visibleIndex);
            s.GetRowValues(e.visibleIndex, 'ArticleTemplateID', OnGetRowValues);
            $('#selected-article-id').val(id);
            LoadingPanel.Show();
           
            $.ajax({
                url: '" + @Url.Action("ChangeArticle", "Articles") + @"',
                type: 'POST',
                traditional: true,
                data: {
                    ID: id
                },
                success: function(data) {
                    $('#article-compose-container').hide();

                    $('#article-compose-container').html(data);

                    LoadingPanel.Hide();

                    $('#article-compose-container').show();
                },
                timeout: 20000
            });
        }";

        settings.SettingsBehavior.EnableRowHotTrack = true;
        settings.Styles.Row.Cursor = "pointer";
        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
        settings.CommandColumn.Visible = false;
        settings.CommandColumn.ShowClearFilterButton = false;
        settings.Settings.ShowFilterRow = true;

        settings.CommandColumn.ShowClearFilterButton = true;
        settings.CommandColumn.ShowNewButtonInHeader = true;
        settings.CommandColumn.ShowDeleteButton = true;
        settings.CommandColumn.VisibleIndex = 100;

        settings.SettingsPager.Mode = GridViewPagerMode.ShowPager;
        settings.Settings.VerticalScrollBarMode = ScrollBarMode.Visible;

        settings.SettingsBehavior.ConfirmDelete = true;
        settings.CommandColumn.ShowSelectCheckbox = false;
        settings.SettingsEditing.Mode = GridViewEditingMode.EditFormAndDisplayRow;
        settings.SettingsPager.PageSizeItemSettings.Visible = true;
        settings.SettingsPager.PageSize = 10;

        settings.SettingsBehavior.AllowFocusedRow = true;

        settings.KeyFieldName = "ArticleID";

        settings.Columns.Add(column =>
        {
            column.Name = "ArticleID";
            column.FieldName = "ArticleID";
            column.Caption = "ID";
            column.Width = 70;
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.SortDescending();
        });

        settings.Columns.Add(column =>
        {
            column.Name = "ArticleTypeID";
            column.FieldName = "ArticleTypeID";
            column.Caption = "Article Type";
            column.ColumnType = MVCxGridViewColumnType.ComboBox;
            var cbProp = column.PropertiesEdit as ComboBoxProperties;
            cbProp.ValueField = "ArticleTypeID";
            cbProp.TextField = "Name";
            cbProp.ValueType = typeof(byte);
            cbProp.DataSource = UoW.GetRepository<Flock.Models.ArticleType>().GetAll().Where(p => p.ArticleTypeID != 0);
            column.EditFormSettings.VisibleIndex = 3;
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.False;
            column.Settings.AllowHeaderFilter = DefaultBoolean.True;
            column.Settings.HeaderFilterMode = HeaderFilterMode.List;
            column.HeaderStyle.Wrap = DefaultBoolean.False;
            column.Width = 95;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
            column.EditFormSettings.Visible = DefaultBoolean.True;
        });

        settings.Columns.Add(column =>
        {
            column.Name = "ArticleSubTypeID";
            column.FieldName = "ArticleSubTypeID";
            column.Caption = "Article Sub Type";
            column.ColumnType = MVCxGridViewColumnType.ComboBox;
            var cbProp = column.PropertiesEdit as ComboBoxProperties;
            cbProp.ValueField = "ArticleSubTypeID";
            cbProp.TextField = "Name";
            cbProp.ValueType = typeof(byte);
            cbProp.DataSource = UoW.GetRepository<Flock.Models.ArticleSubType>().GetAll();
            column.EditFormSettings.VisibleIndex = 3;
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.False;
            column.Settings.AllowHeaderFilter = DefaultBoolean.True;
            column.Settings.HeaderFilterMode = HeaderFilterMode.List;
            column.HeaderStyle.Wrap = DefaultBoolean.False;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
            column.EditFormSettings.Visible = DefaultBoolean.True;
        });

        settings.Columns.Add(column =>
        {
            column.Name = "ArticleTemplateID";
            column.FieldName = "ArticleTemplateID";
            column.Caption = "Template";
            column.ColumnType = MVCxGridViewColumnType.ComboBox;
            var cbProp = column.PropertiesEdit as ComboBoxProperties;
            cbProp.ValueField = "ArticleTemplateID";
            cbProp.TextField = "Name";
            cbProp.ValueType = typeof(byte);
            cbProp.DataSource = UoW.GetRepository<Flock.Models.ArticleTemplate>().GetAll();
            column.EditFormSettings.VisibleIndex = 4;
            column.Settings.AllowAutoFilter = DefaultBoolean.False;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.False;
            column.Settings.AllowHeaderFilter = DefaultBoolean.True;
            column.Settings.HeaderFilterMode = HeaderFilterMode.List;
            column.HeaderStyle.Wrap = DefaultBoolean.False;
            column.Width = 85;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
            column.EditFormSettings.Visible = DefaultBoolean.True;
        });

        settings.SettingsEditing.ShowModelErrorsForEditors = true;

        settings.Columns.Add(column =>
        {
            column.Name = "Name";
            column.FieldName = "Name";
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.EditFormSettings.Visible = DefaultBoolean.True;
            column.EditFormSettings.VisibleIndex = 1;
            
            column.Width = 210;
            column.ColumnType = MVCxGridViewColumnType.TextBox;
            var tbp = column.PropertiesEdit as TextBoxProperties;
            tbp.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.ImageWithTooltip;
            
            tbp.MaxLength = 100;

            column.EditFormCaptionStyle.CssClass = "editform-label";
            column.EditCellStyle.CssClass = "editform-cell";
        });
        
        settings.Columns.Add(column =>
        {
            column.Name = "TitleTag";
            column.FieldName = "TitleTag";
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.EditFormSettings.Visible = DefaultBoolean.True;
            column.EditFormSettings.VisibleIndex = 1;
            column.Width = 190;
            column.ColumnType = MVCxGridViewColumnType.TextBox;
            var tbp = column.PropertiesEdit as TextBoxProperties;
            tbp.MaxLength = 70;
            column.Visible = false;
            column.EditFormCaptionStyle.CssClass = "editform-label";
            column.EditCellStyle.CssClass = "editform-cell";
        });
        
        settings.Columns.Add(column =>
        {
            column.Name = "CreatedDT";
            column.FieldName = "CreatedDT";
            column.Caption = "Created DT";
            column.Settings.AllowHeaderFilter = DefaultBoolean.False;
            column.Settings.AllowAutoFilter = DefaultBoolean.True;
            column.Settings.ShowFilterRowMenu = DefaultBoolean.True;
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.ColumnType = MVCxGridViewColumnType.DateEdit;
            column.Width = 90;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
        });

        MVCxGridViewColumn HeadingColumn = new MVCxGridViewColumn();
        HeadingColumn.Name = "Heading";
        HeadingColumn.FieldName = "Heading";
        HeadingColumn.Caption = "Heading";
        HeadingColumn.EditFormSettings.Visible = DefaultBoolean.True;
        HeadingColumn.EditFormSettings.VisibleIndex = 2;
        HeadingColumn.Visible = false;
        HeadingColumn.ColumnType = MVCxGridViewColumnType.TextBox;
        var hProp = HeadingColumn.PropertiesEdit as TextBoxProperties;
        hProp.MaxLength = 70;
        settings.Columns.Add(HeadingColumn);

        MVCxGridViewColumn WebStatusColumn = new MVCxGridViewColumn();
        WebStatusColumn.FieldName = "WebStatus";
        WebStatusColumn.Name = "WebStatus";
        WebStatusColumn.Caption = "Web Status";
        WebStatusColumn.EditFormSettings.Visible = DefaultBoolean.False;
        WebStatusColumn.Settings.HeaderFilterMode = HeaderFilterMode.List;
        WebStatusColumn.Settings.AllowHeaderFilter = DefaultBoolean.True;
        WebStatusColumn.Settings.AllowAutoFilter = DefaultBoolean.False;
        WebStatusColumn.Width = 120;
        WebStatusColumn.HeaderStyle.Wrap = DefaultBoolean.False;
        WebStatusColumn.SetDataItemTemplateContent(c =>
        {
            var i = Convert.ToByte(DataBinder.Eval(c.DataItem, "WebStatus"));
            string colour = "black";
            string statusText = "unknown";
            statusText = UoW.GetRepository<Flock.Models.Status>().GetAll().Where(p => p.StatusID == i).Select(p => p.Name).Single();
            switch (i)
            {
                case 0:
                    colour = "green";
                    break;
                case 1:
                    colour = "orange";
                    break;
                case 2:
                    colour = "orange";
                    break;
                case 3:
                    colour = "green";
                    break;
                case 4:
                    colour = "red";
                    break;
                default: break;
            }
            string res = "<span style='color: " + colour + " '>" + statusText + "</span>";
            ViewContext.Writer.Write(res);
        });
        settings.Columns.Add(WebStatusColumn);

        settings.HeaderFilterFillItems = (sender, e) =>
        {
            MVCxGridView gridView = (MVCxGridView)sender;
            switch (e.Column.Name)
            {
                case "ArticleTypeID":
                    e.Values.Clear();
                    foreach (var at in UoW.GetRepository<Flock.Models.ArticleType>().GetAll().OrderBy(p => p.Name))
                    {
                        e.AddValue(at.Name, at.ArticleTypeID.ToString());
                    }
                    e.AddShowAll();
                    break;

                case "ArticleSubTypeID":
                    e.Values.Clear();
                    foreach (var at in UoW.GetRepository<Flock.Models.ArticleSubType>().GetAll().OrderBy(p => p.Name))
                    {
                        e.AddValue(at.Name, at.ArticleSubTypeID.ToString());
                    }
                    e.AddShowAll();
                    break;
                    
                   
                case "WebStatus":
                    e.Values.Clear();
                    foreach (var pt in UoW.GetRepository<Flock.Models.Status>().GetAll().OrderBy(p => p.StatusID).ToList())
                    {
                        e.AddValue(pt.Name, pt.StatusID.ToString());
                    }
                    e.AddShowAll();
                    break;

                default: break;
            }
        };
    });

    if (ViewData["EditError"] != null)
    {
        grid.SetEditErrorText((string)ViewData["EditError"]);
    }
}
@grid.BindToLINQ("", "", (s, e) =>
{
    var dataContext = new Flock.DAL.UnitOfWork<Flock.Models.FlockDataContext>();
    var source = dataContext.GetRepository<Flock.Models.vwArticleOverview>().GetAll();
    e.QueryableSource = source;
    e.KeyExpression = "ArticleID";
}).GetHtml()