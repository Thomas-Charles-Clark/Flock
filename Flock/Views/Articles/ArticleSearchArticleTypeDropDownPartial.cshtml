@model List<Flock.Models.ArticleType>
@Html.DevExpress().DropDownEdit(
    settings =>
    {
        settings.Name = "ArticleTypeDD";

        string action = ViewContext.Controller.ValueProvider.GetValue("action").AttemptedValue;
        if (action == "ArticleSearchArticleTypeDropDownPartial")
            settings.Name = "ArticleSearchArticleTypeDD";

        settings.Style.Add("float", "left");
        settings.Style.Add("margin", "0 7px 7px 0");
        settings.Text = "Article Type";
        settings.Properties.DropDownWindowStyle.BackColor = System.Drawing.Color.FromArgb(0xEDEDED);

        settings.Width = System.Web.UI.WebControls.Unit.Pixel(200);
        settings.Height = System.Web.UI.WebControls.Unit.Pixel(35);

        settings.Properties.EnableClientSideAPI = true;

        settings.SetDropDownWindowTemplateContent(c =>
        {
            ViewContext.Writer.Write("<div id='article-type-listbox'>");
            ViewContext.Writer.Write(@Html.Partial("ArticleSearchArticleTypeListBoxPartial", Model));
            ViewContext.Writer.Write("</div>");
            ViewContext.Writer.Write("<div style=\"padding: 6px;\">");
            @Html.DevExpress().Button(
                buttonSettings =>
                {
                    if (action == "ArticleSearchArticleTypeDropDownPartial")
                    {
                        buttonSettings.Name = "ArticleSearchArticleTypeButtonClear";
                        buttonSettings.Text = "Clear";
                        buttonSettings.Style.Add("float", "left");
                        buttonSettings.ClientSideEvents.Click = @"function(s, e){
                            ArticleSearchArticleTypeListBox.UnselectAll();
                            ArticleSearchArticleTypeDD.HideDropDown();
                            ArticleSearchArticleTypeDD.SetText('Article Type');
                            $('#article-searching-icon').fadeIn('fast');
                            $.ajax({
                                url: '" + Url.Action("ArticleSearch", "Articles") + @"',
                                traditional: true,
                                data: {
                                    ArticleTypeID: ArticleSearchArticleTypeListBox.GetValue(),
                                    NameOrID: ArticleSearchNameOrIDTextBox.GetValue()                                
                                },
                                success: function(data) {
                                    $('#article-data-view-container').html(data);
                                    $('#article-searching-icon').fadeOut('slow');
                                },
                                timeout: 20000
                            });
                        }";
                    }
                }
            )
            .Render();
            @Html.DevExpress().Button(
                buttonSettings =>
                {
                    if (action == "ArticleSearchArticleTypeDropDownPartial")
                    {
                        buttonSettings.Name = "articleTypeButtonClose";
                        buttonSettings.Text = "Close";
                        buttonSettings.Style.Add("float", "right");
                        buttonSettings.ClientSideEvents.Click = @"function(s, e){
                            ArticleSearchArticleTypeDD.HideDropDown();
                        }";
                    }
                }
            )
            .Render();
            ViewContext.Writer.Write("<div style='clear: both;'></div></div>");
        });
        settings.Properties.AnimationType = AnimationType.None;
    }
).GetHtml()