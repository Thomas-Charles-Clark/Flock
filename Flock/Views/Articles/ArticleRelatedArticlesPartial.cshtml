@model List<Flock.Models.vwArticle_RelatedArticle>
<div class="content-panel-container">
    <fieldset>
        <legend style="color: black; border-bottom-color: #929292;" onclick="$('#related-articles').slideToggle('fast')">
            Related Articles (click to expand / contract)
            <img id="related-page-busy" class="busy" src="/Images/SystemIcons/busy-icon.gif" alt="busy icon" title="Working..." />
        </legend>
        <div id="related-articles" style="background-color: white; padding: 1em;">
            @if (Model.Count == 0)
            {
                <div id="related-article-placeholder" style="padding: 1em 0; font-size: 1.4em; background-color: white; width: 255px;">
                    No Related Articles have been set.
                </div>
            }
            else
            {
                foreach (Flock.Models.vwArticle_RelatedArticle i in Model)
                {
                    if (i.ImageID != 0 && i.ImageID != null)
                    {
                        <div data-article-id="@(i.RelatedArticleID)" class="related-article-sortable" onmouseover="$(this).find('.image-remove-icon').stop().animate({opacity: 0.8}, 300)" onmouseout="$(this).find('.image-remove-icon').stop().animate({opacity: 0.0}, 300)">
                            <div style="width: 195px; display: table-cell; vertical-align: middle;">
                                <img src="https://flock.designersguild.com/imagelibrary/195/@(i.ImageID).jpeg" alt="@(i.ImageID)" title="@(i.ImageID)" />
                            </div>
                            <img src="~/Images/SystemIcons/remove-icon.png" class="image-remove-icon" onclick="RemoveRelatedArticle(@(i.RelatedArticleID))" />
                            <label>@i.Name</label>
                        </div>
                    }
                    else
                    {
                        <div data-article-id="@(i.RelatedArticleID)" class="related-article-sortable" onmouseover="$(this).find('.image-remove-icon').stop().animate({opacity: 0.8}, 300)" onmouseout="$(this).find('.image-remove-icon').stop().animate({opacity: 0.0}, 300)">
                            <div style="width: 195px; display: table-cell; vertical-align: middle;">
                                <img src="/Images/Admin/ar2-placeholder.png" style="width: 195px;" alt="@(i.ImageID)" title="@(i.ImageID)" />
                            </div>
                            <img src="~/Images/SystemIcons/remove-icon.png" class="image-remove-icon" onclick="RemoveRelatedArticle(@(i.RelatedArticleID))" />
                            <label>@i.Name</label>
                        </div>
                    }
                }
            }
        </div>
    </fieldset>
</div>
<script type="text/javascript">
    if (typeof (InitRelatedArticlesDragDrop) == 'function')
        InitRelatedArticlesDragDrop();
</script>