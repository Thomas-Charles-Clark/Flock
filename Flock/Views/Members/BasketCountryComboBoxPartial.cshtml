@using Flock.ViewModels
@Html.DevExpress().ComboBox(settings =>
{
    settings.Name = "BasketCountrySelector";
    settings.Properties.NullDisplayText = "Country...";
    settings.Properties.NullText = "Country...";
    settings.Style.Add("margin-right", "1em");
    settings.Style.Add("float", "left");
    settings.Properties.CallbackPageSize = 15;
    //settings.Properties.FilterMinLength = 2;
    //settings.Properties.IncrementalFilteringMode = IncrementalFilteringMode.Contains;
    settings.CallbackRouteValues = new { Controller = "Members", Action = "BasketCountryComboBoxPartial" };
    var prop = settings.Properties as ComboBoxProperties;
    //prop.DataSource = ;
    prop.TextField = "Name";
    prop.ValueField = "CountryID";
    prop.ValueType = typeof(short);
    settings.Properties.ClientSideEvents.SelectedIndexChanged = @"function(s, e) {
                                            LoadingPanel.Show();
                                            $.ajax({
                                                url: '" + Url.Action("CountrySpecificBasket", "Members") + @"',
                                                type: 'POST',
                                                traditional: true,
                                                data: {
                                                    MemberID: $('#selected-member-id').val(),
                                                    CountryID: s.GetValue()
                                                },
                                                success: function(data) {
                                                    LoadingPanel.Hide();
                                                    $('#basket-area').html(data)
                                                },
                                                timeout: 20000
                                            });
                                        }";
    settings.Properties.Buttons.Add("Clear");
    var b = settings.Properties.Buttons[0] as EditButton;
    settings.Properties.ClientSideEvents.ButtonClick = @"function(s, e) {
                                            if(e.buttonIndex == 0) {
                                                s.SetSelectedIndex(-1);
                                                LoadingPanel.Show();
                                                $.ajax({
                                                    url: '" + Url.Action("CountrySpecificBasket", "Members") + @"',
                                                    type: 'POST',
                                                    traditional: true,
                                                    data: {
                                                        MemberID: $('#selected-member-id').val(),
                                                        CountryID: s.GetValue()
                                                    },
                                                    success: function(data) {
                                                        LoadingPanel.Hide();
                                                        $('#basket-area').html(data)
                                                    },
                                                    timeout: 20000
                                                });
                                            }
                                        }";
}).BindList(args =>
{
    return LargeDatabaseDataProvider.GetCountries(args);
}, LargeDatabaseDataProvider.GetCountryByID).GetHtml()